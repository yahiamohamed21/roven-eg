@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="mb-3">
                <div class="stat-icon warning mx-auto" style="width: 72px; height: 72px; font-size: 2.25rem;">
                    <i class="bi bi-shield-lock-fill text-danger"></i>
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions or administrative privileges to view this section of ROVEN.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Dashboard</span>
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <span>Go Back</span>
                </a>
            </div>
        </div>
    </div>
</div>
