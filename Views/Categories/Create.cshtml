@model Stockify.ViewModels.Categories.CategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tag-fill text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Create New Category</h5>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Categories
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Computer Accessories" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                            <div class="form-text small text-muted">Category name must be unique.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief summary describing the type of products in this category..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Save Category
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
