    <!-- ============================================================== -->
    <!-- MAISON ROVEN — HAUTE PARFUMERIE LUXURY PRELOADER               -->
    <!-- ============================================================== -->
    <div id="roven-preloader" aria-hidden="false">
        <div class="preloader-glow-orb"></div>
        <div class="preloader-content">
            <!-- Luxury Monogram Emblem -->
            <div class="preloader-emblem-wrap">
                <div class="preloader-gold-orbit"></div>
                <div class="preloader-gold-ring"></div>
                <div class="preloader-shield">
                    <span class="preloader-monogram-letter">R</span>
                </div>
            </div>

            <!-- Brand Wordmark & Subtitle -->
            <h2 class="preloader-brand-title">ROVEN</h2>
            <div class="preloader-brand-subtitle">HAUTE PARFUMERIE &bull; PARIS &bull; CAIRO</div>

            <!-- Ultra-Fine Luxury Progress Meter -->
            <div class="preloader-track">
                <div class="preloader-bar" id="roven-preloader-bar"></div>
            </div>

            <!-- Status Phrase & Percentage Counter -->
            <div class="preloader-footer">
                <span class="preloader-phrase" id="roven-preloader-phrase">L'Art du Parfum...</span>
                <span class="preloader-percent" id="roven-preloader-percent">0%</span>
            </div>
        </div>
    </div>
    <!-- Immediate Mobile / iOS Safari Hardware Viewport Enforcer -->
    <script>
        (function() {
            function enforcePreloaderStretch() {
                var p = document.getElementById('roven-preloader');
                if (p && !p.classList.contains('preloader-hidden')) {
                    var screenH = (window.screen && window.screen.height) ? window.screen.height : 0;
                    var innerH = window.innerHeight || 0;
                    var clientH = document.documentElement.clientHeight || 0;
                    var h = Math.max(screenH, innerH, clientH, 800);
                    p.style.setProperty('height', (h + 470) + 'px', 'important');
                    p.style.setProperty('min-height', (h + 470) + 'px', 'important');
                    p.style.setProperty('top', '-120px', 'important');
                    p.style.setProperty('bottom', '-350px', 'important');
                    p.style.setProperty('left', '-20px', 'important');
                    p.style.setProperty('right', '-20px', 'important');
                    p.style.setProperty('width', 'calc(100vw + 40px)', 'important');
                }
            }
            enforcePreloaderStretch();
            window.addEventListener('resize', enforcePreloaderStretch);
            window.addEventListener('orientationchange', enforcePreloaderStretch);
        })();
    </script>

