            font-weight: 600;
            letter-spacing: 4px;
            color: #EDEBDD;
            opacity: 0.8;
            text-transform: uppercase;
            margin-bottom: 1.75rem;
        }

        /* Micro Luxury Progress Line */
        .preloader-track {
            width: 230px;
            height: 2.5px;
            background: rgba(237, 235, 221, 0.15);
            border-radius: 4px;
            margin: 0 auto 0.75rem;
            overflow: hidden;
            position: relative;
        }

        .preloader-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #630000 0%, #810100 50%, #e8c688 100%);
            box-shadow: 0 0 12px rgba(232, 198, 136, 0.9);
            transition: width 0.15s ease-out;
            border-radius: 4px;
        }

        /* Evocative Phrase & Percentage */
        .preloader-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 230px;
            margin: 0 auto;
            font-size: 0.72rem;
            color: #EDEBDD;
            opacity: 0.75;
        }

        .preloader-phrase {
            font-style: italic;
            font-family: 'Playfair Display', serif;
            letter-spacing: 0.5px;
            transition: opacity 0.25s ease;
        }

        .preloader-percent {
            font-family: monospace;
            font-weight: 600;
            letter-spacing: 1px;
        }

        /* Shimmer Ambient Glow in Background */
        .preloader-glow-orb {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(129, 1, 0, 0.32) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            animation: preloader-breathe 4s ease-in-out infinite alternate;
        }

        /* Keyframes Animations */
        @@keyframes preloader-spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @@keyframes preloader-pulse {
            0%, 100% {
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.65), inset 0 0 15px rgba(232, 198, 136, 0.25);
            }
            50% {
                box-shadow: 0 15px 40px rgba(129, 1, 0, 0.65), inset 0 0 25px rgba(232, 198, 136, 0.45);
            }
        }

        @@keyframes preloader-breathe {
            0% {
                transform: translate(-50%, -50%) scale(0.9);
                opacity: 0.6;
            }
            100% {
                transform: translate(-50%, -50%) scale(1.15);
                opacity: 0.95;
            }
        }

        /* Mobile Viewport Sizing for Preloader */
        @@media (max-width: 576px) {
