@using Microsoft.AspNetCore.Identity
@using Stockify.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Stockify.Data.ApplicationDbContext DbContext

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var siteSetting = DbContext.HomeSettings.FirstOrDefault() ?? new Stockify.Models.Entities.HomeSetting();
}

<!DOCTYPE html>
<html lang="ar" class="roven-loading">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta http-equiv="content-language" content="ar-eg, en" />
    <script>
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }
        window.scrollTo(0, 0);
        try {
            if (localStorage.getItem('roven_lead_dismissed') === 'true' && document.cookie.indexOf('roven_lead_dismissed=true') === -1) {
                document.cookie = "roven_lead_dismissed=true; path=/; max-age=31536000; SameSite=Lax";
            }
        } catch(e) {}
    </script>
    @{
        var rawTitle = ViewData["Title"]?.ToString() ?? "";
        var tabTitle = string.IsNullOrWhiteSpace(rawTitle) || rawTitle == "Storefront" || rawTitle.Equals("ROVEN", StringComparison.OrdinalIgnoreCase)
            ? "ROVEN Haute Parfumerie | دار روڤين / روفان للعطور الفاخرة — الموقع الرسمي"
            : (rawTitle.Contains("ROVEN") ? rawTitle : $"{rawTitle} | ROVEN Haute Parfumerie");
        var canonicalHost = "roven-eg.online";
        var currentPath = Context.Request.Path.Value ?? "/";
        var canonicalUrl = $"https://{canonicalHost}{currentPath}";
    }
    <title>@tabTitle</title>
    
    <!-- ============================================================== -->
    <!-- Brand Domination SEO & Metadata (ROVEN Haute Parfumerie)         -->
    <!-- ============================================================== -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "الموقع الرسمي لدار روڤين / روفان للعطور الفاخرة (Maison ROVEN Haute Parfumerie) في مصر. تسوق أرقى عطور النيش والـ Extraits de Parfum بتركيز 30% زيوت نقية مع ثبات وفوحان يدوم 24 ساعة. شحن وتوصيل فوري لجميع محافظات مصر مع المعاينة قبل الاستلام والدفع عند الاستلام.")" />
    <meta name="keywords" content="ROVEN, roven, Maison ROVEN, roven perfumes, roven perfume, roven egypt, roven fragrance, عطور roven, براند roven, ماركة roven, روڤين, روفين, روفن, روڤن, روفان, روفيين, روبن, عطور روفان, براند روفان, عطور روڤين, عطور روفين, براند روڤين, براند روفين, ماركة روفين, ميزون روفان, ميزون روڤين, ميزون روفين, عطور روبن, موقع روفان, متجر روفان, موقع روفين, متجر روڤين, rovin, rowen, rovan, rouven, rovn, roveen, rovyn, rofen, haute parfumerie, extrait de parfum, luxury perfume egypt, niche perfumes egypt, عطور نيش مصر, تركيبات عطور فاخرة, عطور ثبات عالي, عود هندي, عنبر, مسك, شراء عطور اونلاين مصر, دفع عند الاستلام مع المعاينة" />
    <meta name="author" content="Maison ROVEN" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#1B1717" id="rovenThemeColorMeta" />
    
    <!-- Canonical & International Hreflang Tags (Guaranteed Primary Domain Equity) -->
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="ar-eg" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    
    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:site_name" content="Maison ROVEN (روڤين / روفان)" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@tabTitle" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Official Maison ROVEN Haute Parfumerie. Handcrafted luxury Extraits de Parfum, royal oud, and eternal sillage with Cash on Delivery in Egypt. دار روڤين / روفان للعطور.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{canonicalUrl.TrimEnd('/')}/images/roven-logo.png")" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@tabTitle" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Official Maison ROVEN Haute Parfumerie. Handcrafted luxury Extraits de Parfum with Cash on Delivery across Egypt.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"{canonicalUrl.TrimEnd('/')}/images/roven-logo.png")" />
    
    <!-- Favicon & Touch Icons (Crisp 1:1 ROVEN Monogram) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=roven3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png?v=roven3" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png?v=roven3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png?v=roven3" />
    <link rel="shortcut icon" href="/favicon.ico?v=roven3" />

