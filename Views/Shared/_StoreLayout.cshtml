            height: 100% !important;
            max-height: 100% !important;
            touch-action: none !important;
            overscroll-behavior: none !important;
        }

        .roven-lead-backdrop {
            position: fixed !important;
            inset: 0 !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100% !important;
            width: 100vw !important;
            height: 100% !important;
            height: 100vh !important;
            min-height: 100% !important;
            min-height: 100vh !important;
            min-height: -webkit-fill-available !important;
            z-index: 2147483640 !important;
            background: rgba(12, 10, 10, 0.88) !important;
            backdrop-filter: blur(16px) !important;
            -webkit-backdrop-filter: blur(16px) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 1rem !important;
            padding-top: max(1rem, env(safe-area-inset-top, 0px)) !important;
            padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px)) !important;
            padding-left: max(1rem, env(safe-area-inset-left, 0px)) !important;
            padding-right: max(1rem, env(safe-area-inset-right, 0px)) !important;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            touch-action: none !important;
            overscroll-behavior: none !important;
            transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
        }

        .roven-lead-backdrop.active {
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
        }

        .roven-lead-modal {
            background: radial-gradient(135% 120% at 50% 0%, #221616 0%, #151111 60%, #0d0a0a 100%) !important;
            border: 1px solid rgba(232, 198, 136, 0.4) !important;
            border-radius: 20px !important;
