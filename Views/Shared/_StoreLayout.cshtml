        /* -------------------------------------------------------------
           MAISON ROVEN — HAUTE PARFUMERIE LUXURY PRELOADER
           ------------------------------------------------------------- */
        #roven-preloader {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            inset: -120px -20px -350px -20px !important;
            width: calc(100vw + 40px) !important;
            min-width: 100vw !important;
            height: calc(100vh + 470px) !important;
            height: calc(100lvh + 470px) !important;
            height: calc(100dvh + 470px) !important;
            min-height: calc(100vh + 470px) !important;
            min-height: calc(100lvh + 470px) !important;
            min-height: calc(100dvh + 470px) !important;
            min-height: -webkit-fill-available !important;
            z-index: 2147483647 !important;
            background-color: #1B1717 !important;
            background: radial-gradient(circle at 50% 45%, rgba(129, 1, 0, 0.55) 0%, rgba(99, 0, 0, 0.28) 32%, rgba(27, 23, 23, 0.99) 72%),
                        linear-gradient(135deg, #150f0f 0%, #240505 50%, #150f0f 100%) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            overflow: hidden !important;
            touch-action: none !important;
            overscroll-behavior: none !important;
            margin: 0 !important;
            padding: 120px 20px 350px 20px !important;
            box-sizing: border-box !important;
            pointer-events: auto !important;
            transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        }

        #roven-preloader.preloader-hidden {
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
        }

        .preloader-content {
            text-align: center;
            color: #EDEBDD;
            position: relative;
            z-index: 2;
            padding: 2rem;
            max-width: 440px;
            transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s ease;
        }

        #roven-preloader.preloader-hidden .preloader-content {
            transform: scale(1.05) translateY(-8px);
            opacity: 0;
        }

        /* Luxury Monogram Emblem */
        .preloader-emblem-wrap {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .preloader-gold-orbit {
