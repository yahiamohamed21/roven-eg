        }

        .roven-lead-input-group i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #25D366;
            font-size: 1.25rem;
            pointer-events: none;
            z-index: 2;
        }

        .roven-lead-input {
            background: rgba(255, 255, 255, 0.07) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 12px !important;
