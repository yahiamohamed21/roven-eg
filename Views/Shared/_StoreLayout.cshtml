    @await RenderSectionAsync("SeoStructuredData", required: false)
    
    <!-- Google Fonts: Haute Parfumerie Typography (Playfair Display & Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Local FontAwesome 6 & Bootstrap Icons (Guaranteed Offline / TE Data Protection) -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <!-- CDN Fallbacks -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            /* User Brand Color Palette */
            --roven-burgundy: #630000;
            --roven-crimson: #810100;
            --roven-charcoal: #1B1717;
            --roven-cream: #EDEBDD;

            --store-primary: #630000;
            --store-primary-hover: #810100;
            --store-accent: #810100;
            --store-dark: #1B1717;
            --store-cream: #EDEBDD;
            --store-bg: #FAF9F5;
        }

        html {
            width: 100% !important;
            max-width: 100% !important;
            -webkit-text-size-adjust: 100%;
            -webkit-overflow-scrolling: touch;
        }

        body {
            background-color: var(--store-bg);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1B1717;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            width: 100% !important;
            max-width: 100% !important;
            position: relative;
            -webkit-overflow-scrolling: touch;
        }

        main {
            width: 100% !important;
            max-width: 100vw !important;
            overflow-x: clip;
            flex: 1 0 auto;
        }

        html.roven-loading {
            overflow: hidden !important;
            height: 100% !important;
            min-height: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            min-height: 100lvh !important;
            min-height: -webkit-fill-available !important;
            touch-action: none !important;
            -webkit-overflow-scrolling: auto !important;
            background-color: #1B1717 !important;
            background: #1B1717 !important;
        }

        body.roven-loading {
            position: static !important;
            overflow: visible !important;
            height: auto !important;
            max-height: none !important;
            min-height: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            min-height: 100lvh !important;
            min-height: -webkit-fill-available !important;
            background-color: #1B1717 !important;
            background: #1B1717 !important;
            touch-action: none !important;
            -webkit-overflow-scrolling: auto !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Completely hide the rest of the page under the preloader until dismiss starts */
        html.roven-loading body:not(.roven-revealing) > *:not(#roven-preloader),
        body.roven-loading:not(.roven-revealing) > *:not(#roven-preloader) {
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            user-select: none !important;
        }

        body.roven-revealing > *:not(#roven-preloader) {
            opacity: 1 !important;
            visibility: visible !important;
            transition: opacity 0.4s ease-in;
        }

        .text-gold {
            color: #dfb15b !important;
        }

        .store-topbar,
        .store-footer {
            width: 100% !important;
            max-width: 100% !important;
            overflow-x: clip;
        }

        .store-topbar {
            background: #1B1717;
            color: #EDEBDD;
            font-size: 0.78rem;
            padding: 6px 0;
            border-bottom: 1px solid rgba(237, 235, 221, 0.12);
            line-height: 1.35;
        }

        .topbar-icon-gold {
            color: #dfb15b;
            font-size: 0.8rem;
        }

        .topbar-announcement-text {
            color: #EDEBDD;
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        .topbar-divider {
            color: rgba(237, 235, 221, 0.3);
        }

        .topbar-track-pill {
            color: #EDEBDD !important;
            font-size: 0.74rem;
            font-weight: 600;
            padding: 3px 11px;
            border-radius: 50px;
            background: rgba(237, 235, 221, 0.08);
            border: 1px solid rgba(237, 235, 221, 0.22);
            text-decoration: none !important;
            display: inline-flex;
            align-items: center;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .topbar-track-pill:hover {
            background: #810100;
            border-color: #dfb15b;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        .topbar-track-pill i {
            color: #dfb15b;
        }

        @@media (max-width: 575.98px) {
            .store-topbar {
                padding: 4px 0 !important;
                font-size: 0.72rem !important;
            }
            .topbar-announcement-text {
                font-size: 0.72rem !important;
            }
            .topbar-track-pill {
                font-size: 0.68rem !important;
                padding: 2px 8px !important;
            }
        }

        .store-navbar {
            background: #EDEBDD;
            border-bottom: 2px solid #630000;
            box-shadow: 0 4px 18px rgba(27, 23, 23, 0.08);
            padding: 0.85rem 0;
            position: -webkit-sticky !important;
            position: sticky !important;
            top: 0 !important;
            z-index: 1030 !important;
            transition: box-shadow 0.25s ease, background-color 0.25s ease;
        }

        .store-navbar.navbar-scrolled {
            box-shadow: 0 6px 25px rgba(27, 23, 23, 0.16) !important;
            background-color: rgba(237, 235, 221, 0.98) !important;
            backdrop-filter: blur(10px) !important;
            -webkit-backdrop-filter: blur(10px) !important;
        }

        @@media (max-width: 991.98px) {
            .store-navbar {
                padding: 0.55rem 0 0.45rem 0;
            }
        }

        .store-brand {
            text-decoration: none !important;
            display: inline-flex;
            align-items: center;
            outline: none !important;
        }

        /* Pure, Static, Royalty Logo (Zero Hover Effect & Transparent Blend) */
        .roven-nav-logo {
            height: 44px;
            max-width: 185px;
            object-fit: contain;
            display: block;
            background: transparent !important;
            transform: none !important;
            filter: none !important;
            transition: none !important;
        }

        @@media (max-width: 576px) {
            .roven-nav-logo {
                height: 32px;
                max-width: 130px;
            }
        }

        /* Completely disable hover/focus transforms on brand logo as requested */
        .store-brand:hover,
        .store-brand:focus,
        .store-brand:active,
        .store-brand:hover .roven-nav-logo,
        .store-brand:focus .roven-nav-logo,
        .store-brand:active .roven-nav-logo {
            transform: none !important;
            filter: none !important;
            box-shadow: none !important;
            outline: none !important;
            opacity: 1 !important;
        }

        /* Unified Luxury Search Box (Seamless Floating Pill) */
        .store-search-box {
            display: flex;
            align-items: center;
            background-color: #ffffff;
            border: 1.5px solid rgba(99, 0, 0, 0.22);
            border-radius: 50px;
            padding: 3px 4px 3px 14px;
            box-shadow: 0 2px 8px rgba(27, 23, 23, 0.04);
            transition: border-color 0.2s, box-shadow 0.2s;
            height: 42px;
            width: 100%;
        }

        .store-search-box:focus-within {
            border-color: #630000;
            box-shadow: 0 3px 12px rgba(99, 0, 0, 0.16);
        }

        .search-leading-icon {
            color: #810100;
            font-size: 0.88rem;
            margin-right: 8px;
            flex-shrink: 0;
        }

        .store-search-input {
            border: none !important;
            background: transparent !important;
            padding: 0 6px !important;
            font-size: 0.88rem !important;
            color: #1B1717 !important;
            box-shadow: none !important;
            flex-grow: 1;
            outline: none !important;
        }

        .store-search-input::placeholder {
            color: #8a8275;
            font-size: 0.84rem;
        }

        .btn-search-submit {
            background: linear-gradient(135deg, #630000 0%, #810100 100%) !important;
            color: #EDEBDD !important;
            border: none !important;
            border-radius: 50px !important;
            font-size: 0.82rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.3px;
            padding: 0.38rem 1rem !important;
            height: 34px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: all 0.2s ease !important;
            flex-shrink: 0;
        }

        .btn-search-submit:hover {
            background: #810100 !important;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 2px 6px rgba(129, 1, 0, 0.3);
        }

        /* Mobile Utility Buttons (Hamburger & Track) */
        .btn-mobile-menu {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #FAF9F5;
            border: 1px solid rgba(99, 0, 0, 0.2);
            color: #630000;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: all 0.2s;
            flex-shrink: 0;
            padding: 0;
        }

        .btn-mobile-menu:hover,
        .btn-mobile-menu:focus {
            background-color: #630000;
            color: #EDEBDD;
            border-color: #630000;
        }

        .btn-mobile-track {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #FAF9F5;
            border: 1px solid rgba(99, 0, 0, 0.2);
            color: #630000;
            font-size: 0.88rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
