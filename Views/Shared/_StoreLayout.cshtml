    <!-- VIP Lead Modal Controller Script -->
    <script>
        (function() {
            const modal = document.getElementById('rovenLeadModal');
            if (!modal) return;

            function isLeadModalDismissed() {
                try {
                    if (localStorage.getItem('roven_lead_dismissed') === 'true') return true;
                } catch (e) {}
                try {
                    if (sessionStorage.getItem('roven_lead_dismissed') === 'true') return true;
                } catch (e) {}
                try {
                    if (document.cookie.indexOf('roven_lead_dismissed=true') !== -1) return true;
                } catch (e) {}
                return false;
            }

            function markLeadModalDismissed() {
                try {
                    localStorage.setItem('roven_lead_dismissed', 'true');
                } catch (e) {}
                try {
                    sessionStorage.setItem('roven_lead_dismissed', 'true');
                } catch (e) {}
                try {
                    document.cookie = "roven_lead_dismissed=true; path=/; max-age=31536000; SameSite=Lax";
                } catch (e) {}
            }

            function lockScroll() {
                document.documentElement.classList.add('roven-lead-open');
                document.body.classList.add('roven-lead-open');
            }

            function unlockScroll() {
                document.documentElement.classList.remove('roven-lead-open');
                document.body.classList.remove('roven-lead-open');
            }

            // Optional developer debug flag: ?forceLead=1 forces opening once without resetting storage
            let isForceTesting = false;
            try {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has('forceLead')) {
                    isForceTesting = true;
                }
            } catch (e) {}

            window.openRovenLeadModal = function() {
                if (!isForceTesting && isLeadModalDismissed()) {
                    return;
                }

                // Immediately mark as dismissed/seen on this device so refresh never triggers it again
                markLeadModalDismissed();

                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                lockScroll();

                // Only autofocus on desktop screens (> 768px) to avoid mobile keyboard viewport jump and zoom shifts
                if (window.innerWidth > 768) {
                    setTimeout(() => {
                        document.getElementById('rovenLeadPhone')?.focus();
                    }, 250);
                }
            };

            window.dismissRovenLeadModal = function() {
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
                unlockScroll();
                markLeadModalDismissed();
            };

            window.checkAndTriggerVipLeadModal = function() {
                if (!isForceTesting && isLeadModalDismissed()) {
                    return;
                }
                markLeadModalDismissed();
                setTimeout(openRovenLeadModal, 450);
            };

            // Prevent background dragging and rubber-banding when touching modal or backdrop
            modal.addEventListener('touchmove', function(e) {
                const dialog = modal.querySelector('.roven-lead-modal');
                if (!dialog || !dialog.contains(e.target) || dialog.scrollHeight <= dialog.clientHeight) {
                    e.preventDefault();
                }
            }, { passive: false });

            // Click outside dialog to dismiss
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    dismissRovenLeadModal();
                }
            });

            // Close on Escape key press
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && modal.classList.contains('active')) {
                    dismissRovenLeadModal();
                }
            });

            // Lead Submission Handler
            window.submitRovenLeadForm = async function(e) {
                e.preventDefault();
                const phoneInput = document.getElementById('rovenLeadPhone');
                const errorEl = document.getElementById('rovenLeadError');
                const submitBtn = document.getElementById('rovenLeadSubmitBtn');

                if (errorEl) {
                    errorEl.classList.add('d-none');
                    errorEl.textContent = '';
                }

                const phone = phoneInput ? phoneInput.value.trim() : '';

                if (!phone) {
                    if (errorEl) {
                        errorEl.textContent = 'يرجى إدخال رقم الواتساب.';
                        errorEl.classList.remove('d-none');
                    }
                    return;
                }

                const originalBtnHtml = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> جاري الإرسال...';

                try {
                    const formData = new FormData();
                    formData.append('phone', phone);

                    const csrfToken = document.querySelector('#storefrontCsrfForm input[name="__RequestVerificationToken"]')?.value 
                                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (csrfToken) {
                        formData.append('__RequestVerificationToken', csrfToken);
                    }

                    const res = await fetch('/Home/SubscribeLead', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await res.json();

                    if (data.success) {
                        markLeadModalDismissed();

                        document.getElementById('rovenLeadFormView').classList.add('d-none');
                        const successView = document.getElementById('rovenLeadSuccessView');
                        if (successView) {
                            successView.classList.remove('d-none');
                        }

                        const phoneEl = document.getElementById('rovenSuccessPhone');
                        if (phoneEl) {
                            phoneEl.textContent = data.phone || phone;
                        }
                    } else {
                        if (errorEl) {
                            errorEl.textContent = data.message || 'حدث خطأ أثناء التسجيل، يرجى المحاولة مرة أخرى.';
                            errorEl.classList.remove('d-none');
                        }
                    }
                } catch (err) {
                    console.error('Lead subscription error:', err);
                    if (errorEl) {
                        errorEl.textContent = 'تعذر الاتصال بالسيرفر، يرجى التحقق من اتصال الإنترنت.';
                        errorEl.classList.remove('d-none');
                    }
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
            };

            // Trigger on preloader dismiss event
            window.addEventListener('rovenPreloaderDismissed', function() {
                checkAndTriggerVipLeadModal();
            });

            // Failsafe trigger if preloader was hidden or completed
            setTimeout(function() {
                const preloader = document.getElementById('roven-preloader');
                if (!preloader || preloader.classList.contains('preloader-hidden') || preloader.style.display === 'none') {
                    checkAndTriggerVipLeadModal();
                }
            }, 2400);
        })();
    </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Smooth Sticky Navbar Enhancement
        window.addEventListener('scroll', function() {
            var nav = document.querySelector('.store-navbar');
            if (nav) {
                if (window.scrollY > 15) {
                    nav.classList.add('navbar-scrolled');
                } else {
                    nav.classList.remove('navbar-scrolled');
                }
            }
        }, { passive: true });

        // Global Product Card Direct Navigation (Flacon Click-to-Details)
        document.addEventListener('click', function (e) {
            const card = e.target.closest('.product-card[data-details-url]');
            if (card && !e.target.closest('button, a, input, select, textarea, label, .btn, .bag-btn')) {
                const url = card.getAttribute('data-details-url');
                if (url) {
                    window.location.href = url;
                }
            }
        });
    </script>
</body>
</html>

