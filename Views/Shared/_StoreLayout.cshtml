    <!-- Store Cart Live Counter & Async Helper Script -->
    <script>
        (function() {
            // Update live cart badge from server session
            async function refreshStoreCartBadge() {
                try {
                    const response = await fetch('/Cart/GetCartSummary');
                    if (response.ok) {
                        const data = await response.json();
                        const badge = document.getElementById('cart-item-count');
                        if (badge) {
                            badge.textContent = data.count || 0;
                        }
                    }
                } catch (e) {
                    console.warn('Unable to sync cart count:', e);
                }
            }

            // Expose global helper for adding to cart with immediate visual loading state
            window.addStoreItemToCart = async function(productId, qty = 1, triggerBtn = null) {
                // Automatically identify trigger button if not passed
                let btn = triggerBtn;
                if (!btn && window.event && window.event.target) {
                    btn = window.event.target.closest('button');
                }
                if (!btn) {
                    btn = document.getElementById('btn-add-to-cart');
                }

                let origHtml = '';
                if (btn) {
                    origHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span class="small">جاري الإضافة...</span>';
                }

                try {
                    const formData = new FormData();
                    formData.append('productId', productId);
                    formData.append('quantity', qty);

                    const csrfToken = document.querySelector('#storefrontCsrfForm input[name="__RequestVerificationToken"]')?.value 
                                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (csrfToken) {
                        formData.append('__RequestVerificationToken', csrfToken);
                    }

                    const reqHeaders = {};
                    if (csrfToken) {
                        reqHeaders['RequestVerificationToken'] = csrfToken;
                    }

                    const res = await fetch('/Cart/AddToCart', {
                        method: 'POST',
                        headers: reqHeaders,
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            const badge = document.getElementById('cart-item-count');
                            if (badge) badge.textContent = data.cartCount;
                            
                            // Visual success feedback on button
                            if (btn) {
                                btn.innerHTML = '<i class="fa-solid fa-check text-white me-1"></i><span class="small">تمت الإضافة!</span>';
                                setTimeout(() => {
                                    if (btn) {
                                        btn.innerHTML = origHtml;
                                        btn.disabled = false;
                                    }
                                }, 900);
                            }

                            Swal.fire({
                                icon: 'success',
                                iconColor: '#630000',
                                title: '<i class="fa-solid fa-cart-shopping me-2" style="color: #630000;"></i>Added to Bag!',
                                text: data.message,
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2500,
                                timerProgressBar: true
                            });
                        } else {
                            if (btn) {
                                btn.innerHTML = origHtml;
                                btn.disabled = false;
                            }
                            Swal.fire({
                                icon: 'warning',
                                iconColor: '#810100',
                                title: 'Stock Limit',
                                text: data.message,
                                confirmButtonColor: '#630000'
                            });
                        }
                    } else {
                        if (btn) {
                            btn.innerHTML = origHtml;
                            btn.disabled = false;
                        }
                    }
                } catch (err) {
                    console.error('Add to cart error:', err);
                    if (btn) {
                        btn.innerHTML = origHtml;
                        btn.disabled = false;
                    }
                }
            };

            window.addOfferToCart = async function(offerId, triggerBtn = null) {
                let btn = triggerBtn;
                if (!btn && window.event && window.event.target) {
                    btn = window.event.target.closest('button');
                }

                let origHtml = '';
                if (btn) {
                    origHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span class="small">جاري إضافة العرض...</span>';
                }

                try {
                    const formData = new FormData();
                    formData.append('offerId', offerId);

                    const csrfToken = document.querySelector('#storefrontCsrfForm input[name="__RequestVerificationToken"]')?.value 
                                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (csrfToken) {
                        formData.append('__RequestVerificationToken', csrfToken);
                    }

                    const reqHeaders = {};
                    if (csrfToken) {
                        reqHeaders['RequestVerificationToken'] = csrfToken;
                    }

                    const res = await fetch('/Cart/AddOfferToCart', {
                        method: 'POST',
                        headers: reqHeaders,
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            const badge = document.getElementById('cart-item-count');
                            if (badge) badge.textContent = data.cartCount;
                            
                            if (btn) {
                                btn.innerHTML = '<i class="fa-solid fa-check text-white me-1"></i><span class="small">تمت إضافة العرض!</span>';
                                setTimeout(() => {
                                    if (btn) {
                                        btn.innerHTML = origHtml;
                                        btn.disabled = false;
                                    }
                                }, 900);
                            }

                            Swal.fire({
                                icon: 'success',
                                iconColor: '#630000',
                                title: '<i class="fa-solid fa-gift me-2" style="color: #630000;"></i>تمت إضافة العرض!',
                                text: data.message,
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2800,
                                timerProgressBar: true
                            });
                        } else {
                            if (btn) {
                                btn.innerHTML = origHtml;
                                btn.disabled = false;
                            }
                            Swal.fire({
                                icon: 'warning',
                                iconColor: '#810100',
                                title: 'تنبيه العرض',
                                text: data.message,
                                confirmButtonColor: '#630000'
                            });
                        }
                    } else {
                        if (btn) {
                            btn.innerHTML = origHtml;
                            btn.disabled = false;
                        }
                    }
                } catch (err) {
                    console.error('Add offer to cart error:', err);
                    if (btn) {
                        btn.innerHTML = origHtml;
                        btn.disabled = false;
                    }
                }
            };

            // Run on initial load
            refreshStoreCartBadge();
        })();
    </script>

    <!-- Maison ROVEN Luxury Preloader Controller -->
    <script>
        (function() {
            const preloader = document.getElementById('roven-preloader');
            if (!preloader) return;

            const bar = document.getElementById('roven-preloader-bar');
            const percent = document.getElementById('roven-preloader-percent');
            const phrase = document.getElementById('roven-preloader-phrase');

            const phrases = [
                "L'Art du Parfum...",
                "Rare Damask Botanicals...",
                "Aged Assam Oud...",
                "Eternal Sillage...",
                "Welcome to Maison ROVEN"
            ];

            let currentProgress = 0;
            let isLoaded = false;
            let phraseIndex = 0;

            const timer = setInterval(() => {
                if (isLoaded) {
                    currentProgress += 10;
                } else if (currentProgress < 85) {
                    currentProgress += Math.random() * 5 + 2;
                }

                if (currentProgress > 100) currentProgress = 100;

                if (bar) bar.style.width = currentProgress + '%';
                if (percent) percent.textContent = Math.round(currentProgress) + '%';

                const targetPhraseIndex = Math.min(
                    Math.floor((currentProgress / 100) * phrases.length),
                    phrases.length - 1
                );

                if (targetPhraseIndex !== phraseIndex && phrase) {
                    phraseIndex = targetPhraseIndex;
                    phrase.style.opacity = '0';
                    setTimeout(() => {
                        phrase.textContent = phrases[phraseIndex];
                        phrase.style.opacity = '1';
                    }, 140);
                }

                if (currentProgress >= 100) {
                    clearInterval(timer);
                    setTimeout(dismissPreloader, 320);
                }
            }, 32);

            // Lock viewport to top on initial execution
            window.scrollTo(0, 0);

            // Dynamically fit preloader to full physical screen height on iOS Safari & mobile devices
            function fitPreloader() {
                if (preloader && !preloader.classList.contains('preloader-hidden')) {
                    const h = Math.max(window.innerHeight, document.documentElement.clientHeight, screen.height || 0, 800);
                    preloader.style.setProperty('height', (h + 470) + 'px', 'important');
                    preloader.style.setProperty('min-height', (h + 470) + 'px', 'important');
                    preloader.style.setProperty('top', '-120px', 'important');
                    preloader.style.setProperty('bottom', '-350px', 'important');
                    preloader.style.setProperty('left', '-20px', 'important');
                    preloader.style.setProperty('right', '-20px', 'important');
                    preloader.style.setProperty('width', 'calc(100vw + 40px)', 'important');
                }
            }
            fitPreloader();
            window.addEventListener('resize', fitPreloader);
            window.addEventListener('orientationchange', fitPreloader);

            // Prevent touch and wheel gestures from scrolling while preloader is visible
            function preventPreloaderScroll(e) {
                if (preloader && !preloader.classList.contains('preloader-hidden') && preloader.style.display !== 'none') {
                    e.preventDefault();
                }
            }
            window.addEventListener('touchmove', preventPreloaderScroll, { passive: false });
            window.addEventListener('wheel', preventPreloaderScroll, { passive: false });

            function dismissPreloader() {
                // Reveal page content underneath as the velvet preloader begins fading
                document.body.classList.add('roven-revealing');
                window.scrollTo(0, 0);

                // Revert theme-color back to signature wine
                var themeColorMeta = document.getElementById('rovenThemeColorMeta') || document.querySelector('meta[name="theme-color"]');
                if (themeColorMeta) {
                    themeColorMeta.setAttribute('content', '#630000');
                }

                preloader.classList.add('preloader-hidden');
                window.removeEventListener('touchmove', preventPreloaderScroll);
                window.removeEventListener('wheel', preventPreloaderScroll);
                window.removeEventListener('resize', fitPreloader);
                window.removeEventListener('orientationchange', fitPreloader);

                setTimeout(() => {
                    document.documentElement.classList.remove('roven-loading');
                    document.body.classList.remove('roven-loading');
                    document.body.classList.remove('roven-revealing');
                    preloader.style.display = 'none';
                    // Trigger VIP Welcome Lead Modal right after preloader dismisses
                    window.dispatchEvent(new CustomEvent('rovenPreloaderDismissed'));
                }, 750);
            }

            // Window load event
            if (document.readyState === 'complete') {
                isLoaded = true;
            } else {
                window.addEventListener('load', () => {
                    isLoaded = true;
                });
            }

            // Failsafe timeout to prevent any infinite stall
            setTimeout(() => {
                isLoaded = true;
                if (currentProgress < 90) currentProgress = 92;
            }, 2200);
        })();
    </script>

