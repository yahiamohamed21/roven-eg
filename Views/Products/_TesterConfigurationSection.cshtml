@model Stockify.ViewModels.Products.ITesterProductFormModel
@{
    var selectedSet = (Model.SelectedTesterProductIds ?? new List<int>()).ToHashSet();
    var choices = Model.AvailableTesterProducts ?? new List<Stockify.ViewModels.Products.TesterFragranceChoiceViewModel>();
    var reqCount = Model.TesterRequiredCount > 0 ? Model.TesterRequiredCount : 4;
}

<div class="col-12">
    <div class="card border rounded-4 shadow-xs overflow-hidden" style="border-color: @(Model.IsTester ? "#630000" : "#e6dfd1") !important; background: #fffdf9;">
        <div class="card-header py-2.5 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2" style="background: linear-gradient(90deg, #FAF6EE 0%, #F5ECDF 100%); border-bottom: 1px solid #e6dfd1;">
            <div class="form-check form-switch d-flex align-items-center gap-2 mb-0 ps-0">
                <input class="form-check-input ms-0" type="checkbox" role="switch" id="isTesterToggle" name="IsTester" value="true" @(Model.IsTester ? "checked" : "") style="width: 2.5em; height: 1.3em; cursor: pointer;" />
                <label class="form-check-label fw-bold text-dark mb-0" for="isTesterToggle" style="cursor: pointer; font-size: 0.94rem;">
                    <i class="fa-solid fa-vials me-1" style="color: #630000;"></i>
                    هذا المنتج تيستر / باقة عينات (Tester Product)
                </label>
            </div>
            <span class="badge rounded-pill px-2.5 py-1 fw-semibold" id="testerHeaderStatusBadge" style="background-color: @(Model.IsTester ? "#630000" : "#e9e2d3"); color: @(Model.IsTester ? "#EDEBDD" : "#5a5248"); font-size: 0.74rem;">
                @(Model.IsTester ? $"تيستر مُفعّل • يتطلب {reqCount} عطور" : "منتج عادي")
            </span>
        </div>

        <div id="testerConfigBody" class="card-body p-3 @(Model.IsTester ? "" : "d-none")">
            <div class="row g-3 align-items-center mb-3 pb-3 border-bottom" style="border-color: #f0e8da !important;">
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-bold text-dark mb-1" for="TesterRequiredCount">
                        عدد العطور المطلوب اختيارها من العميل <span class="text-danger">*</span>
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-list-check"></i></span>
                        <input type="number" class="form-control fw-bold font-monospace" id="TesterRequiredCount" name="TesterRequiredCount" value="@reqCount" min="1" max="20" />
                        <span class="input-group-text bg-light text-muted">عطور / منتجات</span>
                    </div>
                    <small class="text-muted d-block mt-1" style="font-size: 0.74rem;">الافتراضي: لازم العميل يختار <strong>4 منتجات</strong> قبل الإضافة للسلة.</small>
                </div>
                <div class="col-12 col-md-7">
                    <div class="p-2.5 px-3 rounded-3 d-flex align-items-center justify-content-between gap-2" style="background: #FAF6EE; border: 1px dashed #c8b48e;">
                        <div class="small text-dark">
                            <div class="fw-bold" style="color: #630000;"><i class="fa-solid fa-circle-info me-1"></i>اختيار العطور المتاحة في التيستر:</div>
                            <div class="text-muted" style="font-size: 0.76rem;">فقط العطور التي تحددها هنا ستظهر للعميل في صفحة المنتج للاختيار منها (بحد أدنى @reqCount عطور).</div>
                        </div>
                        <span class="badge bg-white text-dark border font-monospace fs-6 px-2.5 py-1.5 flex-shrink-0" id="testerSelectedCountBadge">
                            @selectedSet.Count عطر
                        </span>
                    </div>
                </div>
            </div>

            <!-- Toolbar: Filter + Quick Select All / Clear -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2.5">
                <div class="input-group input-group-sm" style="max-width: 320px;">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="testerFragranceSearch" class="form-control border-start-0" placeholder="ابحث باسم العطر أو SKU..." />
                </div>
                <div class="d-flex gap-2">
                    <button type="button" id="btnSelectAllTesters" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="font-size: 0.76rem;">
                        <i class="fa-solid fa-check-double me-1"></i>تحديد الكل
                    </button>
                    <button type="button" id="btnClearAllTesters" class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size: 0.76rem;">
                        <i class="fa-solid fa-xmark me-1"></i>إلغاء الكل
                    </button>
                </div>
            </div>

            <span class="text-danger small d-block mb-2">@Html.ValidationMessage("SelectedTesterProductIds")</span>

            <!-- Checkable Fragrances Grid -->
            @if (choices.Any())
            {
                <div class="row g-2" id="testerChoicesGrid" style="max-height: 290px; overflow-y: auto; padding: 2px;">
                    @foreach (var opt in choices)
                    {
                        var isChecked = selectedSet.Contains(opt.Id);
                        <div class="col-12 col-sm-6 col-md-4 tester-choice-col" data-search="@($"{opt.Name} {opt.Sku} {opt.CategoryName}".ToLowerInvariant())">
                            <label class="d-flex align-items-center gap-2 p-2 rounded-3 border bg-white h-100 tester-choice-card @(isChecked ? "selected" : "")"
                                   style="cursor: pointer; border-color: @(isChecked ? "#630000" : "#e8e1d5") !important; background-color: @(isChecked ? "#fcf8f2" : "#ffffff") !important;">
                                <input type="checkbox"
                                       class="form-check-input mt-0 flex-shrink-0 tester-option-checkbox"
                                       name="SelectedTesterProductIds"
                                       value="@opt.Id"
                                       @(isChecked ? "checked" : "") />
                                @if (!string.IsNullOrWhiteSpace(opt.ImageUrl))
                                {
                                    <img src="@opt.ImageUrl" alt="@opt.Name" class="rounded flex-shrink-0" style="width: 34px; height: 34px; object-fit: cover; border: 1px solid #eee;" onerror="this.style.display='none'" />
                                }
                                <div class="min-w-0 flex-grow-1">
                                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.82rem;">@opt.Name</div>
                                    <div class="text-muted text-truncate font-monospace" style="font-size: 0.68rem;">@opt.Sku • @opt.CategoryName</div>
                                </div>
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border text-muted small mb-0">
                    لا توجد منتجات أخرى متاحة حالياً لإضافتها كخيارات تيستر.
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        function initTesterSection() {
            const toggle = document.getElementById('isTesterToggle');
            const body = document.getElementById('testerConfigBody');
            const statusBadge = document.getElementById('testerHeaderStatusBadge');
            const countBadge = document.getElementById('testerSelectedCountBadge');
            const reqInput = document.getElementById('TesterRequiredCount');
            const searchInput = document.getElementById('testerFragranceSearch');
            const selectAllBtn = document.getElementById('btnSelectAllTesters');
            const clearAllBtn = document.getElementById('btnClearAllTesters');
            const grid = document.getElementById('testerChoicesGrid');

            if (!toggle || toggle.dataset.bound === 'true') return;
            toggle.dataset.bound = 'true';

            function refreshState() {
                const isTester = toggle.checked;
                const reqVal = Math.max(1, parseInt(reqInput?.value || '4') || 4);
                if (body) body.classList.toggle('d-none', !isTester);
                if (statusBadge) {
                    statusBadge.textContent = isTester ? `تيستر مُفعّل • يتطلب ${reqVal} عطور` : 'منتج عادي';
                    statusBadge.style.backgroundColor = isTester ? '#630000' : '#e9e2d3';
                    statusBadge.style.color = isTester ? '#EDEBDD' : '#5a5248';
                }
                const checkedCount = document.querySelectorAll('.tester-option-checkbox:checked').length;
                if (countBadge) {
                    countBadge.textContent = `${checkedCount} عطر`;
                    countBadge.classList.toggle('text-danger', isTester && checkedCount < reqVal);
                    countBadge.classList.toggle('text-success', isTester && checkedCount >= reqVal);
                }
                document.querySelectorAll('.tester-choice-card').forEach(card => {
                    const cb = card.querySelector('.tester-option-checkbox');
                    const on = cb && cb.checked;
                    card.style.borderColor = on ? '#630000' : '#e8e1d5';
                    card.style.backgroundColor = on ? '#fcf8f2' : '#ffffff';
                });
            }

            toggle.addEventListener('change', refreshState);
            if (reqInput) reqInput.addEventListener('input', refreshState);
            if (grid) {
                grid.addEventListener('change', function (e) {
                    if (e.target.matches('.tester-option-checkbox')) refreshState();
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = (this.value || '').trim().toLowerCase();
                    document.querySelectorAll('.tester-choice-col').forEach(col => {
                        const txt = col.dataset.search || '';
                        col.classList.toggle('d-none', q.length > 0 && !txt.includes(q));
                    });
                });
            }

            if (selectAllBtn) {
                selectAllBtn.addEventListener('click', function () {
                    document.querySelectorAll('.tester-choice-col:not(.d-none) .tester-option-checkbox').forEach(cb => {
                        cb.checked = true;
                    });
                    refreshState();
                });
            }

            if (clearAllBtn) {
                clearAllBtn.addEventListener('click', function () {
                    document.querySelectorAll('.tester-option-checkbox').forEach(cb => {
                        cb.checked = false;
                    });
                    refreshState();
                });
            }

            refreshState();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTesterSection);
        } else {
            initTesterSection();
        }
    })();
</script>
