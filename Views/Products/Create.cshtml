@model Stockify.ViewModels.Products.ProductCreateViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam-fill text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Create New Product</h5>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Products
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Dell Latitude 5540 Laptop" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Sku" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Sku" class="form-control text-uppercase" placeholder="e.g. DELL-LAT-5540" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CategoryId" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select">
                                <option value="" selected disabled>Choose category...</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                <span class="input-group-text bg-light text-muted">EGP</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="StockQuantity" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="StockQuantity" type="number" class="form-control" min="0" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ReorderLevel" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ReorderLevel" type="number" class="form-control" min="1" />
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detailed technical specifications, warranty, or product highlights..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ImageFile" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Accepts PNG, JPG or WEBP formats up to 3MB.</small>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Save Product
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
