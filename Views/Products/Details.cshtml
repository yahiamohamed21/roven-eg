@model Stockify.Models.Entities.Product
@{
    ViewData["Title"] = $"Product: {Model.Name}";
    var totalValuation = Model.Price * Model.StockQuantity;
    var isLowStock = Model.StockQuantity <= Model.ReorderLevel;
    var isOutOfStock = Model.StockQuantity <= 0;
    var transactions = Model.InventoryTransactions ?? new List<Stockify.Models.Entities.InventoryTransaction>();
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-box-seam text-primary me-2"></i>@Model.Name
        </h3>
        <p class="text-muted mb-0 small">
            SKU: <code>@Model.Sku</code> &bull; 
            Category: <span class="badge bg-light text-dark border">@(Model.Category != null ? Model.Category.Name : "General")</span>
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary ms-1">Archived</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
        @if (User.IsInRole(Stockify.Common.Constants.Roles.Admin))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-pencil"></i>
                <span>Edit Product</span>
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded border mx-auto mb-3 object-fit-cover shadow-sm" style="width: 160px; height: 160px;" />
            }
            else
            {
                <div class="rounded bg-light border d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 160px; height: 160px;">
                    <i class="bi bi-box-seam text-secondary" style="font-size: 4rem;"></i>
                </div>
            }

            <h4 class="fw-bold text-primary mb-1">@Model.Price.ToString("N2") EGP</h4>
            @if (isOutOfStock)
            {
                <span class="badge bg-danger text-white px-3 py-1 mt-2">Out of Stock</span>
            }
            else if (isLowStock)
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 mt-2">Low Stock Warning</span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mt-2">In Stock</span>
            }

            <hr class="my-4" />
            <div class="text-start small text-muted">
                <div class="d-flex justify-content-between py-1">
                    <span>Current Inventory:</span>
                    <span class="text-dark fw-bold">@Model.StockQuantity units</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Reorder Threshold:</span>
                    <span class="text-dark fw-semibold">@Model.ReorderLevel units</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Total Valuation:</span>
                    <span class="text-success fw-bold">@totalValuation.ToString("N2") EGP</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Added Date:</span>
                    <span class="text-dark">@Model.CreatedAt.ToEgyptTimeString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-7 col-lg-8">
        <!-- Description Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <span class="fw-bold">Product Description & Specs</span>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description provided for this product." : Model.Description)
                </p>
            </div>
        </div>

        <!-- Inventory Transactions History Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <span class="fw-bold">Recent Stock Audit Transactions</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (transactions.Any())
                        {
                            foreach (var t in transactions)
                            {
                                <tr>
                                    <td class="text-muted small">@t.TransactionDate.ToEgyptTimeString("MMM dd, yyyy - hh:mm tt")</td>
                                    <td>
                                        @if (t.TransactionType == Stockify.Models.Enums.TransactionType.StockIn)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Stock In</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Stock Out</span>
                                        }
                                    </td>
                                    <td class="fw-bold @(t.TransactionType == Stockify.Models.Enums.TransactionType.StockIn ? "text-success" : "text-danger")">
                                        @(t.TransactionType == Stockify.Models.Enums.TransactionType.StockIn ? "+" : "-")@t.Quantity
                                    </td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(t.Notes) ? "-" : t.Notes)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-clock-history fs-3 d-block mb-1 text-secondary"></i>
                                    No recorded stock movements for this item yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
