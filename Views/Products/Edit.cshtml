@model Stockify.ViewModels.Products.ProductEditViewModel
@{
    ViewData["Title"] = $"Edit Product: {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Edit Product: @Model.Name</h5>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Products
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingImageUrl" />
                    <input type="hidden" asp-for="StockQuantity" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Sku" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Sku" class="form-control text-uppercase" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CategoryId" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text bg-light text-muted">EGP</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="StockQuantity" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                                <span class="input-group-text bg-light text-muted">units</span>
                            </div>
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            <small class="text-muted">الكمية الفعلية المتوفرة بالمخزن لهذا المنتج.</small>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ReorderLevel" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ReorderLevel" type="number" class="form-control" min="1" />
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="FragranceTagline" class="form-label small fw-semibold text-secondary">تركيز العطر / الجملة التعريفية (Fragrance Tagline / Concentration)</label>
                            <input asp-for="FragranceTagline" class="form-control" placeholder="Extrait de Parfum • 30% Pure Oil" />
                            <span asp-validation-for="FragranceTagline" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">الجملة التي تظهر أسفل اسم العطر في المتجر والكتالوج (مثل: Extrait de Parfum • 30% Pure Oil)</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="IsFeatured" />
                        <input type="hidden" asp-for="IsBestSeller" />

                        <div class="col-12">
                            <label asp-for="ImageFile" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="ImageFile" id="productImageInput" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <button type="button" class="btn btn-outline-danger d-none" id="btnClearSelectedFile" title="إلغاء الملف المختار">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Accepts PNG, JPG or WEBP formats up to 5MB.</small>

                            <!-- Hidden field to communicate image deletion to backend -->
                            <input type="hidden" asp-for="RemoveImage" id="removeImageInput" value="false" />

                            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                            {
                                <!-- Existing Product Image Card with Delete Button -->
                                <div id="existingImageWrapper" class="card border rounded-3 p-2.5 mt-2.5 bg-light shadow-xs" style="max-width: 480px;">
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="d-flex align-items-center gap-2.5 min-w-0">
                                            <img id="existingImagePreview" src="@Model.ExistingImageUrl" alt="Product Image" class="rounded-3 border shadow-xs flex-shrink-0" style="width: 52px; height: 52px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/roven-logo.png';" />
                                            <div class="min-w-0">
                                                <div class="small fw-bold text-dark text-truncate">Current Product Image</div>
                                                <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">الصورة المعتمدة للمنتج حالياً</small>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5 shadow-xs flex-shrink-0" id="btnDeleteExistingImage" title="حذف صورة المنتج">
                                            <i class="fa-solid fa-trash-can"></i>
                                            <span>حذف الصورة</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Deletion notice banner with Undo button -->
                                <div id="imageRemovedNotice" class="alert alert-warning py-2 px-3 small rounded-3 mt-2 d-none align-items-center justify-content-between shadow-xs" style="max-width: 480px; border-color: #ffeeba;">
                                    <div class="d-flex align-items-center gap-2 text-dark">
                                        <i class="fa-solid fa-triangle-exclamation text-danger fs-6"></i>
                                        <span>سيتم حذف الصورة نهائياً عند الضغط على <strong>Update Product</strong>.</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-dark p-0 fw-bold text-decoration-underline ms-2" id="btnUndoDeleteImage">
                                        تراجع
                                    </button>
                                </div>
                            }

                            <!-- Live preview card for newly chosen file -->
                            <div id="newFilePreviewWrapper" class="card border rounded-3 p-2.5 mt-2.5 bg-white shadow-xs d-none" style="max-width: 480px; border-color: #b58d4a !important;">
                                <div class="d-flex align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-2.5 min-w-0">
                                        <img id="newFilePreviewImg" src="" alt="New Image Preview" class="rounded-3 border shadow-xs flex-shrink-0" style="width: 52px; height: 52px; object-fit: cover;" />
                                        <div class="min-w-0">
                                            <div class="small fw-bold text-success text-truncate" id="newFilePreviewName">New Image Selected</div>
                                            <small class="text-muted text-truncate d-block" id="newFilePreviewSize" style="font-size: 0.75rem;">معاينة الصورة الجديدة قبل الحفظ</small>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5 shadow-xs flex-shrink-0" id="btnCancelNewFile" title="إلغاء الملف المختار">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>إلغاء</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Update Product
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('productImageInput');
            const clearBtn = document.getElementById('btnClearSelectedFile');
            const newPreviewWrapper = document.getElementById('newFilePreviewWrapper');
            const newPreviewImg = document.getElementById('newFilePreviewImg');
            const newPreviewName = document.getElementById('newFilePreviewName');
            const newPreviewSize = document.getElementById('newFilePreviewSize');
            const cancelNewFileBtn = document.getElementById('btnCancelNewFile');

            const removeImageInput = document.getElementById('removeImageInput');
            const existingImageWrapper = document.getElementById('existingImageWrapper');
            const imageRemovedNotice = document.getElementById('imageRemovedNotice');
            const deleteExistingBtn = document.getElementById('btnDeleteExistingImage');
            const undoDeleteBtn = document.getElementById('btnUndoDeleteImage');

            // Handle New File Selection
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const file = this.files && this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            if (newPreviewImg) newPreviewImg.src = e.target.result;
                            if (newPreviewName) newPreviewName.textContent = file.name;
                            if (newPreviewSize) newPreviewSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
                            if (newPreviewWrapper) newPreviewWrapper.classList.remove('d-none');
                            if (clearBtn) clearBtn.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);

                        // If existing image was marked for deletion, cancel notice because user selected replacement
                        if (removeImageInput) removeImageInput.value = 'false';
                        if (imageRemovedNotice) {
                            imageRemovedNotice.classList.add('d-none');
                            imageRemovedNotice.classList.remove('d-flex');
                        }
                        if (existingImageWrapper) existingImageWrapper.classList.add('d-none');
                    } else {
                        resetNewFile();
                    }
                });
            }

            function resetNewFile() {
                if (fileInput) fileInput.value = '';
                if (newPreviewWrapper) newPreviewWrapper.classList.add('d-none');
                if (clearBtn) clearBtn.classList.add('d-none');
                if (newPreviewImg) newPreviewImg.src = '';

                // Restore existing image if it wasn't deleted
                if (removeImageInput && removeImageInput.value === 'false' && existingImageWrapper) {
                    existingImageWrapper.classList.remove('d-none');
                }
            }

            if (clearBtn) clearBtn.addEventListener('click', resetNewFile);
            if (cancelNewFileBtn) cancelNewFileBtn.addEventListener('click', resetNewFile);

            // Handle Existing Image Deletion
            if (deleteExistingBtn) {
                deleteExistingBtn.addEventListener('click', function () {
                    if (removeImageInput) removeImageInput.value = 'true';
                    if (existingImageWrapper) existingImageWrapper.classList.add('d-none');
                    if (imageRemovedNotice) {
                        imageRemovedNotice.classList.remove('d-none');
                        imageRemovedNotice.classList.add('d-flex');
                    }
                    resetNewFile();
                });
            }

            // Handle Undo Deletion
            if (undoDeleteBtn) {
                undoDeleteBtn.addEventListener('click', function () {
                    if (removeImageInput) removeImageInput.value = 'false';
                    if (imageRemovedNotice) {
                        imageRemovedNotice.classList.add('d-none');
                        imageRemovedNotice.classList.remove('d-flex');
                    }
                    if (existingImageWrapper) existingImageWrapper.classList.remove('d-none');
                });
            }
        });
    </script>
}
