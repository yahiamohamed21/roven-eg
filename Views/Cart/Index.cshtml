@model Stockify.ViewModels.Store.CartViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-4">
    <!-- Luxury Maison ROVEN Breadcrumb -->
    <nav aria-label="breadcrumb">
        <div class="roven-breadcrumb-nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            <a asp-controller="Store" asp-action="Index">Catalog</a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            <span class="breadcrumb-current">Shopping Cart</span>
        </div>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1B1717;"><i class="fa-solid fa-bag-shopping me-2" style="color: #630000;"></i>Your Fragrance Bag</h3>
            <p class="small mb-0" style="color: #6c6358;">Review your chosen flacons, adjust allocations, and proceed to bespoke checkout.</p>
        </div>
        @if (Model.Items.Any())
        {
            <form asp-action="ClearCart" method="post" id="form-clear-cart">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmClearCart()">
                    <i class="fa-solid fa-trash-can me-1"></i>Empty Bag
                </button>
            </form>
        }
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-4" id="cart-content-row">
            <!-- Left: Items (Responsive: Cards on Mobile, Table on Desktop) -->
            <div class="col-12 col-lg-8">
                <!-- Mobile View: Clean Stacked Cards (< 768px) -->
                <div class="d-flex flex-column gap-3 mb-4 d-md-none" id="cart-mobile-list">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card border rounded-4 p-3 shadow-xs bg-white" id="cart-mobile-item-@item.ProductId" style="border-color: #e8e3d5 !important;">
                            <div class="d-flex gap-3 align-items-start mb-2">
                                <div class="rounded-3 bg-light p-1.5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 64px; height: 64px;">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-height: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-spray-can-sparkles text-secondary fs-4"></i>
                                    }
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start gap-1">
                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none small text-truncate d-block" style="max-width: 180px;">
                                            @item.ProductName
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1 flex-shrink-0" onclick="removeCartItem(@item.ProductId, '@item.ProductName')" title="Remove">
                                            <i class="fa-solid fa-trash-can text-danger"></i>
                                        </button>
                                    </div>
                                    <div class="font-monospace text-muted" style="font-size: 0.72rem;">SKU: @item.Sku</div>
                                    <div class="fw-semibold text-dark small mt-0.5">@item.UnitPrice.ToString("N2") <span class="text-muted" style="font-size: 0.72rem;">EGP</span></div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: #f0ece1 !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group input-group-sm" style="width: 110px;">
                                        <button class="btn btn-outline-secondary px-2" type="button" onclick="changeQuantity(@item.ProductId, -1)">-</button>
                                        <input type="number" class="form-control text-center fw-bold item-qty-input px-1" id="qty-input-mobile-@item.ProductId" value="@item.Quantity" min="1" max="@item.StockAvailable" onchange="submitQuantityUpdate(@item.ProductId, this.value)" />
                                        <button class="btn btn-outline-secondary px-2" type="button" onclick="changeQuantity(@item.ProductId, 1)">+</button>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="small text-muted d-block" style="font-size: 0.7rem;">الإجمالي</span>
                                    <span class="fw-bold fs-6 font-monospace" style="color: #630000;" id="line-total-mobile-@item.ProductId">@item.LineTotal.ToString("N2") EGP</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desktop / Tablet View: Full Table (>= 768px) -->
                <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none d-md-block">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" id="cart-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 250px;">Product</th>
                                    <th>Price</th>
                                    <th style="width: 140px;">Quantity</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center" style="width: 60px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-row-@item.ProductId">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-3 bg-light p-2 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; flex-shrink: 0;">
                                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-box-seam text-secondary fs-4"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="font-monospace small text-muted">SKU: @item.Sku</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            @item.UnitPrice.ToString("N2") <span class="small text-muted">EGP</span>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(@item.ProductId, -1)">-</button>
                                                <input type="number" class="form-control text-center fw-bold item-qty-input" id="qty-input-@item.ProductId" value="@item.Quantity" min="1" max="@item.StockAvailable" onchange="submitQuantityUpdate(@item.ProductId, this.value)" />
                                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(@item.ProductId, 1)">+</button>
                                            </div>
                                            <div class="small text-muted mt-1" style="font-size: 0.72rem;">
                                                Stock: @item.StockAvailable avail.
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-primary" id="line-total-@item.ProductId">
                                            @item.LineTotal.ToString("N2") EGP
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeCartItem(@item.ProductId, '@item.ProductName')" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Store" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Right: Order Summary Card -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Items Subtotal:</span>
                        <span class="fw-bold text-dark" id="summary-subtotal">@Model.Subtotal.ToString("N2") EGP</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Shipping / Delivery:</span>
                        <span class="fw-bold text-success">FREE Nationwide</span>
                    </div>

                    <!-- Luxury Coupon Application Box -->
                    <div class="mb-3 p-3 rounded-3" style="background-color: #FAF9F5; border: 1.5px dashed rgba(99, 0, 0, 0.25);">
                        <label class="form-label small fw-bold text-dark mb-1 d-flex align-items-center justify-content-between">
                            <span><i class="fa-solid fa-ticket me-1" style="color: #810100;"></i>Have a Privilege Code?</span>
                            <span id="cart-coupon-badge" class="badge @(string.IsNullOrEmpty(Model.AppliedCouponCode) ? "d-none" : "")" style="background: #630000; color: #EDEBDD;">Applied</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="cart-coupon-input" class="form-control text-uppercase font-monospace fw-bold" placeholder="e.g. ROVEN10" value="@Model.AppliedCouponCode" @(!string.IsNullOrEmpty(Model.AppliedCouponCode) ? "disabled" : "") />
                            <button class="btn btn-roven-wine @(!string.IsNullOrEmpty(Model.AppliedCouponCode) ? "d-none" : "")" type="button" id="btn-apply-cart-coupon">Apply</button>
                            <button class="btn btn-outline-danger @(string.IsNullOrEmpty(Model.AppliedCouponCode) ? "d-none" : "")" type="button" id="btn-remove-cart-coupon" title="Remove Code">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                        <div id="cart-coupon-msg" class="small mt-1 fw-semibold @(string.IsNullOrEmpty(Model.AppliedCouponCode) ? "d-none" : "text-success")">
                            @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                            {
                                <span>Privilege code '@Model.AppliedCouponCode' applied (-@Model.DiscountAmount.ToString("N2") EGP)</span>
                            }
                        </div>
                    </div>

                    <!-- Discount Row -->
                    <div class="d-flex justify-content-between mb-2 small text-danger @(Model.DiscountAmount > 0 ? "" : "d-none")" id="cart-discount-row">
                        <span>Privilege Discount:</span>
                        <span class="fw-bold" id="cart-discount-amount">- @Model.DiscountAmount.ToString("N2") EGP</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5" style="color: #1B1717;">Total Investment:</span>
                        <span class="fw-bold fs-4" style="color: #630000;" id="summary-grand-total">@Model.GrandTotal.ToString("N2") EGP</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn w-100 py-3 fw-bold rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm mb-3" style="background-color: #630000; color: #EDEBDD; border: 1px solid #810100;">
                        <i class="fa-solid fa-lock"></i>
                        <span>Proceed to Secure Delivery</span>
                    </a>

                    <div class="rounded-3 p-3 small border" style="background-color: #EDEBDD; color: #1B1717; border-color: rgba(99, 0, 0, 0.2) !important;">
                        <div class="d-flex align-items-center gap-2 fw-semibold mb-1" style="color: #630000;">
                            <i class="fa-solid fa-money-bill-wave fs-5" style="color: #810100;"></i>
                            Cash on Delivery & Parcel Inspection
                        </div>
                        <div>No credit card required. Inspect flacon packaging with courier upon delivery.</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; background-color: #EDEBDD; color: #630000;">
                <i class="fa-solid fa-bag-shopping display-4"></i>
            </div>
            <h4 class="fw-bold mb-2" style="color: #1B1717;">Your Fragrance Bag is Empty</h4>
            <p class="mb-4" style="color: #6c6358;">Explore our Extraits, Royal Oud, and discovery sets to begin your olfactory journey.</p>
            <div>
                <a asp-controller="Store" asp-action="Index" class="btn px-4 py-2 fw-semibold rounded-pill shadow-sm" style="background-color: #630000; color: #EDEBDD; border: 1px solid #810100;">
                    <i class="fa-solid fa-spray-can-sparkles me-2"></i>Explore ROVEN Parfums
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function formatEgp(val) {
        return (val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' EGP';
    }

    function getCsrfToken() {
        return document.querySelector('#storefrontCsrfForm input[name="__RequestVerificationToken"]')?.value 
            || document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    async function submitQuantityUpdate(productId, qty) {
        const parsed = parseInt(qty) || 1;
        try {
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('quantity', parsed);

            const csrfToken = getCsrfToken();
            if (csrfToken) {
                formData.append('__RequestVerificationToken', csrfToken);
            }

            const res = await fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {},
                body: formData
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    if (data.removed) {
                        const row = document.getElementById(`cart-row-${productId}`);
                        if (row) row.remove();
                        const mobileCard = document.getElementById(`cart-mobile-item-${productId}`);
                        if (mobileCard) mobileCard.remove();
                    } else {
                        const lineCell = document.getElementById(`line-total-${productId}`);
                        if (lineCell) lineCell.textContent = formatEgp(data.itemTotal);
                        const mobileLineCell = document.getElementById(`line-total-mobile-${productId}`);
                        if (mobileLineCell) mobileLineCell.textContent = formatEgp(data.itemTotal);
                    }

                    // Update summary
                    document.getElementById('summary-subtotal').textContent = formatEgp(data.subtotal);
                    const taxEl = document.getElementById('summary-tax');
                    if (taxEl) taxEl.textContent = formatEgp(data.tax);
                    document.getElementById('summary-grand-total').textContent = formatEgp(data.grandTotal);

                    // Update badge
                    const badge = document.getElementById('cart-item-count');
                    if (badge) badge.textContent = data.totalCount;

                    if (data.totalCount === 0) {
                        window.location.reload();
                    }
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Stock Limit Reached',
                        text: data.message
                    });
                    if (data.stockAvailable) {
                        document.getElementById(`qty-input-${productId}`).value = data.stockAvailable;
                    }
                }
            }
        } catch (e) {
            console.error('Update quantity failed', e);
        }
    }

    function changeQuantity(productId, delta) {
        const desktopInput = document.getElementById(`qty-input-${productId}`);
        const mobileInput = document.getElementById(`qty-input-mobile-${productId}`);
        const activeInput = desktopInput || mobileInput;
        let current = parseInt(activeInput ? activeInput.value : '1') || 1;
        current += delta;
        if (current < 1) current = 1;
        if (desktopInput) desktopInput.value = current;
        if (mobileInput) mobileInput.value = current;
        submitQuantityUpdate(productId, current);
    }

    function removeCartItem(productId, name) {
        Swal.fire({
            title: 'Remove item?',
            text: `Remove "${name}" from your shopping cart?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Remove',
            confirmButtonColor: '#dc3545',
            cancelButtonText: 'Cancel'
        }).then(async (result) => {
            if (result.isConfirmed) {
                const formData = new FormData();
                formData.append('productId', productId);

                const csrfToken = getCsrfToken();
                if (csrfToken) {
                    formData.append('__RequestVerificationToken', csrfToken);
                }

                const res = await fetch('/Cart/RemoveFromCart', {
                    method: 'POST',
                    headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {},
                    body: formData
                });

                if (res.ok) {
                    const data = await res.json();
                    const row = document.getElementById(`cart-row-${productId}`);
                    if (row) row.remove();
                    const mobileCard = document.getElementById(`cart-mobile-item-${productId}`);
                    if (mobileCard) mobileCard.remove();

                    document.getElementById('summary-subtotal').textContent = formatEgp(data.subtotal);
                    const taxEl2 = document.getElementById('summary-tax');
                    if (taxEl2) taxEl2.textContent = formatEgp(data.tax);
                    document.getElementById('summary-grand-total').textContent = formatEgp(data.grandTotal);

                    const badge = document.getElementById('cart-item-count');
                    if (badge) badge.textContent = data.totalCount;

                    if (data.totalCount === 0) {
                        window.location.reload();
                    }

                    Swal.fire({
                        icon: 'info',
                        title: 'Item removed',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000
                    });
                }
            }
        });
    }

//   كاف 
//   كفكف دموعك ي عنتره فعيون عبله اصبحت مستعمره 

    // Cart Coupon Logic
    const btnApplyCartCoupon = document.getElementById('btn-apply-cart-coupon');
    const btnRemoveCartCoupon = document.getElementById('btn-remove-cart-coupon');
    const cartCouponInput = document.getElementById('cart-coupon-input');
    const cartCouponMsg = document.getElementById('cart-coupon-msg');
    const cartCouponBadge = document.getElementById('cart-coupon-badge');
    const cartDiscountRow = document.getElementById('cart-discount-row');
    const cartDiscountAmount = document.getElementById('cart-discount-amount');

    if (btnApplyCartCoupon) {
        btnApplyCartCoupon.addEventListener('click', async function () {
            const code = (cartCouponInput.value || '').trim();
            if (!code) {
                cartCouponMsg.className = 'small mt-1 text-danger fw-semibold';
                cartCouponMsg.textContent = 'Please enter a privilege code.';
                cartCouponMsg.classList.remove('d-none');
                return;
            }

            btnApplyCartCoupon.disabled = true;
            btnApplyCartCoupon.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            const formData = new FormData();
            formData.append('couponCode', code);

            const csrfToken = getCsrfToken();
            if (csrfToken) {
                formData.append('__RequestVerificationToken', csrfToken);
            }

            try {
                const res = await fetch('/Cart/ApplyCoupon', {
                    method: 'POST',
                    headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {},
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    cartCouponInput.value = data.code;
                    cartCouponInput.disabled = true;
                    btnApplyCartCoupon.classList.add('d-none');
                    btnRemoveCartCoupon.classList.remove('d-none');
                    cartCouponBadge.classList.remove('d-none');

                    cartCouponMsg.className = 'small mt-1 text-success fw-semibold';
                    cartCouponMsg.textContent = data.message;
                    cartCouponMsg.classList.remove('d-none');

                    cartDiscountRow.classList.remove('d-none');
                    cartDiscountAmount.textContent = '- ' + formatEgp(data.discountAmount);
                    document.getElementById('summary-grand-total').textContent = formatEgp(data.grandTotal);

                    Swal.fire({
                        icon: 'success',
                        title: 'Privilege Applied',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                } else {
                    cartCouponMsg.className = 'small mt-1 text-danger fw-semibold';
                    cartCouponMsg.textContent = data.message;
                    cartCouponMsg.classList.remove('d-none');
                }
            } catch (e) {
                cartCouponMsg.className = 'small mt-1 text-danger fw-semibold';
                cartCouponMsg.textContent = 'Unable to validate privilege code.';
                cartCouponMsg.classList.remove('d-none');
            } finally {
                btnApplyCartCoupon.disabled = false;
                btnApplyCartCoupon.textContent = 'Apply';
            }
        });
     }


 //  قاف  قل للطبيب الذي جاء يسعفنا الجرح ليس بالبدن  
// رواه دكتو زوز 
    if (btnRemoveCartCoupon) {
        btnRemoveCartCoupon.addEventListener('click', async function () {
            try {
                const csrfToken = getCsrfToken();
                const res = await fetch('/Cart/RemoveCoupon', {
                    method: 'POST',
                    headers: csrfToken ? { 'RequestVerificationToken': csrfToken } : {}
                });
                const data = await res.json();
                if (data.success) {
                    cartCouponInput.value = '';
                    cartCouponInput.disabled = false;
                    btnApplyCartCoupon.classList.remove('d-none');
                    btnRemoveCartCoupon.classList.add('d-none');
                    cartCouponBadge.classList.add('d-none');
                    cartCouponMsg.classList.add('d-none');
                    cartDiscountRow.classList.add('d-none');
                    document.getElementById('summary-grand-total').textContent = formatEgp(data.grandTotal);

                    Swal.fire({
                        icon: 'info',
                        title: 'Privilege Removed',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            } catch (e) {
                console.error(e);
            }
        });
    }

    function confirmClearCart() {
        Swal.fire({
            title: 'Clear Shopping Cart?',
            text: 'All items will be removed from your cart.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Clear Cart',
            confirmButtonColor: '#dc3545',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('form-clear-cart').submit();
            }
        });
    }
</script>
}

