@model Stockify.ViewModels.Store.StoreHomeViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "ROVEN — Haute Parfumerie";
    ViewData["MetaDescription"] = "Welcome to the official Maison ROVEN. Handcrafted luxury perfumes, Extraits de Parfum (30% pure oil concentration), royal ambergris, and eternal sillage. Free delivery with Cash on Delivery inspection across Egypt. دار روڤين للعطور الفاخرة.";
}

<!-- Custom Styles for ROVEN Luxury Perfumery -->
<style>
    /* -------------------------------------------------------------
       ROVEN 4-Color Luxury Perfume Palette:
       1. #630000 (Deep Burgundy / Wine)
       2. #810100 (Rich Crimson / Ruby Carmine)
       3. #1B1717 (Deep Charcoal Jet / Off-Black)
       4. #EDEBDD (Warm Linen / Cream / Ivory)
       ------------------------------------------------------------- */

    /* Global Mobile Scroll & Overflow Protection */
    section {
        overflow-x: clip;
        max-width: 100%;
        width: 100%;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.5em;
        line-height: 1.25;
    }

    #heroHomeCarousel,
    .carousel,
    .carousel-inner {
        overflow: hidden !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Hero Carousel Luxury Styling */
    .hero-carousel-item {
        min-height: 580px;
        display: flex;
        align-items: center;
        background-size: cover;
        background-position: center;
        position: relative;
        overflow: hidden !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .hero-slide-1 {
        background: radial-gradient(circle at 75% 35%, rgba(129, 1, 0, 0.55) 0%, rgba(27, 23, 23, 0.98) 65%),
                    linear-gradient(135deg, #150f0f 0%, #2b0404 45%, #630000 100%);
    }

    .hero-slide-2 {
        background: radial-gradient(circle at 75% 35%, rgba(184, 115, 51, 0.38) 0%, rgba(99, 0, 0, 0.6) 45%, rgba(27, 23, 23, 0.98) 75%),
                    linear-gradient(135deg, #150f0f 0%, #300c02 50%, #810100 100%);
    }

    .hero-slide-3 {
        background: radial-gradient(circle at 75% 35%, rgba(129, 1, 0, 0.5) 0%, rgba(27, 23, 23, 0.98) 65%),
                    linear-gradient(135deg, #1a0a0a 0%, #3a0808 45%, #630000 100%);
    }

    .hero-pill-eyebrow {
        background: rgba(237, 235, 221, 0.12);
        border: 1px solid rgba(237, 235, 221, 0.3);
        color: #EDEBDD;
        backdrop-filter: blur(8px);
        letter-spacing: 1.5px;
        font-size: 0.78rem;
    }

    .hero-sparkle-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #810100;
        box-shadow: 0 0 8px #810100, 0 0 12px #810100;
        display: inline-block;
    }

    .hero-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 700;
        font-size: clamp(2.1rem, 4.4vw, 3.5rem);
        line-height: 1.15;
        letter-spacing: -0.5px;
        color: #EDEBDD;
    }

    .hero-title-accent {
        background: linear-gradient(135deg, #EDEBDD 0%, #e8c688 50%, #EDEBDD 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-style: italic;
    }

    .hero-spec-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(237, 235, 221, 0.1);
        border: 1px solid rgba(237, 235, 221, 0.22);
        color: #EDEBDD;
        padding: 0.5rem 0.85rem;
        border-radius: 50px;
        font-size: 0.8rem;
        backdrop-filter: blur(6px);
        transition: all 0.2s ease;
    }

    .hero-spec-pill:hover {
        background: rgba(237, 235, 221, 0.18);
        border-color: rgba(237, 235, 221, 0.4);
        transform: translateY(-1px);
    }

    .btn-roven-hero-primary {
        background: linear-gradient(135deg, #810100 0%, #630000 100%);
        border: 1px solid rgba(232, 198, 136, 0.45);
        color: #EDEBDD !important;
        box-shadow: 0 10px 25px rgba(99, 0, 0, 0.45);
        transition: all 0.25s ease;
    }

    .btn-roven-hero-primary:hover {
        background: linear-gradient(135deg, #630000 0%, #810100 100%);
        color: #EDEBDD !important;
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(129, 1, 0, 0.6);
        border-color: rgba(232, 198, 136, 0.7);
    }

    .btn-roven-hero-secondary {
        background: rgba(237, 235, 221, 0.08);
        border: 1.5px solid rgba(237, 235, 221, 0.5);
        color: #EDEBDD !important;
        backdrop-filter: blur(8px);
        transition: all 0.25s ease;
    }

    .btn-roven-hero-secondary:hover {
        background: #EDEBDD;
        color: #1B1717 !important;
        border-color: #EDEBDD;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    }

    .hero-glass-card {
        background: linear-gradient(145deg, rgba(32, 24, 24, 0.82) 0%, rgba(18, 14, 14, 0.92) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(237, 235, 221, 0.2);
        border-radius: 24px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.65);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }

    .hero-glass-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 36px 70px rgba(99, 0, 0, 0.4);
    }

    .flacon-presentation-frame {
        position: relative;
        max-width: 250px;
        height: 220px;
        margin: 0 auto 1rem;
        border-radius: 18px;
        overflow: hidden;
        background: radial-gradient(circle, rgba(129, 1, 0, 0.35) 0%, rgba(0, 0, 0, 0.85) 80%);
        border: 1px solid rgba(237, 235, 221, 0.15);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    .flacon-presentation-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .hero-glass-card:hover .flacon-presentation-frame img {
        transform: scale(1.05);
    }

    .hero-note-tag {
        display: inline-block;
        background: rgba(237, 235, 221, 0.08);
        border: 1px solid rgba(237, 235, 221, 0.18);
        color: #EDEBDD;
        font-size: 0.72rem;
        padding: 0.2rem 0.55rem;
        border-radius: 50px;
        margin: 2px;
    }

    .hero-lead-text {
        color: #EDEBDD;
        opacity: 0.92;
        max-width: 580px;
        line-height: 1.65;
        font-size: clamp(0.92rem, 1.8vw, 1.1rem);
    }

    .carousel-indicators {
        margin-bottom: 0.85rem !important;
        gap: 6px !important;
        z-index: 5;
    }

    .carousel-indicators [data-bs-target] {
        width: 28px !important;
        height: 5px !important;
        border-radius: 4px !important;
        background-color: rgba(237, 235, 221, 0.35) !important;
        border: none !important;
        transition: all 0.3s ease !important;
    }

    .carousel-indicators .active {
        width: 46px !important;
        background-color: #810100 !important;
        box-shadow: 0 0 10px rgba(129, 1, 0, 0.8) !important;
    }

    .carousel-control-prev, .carousel-control-next {
        width: 50px;
        height: 50px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(27, 23, 23, 0.75);
        border-radius: 50%;
        border: 1px solid rgba(237, 235, 221, 0.25);
        backdrop-filter: blur(8px);
        margin: 0 20px;
        opacity: 0.85;
        color: #EDEBDD;
        transition: all 0.2s;
    }

    .carousel-control-prev:hover, .carousel-control-next:hover {
        background: #630000;
        border-color: #810100;
        opacity: 1;
        box-shadow: 0 0 20px rgba(99, 0, 0, 0.6);
        color: #EDEBDD;
    }

    /* Trust Feature Badges */
    .trust-card {
        background: #ffffff;
        border: 1px solid #e8e3d5;
        border-radius: 16px;
        padding: 1.35rem 1.25rem;
        transition: all 0.25s ease;
    }

    .trust-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(27, 23, 23, 0.08);
        border-color: #630000;
    }

    .trust-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    /* Category Showcase Cards */
    .cat-showcase-card {
        background: #ffffff;
        border: 1px solid #e8e3d5;
        border-radius: 20px;
        padding: 1.5rem;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(27, 23, 23, 0.03);
    }

    .cat-showcase-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #630000, #810100);
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .cat-showcase-card:hover {
        transform: translateY(-6px);
        border-color: rgba(129, 1, 0, 0.35);
        box-shadow: 0 18px 36px rgba(99, 0, 0, 0.1);
    }

    .cat-showcase-card:hover::before {
        opacity: 1;
    }

    .cat-icon-container {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background-color: #EDEBDD;
        color: #630000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        border: 1px solid rgba(99, 0, 0, 0.12);
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .cat-showcase-card:hover .cat-icon-container {
        background-color: #630000;
        color: #EDEBDD;
        border-color: #810100;
        transform: scale(1.08) rotate(-3deg);
    }

    .cat-count-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        background-color: #FAF9F5;
        color: #630000;
        border: 1px solid #e8e3d5;
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .cat-card-title {
        color: #1B1717;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.2px;
        margin-top: 0.75rem;
        transition: color 0.2s ease;
    }

    .cat-showcase-card:hover .cat-card-title {
        color: #630000;
    }

    .cat-card-desc {
        color: #6c6358;
        font-size: 0.85rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .cat-card-footer {
        border-top: 1px solid #f0ecdf;
        padding-top: 0.85rem;
    }

    .cat-explore-text {
        color: #630000;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .cat-arrow-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #EDEBDD;
        color: #630000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: all 0.25s ease;
        border: 1px solid rgba(99, 0, 0, 0.1);
    }

    .cat-showcase-card:hover .cat-arrow-circle {
        background-color: #630000;
        color: #EDEBDD;
        border-color: #810100;
        transform: translateX(4px);
    }

    /* Flash Deal Timer Box */
    .timer-unit-box {
        background: #1B1717;
        color: #EDEBDD;
        border-radius: 10px;
        padding: 0.5rem 0.6rem;
        text-align: center;
        min-width: 52px;
        flex: 1 1 0;
        box-shadow: 0 4px 10px rgba(27, 23, 23, 0.2);
        border: 1px solid rgba(237, 235, 221, 0.15);
    }

    .timer-unit-num {
        font-size: 1.35rem;
        font-weight: 800;
        font-family: monospace;
        line-height: 1;
        color: #EDEBDD;
    }

    .timer-unit-lbl {
        font-size: 0.62rem;
        text-transform: uppercase;
        color: #EDEBDD;
        opacity: 0.75;
        margin-top: 3px;
        letter-spacing: 0.5px;
    }

    @@media (max-width: 991.98px) {
        .hero-carousel-item {
            min-height: auto !important;
            padding: 1.5rem 0 2.5rem !important;
        }
        .hero-title {
            font-size: clamp(1.55rem, 5.2vw, 2.2rem) !important;
            line-height: 1.18 !important;
            letter-spacing: -0.3px !important;
        }
        .hero-pill-eyebrow {
            font-size: 0.7rem !important;
            padding: 0.25rem 0.65rem !important;
            letter-spacing: 0.8px !important;
        }
        .hero-lead-text {
            font-size: 0.86rem !important;
            line-height: 1.5 !important;
            max-width: min(480px, 100%) !important;
            width: 100% !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }
        .hero-spec-pill {
            font-size: 0.72rem !important;
            padding: 0.35rem 0.65rem !important;
        }
        .hero-glass-card {
            padding: 1.1rem 0.95rem !important;
            border-radius: 18px !important;
            max-width: min(390px, 100%) !important;
            width: 100% !important;
            margin-left: auto !important;
            margin-right: auto !important;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6) !important;
            overflow: hidden !important;
        }
        .flacon-presentation-frame {
            height: 145px !important;
            max-width: 160px !important;
            border-radius: 14px !important;
            margin-bottom: 0.5rem !important;
        }
        .hero-card-title {
            font-size: 1.05rem !important;
            margin-bottom: 0.25rem !important;
        }
        .hero-note-tag {
            font-size: 0.66rem !important;
            padding: 0.15rem 0.45rem !important;
        }
        .hero-card-price {
            font-size: 1.2rem !important;
        }
        .carousel-control-prev, .carousel-control-next {
            display: none !important;
        }

        .trust-title {
            font-size: 0.82rem !important;
            word-break: break-word;
        }
        .trust-subtitle {
            font-size: 0.7rem !important;
            line-height: 1.25 !important;
            word-break: break-word;
        }
        .trust-icon-box {
            width: 36px !important;
            height: 36px !important;
            font-size: 1.05rem !important;
            border-radius: 10px !important;
        }
    }

    @@media (max-width: 767.98px) {
        /* Category Showcase 2x2 Grid Optimization for Mobile */
        .cat-showcase-card {
            padding: 0.95rem 0.85rem !important;
            border-radius: 16px !important;
            min-height: 220px !important;
            overflow: hidden !important;
            word-break: break-word;
        }
        .cat-icon-container {
            width: 38px !important;
            height: 38px !important;
            font-size: 1.05rem !important;
            border-radius: 10px !important;
        }
        .cat-count-badge {
            font-size: 0.68rem !important;
            padding: 0.22rem 0.5rem !important;
            font-weight: 700 !important;
        }
        .cat-card-title {
            font-size: 0.92rem !important;
            line-height: 1.25 !important;
            margin-top: 0.55rem !important;
            min-height: 2.35rem !important;
            display: flex !important;
            align-items: center !important;
            word-break: break-word;
        }
        .cat-card-desc {
            font-size: 0.74rem !important;
            line-height: 1.35 !important;
            margin-bottom: 0.6rem !important;
            display: -webkit-box !important;
            -webkit-line-clamp: 2 !important;
            -webkit-box-orient: vertical !important;
            overflow: hidden !important;
            word-break: break-word;
        }
        .cat-card-footer {
            margin-top: auto !important;
        }
        .cat-explore-text {
            font-size: 0.75rem !important;
            font-weight: 700 !important;
        }
        .cat-arrow-circle {
            width: 26px !important;
            height: 26px !important;
            font-size: 0.7rem !important;
        }

        /* Spotlight Deal Mobile Refinement */
        .spotlight-deal-card {
            border-radius: 18px !important;
            overflow: hidden !important;
            max-width: 100% !important;
        }
        .spotlight-actions {
            flex-direction: column !important;
            width: 100% !important;
            gap: 10px !important;
        }
        .spotlight-actions .btn {
            width: 100% !important;
            justify-content: center !important;
            font-size: clamp(0.82rem, 3.6vw, 0.95rem) !important;
            padding: 0.8rem 1rem !important;
            white-space: normal !important;
            border-radius: 50px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 8px !important;
            word-break: break-word !important;
        }
        .spotlight-actions .btn span {
            white-space: normal !important;
        }
        .spotlight-timer-boxes {
            display: flex !important;
            gap: 8px !important;
            justify-content: flex-start !important;
        }
        .timer-unit-box {
            width: 58px !important;
            height: 54px !important;
            border-radius: 12px !important;
        }
        .timer-unit-num {
            font-size: 1.2rem !important;
        }
        .timer-unit-lbl {
            font-size: 0.62rem !important;
        }
        .spotlight-meter-header {
            flex-wrap: wrap !important;
            gap: 6px !important;
            justify-content: space-between !important;
            width: 100% !important;
        }
        .spotlight-meter-header span {
            font-size: 0.78rem !important;
            white-space: normal !important;
        }

        /* Luxury VIP Newsletter Mobile Refinement */
        .newsletter-card {
            padding: 2.5rem 1.15rem !important;
            border-radius: 20px !important;
            overflow: hidden !important;
        }
        .newsletter-pill-form {
            flex-direction: column !important;
            padding: 8px !important;
            border-radius: 20px !important;
            gap: 8px !important;
            background: #EDEBDD !important;
        }
        .newsletter-pill-form .form-control {
            text-align: center !important;
            font-size: 16px !important; /* Prevents iOS auto-zoom */
            padding: 0.5rem !important;
            width: 100% !important;
        }
        .newsletter-btn {
            width: 100% !important;
            justify-content: center !important;
            padding: 0.65rem 1rem !important;
            font-size: 0.9rem !important;
        }

        /* Luxury FAQ Mobile Refinement */
        .roven-faq-btn {
            padding: 0.95rem 1rem !important;
            font-size: 0.92rem !important;
        }
        .roven-faq-body {
            padding: 0.95rem 1rem !important;
            font-size: 0.88rem !important;
        }
    }

    @@media (max-width: 575.98px) {
        /* Section Spacing & Containers for Small Phones */
        section {
            padding-top: 2rem !important;
            padding-bottom: 2rem !important;
        }

        .container {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        /* 1. Trust Value Cards (2x2 Grid) */
        .trust-card {
            padding: 0.75rem 0.45rem !important;
            border-radius: 12px !important;
            gap: 4px !important;
            text-align: center !important;
            justify-content: center !important;
        }
        .trust-icon-box {
            width: 32px !important;
            height: 32px !important;
            font-size: 0.95rem !important;
            border-radius: 8px !important;
            margin: 0 auto 3px auto !important;
        }
        .trust-title {
            font-size: 0.74rem !important;
            line-height: 1.2 !important;
            margin-bottom: 2px !important;
            font-weight: 700 !important;
        }
        .trust-subtitle {
            font-size: 0.63rem !important;
            line-height: 1.2 !important;
            color: #78716c !important;
        }

        /* 2. Category Showcase (2x2 Grid) */
        .cat-showcase-card {
            padding: 0.8rem 0.65rem !important;
            border-radius: 14px !important;
            min-height: 190px !important;
        }
        .cat-icon-container {
            width: 34px !important;
            height: 34px !important;
            font-size: 0.95rem !important;
            border-radius: 8px !important;
        }
        .cat-count-badge {
            font-size: 0.62rem !important;
            padding: 0.15rem 0.4rem !important;
        }
        .cat-card-title {
            font-size: 0.86rem !important;
            min-height: 2.1rem !important;
            line-height: 1.25 !important;
            margin-top: 0.4rem !important;
        }
        .cat-card-desc {
            font-size: 0.7rem !important;
            line-height: 1.3 !important;
            margin-bottom: 0.35rem !important;
        }
        .cat-explore-text {
            font-size: 0.7rem !important;
        }
        .cat-arrow-circle {
            width: 24px !important;
            height: 24px !important;
            font-size: 0.65rem !important;
        }

        /* 3. Special Offers & Duo Bundles */
        .special-offer-card {
            border-radius: 16px !important;
        }
        .special-offer-duo-img {
            max-height: 125px !important;
        }
        .special-offer-single-img {
            max-height: 160px !important;
        }
        .special-offer-plus-badge {
            width: 26px !important;
            height: 26px !important;
            font-size: 0.85rem !important;
        }
        .special-offer-actions .btn {
            font-size: 0.8rem !important;
            padding: 0.55rem 0.75rem !important;
        }

        /* 4. Spotlight Deal of the Day */
        .spotlight-deal-card {
            border-radius: 16px !important;
        }
        .spotlight-deal-card img {
            max-height: 220px !important;
        }
        .spotlight-timer-boxes {
            justify-content: center !important;
        }
        .timer-unit-box {
            width: 52px !important;
            height: 48px !important;
            padding: 0.35rem 0.4rem !important;
            border-radius: 10px !important;
        }
        .timer-unit-num {
            font-size: 1.1rem !important;
        }
        .timer-unit-lbl {
            font-size: 0.58rem !important;
        }

        /* 5. Product Cards (Featured & Best Sellers) */
        .product-card {
            border-radius: 14px !important;
        }
        .product-image-container {
            height: 200px !important;
        }
        .product-card .p-3 {
            padding: 0.85rem !important;
        }
        .product-card h6 {
            font-size: 0.95rem !important;
