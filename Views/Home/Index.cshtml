        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .hero-banner-frame {
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        background-color: #140808;
        border: 1px solid rgba(223, 177, 91, 0.24);
        box-shadow: 0 10px 32px rgba(27, 23, 23, 0.08);
        transition: box-shadow 0.35s ease, border-color 0.35s ease;
        touch-action: pan-y pinch-zoom;
        user-select: none;
        -webkit-user-select: none;
        cursor: grab;
    }

    .hero-banner-frame:active {
        cursor: grabbing;
    }

    .hero-banner-frame:hover {
        border-color: rgba(223, 177, 91, 0.45);
        box-shadow: 0 16px 42px rgba(27, 23, 23, 0.14);
    }

    .hero-banner-link {
        display: block;
        width: 100%;
        line-height: 0;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
    }

    .hero-banner-responsive-img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        max-height: 520px;
        transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        border-radius: inherit;
        -webkit-user-drag: none;
        user-drag: none;
        user-select: none;
        -webkit-user-select: none;
        pointer-events: none;
    }

    .hero-banner-link:hover .hero-banner-responsive-img {
        transform: scale(1.008);
    }

    /* Silky-Smooth Carousel Transition */
    #heroHomeCarousel .carousel-item {
        transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1) !important;
    }

    #heroHomeCarousel .carousel-indicators {
        bottom: 14px !important;
        margin-bottom: 0 !important;
        z-index: 10;
    }

    #heroHomeCarousel .carousel-indicators [data-bs-target] {
        width: 28px !important;
        height: 4px !important;
        border-radius: 4px !important;
        background-color: rgba(237, 235, 221, 0.45) !important;
        border: none !important;
        margin: 0 4px !important;
        cursor: pointer !important;
        transition: all 0.3s ease !important;
    }

    #heroHomeCarousel .carousel-indicators .active {
        width: 48px !important;
        background-color: #dfb15b !important;
        box-shadow: 0 0 12px rgba(223, 177, 91, 0.8) !important;
    }

    /* Navigation Arrows: Always accessible, visible & touch-friendly on both Desktop & Mobile */
    #heroHomeCarousel .carousel-control-prev,
    #heroHomeCarousel .carousel-control-next {
        display: flex !important;
        width: 44px;
        height: 44px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(20, 8, 8, 0.72) !important;
        border-radius: 50%;
        border: 1px solid rgba(223, 177, 91, 0.35);
        backdrop-filter: blur(8px);
        margin: 0 16px;
        opacity: 0.85;
        transition: all 0.25s ease;
        color: #fdf4dc !important;
        z-index: 10;
    }

    #heroHomeCarousel:hover .carousel-control-prev,
    #heroHomeCarousel:hover .carousel-control-next {
        opacity: 1;
    }

    #heroHomeCarousel .carousel-control-prev:hover,
    #heroHomeCarousel .carousel-control-next:hover {
        background: #810100 !important;
        border-color: #dfb15b;
        box-shadow: 0 0 16px rgba(129, 1, 0, 0.7);
        color: #ffffff !important;
    }

    @@media (max-width: 768px) {
        .hero-banner-section {
            padding-top: 0.85rem !important;
            padding-bottom: 0.85rem !important;
        }

        .hero-banner-frame {
            border-radius: 14px;
        }

        .hero-banner-responsive-img {
            max-height: none;
            border-radius: 14px;
        }

        #heroHomeCarousel .carousel-control-prev,
        #heroHomeCarousel .carousel-control-next {
            display: flex !important;
            width: 32px !important;
            height: 32px !important;
            font-size: 0.75rem !important;
            margin: 0 6px !important;
            background: rgba(20, 8, 8, 0.65) !important;
            opacity: 0.85 !important;
        }

        #heroHomeCarousel .carousel-indicators [data-bs-target] {
            width: 18px !important;
            height: 3px !important;
            margin: 0 3px !important;
        }

        #heroHomeCarousel .carousel-indicators .active {
            width: 32px !important;
        }
    }
</style>

<!-- ======================================================================== -->
<!-- 1. HERO BANNERS CAROUSEL (Admin-Managed Dynamic Luxury Banners)           -->
<!-- ======================================================================== -->
@if (Model.HeroBanners != null && Model.HeroBanners.Any())
{
    <section class="hero-banner-section py-3 py-md-4">
        <div class="container">
            <div class="hero-banner-frame shadow-sm position-relative overflow-hidden">
                @if (Model.HeroBanners.Count > 1)
                {
                    <div id="heroHomeCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4500" data-bs-pause="false" data-bs-touch="true">
                        <!-- Carousel Indicators -->
                        <div class="carousel-indicators mb-2 mb-md-3">
                            @for (int i = 0; i < Model.HeroBanners.Count; i++)
                            {
                                <button type="button" data-bs-target="#heroHomeCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>

                        <!-- Carousel Slides -->
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.HeroBanners.Count; i++)
                            {
                                var banner = Model.HeroBanners[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <a href="@(string.IsNullOrWhiteSpace(banner.RedirectLink) ? "/Store" : banner.RedirectLink)" class="hero-banner-link" title="@banner.Title">
                                        <picture>
                                            @if (!string.IsNullOrWhiteSpace(banner.MobileImageUrl))
                                            {
                                                <source media="(max-width: 768px)" srcset="@banner.MobileImageUrl">
                                            }
                                            <img src="@banner.DesktopImageUrl" alt="@(string.IsNullOrWhiteSpace(banner.AltText) ? banner.Title : banner.AltText)" class="hero-banner-responsive-img d-block w-100" loading="@(i == 0 ? "eager" : "lazy")" draggable="false" onerror="this.src='/images/banners/hero_slide_1.svg'" />
                                        </picture>
                                    </a>
                                </div>
                            }
                        </div>

                        <!-- Carousel Navigation Controls (Click / Tap to slide) -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#heroHomeCarousel" data-bs-slide="prev" aria-label="Previous Banner">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#heroHomeCarousel" data-bs-slide="next" aria-label="Next Banner">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                }
                else
                {
                    var singleBanner = Model.HeroBanners[0];
                    <div class="w-100 p-0 m-0">
                        <a href="@(string.IsNullOrWhiteSpace(singleBanner.RedirectLink) ? "/Store" : singleBanner.RedirectLink)" class="hero-banner-link" title="@singleBanner.Title">
                            <picture>
                                @if (!string.IsNullOrWhiteSpace(singleBanner.MobileImageUrl))
                                {
                                    <source media="(max-width: 768px)" srcset="@singleBanner.MobileImageUrl">
                                }
                                <img src="@singleBanner.DesktopImageUrl" alt="@(string.IsNullOrWhiteSpace(singleBanner.AltText) ? singleBanner.Title : singleBanner.AltText)" class="hero-banner-responsive-img d-block w-100" loading="eager" onerror="this.src='/images/banners/hero_slide_1.svg'" />
                            </picture>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

