                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3 g-lg-4">
            @foreach (var cat in Model.Categories)
            {
                var faIcon = cat.Name.ToLower() switch
                {
                    var n when n.Contains("extrait") => "fa-solid fa-droplet",
                    var n when n.Contains("oud") || n.Contains("orient") => "fa-solid fa-fire-flame-simple",
                    var n when n.Contains("eau") => "fa-solid fa-spray-can-sparkles",
                    var n when n.Contains("gift") || n.Contains("discov") => "fa-solid fa-gift",
                    _ => "fa-solid fa-gem"
                };

                <div class="col-6 col-lg-3">
                    <a asp-controller="Store" asp-action="Index" asp-route-categoryId="@cat.Id" class="cat-showcase-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                            <div class="cat-icon-container">
                                <i class="@faIcon"></i>
                            </div>
