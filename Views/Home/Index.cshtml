                                <i class="fa-solid fa-spray-can-sparkles me-1" style="color: #810100;"></i>@(cat.ProductsCount == 1 ? "1 Parfum" : $"{cat.ProductsCount} Parfums")
                            </span>
                        </div>
                        <h5 class="cat-card-title">@cat.Name</h5>
                        <p class="cat-card-desc flex-grow-1">@(cat.Description ?? "Discover the haute perfumerie collection")</p>
                        <div class="cat-card-footer mt-auto d-flex align-items-center justify-content-between">
                            <span class="cat-explore-text d-none d-sm-inline" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: calc(100% - 32px);">Explore Department</span>
                            <span class="cat-explore-text d-inline d-sm-none" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Explore</span>
                            <div class="cat-arrow-circle">
                                <i class="fa-solid fa-arrow-right"></i>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
}

