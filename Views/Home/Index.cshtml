                    </h2>
                    <p class="text-muted small mx-auto mb-0" style="max-width: 620px;">
                        إصدارات عطرية مختارة بتخفيضات استثنائية لفترة محدودة، مع شحن لكافة المحافظات وإمكانية معاينة الطرد قبل الدفع عند الاستلام.
                    </p>
                </div>

                <div class="row g-3 g-md-4 justify-content-center">
                    @foreach (var offer in Model.SpecialOffers)
                    {
                        var isDuo = offer.IsDuoOffer;
                        <div class="col-12 col-md-6 @(Model.SpecialOffers.Count == 2 ? "col-lg-6" : "col-lg-4")">
                            <div class="card special-offer-card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative d-flex flex-column" style="background-color: #FAF9F5; border: 1px solid rgba(99, 0, 0, 0.12) !important; transition: transform 0.25s ease, box-shadow 0.25s ease;">
                                <!-- Top Badges -->
                                <div class="position-absolute top-0 start-0 m-3 z-2 d-flex flex-column gap-1">
                                    <span class="badge badge-roven-crimson px-2.5 py-1.5 rounded-pill fw-bold shadow-xs small d-inline-flex align-items-center gap-1">
                                        <i class="fa-solid @(isDuo ? "fa-layer-group" : "fa-crown") text-warning"></i>
                                        <span>@(string.IsNullOrWhiteSpace(offer.BadgeText) ? (isDuo ? "DUO BUNDLE • عرض عطرين" : "OFFER") : offer.BadgeText)</span>
                                    </span>
                                    @if (offer.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2.5 py-1 fw-bold shadow-xs small" style="width: fit-content;">
                                            وفر @offer.DiscountPercent%
                                        </span>
                                    }
                                </div>

                                <!-- Perfume Image Box -->
                                <div class="text-center p-3 position-relative overflow-hidden special-offer-img-box" style="background-color: #EDEBDD; min-height: 250px; display: flex; align-items: center; justify-content: center;">
                                    @if (isDuo)
                                    {
                                        <!-- Duo Perfumes Visual Presentation (2 Flacons side-by-side with + divider) -->
                                        <div class="d-flex align-items-center justify-content-center gap-1.5 w-100 py-2">
                                            <!-- Flacon 1 -->
                                            <div class="text-center position-relative flex-fill" style="max-width: 48%;">
                                                <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-block" title="@offer.ProductName">
                                                    @if (!string.IsNullOrWhiteSpace(offer.ImageUrl))
                                                    {
                                                        <img src="@offer.ImageUrl" alt="@offer.ProductName" class="img-fluid rounded-3 shadow-xs special-offer-duo-img" style="max-height: 185px; object-fit: contain; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-spray-can-sparkles display-4" style="color: #630000;"></i>
                                                    }
                                                </a>
                                                <span class="badge position-absolute bottom-0 start-50 translate-middle-x rounded-pill font-monospace small px-2 py-0.5" style="background: rgba(20, 8, 8, 0.82); color: #dfb15b; font-size: 0.65rem; white-space: nowrap;">
                                                    العطر 1
                                                </span>
                                            </div>

                                            <!-- Gold Plus Separator Badge -->
                                            <div class="d-flex align-items-center justify-content-center rounded-circle shadow-sm special-offer-plus-badge" style="width: 32px; height: 32px; background: #630000; color: #EDEBDD; font-weight: bold; font-size: 1.1rem; flex-shrink: 0; z-index: 2; border: 2px solid #dfb15b;">
                                                +
                                            </div>

                                            <!-- Flacon 2 -->
                                            <div class="text-center position-relative flex-fill" style="max-width: 48%;">
                                                <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.SecondProductId" class="d-block" title="@offer.SecondProductName">
                                                    @if (!string.IsNullOrWhiteSpace(offer.SecondProductImageUrl))
                                                    {
                                                        <img src="@offer.SecondProductImageUrl" alt="@offer.SecondProductName" class="img-fluid rounded-3 shadow-xs special-offer-duo-img" style="max-height: 185px; object-fit: contain; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.06)'" onmouseout="this.style.transform='scale(1)'" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-spray-can-sparkles display-4" style="color: #630000;"></i>
                                                    }
                                                </a>
                                                <span class="badge position-absolute bottom-0 start-50 translate-middle-x rounded-pill font-monospace small px-2 py-0.5" style="background: rgba(20, 8, 8, 0.82); color: #dfb15b; font-size: 0.65rem; white-space: nowrap;">
                                                    العطر 2
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Single Perfume Image Box -->
                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-block">
                                            @if (!string.IsNullOrWhiteSpace(offer.ImageUrl))
                                            {
                                                <img src="@offer.ImageUrl" alt="@offer.ProductName" class="img-fluid rounded-3 shadow-xs special-offer-single-img" style="max-height: 210px; object-fit: contain; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-spray-can-sparkles display-3" style="color: #630000;"></i>
                                            }
                                        </a>
                                    }
                                </div>

                                <!-- Card Body -->
                                <div class="card-body p-3 p-md-4 d-flex flex-column flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center small mb-1.5 text-muted">
                                        @if (isDuo)
                                        {
                                            <span class="badge rounded-pill fw-bold" style="background-color: #630000; color: #fdf4dc; font-size: 0.72rem;">
                                                <i class="fa-solid fa-layer-group me-1"></i>باقة ثنائية (عطرين معاً)
                                            </span>
                                            <span class="font-monospace small text-muted">2x 100ml Flacons</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-roven-cream px-2 py-0.5 rounded-pill">@offer.CategoryName</span>
                                            <span class="font-monospace small">SKU: @offer.Sku</span>
                                        }
                                    </div>

                                    <h5 class="fw-bold mb-2 text-dark" style="font-size: 1.05rem; line-height: 1.4;">
                                        @offer.DisplayTitle
                                    </h5>

                                    @if (isDuo)
                                    {
                                        <!-- Itemized fragrance list in Duo Offer -->
                                        <div class="d-flex flex-column gap-1 mb-3 p-2 rounded-3" style="background: rgba(232, 227, 213, 0.4); border: 1px dashed rgba(99,0,0,0.2);">
                                            <div class="small text-dark d-flex align-items-center gap-1.5">
                                                <i class="fa-solid fa-check-circle text-success" style="font-size: 0.75rem;"></i>
                                                <span class="fw-semibold">1.</span> @offer.ProductName
                                            </div>
                                            <div class="small text-dark d-flex align-items-center gap-1.5">
                                                <i class="fa-solid fa-check-circle text-success" style="font-size: 0.75rem;"></i>
                                                <span class="fw-semibold">2.</span> @offer.SecondProductName
                                            </div>
                                        </div>
                                    }

                                    <!-- Price Comparison Box -->
                                    <div class="p-2.5 rounded-3 mb-3 d-flex justify-content-between align-items-center mt-auto" style="background-color: #ffffff; border: 1px solid #e8e3d5;">
                                        <div>
                                            @if (offer.OriginalPrice > offer.OfferPrice)
                                            {
                                                <div class="text-muted small text-decoration-line-through font-monospace">
                                                    @offer.OriginalPrice.ToString("N0") EGP
                                                </div>
                                            }
                                            <div class="fw-extrabold fs-5 font-monospace" style="color: #630000;">
                                                @offer.OfferPrice.ToString("N0") <span class="fs-7 fw-normal text-muted">EGP</span>
                                            </div>
                                        </div>
                                        @if (offer.DiscountPercent > 0)
                                        {
                                            <div class="text-end">
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 font-monospace fw-bold">
                                                    خصم @offer.DiscountPercent%
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Progress Meter -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center small mb-1" style="font-size: 0.76rem; color: #6c6358;">
                                            <span>نسبة الحجز: <strong>@offer.AllocatedPercent%</strong></span>
                                            <span class="fw-bold" style="color: #810100;">
                                                <i class="fa-solid fa-fire me-1"></i>متبقي @offer.RemainingCount @(isDuo ? "باقة" : "فقط")!
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 6px; background-color: #e8e3d5;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @(offer.AllocatedPercent)%; background-color: #810100;"></div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2 special-offer-actions">
                                        <button type="button" class="btn btn-roven-wine btn-sm py-2 px-3 fw-bold rounded-pill flex-grow-1 d-flex align-items-center justify-content-center gap-1.5 shadow-xs" onclick="window.addOfferToCart(@offer.Id, this)">
                                            <i class="fa-solid @(isDuo ? "fa-gift" : "fa-bag-shopping")"></i>
                                            <span>@(isDuo ? "أضف باقة العطرين للحقيبة" : "أضف للحقيبة")</span>
                                        </button>
                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="btn btn-outline-dark btn-sm py-2 px-3 rounded-pill fw-semibold" title="عرض التفاصيل">
                                            <i class="fa-solid fa-arrow-left"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        <!-- Single Product Hero Spotlight (If only 1 offer is configured) -->
        var singleOffer = Model.SpecialOffers.FirstOrDefault();
        var deal = singleOffer != null ? new Stockify.ViewModels.Store.StoreProductCardViewModel
        {
            Id = singleOffer.ProductId,
            Name = singleOffer.ProductName,
            Sku = singleOffer.Sku,
            CategoryName = singleOffer.CategoryName,
            ImageUrl = singleOffer.ImageUrl,
            Description = singleOffer.Description,
            Price = singleOffer.OfferPrice,
            StockQuantity = singleOffer.RemainingCount
        } : Model.DealOfTheDay!;

        var spotPrice = (singleOffer != null && singleOffer.OfferPrice > 0) ? singleOffer.OfferPrice : ((Model.Settings != null && Model.Settings.SpotlightPrice > 0) ? Model.Settings.SpotlightPrice : deal.Price);
        var spotAlloc = singleOffer?.AllocatedPercent ?? Model.Settings?.SpotlightAllocatedPercent ?? 82;
        var spotRemaining = singleOffer?.RemainingCount ?? ((Model.Settings != null && Model.Settings.SpotlightRemainingCount > 0) ? Model.Settings.SpotlightRemainingCount : Math.Max(1, deal.StockQuantity));
        var badgeText = singleOffer?.BadgeText ?? "EXCLUSIVE SPOTLIGHT";

        <section class="py-5 bg-white border-top border-bottom overflow-hidden w-100" style="border-color: #e8e3d5 !important;">
            <div class="container">
                <div class="card border-0 shadow-lg overflow-hidden spotlight-deal-card" style="border-radius: 20px; border: 1px solid rgba(99, 0, 0, 0.12) !important;">
                    <div class="row g-0 align-items-center">
                        <!-- Left Promo Image -->
                        <div class="col-12 col-lg-5 p-4 p-md-5 text-center position-relative" style="background-color: #EDEBDD;">
                            <span class="badge badge-roven-crimson px-3 py-2 rounded-pill fw-bold position-absolute top-0 start-0 m-3 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="fa-solid fa-crown"></i>
                                <span>@badgeText</span>
                            </span>
                            <div class="py-3">
                                <a asp-controller="Store" asp-action="Details" asp-route-id="@deal.Id" class="d-inline-block text-decoration-none" title="عرض تفاصيل عطر @deal.Name">
                                    @if (!string.IsNullOrWhiteSpace(deal.ImageUrl))
                                    {
                                        <img src="@deal.ImageUrl" alt="@deal.Name" class="img-fluid rounded-4 shadow-sm" style="max-height: 320px; object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-spray-can-sparkles display-1" style="color: #630000;"></i>
                                    }
                                </a>
                            </div>
                        </div>

                        <!-- Right Deal Details & Live Countdown -->
                        <div class="col-12 col-lg-7 p-3 p-sm-4 p-md-5">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge badge-roven-cream px-3 py-1 rounded-pill">
                                    @deal.CategoryName
                                </span>
                                <span class="font-monospace small" style="color: #6c6358;">SKU: @deal.Sku</span>
                            </div>

                            <h3 class="fw-extrabold mb-2" style="color: #1B1717;">@deal.Name</h3>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="star-rating">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                </div>
                                <span class="small" style="color: #6c6358;">5.0 (Connoisseur Verified Favorite)</span>
                            </div>

                            <p class="small mb-4" style="color: #595252; max-width: 520px; line-height: 1.6;">
                                @(deal.Description ?? "Limited daily allocation of this masterwork fragrance. Sealed flacon in luxury presentation box, backed by Cash on Delivery parcel inspection.")
                            </p>

                            <!-- Price & Live Countdown Box -->
                            <div class="p-3 rounded-3 mb-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3" style="background-color: #FAF9F5; border: 1px solid #e8e3d5;">
                                <div>
                                    <span class="small d-block" style="color: #6c6358;">Spotlight Price</span>
                                    <h3 class="fw-extrabold mb-0" style="color: #630000;">
                                        @spotPrice.ToString("N2") <span class="fs-6 fw-normal" style="color: #6c6358;">EGP</span>
                                    </h3>
                                </div>

                                <!-- Live Countdown Display -->
                                <div class="w-100 w-sm-auto">
                                    <div class="small fw-semibold mb-1 text-sm-end d-flex align-items-center justify-content-start justify-content-sm-end gap-1" style="color: #6c6358;">
                                        <i class="fa-solid fa-clock" style="color: #810100;"></i>
                                        <span>Spotlight Ends In:</span>
                                    </div>
                                    <div class="d-flex gap-2 spotlight-timer-boxes">
                                        <div class="timer-unit-box">
                                            <div class="timer-unit-num" id="countdown-hours">09</div>
                                            <div class="timer-unit-lbl">Hours</div>
                                        </div>
                                        <div class="timer-unit-box">
                                            <div class="timer-unit-num" id="countdown-mins">34</div>
                                            <div class="timer-unit-lbl">Mins</div>
                                        </div>
                                        <div class="timer-unit-box">
                                            <div class="timer-unit-num" id="countdown-secs">50</div>
                                            <div class="timer-unit-lbl">Secs</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Stock Progress Meter -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center small mb-2 spotlight-meter-header" style="color: #6c6358;">
                                    <span class="d-inline-flex align-items-center gap-1.5 fw-semibold">
                                        <i class="fa-solid fa-box-open" style="color: #810100;"></i>
                                        <span>Allocated: <strong style="color: #1B1717;">@spotAlloc% Claimed</strong></span>
                                    </span>
                                    <span class="fw-bold" style="color: #810100;">
                                        <i class="fa-solid fa-fire me-1"></i>Only @spotRemaining flacons remaining!
                                    </span>
                                </div>
                                <div class="progress" style="height: 8px; background-color: #e8e3d5;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @(spotAlloc)%; background-color: #810100;"></div>
                                </div>
                            </div>

                            <!-- Actions (Responsive Stacked Pills on Mobile, Inline on Desktop) -->
                            <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-3 spotlight-actions">
                                <button type="button" class="btn btn-roven-wine btn-lg px-3 px-sm-4 py-3 fw-bold rounded-pill shadow-sm d-inline-flex align-items-center justify-content-center gap-2 w-100 w-sm-auto" onclick="window.addStoreItemToCart(@deal.Id, 1, this)">
                                    <i class="fa-solid fa-bag-shopping"></i>
                                    <span>Claim Flacon &bull; Add to Bag</span>
                                </button>
                                <a asp-controller="Store" asp-action="Details" asp-route-id="@deal.Id" class="btn btn-lg px-3 px-sm-4 py-3 fw-semibold rounded-pill d-inline-flex align-items-center justify-content-center w-100 w-sm-auto" style="border: 1.5px solid #1B1717; color: #1B1717; background: transparent;">
                                    Full Olfactory Pyramid
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
}

<!-- ======================================================================== -->
<!-- 5. FEATURED LUXURY FRAGRANCES (Editor's Choice)                         -->
<!-- ======================================================================== -->
@if (Model.Settings?.ShowFeaturedSection != false)
{
<section class="py-5 overflow-hidden w-100" style="background-color: #FAF9F5;">
    <div class="container">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
            <div>
                <span class="badge badge-roven-cream px-3 py-1 rounded-pill fw-semibold mb-2 d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-crown" style="color: #630000;"></i>
                    <span>Master Distillations</span>
                </span>
                <h3 class="fw-extrabold mb-1" style="color: #1B1717;">Featured ROVEN Parfums</h3>
                <p class="mb-0 small" style="color: #6c6358;">Our most acclaimed fragrant creations formulated with precious Grasse and oriental oils</p>
            </div>
            <a asp-controller="Store" asp-action="Index" class="btn btn-sm fw-semibold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 align-self-start align-self-sm-auto" style="border: 1px solid #630000; color: #630000; background: transparent;">
                <span>Explore Full Collection</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="product-card shadow-sm" data-details-url="@Url.Action("Details", "Store", new { id = product.Id })">
                        <a asp-controller="Store" asp-action="Details" asp-route-id="@product.Id" class="product-image-container d-block position-relative text-decoration-none" style="background: #000;" title="عرض تفاصيل عطر @product.Name">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" decoding="async" onload="this.classList.add('loaded')" style="object-fit: cover; width: 100%; height: 100%;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-spray-can-sparkles display-4" style="color: #EDEBDD;"></i>
                            }

                            <!-- Badges -->
                            <div class="position-absolute top-0 end-0 m-2 d-flex flex-column gap-1">
                                <span class="badge badge-roven-burgundy shadow-sm"><i class="fa-solid fa-gem me-1" style="color: #EDEBDD;"></i>Featured</span>
                                @if (product.IsLowStock)
                                {
                                    <span class="badge badge-roven-cream">Only @product.StockQuantity flacons</span>
                                }
                            </div>
                        </a>

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small" style="color: #6c6358;">@product.CategoryName</span>
                                <div class="star-rating">
                                    <i class="fa-solid fa-star"></i>
                                    <span class="small ms-1" style="color: #6c6358;">4.9</span>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-1 line-clamp-2">
                                <a asp-controller="Store" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none" style="color: #1B1717;">
                                    @product.Name
                                </a>
                            </h6>
                            <div class="font-monospace small mb-3" style="color: #8c8374;">SKU: @product.Sku</div>

                            <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-color: #e8e3d5 !important;">
                                <div>
                                    <div class="small" style="font-size: 0.75rem; color: #6c6358;">Price</div>
                                    <div class="fw-bold fs-5" style="color: #630000;">
                                        @product.Price.ToString("N2") <span class="fs-6 fw-normal" style="color: #6c6358;">EGP</span>
                                    </div>
                                </div>

                                @if (product.IsOutOfStock)
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>Allocated</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-roven-wine btn-sm px-3 py-1 rounded-pill d-flex align-items-center gap-1 shadow-sm" onclick="window.addStoreItemToCart(@product.Id, 1, this)" title="Add to Bag">
                                        <i class="fa-solid fa-bag-shopping"></i> Add
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ======================================================================== -->
<!-- 6. BEST SELLERS & ACCLAIMED FLACONS                                     -->
<!-- ======================================================================== -->
@if ((Model.Settings?.ShowBestSellersSection != false) && Model.BestSellers.Any())
{
    <section class="py-5 bg-white border-top border-bottom overflow-hidden w-100" style="border-color: #e8e3d5 !important;">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
                <div>
                    <span class="badge badge-roven-crimson px-3 py-1 rounded-pill fw-semibold mb-2 d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire"></i>
                        <span>Most Requested</span>
                    </span>
                    <h3 class="fw-extrabold mb-1" style="color: #1B1717;">Top Acclaimed ROVEN Parfums</h3>
                    <p class="mb-0 small" style="color: #6c6358;">The fragrances most cherished by our clientele across Egypt this month</p>
                </div>
                <a asp-controller="Store" asp-action="Index" class="btn btn-sm fw-semibold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 align-self-start align-self-sm-auto" style="border: 1px solid #1B1717; color: #1B1717; background: transparent;">
                    <span>View All Best Sellers</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var product in Model.BestSellers)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
