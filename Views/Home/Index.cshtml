@if (Model.Settings?.ShowCategoriesShowcase != false)
{
<section class="py-5 overflow-hidden w-100" style="background-color: #FAF9F5;">
    <div class="container">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
            <div>
                <span class="badge badge-roven-cream px-3 py-1.5 rounded-pill fw-semibold mb-2 d-inline-flex align-items-center gap-2">
