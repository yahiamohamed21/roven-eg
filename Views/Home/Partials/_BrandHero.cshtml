@model Stockify.ViewModels.Store.StoreHomeViewModel

@if (Model.Settings?.ShowBrandHero ?? true)
{
    var desktopUrl = !string.IsNullOrWhiteSpace(Model.Settings?.BrandHeroDesktopImageUrl) 
        ? Model.Settings.BrandHeroDesktopImageUrl 
        : "/images/banners/roven-hero-main.png";
    var mobileUrl = !string.IsNullOrWhiteSpace(Model.Settings?.BrandHeroMobileImageUrl) 
        ? Model.Settings.BrandHeroMobileImageUrl 
        : "/images/banners/roven-hero-main-sm.png";
    var redirectLink = !string.IsNullOrWhiteSpace(Model.Settings?.BrandHeroRedirectLink) 
        ? Model.Settings.BrandHeroRedirectLink 
        : "/Store";
    var altText = !string.IsNullOrWhiteSpace(Model.Settings?.BrandHeroAltText) 
        ? Model.Settings.BrandHeroAltText 
        : "ROVEN FRAGRANCES — Your Safest Choice • Explore the Collection";

<!-- ======================================================================== -->
<!-- 1. DEDICATED MAIN BRAND HERO SECTION (Full-Bleed Ultra-HD Luxury Visual) -->
<!-- ======================================================================== -->
<section id="mainBrandHero" class="main-brand-hero-section w-100 p-0 m-0 overflow-hidden position-relative">
    <div class="main-brand-hero-wrapper w-100 p-0 m-0 position-relative overflow-hidden">
        <a href="@redirectLink" class="main-brand-hero-link d-block w-100 position-relative text-decoration-none" title="@altText">
            <picture class="main-brand-hero-picture d-block w-100">
                <!-- Mobile / Small Screens (<= 768px): Responsive Mobile Asset -->
                @if (mobileUrl.EndsWith("roven-hero-main-sm.png", StringComparison.OrdinalIgnoreCase))
                {
                    <source media="(max-width: 768px)" type="image/webp" srcset="/images/banners/roven-hero-main-sm.webp">
                }
                <source media="(max-width: 768px)" srcset="@mobileUrl">

                <!-- Desktop / Large Screens (>= 769px): Responsive Desktop Asset -->
                @if (desktopUrl.EndsWith("roven-hero-main.png", StringComparison.OrdinalIgnoreCase))
                {
                    <source media="(min-width: 769px)" type="image/webp" srcset="/images/banners/roven-hero-main.webp">
                }
                <source media="(min-width: 769px)" srcset="@desktopUrl">

                <!-- Fallback Image for Legacy Browsers / SEO Crawlers -->
                <img src="@desktopUrl" 
                     alt="@altText" 
                     class="main-brand-hero-image d-block w-100" 
                     width="1975"
                     height="796"
                     loading="eager" 
                     fetchpriority="high"
                     decoding="async" 
                     draggable="false" 
                     onerror="this.src='/images/banners/roven-hero-main.png'" />
            </picture>
        </a>
    </div>
</section>
}
