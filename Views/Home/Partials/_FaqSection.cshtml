@model Stockify.ViewModels.Store.StoreHomeViewModel
@if (Model.Settings?.ShowFaqSection != false)
{
    var faqItems = Model.FaqItems?.Where(f => f.IsActive).OrderBy(f => f.DisplayOrder).ThenBy(f => f.Id).ToList() ?? new List<Stockify.Models.Entities.HomeFaqItem>();

<section class="py-5 bg-white border-top border-bottom overflow-hidden w-100" style="border-color: #e8e3d5 !important;">
    <div class="container" style="max-width: 860px;">
        <div class="text-center mb-5">
            <span class="badge badge-roven-cream px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-gem" style="color: #630000;"></i>
                <span>@(string.IsNullOrWhiteSpace(Model.Settings?.FaqBadgeText) ? "Maison ROVEN Clarifications" : Model.Settings.FaqBadgeText)</span>
            </span>
            <h3 class="fw-extrabold mb-1" style="color: #1B1717;">
                @(string.IsNullOrWhiteSpace(Model.Settings?.FaqTitle) ? "Frequently Asked Questions" : Model.Settings.FaqTitle)
            </h3>
            <p class="small mb-0" style="color: #6c6358;">
                @(string.IsNullOrWhiteSpace(Model.Settings?.FaqSubtitle) ? "Everything you need to know about concentrations, parcel inspection, and authenticity" : Model.Settings.FaqSubtitle)
            </p>
        </div>

        <div class="accordion" id="homeFaqAccordion">
            @if (faqItems.Any())
            {
                for (int i = 0; i < faqItems.Count; i++)
                {
                    var faq = faqItems[i];
                    var collapseId = $"faq-collapse-{faq.Id}";
                    var headingId = $"faq-heading-{faq.Id}";
                    var isFirst = i == 0;
                    var iconClass = !string.IsNullOrWhiteSpace(faq.IconClass) ? faq.IconClass : "fa-solid fa-circle-question";

                    <div class="roven-faq-card">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button roven-faq-btn @(isFirst ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="@iconClass" style="color: #810100;"></i>
                                    <span>@faq.Question</span>
                                </span>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#homeFaqAccordion">
                            <div class="accordion-body roven-faq-body">
                                @Html.Raw(faq.Answer)
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback Default FAQs -->
                <div class="roven-faq-card">
                    <h2 class="accordion-header" id="faq-heading-1">
                        <button class="accordion-button roven-faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-1" aria-expanded="true" aria-controls="faq-collapse-1">
                            <span class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-droplet" style="color: #810100;"></i>
                                <span>What distinguishes an Extrait de Parfum from Eau de Parfum?</span>
                            </span>
                        </button>
                    </h2>
                    <div id="faq-collapse-1" class="accordion-collapse collapse show" aria-labelledby="faq-heading-1" data-bs-parent="#homeFaqAccordion">
                        <div class="accordion-body roven-faq-body">
                            ROVEN Extraits de Parfum contain <strong>30% or higher</strong> concentrations of pure perfume oil essences, offering an exceptionally rich and intimate sillage that endures for 24+ hours on fabrics and skin. Our Eaux de Parfum are concentrated at 20%, engineered for vibrant projection and refined daytime versatility.
                        </div>
                    </div>
                </div>

                <div class="roven-faq-card">
                    <h2 class="accordion-header" id="faq-heading-2">
                        <button class="accordion-button roven-faq-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-2" aria-expanded="false" aria-controls="faq-collapse-2">
                            <span class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-shield-halved" style="color: #630000;"></i>
                                <span>How does Cash on Delivery (COD) inspection work?</span>
                            </span>
                        </button>
                    </h2>
                    <div id="faq-collapse-2" class="accordion-collapse collapse" aria-labelledby="faq-heading-2" data-bs-parent="#homeFaqAccordion">
                        <div class="accordion-body roven-faq-body">
                            No online credit card is required. You can complete your order instantly as a guest without creating an account. When the courier arrives, you have the right to inspect the parcel seal and external luxury packaging condition before handing over the payment in Egyptian Pounds (EGP).
                        </div>
                    </div>
                </div>

                <div class="roven-faq-card">
                    <h2 class="accordion-header" id="faq-heading-3">
                        <button class="accordion-button roven-faq-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-3" aria-expanded="false" aria-controls="faq-collapse-3">
                            <span class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-truck-fast" style="color: #810100;"></i>
                                <span>What is the expected delivery timeframe?</span>
                            </span>
                        </button>
                    </h2>
                    <div id="faq-collapse-3" class="accordion-collapse collapse" aria-labelledby="faq-heading-3" data-bs-parent="#homeFaqAccordion">
                        <div class="accordion-body roven-faq-body">
                            Orders placed for Cairo and Giza are fulfilled within <strong>24 to 48 hours</strong>. Shipments to Alexandria, Delta, and Upper Egypt governorates are fulfilled within <strong>48 to 72 hours</strong> with real-time status updates and SMS notification.
                        </div>
                    </div>
                </div>

                <div class="roven-faq-card">
                    <h2 class="accordion-header" id="faq-heading-4">
                        <button class="accordion-button roven-faq-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-4" aria-expanded="false" aria-controls="faq-collapse-4">
                            <span class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-box-open" style="color: #630000;"></i>
                                <span>How can I track my fragrance delivery?</span>
                            </span>
                        </button>
                    </h2>
                    <div id="faq-collapse-4" class="accordion-collapse collapse" aria-labelledby="faq-heading-4" data-bs-parent="#homeFaqAccordion">
                        <div class="accordion-body roven-faq-body">
                            Upon order confirmation, you receive a distinct tracking reference number (e.g. <code>ORD-20261105-XXXX</code>). Visit the <a asp-controller="OrderTracking" asp-action="Index" style="color: #630000; font-weight: 700; text-decoration: underline;">Track Order</a> page anytime to view the live multi-stage dispatch timeline of your flacon.
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}