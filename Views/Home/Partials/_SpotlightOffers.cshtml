@model Stockify.ViewModels.Store.StoreHomeViewModel
@if (Model.Settings?.SpotlightActive != false && (Model.SpecialOffers.Any() || Model.DealOfTheDay != null))
{
    var offers = Model.SpecialOffers.Any() 
        ? Model.SpecialOffers.ToList() 
        : (Model.DealOfTheDay != null 
            ? new List<Stockify.ViewModels.Store.HomeOfferItemViewModel>
            {
                new()
                {
                    Id = 0,
                    ProductId = Model.DealOfTheDay.Id,
                    ProductName = Model.DealOfTheDay.Name,
                    Sku = Model.DealOfTheDay.Sku,
                    CategoryName = Model.DealOfTheDay.CategoryName ?? "Haute Parfumerie",
                    ImageUrl = Model.DealOfTheDay.ImageUrl,
                    Description = Model.DealOfTheDay.Description,
                    FirstProductPrice = Model.DealOfTheDay.Price,
                    OfferPrice = (Model.Settings?.SpotlightPrice > 0 ? Model.Settings.SpotlightPrice : Model.DealOfTheDay.Price),
                    Title = Model.DealOfTheDay.Name,
                    RemainingCount = Model.DealOfTheDay.StockQuantity,
                    AllocatedPercent = Model.Settings?.SpotlightAllocatedPercent ?? 82
                }
            } 
            : new List<Stockify.ViewModels.Store.HomeOfferItemViewModel>());

    if (offers.Any())
    {
        <style>
            .roven-spotlight-hero-card,
            .roven-spotlight-hero-card:hover,
            .roven-offer-slide-item,
            .roven-offer-slide-item:hover,
            .roven-offer-img-frame,
            .roven-offer-img-frame:hover {
                box-shadow: none !important;
                -webkit-box-shadow: none !important;
                transform: none !important;
            }
            .roven-spotlight-hero-card::before,
            .roven-spotlight-hero-card::after {
                display: none !important;
                content: none !important;
            }
        </style>

        <section id="homeSpotlightSection" class="py-5 w-100 position-relative overflow-hidden" style="background-color: #FFFFFF;">
            <div class="container position-relative">
                <!-- Section Header -->
                <div class="text-center mb-4 mb-md-5">
                    <span class="badge badge-roven-cream px-3 py-1.5 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire text-danger"></i>
                        <span>@(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightBadgeText) ? "EXCLUSIVE ATELIER OFFERS & DEALS" : Model.Settings.SpotlightBadgeText)</span>
                    </span>
                    <h2 class="fw-extrabold mb-2" style="font-family: 'Playfair Display', serif; color: #1B1717;">
                        @(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightTitle) ? "ROVEN OFFERS 🔥" : Model.Settings.SpotlightTitle)
                    </h2>
                    <p class="text-muted small mx-auto mb-0" style="max-width: 620px;">
                        @(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightSubtitle) ? "Discover the world of ROVEN through our new online store, where luxury meets elegance in every detail." : Model.Settings.SpotlightSubtitle)
                    </p>
                </div>

                <!-- Horizontal X-Axis Scrollable Track / Carousel -->
                <div class="roven-offers-carousel-wrap position-relative">
                    @if (offers.Count > 1)
                    {
                        <!-- Previous Navigation Button -->
                        <button type="button" class="roven-offers-nav-btn roven-offers-nav-prev d-none d-md-flex" onclick="rovenScrollTrack('rovenOffersTrack', -1)" aria-label="Previous Offer">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <!-- Next Navigation Button -->
                        <button type="button" class="roven-offers-nav-btn roven-offers-nav-next d-none d-md-flex" onclick="rovenScrollTrack('rovenOffersTrack', 1)" aria-label="Next Offer">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }

                    <div id="rovenOffersTrack" class="roven-offers-track d-flex overflow-auto" onscroll="rovenUpdateOfferDots()">
                        @for (int i = 0; i < offers.Count; i++)
                        {
                            var offer = offers[i];
                            var isDuo = offer.IsDuoOffer;
                            var discount = offer.DiscountPercent > 0 ? offer.DiscountPercent : (offer.OriginalPrice > offer.OfferPrice ? (int)Math.Round(((offer.OriginalPrice - offer.OfferPrice) / offer.OriginalPrice) * 100m) : 0);
                            var savings = Math.Max(0, offer.OriginalPrice - offer.OfferPrice);

                            <div class="roven-offer-slide-item">
                                <div class="roven-spotlight-hero-card">
                                    <div class="row g-4 g-lg-5 align-items-center">
                                        <!-- Left Column: Clean White Framed Image Box (الصوره في الشمال) -->
                                        <div class="col-12 col-lg-5">
                                            <div class="roven-offer-img-frame">
                                                @if (discount > 0)
                                                {
                                                    <span class="roven-offer-discount-badge position-absolute top-0 start-0 m-3">
                                                        @discount% OFF
                                                    </span>
                                                }

                                                @if (isDuo)
                                                {
                                                    <div class="d-flex align-items-center justify-content-center gap-2 w-100 h-100">
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-block text-center w-50" title="@offer.ProductName">
                                                            @if (!string.IsNullOrWhiteSpace(offer.ImageUrl))
                                                            {
                                                                <img src="@offer.ImageUrl" alt="@offer.ProductName" class="img-fluid" style="max-height: 290px; object-fit: contain;" />
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-solid fa-spray-can-sparkles display-4 text-muted"></i>
                                                            }
                                                        </a>
                                                        <span class="badge rounded-circle shadow-sm" style="background: #1B1717; color: #dfb15b; border: 1px solid rgba(223, 177, 91, 0.4); width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">+</span>
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.SecondProductId" class="d-block text-center w-50" title="@offer.SecondProductName">
                                                            @if (!string.IsNullOrWhiteSpace(offer.SecondProductImageUrl))
                                                            {
                                                                <img src="@offer.SecondProductImageUrl" alt="@offer.SecondProductName" class="img-fluid" style="max-height: 290px; object-fit: contain;" />
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-solid fa-spray-can-sparkles display-4 text-muted"></i>
                                                            }
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-flex align-items-center justify-content-center w-100 h-100 text-decoration-none" title="@offer.ProductName">
                                                        @if (!string.IsNullOrWhiteSpace(offer.ImageUrl))
                                                        {
                                                            <img src="@offer.ImageUrl" alt="@offer.ProductName" class="img-fluid" style="max-height: 330px; object-fit: contain;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="text-center py-5">
                                                                <i class="fa-solid fa-spray-can-sparkles display-2" style="color: #630000; opacity: 0.7;"></i>
                                                                <div class="text-muted small mt-2 fw-semibold">ROVEN Haute Parfumerie</div>
                                                            </div>
                                                        }
                                                    </a>
                                                }
                                            </div>
                                        </div>

                                        <!-- Right Column: Typography & Offer Action (الكلام في اليمين) -->
                                        <div class="col-12 col-lg-7">
                                            <div class="ps-lg-3">
                                                <!-- Subtitle -->
                                                <div class="roven-offer-subtitle">
                                                    @(string.IsNullOrWhiteSpace(offer.BadgeText) ? (isDuo ? "DUO BUNDLE • 2x FLACONS" : $"{offer.CategoryName} • EXCLUSIVE OFFER") : offer.BadgeText)
                                                </div>

                                                <!-- Big Title -->
                                                <h3 class="roven-offer-title">
                                                    @offer.DisplayTitle
                                                </h3>

                                                <!-- Description -->
                                                <p class="roven-offer-desc">
                                                    @(string.IsNullOrWhiteSpace(offer.Description) ? "Experience the pinnacle of haute perfumerie. Handcrafted with rare Grasse botanicals, pure oriental oils, and eternal sillage." : offer.Description)
                                                </p>

                                                <!-- Fragrance / Feature Pills -->
                                                <div class="d-flex flex-wrap gap-2 mb-4">
                                                    @if (isDuo)
                                                    {
                                                        <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.ProductName</span>
                                                        <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.SecondProductName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.CategoryName</span>
                                                    }
                                                    <span class="roven-offer-pill">Extrait de Parfum</span>
                                                    <span class="roven-offer-pill">30% Pure Concentration</span>
                                                    <span class="roven-offer-pill">Cash on Delivery</span>
                                                    <span class="roven-offer-pill">Free Inspection on Delivery</span>
                                                </div>

                                                <!-- Price and Savings Row -->
                                                <div class="d-flex flex-wrap align-items-baseline gap-3 mb-4">
                                                    <div class="roven-offer-price-main">
                                                        <span>LE</span> @offer.OfferPrice.ToString("N0")
                                                    </div>
                                                    @if (offer.OriginalPrice > offer.OfferPrice)
                                                    {
                                                        <div class="roven-offer-price-old">
                                                            <span>LE</span> @offer.OriginalPrice.ToString("N0")
                                                        </div>
                                                        <div class="roven-offer-savings">
                                                            You save LE @savings.ToString("N0")
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                                    @if (offer.Id > 0)
                                                    {
                                                        <button type="button" class="roven-offer-shop-btn" onclick="window.addOfferToCart(@offer.Id, this)">
                                                            <span>@(isDuo ? "SHOP THE BUNDLE" : "SHOP THE SET")</span>
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="roven-offer-shop-btn" onclick="window.addStoreItemToCart(@offer.ProductId, 1, this)">
                                                            <span>SHOP THE SET</span>
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </button>
                                                    }

                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="roven-offer-details-link" title="View Fragrance Details">
                                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (offers.Count > 1)
                    {
                        <!-- Indicator Dots -->
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-4" id="rovenOfferDotsWrap">
                            @for (int i = 0; i < offers.Count; i++)
                            {
                                var dotIdx = i;
                                <button type="button" class="roven-offers-dot @(dotIdx == 0 ? "active" : "")" onclick="rovenScrollToOffer(@dotIdx)" aria-label="Go to offer @(dotIdx + 1)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <script>
            function rovenScrollTrack(trackId, direction) {
                var track = document.getElementById(trackId);
                if (!track) return;
                var step = track.clientWidth || 400;
                track.scrollBy({ left: direction * step, behavior: 'smooth' });
            }

            function rovenScrollToOffer(index) {
                var track = document.getElementById('rovenOffersTrack');
                if (!track) return;
                track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
                updateOfferDotsActive(index);
            }

            function rovenUpdateOfferDots() {
                var track = document.getElementById('rovenOffersTrack');
                if (!track || track.clientWidth <= 0) return;
                var index = Math.round(track.scrollLeft / track.clientWidth);
                updateOfferDotsActive(index);
            }

            function updateOfferDotsActive(index) {
                var dots = document.querySelectorAll('#rovenOfferDotsWrap .roven-offers-dot');
                dots.forEach(function (dot, i) {
                    if (i === index) {
                        dot.classList.add('active');
                    } else {
                        dot.classList.remove('active');
                    }
                });
            }
        </script>
    }
}
