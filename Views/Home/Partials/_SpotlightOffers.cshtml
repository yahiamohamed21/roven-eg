        <section id="homeSpotlightSection" class="roven-spotlight-section py-5 w-100 position-relative overflow-hidden" style="background-color: #FFFFFF;">
            <div class="container position-relative">
                <!-- Section Header -->
                <div class="text-center mb-4 mb-md-5">
                    <span class="badge roven-spotlight-badge px-3 py-1.5 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-fire text-danger"></i>
                        <span>@(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightBadgeText) ? "EXCLUSIVE ATELIER OFFERS & DEALS" : Model.Settings.SpotlightBadgeText)</span>
                    </span>
                    <h2 class="fw-extrabold mb-2 roven-spotlight-heading" style="font-family: 'Playfair Display', serif; color: #1B1717;">
                        @(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightTitle) ? "ROVEN OFFERS 🔥" : Model.Settings.SpotlightTitle)
                    </h2>
                    <p class="roven-spotlight-sub small mx-auto mb-0" style="max-width: 620px; color: #6c6358;">
                        @(string.IsNullOrWhiteSpace(Model.Settings?.SpotlightSubtitle) ? "Discover the world of ROVEN through our new online store, where luxury meets elegance in every detail." : Model.Settings.SpotlightSubtitle)
                    </p>
                </div>

                <!-- Horizontal X-Axis Scrollable Track / Carousel -->
                <div class="roven-offers-carousel-wrap position-relative">
                    @if (offers.Count > 1)
                    {
                        <!-- Previous Navigation Button -->
                        <button type="button" class="roven-offers-nav-btn roven-offers-nav-prev d-none d-md-flex" onclick="rovenScrollTrack('rovenOffersTrack', -1)" aria-label="Previous Offer">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <!-- Next Navigation Button -->
                        <button type="button" class="roven-offers-nav-btn roven-offers-nav-next d-none d-md-flex" onclick="rovenScrollTrack('rovenOffersTrack', 1)" aria-label="Next Offer">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }

                    <div id="rovenOffersTrack" class="roven-offers-track d-flex overflow-auto" onscroll="rovenUpdateOfferDots()">
                        @for (int i = 0; i < offers.Count; i++)
                        {
                            var offer = offers[i];
                            var isTrio = offer.IsTrioOffer;
                            var isDuo = offer.IsDuoOffer;
                            var isMulti = offer.IsMultiOffer;
                            var discount = offer.DiscountPercent > 0 ? offer.DiscountPercent : (offer.OriginalPrice > offer.OfferPrice ? (int)Math.Round(((offer.OriginalPrice - offer.OfferPrice) / offer.OriginalPrice) * 100m) : 0);
                            var savings = Math.Max(0, offer.OriginalPrice - offer.OfferPrice);
                            var isStarProduct = (offer.DisplayTitle?.Contains("STAR", StringComparison.OrdinalIgnoreCase) == true ||
                                                 offer.ProductName?.Contains("STAR", StringComparison.OrdinalIgnoreCase) == true);
                            var effectiveImg = !string.IsNullOrWhiteSpace(offer.CustomImageUrl) ? offer.CustomImageUrl : (offer.ImageUrl ?? "");
                            if (isStarProduct && (string.IsNullOrWhiteSpace(effectiveImg) || effectiveImg.Contains("653512e607aa40008b9c03356653409f")))
                            {
                                effectiveImg = "/roven/products/star_master_offer.webp";
                            }

                            <div class="roven-offer-slide-item">
                                <div class="roven-spotlight-hero-card">
                                    <div class="row g-4 g-lg-5 align-items-center">
                                        <!-- Left Column: Clean Framed Image Box (الصوره في الشمال) -->
                                        <div class="col-12 col-lg-5">
                                            <div class="roven-offer-img-frame">
                                                @if (discount > 0)
                                                {
                                                    <span class="roven-offer-discount-badge position-absolute top-0 start-0 m-2 m-md-3">
                                                        @discount% OFF
                                                    </span>
                                                }

                                                @if (isTrio)
                                                {
                                                    <span class="roven-offer-duo-badge position-absolute top-0 end-0 m-2 m-md-3">
                                                        3x FLACONS
                                                    </span>
                                                }
                                                else if (isDuo)
                                                {
                                                    <span class="roven-offer-duo-badge position-absolute top-0 end-0 m-2 m-md-3">
                                                        2x FLACONS
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(offer.CustomImageUrl))
                                                {
                                                    <!-- Custom Combined Photo / Graphic -->
                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-flex align-items-center justify-content-center w-100 h-100 text-decoration-none" title="@offer.DisplayTitle">
                                                        <img src="@offer.CustomImageUrl" alt="@offer.DisplayTitle" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                    </a>
                                                }
                                                else if (isTrio)
                                                {
                                                    <!-- 3-Perfume Luxury Trio Stage -->
                                                    <div class="roven-offer-multi-stage trio-stage">
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="roven-multi-bottle-tile" title="@offer.ProductName">
                                                            <img src="@(string.IsNullOrWhiteSpace(offer.ImageUrl) ? "/roven/products/star_master_offer.webp" : offer.ImageUrl)" alt="@offer.ProductName" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                            <span class="roven-duo-bottle-label">@offer.ProductName</span>
                                                        </a>
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.SecondProductId" class="roven-multi-bottle-tile" title="@offer.SecondProductName">
                                                            <img src="@(string.IsNullOrWhiteSpace(offer.SecondProductImageUrl) ? "/roven/products/star_master_offer.webp" : offer.SecondProductImageUrl)" alt="@offer.SecondProductName" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                            <span class="roven-duo-bottle-label">@offer.SecondProductName</span>
                                                        </a>
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ThirdProductId" class="roven-multi-bottle-tile" title="@offer.ThirdProductName">
                                                            <img src="@(string.IsNullOrWhiteSpace(offer.ThirdProductImageUrl) ? "/roven/products/star_master_offer.webp" : offer.ThirdProductImageUrl)" alt="@offer.ThirdProductName" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                            <span class="roven-duo-bottle-label">@offer.ThirdProductName</span>
                                                        </a>
                                                    </div>
                                                }
                                                else if (isDuo)
                                                {
                                                    <!-- 2-Perfume Luxury Duo Stage -->
                                                    <div class="roven-offer-multi-stage duo-stage">
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="roven-multi-bottle-tile" title="@offer.ProductName">
                                                            <img src="@(string.IsNullOrWhiteSpace(offer.ImageUrl) ? "/roven/products/star_master_offer.webp" : offer.ImageUrl)" alt="@offer.ProductName" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                            <span class="roven-duo-bottle-label">@offer.ProductName</span>
                                                        </a>
                                                        <div class="roven-duo-connector-badge">
                                                            <i class="fa-solid fa-plus"></i>
                                                        </div>
                                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.SecondProductId" class="roven-multi-bottle-tile" title="@offer.SecondProductName">
                                                            <img src="@(string.IsNullOrWhiteSpace(offer.SecondProductImageUrl) ? "/roven/products/star_master_offer.webp" : offer.SecondProductImageUrl)" alt="@offer.SecondProductName" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                            <span class="roven-duo-bottle-label">@offer.SecondProductName</span>
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- Single Product Showcase -->
                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="d-flex align-items-center justify-content-center w-100 h-100 text-decoration-none" title="@offer.DisplayTitle">
                                                        @if (!string.IsNullOrWhiteSpace(effectiveImg))
                                                        {
                                                            <img src="@effectiveImg" alt="@offer.DisplayTitle" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/roven/products/star_master_offer.webp';" />
                                                        }
                                                        else
                                                        {
                                                            <div class="text-center py-5">
                                                                <i class="fa-solid fa-spray-can-sparkles display-2" style="color: #dfb15b; opacity: 0.8;"></i>
                                                                <div class="small mt-2 fw-semibold" style="color: #dfb15b;">ROVEN Haute Parfumerie</div>
                                                            </div>
                                                        }
                                                    </a>
                                                }
                                            </div>
                                        </div>

                                        <!-- Right Column: Typography & Offer Action (الكلام في اليمين) -->
                                        <div class="col-12 col-lg-7">
                                            <div class="ps-lg-3">
                                                <!-- Subtitle -->
                                                <div class="roven-offer-subtitle">
                                                    @(string.IsNullOrWhiteSpace(offer.BadgeText) ? (isTrio ? "TRIO BUNDLE • باقة 3 عطور" : (isDuo ? "DUO BUNDLE • باقة عطرين" : $"{offer.CategoryName} • EXCLUSIVE OFFER")) : offer.BadgeText)
                                                </div>

                                                <!-- Big Title -->
                                                <h3 class="roven-offer-title">
                                                    @offer.DisplayTitle
                                                </h3>

                                                <!-- Description -->
                                                <p class="roven-offer-desc">
                                                    @(string.IsNullOrWhiteSpace(offer.EffectiveDescription) ? (isMulti ? "Exclusive luxury fragrance bundle handcrafted with rare Grasse botanicals, pure oriental oils, and eternal sillage." : "Experience the pinnacle of haute perfumerie. Handcrafted with rare Grasse botanicals, pure oriental oils, and eternal sillage.") : offer.EffectiveDescription)
                                                </p>

                                                <!-- Fragrance / Feature Pills -->
                                                <div class="roven-offer-pills-wrap d-flex flex-wrap gap-2 mb-4">
                                                    @if (offer.FeaturePillsList.Any())
                                                    {
                                                        @foreach (var pill in offer.FeaturePillsList)
                                                        {
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @pill</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (isTrio)
                                                        {
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.ProductName</span>
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.SecondProductName</span>
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.ThirdProductName</span>
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-layer-group me-1 text-gold"></i> 3x Flacons Set</span>
                                                        }
                                                        else if (isDuo)
                                                        {
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.ProductName</span>
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.SecondProductName</span>
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-layer-group me-1 text-gold"></i> 2x Flacons Bundle</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="roven-offer-pill"><i class="fa-solid fa-gem me-1 text-gold"></i> @offer.CategoryName</span>
                                                        }
                                                        <span class="roven-offer-pill">Extrait de Parfum</span>
                                                        <span class="roven-offer-pill">30% Pure Concentration</span>
                                                        <span class="roven-offer-pill">Cash on Delivery</span>
                                                        <span class="roven-offer-pill">Free Inspection on Delivery</span>
                                                    }
                                                </div>

                                                <!-- Price and Savings Row -->
                                                <div class="roven-offer-price-row d-flex flex-wrap align-items-baseline gap-3 mb-4">
                                                    <div class="roven-offer-price-main">
                                                        <span>LE</span> @offer.OfferPrice.ToString("N0")
                                                    </div>
                                                    @if (offer.OriginalPrice > offer.OfferPrice)
                                                    {
                                                        <div class="roven-offer-price-old">
                                                            <span>LE</span> @offer.OriginalPrice.ToString("N0")
                                                        </div>
                                                        <div class="roven-offer-savings">
                                                            You save LE @savings.ToString("N0")
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="roven-offer-actions-wrap d-flex align-items-center gap-3 flex-wrap">
                                                    @if (offer.Id > 0)
                                                    {
                                                        <button type="button" class="roven-offer-shop-btn" onclick="window.addOfferToCart(@offer.Id, this)">
                                                            <span>@offer.EffectiveButtonText</span>
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="roven-offer-shop-btn" onclick="window.addStoreItemToCart(@offer.ProductId, 1, this)">
                                                            <span>@offer.EffectiveButtonText</span>
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </button>
                                                    }

                                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@offer.ProductId" class="roven-offer-details-link" title="View Fragrance Details">
                                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (offers.Count > 1)
                    {
                        <!-- Indicator Dots -->
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-4" id="rovenOfferDotsWrap">
                            @for (int i = 0; i < offers.Count; i++)
                            {
                                var dotIdx = i;
                                <button type="button" class="roven-offers-dot @(dotIdx == 0 ? "active" : "")" onclick="rovenScrollToOffer(@dotIdx)" aria-label="Go to offer @(dotIdx + 1)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <script>
            function rovenScrollTrack(trackId, direction) {
                var track = document.getElementById(trackId);
                if (!track) return;
                var step = track.clientWidth || 400;
                track.scrollBy({ left: direction * step, behavior: 'smooth' });
            }

            function rovenScrollToOffer(index) {
                var track = document.getElementById('rovenOffersTrack');
                if (!track) return;
                track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
                updateOfferDotsActive(index);
            }

            function rovenUpdateOfferDots() {
                var track = document.getElementById('rovenOffersTrack');
                if (!track || track.clientWidth <= 0) return;
                var index = Math.round(track.scrollLeft / track.clientWidth);
                updateOfferDotsActive(index);
            }

            function updateOfferDotsActive(index) {
                var dots = document.querySelectorAll('#rovenOfferDotsWrap .roven-offers-dot');
                dots.forEach(function (dot, i) {
                    if (i === index) {
                        dot.classList.add('active');
                    } else {
                        dot.classList.remove('active');
                    }
                });
            }
        </script>
    }
}
