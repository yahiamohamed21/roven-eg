@model Stockify.ViewModels.Store.StoreHomeViewModel

<!-- ======================================================================== -->
<!-- 0. CINEMATIC SCROLL FRAME EXPERIENCE SECTION (Pre-Hero Luxury Sequence)  -->
<!-- ======================================================================== -->
<section id="rovenCinematicSection" class="roven-cinematic-scroll-section" aria-label="Cinematic Perfume Experience">
    <div id="rovenCinematicTrack" class="roven-cinematic-track">
        <div class="roven-cinematic-sticky">
            <!-- Luxury Interactive Canvas -->
            <canvas id="rovenCinematicCanvas" class="roven-cinematic-canvas"></canvas>

            <!-- Vignette & Dark Contrast Gradient Overlays -->
            <div class="roven-cinematic-vignette"></div>

            <!-- Overlaid Narrative Content (Visible at start, fades completely upon scroll) -->
            <div class="roven-cinematic-overlay-content">
                <div class="roven-cinema-text-stage active" id="cinemaStageIntro">
                    <div class="roven-cinema-stage-top">
                        <span class="roven-cinema-badge">
                            <i class="fa-solid fa-crown me-1"></i> MAISON ROVEN &bull; HAUTE PARFUMERIE
                        </span>
                        <h1 class="roven-cinema-headline">L'Art de l'Extrait</h1>
                    </div>
                    <div class="roven-cinema-stage-bottom">
                        <p class="roven-cinema-subheadline">30% Pure Oil Concentration &bull; Cold-Matured Perfection</p>
                        <div class="roven-cinema-scroll-hint" id="rovenScrollHint" role="button" tabindex="0" aria-label="Scroll to discover">
                            <div class="roven-scroll-pill-wrap">
                                <div class="roven-essence-capsule">
                                    <div class="roven-essence-droplet"></div>
                                </div>
                                <div class="roven-scroll-labels">
                                    <span class="roven-scroll-ar">اسحب للاكتشاف</span>
                                    <span class="roven-scroll-en">SCROLL TO UNVEIL</span>
                                </div>
                                <div class="roven-scroll-chevrons">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>