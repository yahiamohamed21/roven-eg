@model Stockify.ViewModels.Store.StoreHomeViewModel

@if (Model.Settings?.ShowTestimonialsSection ?? true)
{
    var hasDynamicReviews = Model.FeaturedReviews != null && Model.FeaturedReviews.Any();

    <section class="py-5 overflow-hidden w-100" style="background-color: #FAF9F5;">
        <div class="container position-relative">
            <div class="text-center mb-5">
                <span class="badge badge-roven-cream px-3 py-1.5 rounded-pill fw-semibold mb-2 d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-gem" style="color: #810100;"></i>
                    <span>Cherished Across Egypt</span>
                </span>
                <h3 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', serif; font-size: clamp(1.45rem, 2.8vw, 2.1rem);">Words From ROVEN Patrons</h3>
                <p class="small mb-0" style="color: #6c6358;">Over @Model.TotalCustomersCount+ discerning fragrance collectors rely on ROVEN Parfums</p>
            </div>

            <!-- Horizontal X-Axis Scroll Carousel Track for Testimonials -->
            <div class="roven-testimonials-carousel-wrap position-relative">
                <!-- Navigation Arrow Controls for Desktop / Tablet -->
                <button type="button" class="roven-testimonials-nav-btn roven-testimonials-nav-prev d-none d-md-flex" onclick="rovenScrollTrack('rovenTestimonialsTrack', -1)" aria-label="Previous reviews">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="roven-testimonials-nav-btn roven-testimonials-nav-next d-none d-md-flex" onclick="rovenScrollTrack('rovenTestimonialsTrack', 1)" aria-label="Next reviews">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                <!-- Scrollable Track (Swipeable in X-Axis) -->
                <div id="rovenTestimonialsTrack" class="roven-testimonials-track d-flex overflow-auto pb-3">
                    @if (hasDynamicReviews)
                    {
                        var avatarColors = new[] { "#810100", "#630000", "#1B1717", "#731818", "#4a0e0e" };
                        int colorIdx = 0;

                        foreach (var rev in Model.FeaturedReviews!)
                        {
                            var avatarBg = avatarColors[colorIdx % avatarColors.Length];
                            colorIdx++;

                            // Calculate customer initials
                            string initials = "RP";
                            if (!string.IsNullOrWhiteSpace(rev.CustomerName))
                            {
                                var parts = rev.CustomerName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                if (parts.Length >= 2)
                                {
                                    initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                                }
                                else if (parts[0].Length >= 2)
                                {
                                    initials = parts[0].Substring(0, 2).ToUpper();
                                }
                                else
                                {
                                    initials = parts[0].ToUpper();
                                }
                            }

                            <div class="roven-testimonial-track-item">
                                <div class="card testimonial-card border-0 shadow-sm p-4 h-100 rounded-4 bg-white d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="star-rating" style="color: #810100; letter-spacing: 2px;">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <i class="fa-solid fa-star @(s <= rev.Rating ? "" : "text-muted opacity-25")"></i>
                                            }
                                        </div>
                                        <span class="badge rounded-pill fw-semibold font-monospace" style="background: rgba(129, 1, 0, 0.06); color: #810100; font-size: 0.72rem; padding: 4px 8px;">
                                            <i class="fa-solid fa-certificate me-1"></i>VERIFIED PATRON
                                        </span>
                                    </div>

                                    <p class="small mb-4 flex-grow-1" style="color: #595252; line-height: 1.65; font-style: italic;">
                                        "@rev.Comment"
                                    </p>

                                    <div class="d-flex align-items-center gap-3 pt-3 border-top mt-auto" style="border-color: #f0ece3 !important;">
                                        <div class="rounded-circle fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 42px; height: 42px; background-color: @avatarBg; color: #EDEBDD; font-size: 0.9rem; letter-spacing: 0.5px;">
                                            @initials
                                        </div>
                                        <div class="flex-grow-1 min-w-0" style="min-width: 0;">
                                            <div class="fw-bold small text-truncate" style="color: #1B1717;">@rev.CustomerName</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">Verified Fragrance Collector</div>
                                        </div>
                                    </div>

                                    @if (rev.Product != null)
                                    {
                                        <a asp-controller="Store"
                                           asp-action="Details"
                                           asp-route-id="@rev.Product.Id"
                                           class="d-flex align-items-center gap-2.5 mt-3 p-2 rounded-3 text-decoration-none"
                                           style="background: #faf8f4; border: 1px solid #e8dfd0; transition: all 0.2s ease;"
                                           onmouseover="this.style.borderColor='#810100'; this.style.background='#f5efe6';"
                                           onmouseout="this.style.borderColor='#e8dfd0'; this.style.background='#faf8f4';"
                                           title="View @rev.Product.Name">
                                            <div class="rounded-2 overflow-hidden flex-shrink-0 d-flex align-items-center justify-content-center bg-white border" style="width: 42px; height: 42px; border-color: #ece4d6 !important;">
                                                @if (!string.IsNullOrWhiteSpace(rev.Product.ImageUrl))
                                                {
                                                    <img src="@rev.Product.ImageUrl" alt="@rev.Product.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none';" />
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-spray-can-sparkles" style="color: #810100; font-size: 0.95rem;"></i>
                                                }
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="text-uppercase fw-semibold" style="font-size: 0.62rem; color: #8c7e6d; letter-spacing: 0.6px;">Reviewed Perfume</div>
                                                <div class="fw-bold text-truncate" style="font-size: 0.82rem; color: #1B1717;">@rev.Product.Name</div>
                                            </div>
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; background: rgba(129, 1, 0, 0.08); color: #810100; font-size: 0.7rem;">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        var curatedFallbacks = new[]
                        {
                            new { Initials = "AM", Bg = "#630000", Customer = "Ahmed Mansour", Comment = "Simply hypnotic! The scent trail lasts well past 24 hours on clothes. Delivery to New Cairo was immaculate and paying Cash on Delivery was seamless." },
                            new { Initials = "ME", Bg = "#810100", Customer = "Mona El-Shennawy", Comment = "Genuine depth without harsh synthetic sharpness. The presentation box and atomizers are true works of art. ROVEN is in a class of its own." },
                            new { Initials = "TZ", Bg = "#1B1717", Customer = "Tarek Zaki", Comment = "Testing the fragrances before selecting my signature bottle made all the difference. The order arrived the very next afternoon in Sheikh Zayed." }
                        };
                        var fallbackProducts = (Model.BestSellers ?? Enumerable.Empty<Stockify.ViewModels.Store.StoreProductCardViewModel>())
                            .Concat(Model.FeaturedProducts ?? Enumerable.Empty<Stockify.ViewModels.Store.StoreProductCardViewModel>())
                            .Concat(Model.LatestProducts ?? Enumerable.Empty<Stockify.ViewModels.Store.StoreProductCardViewModel>())
                            .GroupBy(p => p.Id)
                            .Select(g => g.First())
                            .Take(3)
                            .ToList();

                        for (int idx = 0; idx < curatedFallbacks.Length; idx++)
                        {
                            var item = curatedFallbacks[idx];
                            var linkedProd = idx < fallbackProducts.Count ? fallbackProducts[idx] : null;
                            <div class="roven-testimonial-track-item">
                                <div class="card testimonial-card border-0 shadow-sm p-4 h-100 rounded-4 bg-white d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="star-rating" style="color: #810100; letter-spacing: 2px;">
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                        </div>
                                        <span class="badge rounded-pill fw-semibold font-monospace" style="background: rgba(129, 1, 0, 0.06); color: #810100; font-size: 0.72rem; padding: 4px 8px;">
                                            <i class="fa-solid fa-certificate me-1"></i>VERIFIED PATRON
                                        </span>
                                    </div>
                                    <p class="small mb-4 flex-grow-1" style="color: #595252; line-height: 1.65; font-style: italic;">
                                        "@item.Comment"
                                    </p>
                                    <div class="d-flex align-items-center gap-3 pt-3 border-top mt-auto" style="border-color: #f0ece3 !important;">
                                        <div class="rounded-circle fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 42px; height: 42px; background-color: @item.Bg; color: #EDEBDD;">
                                            @item.Initials
                                        </div>
                                        <div class="flex-grow-1 min-w-0" style="min-width: 0;">
                                            <div class="fw-bold small text-truncate" style="color: #1B1717;">@item.Customer</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">Verified Fragrance Collector</div>
                                        </div>
                                    </div>
                                    @if (linkedProd != null)
                                    {
                                        <a asp-controller="Store"
                                           asp-action="Details"
                                           asp-route-id="@linkedProd.Id"
                                           class="d-flex align-items-center gap-2.5 mt-3 p-2 rounded-3 text-decoration-none"
                                           style="background: #faf8f4; border: 1px solid #e8dfd0; transition: all 0.2s ease;"
                                           onmouseover="this.style.borderColor='#810100'; this.style.background='#f5efe6';"
                                           onmouseout="this.style.borderColor='#e8dfd0'; this.style.background='#faf8f4';"
                                           title="View @linkedProd.Name">
                                            <div class="rounded-2 overflow-hidden flex-shrink-0 d-flex align-items-center justify-content-center bg-white border" style="width: 42px; height: 42px; border-color: #ece4d6 !important;">
                                                @if (!string.IsNullOrWhiteSpace(linkedProd.ImageUrl))
                                                {
                                                    <img src="@linkedProd.ImageUrl" alt="@linkedProd.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none';" />
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-spray-can-sparkles" style="color: #810100; font-size: 0.95rem;"></i>
                                                }
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="text-uppercase fw-semibold" style="font-size: 0.62rem; color: #8c7e6d; letter-spacing: 0.6px;">Reviewed Perfume</div>
                                                <div class="fw-bold text-truncate" style="font-size: 0.82rem; color: #1B1717;">@linkedProd.Name</div>
                                            </div>
                                            <span class="rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; background: rgba(129, 1, 0, 0.08); color: #810100; font-size: 0.7rem;">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
}
