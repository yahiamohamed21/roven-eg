@model Stockify.ViewModels.Store.StoreHomeViewModel
@{
    var settings = Model.Settings;
    if (settings != null && (!settings.ComparisonActive || !settings.ShowComparisonSection))
    {
        return;
    }

    var badgeText = !string.IsNullOrWhiteSpace(settings?.ComparisonBadgeText) 
        ? settings.ComparisonBadgeText 
        : "MAISON ROVEN • QUALITY PROMISE";

    var title = !string.IsNullOrWhiteSpace(settings?.ComparisonTitle) 
        ? settings.ComparisonTitle 
        : "US VS THEM";

    var subtitle = !string.IsNullOrWhiteSpace(settings?.ComparisonSubtitle) 
        ? settings.ComparisonSubtitle 
        : "Why settle for the brand name when you can wear the same scent for a fraction of the price?";

    var buttonText = !string.IsNullOrWhiteSpace(settings?.ComparisonButtonText) 
        ? settings.ComparisonButtonText 
        : "Shop Now";

    var buttonLink = !string.IsNullOrWhiteSpace(settings?.ComparisonButtonLink) 
        ? settings.ComparisonButtonLink 
        : "/Store";

    var beforeLabel = !string.IsNullOrWhiteSpace(settings?.ComparisonBeforeLabel) 
        ? settings.ComparisonBeforeLabel 
        : "Before";

    var afterLabel = !string.IsNullOrWhiteSpace(settings?.ComparisonAfterLabel) 
        ? settings.ComparisonAfterLabel 
        : "After";

    var beforeImage = !string.IsNullOrWhiteSpace(settings?.ComparisonBeforeImageUrl) 
        ? settings.ComparisonBeforeImageUrl 
        : "/images/comparison/roven-comparison-before.svg";

    var afterImage = !string.IsNullOrWhiteSpace(settings?.ComparisonAfterImageUrl) 
        ? settings.ComparisonAfterImageUrl 
        : "/images/comparison/roven-comparison-after.svg";
}

<!-- ======================================================================== -->
<!-- MAISON ROVEN HAUTE PARFUMERIE COMPARISON SHOWCASE (US VS THEM)           -->
<!-- ======================================================================== -->
<section id="homeComparisonSection" class="roven-compare-section position-relative">
    <!-- Ambient Radial Glows -->
    <div class="roven-compare-ambient-glow" aria-hidden="true"></div>
    <div class="roven-compare-ambient-glow-secondary" aria-hidden="true"></div>

    <div class="container px-3 px-md-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-4 g-xl-5">
            
            <!-- Left Column: Editorial & Quality Value Props (order-2 on mobile, order-1 on desktop) -->
            <div class="col-12 col-lg-5 text-center text-lg-start order-2 order-lg-1">
                <div class="roven-compare-editorial pe-lg-2">
                    
                    <!-- Editorial Haute Headline: US VS THEM -->
                    <h2 class="roven-compare-title mb-3">
                        @if (title.Trim().Equals("US VS THEM", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="roven-title-us">US</span>
                            <span class="roven-title-vs-pill">VS</span>
                            <span class="roven-title-them">THEM</span>
                        }
                        else
                        {
                            <span>@title</span>
                        }
                    </h2>

                    <!-- Decorative Gold Flourish Divider -->
                    <div class="roven-editorial-flourish mb-4 d-flex align-items-center justify-content-center justify-content-lg-start gap-2">
                        <span class="flourish-line"></span>
                        <span class="flourish-gem">◈</span>
                        <span class="flourish-line-long"></span>
                    </div>

                    <!-- Narrative Subtitle -->
                    <p class="roven-compare-subtitle mb-4 pb-2">
                        @subtitle
                    </p>

                    <!-- Atelier Quality Signatures (3 Refined Luxury Plaque Cards) -->
                    <div class="roven-compare-features d-flex flex-column gap-3 mb-4 pb-2 text-start">
                        
                        <!-- Signature 1: Concentration -->
                        <div class="roven-feature-card d-flex align-items-center gap-3">
                            <div class="roven-feature-icon-box flex-shrink-0">
                                <i class="fa-solid fa-droplet"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="roven-feature-name">Extrait de Parfum (30% Concentration)</div>
                                <div class="roven-feature-desc">أعلى تركيز زيوت عطرية نقية معتمدة لثبات وفوحان فائق</div>
                            </div>
                            <div class="roven-feature-metric flex-shrink-0 d-flex flex-column text-end">
                                <span class="metric-val">30%</span>
                                <span class="metric-lbl">Pure</span>
                            </div>
                        </div>

                        <!-- Signature 2: Longevity -->
                        <div class="roven-feature-card d-flex align-items-center gap-3">
                            <div class="roven-feature-icon-box flex-shrink-0">
                                <i class="fa-solid fa-hourglass-half"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="roven-feature-name">24+ Hours Royal Longevity &amp; Sillage</div>
                                <div class="roven-feature-desc">ثبات وفوحان ملكي يدوم أكثر من 24 ساعة على الملابس</div>
                            </div>
                            <div class="roven-feature-metric flex-shrink-0 d-flex flex-column text-end">
                                <span class="metric-val">24h+</span>
                                <span class="metric-lbl">Long</span>
                            </div>
                        </div>

                        <!-- Signature 3: Risk-Free Guarantee -->
                        <div class="roven-feature-card d-flex align-items-center gap-3">
                            <div class="roven-feature-icon-box flex-shrink-0">
                                <i class="fa-solid fa-shield-heart"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="roven-feature-name">100% Risk-Free Inspection on Delivery</div>
                                <div class="roven-feature-desc">حق المعاينة والتجربة الكاملة قبل استلام الطرد والدفع</div>
                            </div>
                            <div class="roven-feature-metric flex-shrink-0 d-flex flex-column text-end">
                                <span class="metric-val">100%</span>
                                <span class="metric-lbl">COD</span>
                            </div>
                        </div>
                    </div>

                    <!-- Master Haute Parfumerie CTA Button ("Shop Now") -->
                    <div class="mt-4 pt-2">
                        <a href="@buttonLink" class="roven-master-cta-btn">
                            <span class="roven-btn-sparkle-left">✦</span>
                            <span class="roven-master-btn-text">@buttonText</span>
                            <span class="roven-master-btn-circle">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </a>
                    </div>

                    <!-- Luxury Trust & Reassurance Strip -->
                    <div class="roven-compare-guarantee-bar d-flex align-items-center justify-content-center justify-content-lg-start gap-2 gap-sm-3 pt-3 flex-wrap">
                        <div class="guarantee-item d-flex align-items-center gap-1.5">
                            <i class="fa-solid fa-box-open" style="color: #810100;"></i>
                            <span>معاينة وتجربة قبل الدفع</span>
                        </div>
                        <span class="guarantee-dot">•</span>
                        <div class="guarantee-item d-flex align-items-center gap-1.5">
                            <i class="fa-solid fa-certificate" style="color: #b58d4a;"></i>
                            <span>زيوت فرنسية نقية 100%</span>
                        </div>
                        <span class="guarantee-dot">•</span>
                        <div class="guarantee-item d-flex align-items-center gap-1.5">
                            <i class="fa-solid fa-truck-fast" style="color: #059669;"></i>
                            <span>شحن سريع لجميع المحافظات</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Column: High-Jewelry Comparison Showcase (order-1 on mobile, order-2 on desktop) -->
            <div class="col-12 col-lg-7 order-1 order-lg-2">
                <div class="roven-showcase-pedestal">
                    
                    <!-- Showcase Frame with Exact 1600/1194 Flacon Ratio -->
                    <div class="roven-compare-stage position-relative overflow-hidden" 
                         id="rovenComparisonBox"
                         style="--pos: 50%;">
                        
                        <!-- Base Layer: After (Maison ROVEN Royal Flacon) -->
                        <img src="@afterImage" 
                             alt="@afterLabel" 
                             class="roven-compare-img roven-compare-after-img w-100 h-100 d-block" 
                             loading="eager" />

                        <!-- Top Layer: Before (Them / Conventional), Clipped at Slider Position -->
                        <img src="@beforeImage" 
                             alt="@beforeLabel" 
                             class="roven-compare-img roven-compare-before-img w-100 h-100 position-absolute top-0 start-0" 
                             loading="eager" />

                        <!-- Draggable Gold Hairline Laser Divider -->
                        <div class="roven-compare-divider position-absolute top-0 bottom-0" 
                             aria-hidden="true">
                            
                            <!-- Jewelry Dial Handle with Crimson Core and Gold Ring -->
                            <div class="roven-jewelry-handle position-absolute top-50 start-50 translate-middle d-flex align-items-center justify-content-center">
                                <div class="roven-handle-core d-flex align-items-center justify-content-center">
                                    <i class="fa-solid fa-chevron-left roven-handle-chevron"></i>
                                    <span class="roven-handle-bar"></span>
                                    <i class="fa-solid fa-chevron-right roven-handle-chevron"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Accessible Native Range Control Overlay -->
                        <input type="range" 
                               min="0" 
                               max="100" 
                               value="50" 
                               id="rovenComparisonRange"
                               class="roven-range-slider-input position-absolute top-0 start-0 w-100 h-100" 
                               aria-label="Before and After Quality Comparison Slider" />
                    </div>
                </div>


            </div>

        </div>
    </div>
</section>

<style>
    /* ==========================================================================
       MAISON ROVEN COMPARISON SECTION STYLING (HAUTE PARFUMERIE)
       ========================================================================== */
    .roven-compare-section {
        background: linear-gradient(180deg, #FFFFFF 0%, #FAF8F4 15%, #F5F0E6 50%, #FAF8F4 85%, #FFFFFF 100%);
        padding: 4.8rem 0;
        border-top: 1px solid rgba(223, 177, 91, 0.22);
        border-bottom: 1px solid rgba(223, 177, 91, 0.22);
        position: relative;
        overflow: hidden;
    }

    .roven-compare-ambient-glow {
        position: absolute;
        top: 15%;
        right: 8%;
        width: 550px;
        height: 550px;
        background: radial-gradient(circle, rgba(223, 177, 91, 0.14) 0%, rgba(129, 1, 0, 0.05) 45%, transparent 70%);
        filter: blur(65px);
        pointer-events: none;
        z-index: 1;
    }

    .roven-compare-ambient-glow-secondary {
        position: absolute;
        bottom: 10%;
        left: 5%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(223, 177, 91, 0.1) 0%, transparent 65%);
        filter: blur(55px);
        pointer-events: none;
        z-index: 1;
    }

    /* Left Column Typography: US VS THEM */
    .roven-compare-title {
        font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
        font-size: clamp(3rem, 5.5vw, 4.4rem);
        font-weight: 900;
        letter-spacing: 1.5px;
        line-height: 1.05;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    @@media (min-width: 992px) {
        .roven-compare-title {
            justify-content: flex-start;
        }
    }

    .roven-title-us {
        color: #810100;
        font-weight: 900;
        text-shadow: 0 4px 18px rgba(129, 1, 0, 0.18);
    }

    .roven-title-vs-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #dfb15b 0%, #b58d4a 100%);
        color: #1B1717;
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(0.75rem, 1.8vw, 0.95rem);
        font-weight: 900;
        letter-spacing: 2px;
        padding: 5px 16px;
        border-radius: 50px;
        border: 2px solid #FFFFFF;
        box-shadow: 0 4px 16px rgba(223, 177, 91, 0.5);
        vertical-align: middle;
        margin: 0 6px;
        transform: translateY(-2px);
    }

    .roven-title-them {
        color: #1B1717;
        font-weight: 900;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .roven-editorial-flourish {
        height: 12px;
    }

    .roven-editorial-flourish .flourish-line {
        width: 25px;
        height: 1.5px;
        background: linear-gradient(90deg, transparent, #dfb15b);
    }

    .roven-editorial-flourish .flourish-gem {
        color: #dfb15b;
        font-size: 0.8rem;
    }

    .roven-editorial-flourish .flourish-line-long {
        width: 60px;
        height: 1.5px;
        background: linear-gradient(90deg, #dfb15b, transparent);
    }

    .roven-compare-subtitle {
        color: #554e46;
        font-size: 1.04rem;
        line-height: 1.75;
        max-width: 480px;
        font-weight: 400;
    }

    /* 3 Refined Feature Plaque Cards */
    .roven-feature-card {
        background: #FFFFFF;
        border: 1px solid rgba(223, 177, 91, 0.35);
        border-inline-start: 4px solid #810100;
        border-radius: 14px;
        padding: 13px 18px;
        position: relative;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .roven-feature-card:hover {
        background: #FFFFFF;
        border-color: #dfb15b;
        border-inline-start-color: #dfb15b;
        transform: translateX(5px);
        box-shadow: 0 10px 28px rgba(129, 1, 0, 0.08), 0 0 15px rgba(223, 177, 91, 0.2);
    }

    .roven-feature-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, #810100 0%, #550000 100%);
        color: #dfb15b;
        border: 1.5px solid #dfb15b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.12rem;
        box-shadow: 0 4px 12px rgba(129, 1, 0, 0.3);
        transition: all 0.25s ease;
    }

    .roven-feature-card:hover .roven-feature-icon-box {
        transform: scale(1.08) rotate(4deg);
        box-shadow: 0 6px 16px rgba(129, 1, 0, 0.4);
    }

    .roven-feature-name {
        color: #1B1717;
        font-size: 0.94rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .roven-feature-desc {
        color: #6a635a;
        font-size: 0.81rem;
        line-height: 1.45;
        margin-top: 2px;
    }

    .roven-feature-metric {
        padding-inline-start: 12px;
        border-inline-start: 1px solid rgba(223, 177, 91, 0.35);
    }

    .roven-feature-metric .metric-val {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.05rem;
        font-weight: 800;
        color: #810100;
        line-height: 1;
    }

    .roven-feature-metric .metric-lbl {
        font-size: 0.68rem;
        font-weight: 700;
        color: #b58d4a;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 3px;
    }

    /* ==========================================================================
       MASTER HAUTE PARFUMERIE CTA BUTTON ("SHOP NOW")
       ========================================================================== */
    .roven-master-cta-btn {
        background: linear-gradient(135deg, #8c0100 0%, #680000 50%, #4a0000 100%);
        color: #FFFFFF !important;
        border: 1.5px solid #dfb15b;
        outline: 3.5px solid rgba(223, 177, 91, 0.22);
        outline-offset: 3px;
        border-radius: 60px;
        padding: 1rem 2.8rem;
        font-size: 0.98rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        box-shadow: 0 10px 30px rgba(129, 1, 0, 0.38), 0 0 20px rgba(223, 177, 91, 0.28);
        transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
    }

    /* Shimmer Sweep Animation */
    .roven-master-cta-btn::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -120%;
        width: 80%;
        height: 200%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.32), transparent);
        transform: rotate(25deg);
        animation: rovenMasterBtnSheen 4.5s infinite ease-in-out;
    }

    @@keyframes rovenMasterBtnSheen {
        0%, 70% { left: -120%; }
        100% { left: 160%; }
    }

    .roven-master-cta-btn:hover {
        background: linear-gradient(135deg, #a30100 0%, #7d0000 50%, #580000 100%);
        border-color: #ffe090;
        outline-color: rgba(223, 177, 91, 0.45);
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 14px 36px rgba(129, 1, 0, 0.5), 0 0 30px rgba(223, 177, 91, 0.45);
        color: #FFFFFF !important;
    }

    .roven-btn-sparkle-left {
        color: #ffd885;
        font-size: 0.9rem;
        transition: transform 0.3s ease;
    }

    .roven-master-cta-btn:hover .roven-btn-sparkle-left {
        transform: rotate(90deg) scale(1.2);
    }

    .roven-master-btn-text {
        font-family: 'Cinzel', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: 2.2px;
    }

    .roven-master-btn-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(223, 177, 91, 0.25);
        border: 1.5px solid #dfb15b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.28s ease;
    }

    .roven-master-btn-circle i {
        color: #dfb15b;
        font-size: 0.82rem;
        transition: transform 0.28s ease;
    }

    .roven-master-cta-btn:hover .roven-master-btn-circle {
        background: #dfb15b;
        transform: translateX(4px);
        box-shadow: 0 0 12px rgba(223, 177, 91, 0.8);
    }

    .roven-master-cta-btn:hover .roven-master-btn-circle i {
        color: #810100;
        transform: translateX(2px);
    }

    /* Guarantee & Reassurance Bar */
    .roven-compare-guarantee-bar {
        font-size: 0.8rem;
        color: #5d564f;
        font-weight: 600;
    }

    .guarantee-item i {
        font-size: 0.85rem;
    }

    .guarantee-dot {
        color: #dfb15b;
        opacity: 0.6;
    }

    /* ==========================================================================
       RIGHT COLUMN: SHOWCASE PEDESTAL FRAME
       ========================================================================== */
    .roven-showcase-pedestal {
        padding: 10px;
        border-radius: 30px;
        background: linear-gradient(135deg, rgba(223, 177, 91, 0.5) 0%, rgba(255, 255, 255, 0.95) 45%, rgba(129, 1, 0, 0.28) 100%);
        box-shadow: 0 25px 60px -15px rgba(129, 1, 0, 0.15), 0 10px 30px -5px rgba(0, 0, 0, 0.05);
        outline: 1px solid rgba(223, 177, 91, 0.35);
        transition: all 0.35s ease;
    }

    .roven-showcase-pedestal:hover {
        box-shadow: 0 32px 75px -15px rgba(129, 1, 0, 0.22), 0 0 35px rgba(223, 177, 91, 0.3);
        outline-color: #dfb15b;
    }

    .roven-compare-stage {
        border-radius: 22px;
        aspect-ratio: 1600 / 1194;
        background-color: #F1EAE0;
        cursor: ew-resize;
        user-select: none;
        -webkit-user-select: none;
        touch-action: pan-y;
    }

    .roven-compare-img {
        object-fit: cover;
        object-position: center;
        pointer-events: none;
        user-select: none;
    }

    /* Clip-path reveal for Before image */
    .roven-compare-before-img {
        clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);
        z-index: 2;
        transition: none;
    }

    /* Laser Divider Line */
    .roven-compare-divider {
        left: var(--pos, 50%);
        width: 3px;
        background: linear-gradient(180deg, rgba(223, 177, 91, 0.3) 0%, #dfb15b 15%, #dfb15b 85%, rgba(223, 177, 91, 0.3) 100%);
        transform: translateX(-50%);
        pointer-events: none;
        z-index: 5;
        box-shadow: 0 0 12px rgba(223, 177, 91, 0.8), 0 0 3px rgba(129, 1, 0, 0.6);
    }

    /* Jewelry Dial Handle */
    .roven-jewelry-handle {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dfb15b 0%, #ffd885 50%, #b58d4a 100%);
        padding: 3.5px;
        box-shadow: 0 8px 24px rgba(129, 1, 0, 0.42), 0 0 0 5px rgba(223, 177, 91, 0.25), 0 0 18px rgba(223, 177, 91, 0.55);
        cursor: ew-resize;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .roven-handle-core {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, #9e0201 0%, #630000 70%, #3e0000 100%);
        border: 1.5px solid rgba(255, 215, 130, 0.7);
        gap: 4px;
    }

    .roven-handle-chevron {
        color: #dfb15b;
        font-size: 0.74rem;
    }

    .roven-handle-bar {
        display: inline-block;
        width: 2px;
        height: 14px;
        background: #dfb15b;
        border-radius: 2px;
        opacity: 0.85;
    }

    .roven-compare-stage:hover .roven-jewelry-handle {
        transform: translate(-50%, -50%) scale(1.12);
        box-shadow: 0 12px 30px rgba(129, 1, 0, 0.52), 0 0 0 7px rgba(223, 177, 91, 0.35), 0 0 25px rgba(223, 177, 91, 0.75);
    }

    /* Native Accessible Range Input */
    .roven-range-slider-input {
        opacity: 0;
        cursor: ew-resize;
        z-index: 10;
        margin: 0;
        padding: 0;
        -webkit-appearance: none;
        appearance: none;
    }



    /* Responsive Adjustments for Tablets and Mobile Screens */
    @@media (max-width: 991.98px) {
        .roven-compare-section {
            padding: 3.5rem 0;
        }
        .roven-compare-title {
            font-size: clamp(2.5rem, 8.8vw, 3.4rem) !important;
            margin-bottom: 1.25rem !important;
        }
        .roven-title-vs-pill {
            padding: 4px 13px !important;
            font-size: 0.8rem !important;
        }
        .roven-compare-subtitle {
            font-size: 0.98rem;
            margin-left: auto;
            margin-right: auto;
            margin-bottom: 1.8rem !important;
            line-height: 1.7;
        }
        .roven-compare-features {
            gap: 1.15rem !important;
            margin-bottom: 1.8rem !important;
        }
        .roven-feature-card {
            padding: 14px 16px !important;
            border-radius: 16px !important;
        }
        .roven-feature-name {
            font-size: 0.92rem !important;
        }
        .roven-feature-desc {
            font-size: 0.8rem !important;
            line-height: 1.5;
        }
        .roven-master-cta-btn {
            width: 100%;
            max-width: 320px;
            padding: 1rem 2rem !important;
            font-size: 0.95rem !important;
            margin: 0 auto;
        }
        .roven-jewelry-handle {
            width: 46px;
            height: 46px;
        }
        .roven-handle-bar {
            height: 12px;
        }
        .roven-handle-chevron {
            font-size: 0.65rem;
        }
        .roven-feature-icon-box {
            width: 42px;
            height: 42px;
            font-size: 1.05rem;
        }
    }
    }
</style>

<script>
    (function () {
        function initRovenHauteComparison() {
            const box = document.getElementById('rovenComparisonBox');
            const range = document.getElementById('rovenComparisonRange');
            if (!box || !range) return;

            function setPosition(percent) {
                const clamped = Math.max(0, Math.min(100, percent));
                box.style.setProperty('--pos', clamped + '%');
                range.value = clamped;
            }

            range.addEventListener('input', function (e) {
                setPosition(e.target.value);
            });

            // Smooth direct touch & mouse dragging
            let isDragging = false;

            function updateFromClientX(clientX) {
                const rect = box.getBoundingClientRect();
                const offsetX = clientX - rect.left;
                const percent = (offsetX / rect.width) * 100;
                setPosition(percent);
            }

            box.addEventListener('mousedown', function (e) {
                isDragging = true;
                updateFromClientX(e.clientX);
            });

            window.addEventListener('mousemove', function (e) {
                if (!isDragging) return;
                updateFromClientX(e.clientX);
            });

            window.addEventListener('mouseup', function () {
                isDragging = false;
            });

            box.addEventListener('touchstart', function (e) {
                if (e.touches.length > 0) {
                    isDragging = true;
                    updateFromClientX(e.touches[0].clientX);
                }
            }, { passive: true });

            window.addEventListener('touchmove', function (e) {
                if (!isDragging || e.touches.length === 0) return;
                updateFromClientX(e.touches[0].clientX);
            }, { passive: true });

            window.addEventListener('touchend', function () {
                isDragging = false;
            });

            // Gentle initial peek animation on scroll entrance
            let animated = false;
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && !animated) {
                        animated = true;
                        let step = 0;
                        const interval = setInterval(() => {
                            step++;
                            if (step <= 16) {
                                setPosition(50 + (step * -1.25)); // reveal left up to 30%
                            } else if (step <= 32) {
                                setPosition(30 + ((step - 16) * 1.25)); // return smoothly to 50%
                            } else {
                                clearInterval(interval);
                                setPosition(50);
                            }
                        }, 25);
                    }
                });
            }, { threshold: 0.35 });

            observer.observe(box);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initRovenHauteComparison);
        } else {
            initRovenHauteComparison();
        }
    })();
</script>
