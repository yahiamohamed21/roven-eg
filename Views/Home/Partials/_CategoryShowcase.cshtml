@model Stockify.ViewModels.Store.StoreHomeViewModel
@if (Model.Settings?.ShowCategoriesShowcase != false)
{
<section class="py-5 w-100 position-relative overflow-hidden" style="background-color: #FAF9F5;">
    <div class="container position-relative">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
            <div>
                <span class="badge badge-roven-cream px-3 py-1.5 rounded-pill fw-semibold mb-2 d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-spray-can-sparkles" style="color: #630000;"></i>
                    <span>ROVEN Haute Parfumerie</span>
                </span>
                <h3 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.4rem, 2.8vw, 1.95rem);">
                    Explore Olfactory Departments
                </h3>
                <p class="mb-0 small" style="color: #6c6358;">From concentrated Extraits to majestic Oud and discovery coffrets</p>
            </div>
            <div class="d-flex align-items-center gap-2 align-self-start align-self-sm-auto">
                <a asp-controller="Store" asp-action="Index" class="btn btn-sm fw-semibold px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2" style="border: 1px solid #630000; color: #630000; background: transparent;">
                    <span>View All Fragrances</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- Category Showcase Track / Carousel Container -->
        <div class="roven-cat-carousel-container position-relative">
            <!-- Navigation Controls -->
            <button type="button" class="roven-cat-nav-btn roven-cat-nav-prev d-none d-md-flex" onclick="rovenScrollTrack('rovenCatTrack', -1)" aria-label="Previous departments">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="roven-cat-nav-btn roven-cat-nav-next d-none d-md-flex" onclick="rovenScrollTrack('rovenCatTrack', 1)" aria-label="Next departments">
                <i class="fa-solid fa-chevron-right"></i>
            </button>

            <!-- Scrollable Track -->
            <div id="rovenCatTrack" class="roven-cat-track d-flex gap-3 gap-lg-4 overflow-auto pb-2">
                @foreach (var cat in Model.Categories)
                {
                    var faIcon = cat.Name.ToLower() switch
                    {
                        var n when n.Contains("winter") => "fa-solid fa-snowflake",
                        var n when n.Contains("extrait") => "fa-solid fa-droplet",
                        var n when n.Contains("oud") || n.Contains("orient") => "fa-solid fa-fire-flame-simple",
                        var n when n.Contains("eau") => "fa-solid fa-spray-can-sparkles",
                        var n when n.Contains("gift") || n.Contains("discov") => "fa-solid fa-gift",
                        _ => "fa-solid fa-gem"
                    };

                    <div class="roven-cat-item">
                        <a asp-controller="Store" asp-action="Index" asp-route-categoryId="@cat.Id" class="roven-cat-card">
                            <!-- Visual Poster / Media Frame -->
                            <div class="roven-cat-img-box">
                                @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                {
                                    <img src="@cat.ImageUrl" alt="@cat.Name" class="roven-cat-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <div class="roven-cat-placeholder" style="display: none;">
                                        <div class="roven-cat-medallion">
                                            <i class="@faIcon"></i>
                                        </div>
                                        <span class="roven-cat-placeholder-brand">Maison ROVEN</span>
                                        <span class="roven-cat-placeholder-sub">Haute Parfumerie</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="roven-cat-placeholder">
                                        <div class="roven-cat-medallion">
                                            <i class="@faIcon"></i>
                                        </div>
                                        <span class="roven-cat-placeholder-brand">Maison ROVEN</span>
                                        <span class="roven-cat-placeholder-sub">Haute Parfumerie</span>
                                    </div>
                                }

                                <!-- Parfums count badge floating at top right -->
                                <span class="roven-cat-badge">
                                    <i class="fa-solid fa-spray-can-sparkles me-1" style="color: #dfb15b;"></i>@(cat.ProductsCount == 1 ? "1 Parfum" : $"{cat.ProductsCount} Parfums")
                                </span>
                            </div>

                            <!-- Bottom Bar with smooth hover 'Shop now' reveal -->
                            <div class="roven-cat-bar">
                                <h4 class="roven-cat-title">@cat.Name</h4>
                                <div class="roven-cat-action">
                                    <span class="roven-cat-shop-pill">
                                        <span>Shop now</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script>
    function rovenScrollCategories(direction) {
        var track = document.getElementById('rovenCatTrack');
        if (!track) return;
        var scrollAmount = Math.max(280, track.clientWidth * 0.75);
        track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
</script>
}
