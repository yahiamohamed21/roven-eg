@model Stockify.ViewModels.Store.StoreHomeViewModel
@if (Model.Settings?.ShowCategoriesShowcase != false)
{
<style>
    /* Absolute Zero Dark / Black Overlay on Category Cards */
    .roven-cat-scrim {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }
    .roven-cat-card:hover .roven-cat-hover-reveal {
        opacity: 1 !important;
        max-height: 120px !important;
        overflow: visible !important;
        transform: translateY(0) !important;
        margin-top: 8px !important;
        padding-bottom: 6px !important;
        pointer-events: auto !important;
    }
    .roven-cat-action {
        display: flex !important;
        justify-content: center !important;
        width: 100% !important;
        padding: 4px 6px 8px !important;
        overflow: visible !important;
    }
    .roven-cat-shop-pill,
    .roven-cat-card:hover .roven-cat-shop-pill {
        background: transparent !important;
        background-color: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        box-shadow: none !important;
        border: 1.5px solid #dfb15b !important;
        color: #FAF9F5 !important;
        box-sizing: border-box !important;
        margin-bottom: 2px !important;
    }
    .roven-cat-card:hover .roven-cat-shop-pill:hover {
        background: #dfb15b !important;
        background-color: #dfb15b !important;
        color: #1B1717 !important;
        border-color: #dfb15b !important;
    }
    .roven-cat-bottom-content,
    .roven-cat-hover-reveal,
    .roven-cat-action {
        background: transparent !important;
        background-color: transparent !important;
        box-shadow: none !important;
    }
</style>
<section class="roven-categories-showcase-section py-5 w-100 position-relative overflow-hidden">
    <!-- Ambient Luxury Gold Glow -->
    <div class="roven-cat-ambient-glow" aria-hidden="true"></div>

    <div class="container position-relative" style="z-index: 3;">
        <!-- Header Section -->
        <div class="roven-cat-header-wrap position-relative mb-4 pb-2">
            <!-- Crown Emblem with Horizontal Lines -->
            <div class="roven-cat-crown-wrap d-flex align-items-center justify-content-center gap-3 mb-2">
                <span class="roven-cat-crown-line"></span>
                <i class="fa-solid fa-crown roven-cat-crown-icon"></i>
                <span class="roven-cat-crown-line"></span>
            </div>

            <!-- Main Heading with "Departments" in Royal Crimson -->
            <h2 class="roven-cat-section-heading text-center mb-2">
                Explore Olfactory <span class="roven-cat-heading-accent">Departments</span>
            </h2>

            <!-- Subtitle -->
            <p class="roven-cat-section-sub text-center mb-3">
                Discover our premium collection, crafted for every mood and occasion.
            </p>

            <!-- Small Gold Diamond Divider -->
            <div class="roven-cat-diamond-wrap d-flex align-items-center justify-content-center gap-2 mb-2">
                <span class="roven-cat-diamond-line"></span>
                <i class="fa-solid fa-diamond roven-cat-diamond-icon"></i>
                <span class="roven-cat-diamond-line"></span>
            </div>

            <!-- "View All Fragrances ->" Button (Absolute top-right on desktop, centered on mobile) -->
            <div class="roven-cat-view-all-wrapper">
                <a asp-controller="Store" asp-action="Index" class="roven-cat-view-all-btn d-inline-flex align-items-center gap-2">
                    <span>View All Fragrances</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- Category Showcase Track / Carousel Container -->
        <div class="roven-cat-carousel-container position-relative">
            <!-- Navigation Controls -->
            <button type="button" class="roven-cat-nav-btn roven-cat-nav-prev" onclick="rovenScrollCategories(-1)" aria-label="Previous departments">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="roven-cat-nav-btn roven-cat-nav-next" onclick="rovenScrollCategories(1)" aria-label="Next departments">
                <i class="fa-solid fa-chevron-right"></i>
            </button>

            <!-- Scrollable Track -->
            <div id="rovenCatTrack" class="roven-cat-track d-flex gap-3 gap-lg-4 overflow-auto pb-2">
                @foreach (var cat in Model.Categories)
                {
                    var isGiftOrSet = cat.Name.ToLower().Contains("gift") || cat.Name.ToLower().Contains("discov");
                    var faIcon = isGiftOrSet ? "fa-solid fa-gift" : "fa-solid fa-gem";
                    var hasDedicatedImage = !string.IsNullOrWhiteSpace(cat.ImageUrl);
                    var catImage = cat.ImageUrl;

                    <div class="roven-cat-item">
                        <a asp-controller="Store" asp-action="Index" asp-route-categoryId="@cat.Id" class="roven-cat-card">
                            <!-- Top Right Floating Badge -->
                            <div class="roven-cat-top-bar">
                                <span class="roven-cat-badge">
                                    <i class="@(isGiftOrSet ? "fa-solid fa-gift" : "fa-solid fa-spray-can-sparkles") me-1.5" style="color: #810100;"></i>
                                    @(cat.ProductsCount == 1 ? "1 Parfum" : $"{cat.ProductsCount} Parfums")
                                </span>
                            </div>

                            @if (hasDedicatedImage)
                            {
                                <!-- Image Card Canvas (100% Clear, No Dark Scrim Overlay) -->
                                <div class="roven-cat-img-box">
                                    <img src="@catImage" alt="@cat.Name" class="roven-cat-img" loading="lazy" onerror="this.parentElement.style.display='none'; this.parentElement.nextElementSibling.style.display='flex';" />
                                </div>
                                <!-- Fallback Velvet Canvas if image fails to load -->
                                <div class="roven-cat-placeholder" style="display: none;">
                                    <div class="roven-cat-center-emblem">
                                        <div class="roven-cat-ring-icon">
                                            <i class="@faIcon"></i>
                                        </div>
                                        <span class="roven-cat-brand-text">MAISON ROVEN</span>
                                        <span class="roven-cat-sub-text">HAUTE PARFUMERIE</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Luxury Velvet Medallion Canvas -->
                                <div class="roven-cat-placeholder">
                                    <div class="roven-cat-center-emblem">
                                        <div class="roven-cat-ring-icon">
                                            <i class="@faIcon"></i>
                                        </div>
                                        <span class="roven-cat-brand-text">MAISON ROVEN</span>
                                        <span class="roven-cat-sub-text">HAUTE PARFUMERIE</span>
                                    </div>
                                </div>
                            }

                            <!-- Bottom Content Plaque -->
                            <div class="roven-cat-bottom-content">
                                <!-- Glowing Golden Wave Accent -->
                                <div class="roven-cat-wave-wrap" aria-hidden="true">
                                    <svg class="roven-cat-wave-svg" viewBox="0 0 280 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M0 10 C 65 18, 135 2, 205 13 C 240 18, 265 6, 280 10" stroke="url(#catGoldWave-@cat.Id)" stroke-width="1.3" stroke-linecap="round" />
                                        <defs>
                                            <linearGradient id="catGoldWave-@cat.Id" x1="0%" y1="0%" x2="100%" y2="0%">
                                                <stop offset="0%" stop-color="rgba(223, 177, 91, 0)" />
                                                <stop offset="25%" stop-color="rgba(223, 177, 91, 0.7)" />
                                                <stop offset="50%" stop-color="#dfb15b" />
                                                <stop offset="75%" stop-color="rgba(223, 177, 91, 0.7)" />
                                                <stop offset="100%" stop-color="rgba(223, 177, 91, 0)" />
                                            </linearGradient>
                                        </defs>
                                    </svg>
                                </div>

                                <!-- Category Title (Formatted to wrap cleanly on 2 lines with zero truncation) -->
                                <h4 class="roven-cat-title">@cat.Name</h4>

                                <!-- Hover Reveal Action: Subtitle & Shop Now Pill Button -->
                                <div class="roven-cat-hover-reveal">
                                    <div class="roven-cat-collection-divider">
                                        <span>— COLLECTION —</span>
                                    </div>
                                    <div class="roven-cat-action">
                                        <span class="roven-cat-shop-pill">
                                            <span>Shop Now</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- Carousel Pagination Dots (Dynamically generated based on categories and scroll responsiveness) -->
            <div class="roven-cat-dots-wrap d-flex justify-content-center align-items-center gap-2 mt-4" id="rovenCatDots" style="display: none !important;">
            </div>
        </div>
    </div>
</section>

<script>
    function rovenScrollCategories(direction) {
        var track = document.getElementById('rovenCatTrack');
        if (!track) return;
        var scrollAmount = Math.max(280, track.clientWidth * 0.75);
        track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }

    (function() {
        var track = document.getElementById('rovenCatTrack');
        var dotsContainer = document.getElementById('rovenCatDots');
        var prevBtn = document.querySelector('.roven-cat-nav-prev');
        var nextBtn = document.querySelector('.roven-cat-nav-next');
        if (!track || !dotsContainer) return;

        function updateCategoryPagination() {
            var scrollWidth = track.scrollWidth;
            var clientWidth = track.clientWidth;
            var maxScroll = Math.max(0, scrollWidth - clientWidth);

            // If all categories fit without scrolling (e.g. 4 or fewer categories on desktop)
            if (maxScroll <= 10) {
                dotsContainer.style.setProperty('display', 'none', 'important');
                if (prevBtn) prevBtn.style.setProperty('display', 'none', 'important');
                if (nextBtn) nextBtn.style.setProperty('display', 'none', 'important');
                return;
            }

            // If scrolling is needed (overflow exists):
            // Show navigation arrows on desktop/tablet (>= 768px)
            if (window.innerWidth >= 768) {
                if (prevBtn) prevBtn.style.removeProperty('display');
                if (nextBtn) nextBtn.style.removeProperty('display');
            } else {
                if (prevBtn) prevBtn.style.setProperty('display', 'none', 'important');
                if (nextBtn) nextBtn.style.setProperty('display', 'none', 'important');
            }

            var items = track.querySelectorAll('.roven-cat-item');
            if (items.length <= 1) {
                dotsContainer.style.setProperty('display', 'none', 'important');
                return;
            }

            // Calculate visible cards count in current viewport
            var firstItemWidth = items[0].getBoundingClientRect().width;
            var visibleCount = Math.max(1, Math.floor(clientWidth / (firstItemWidth || 250)));
            
            // Total slides/pages needed
            var totalPages = Math.max(2, Math.ceil(items.length / visibleCount));
            totalPages = Math.min(items.length, totalPages);

            dotsContainer.style.removeProperty('display');
            dotsContainer.style.display = 'flex';

            // Check if we need to regenerate the dots
            var existingDots = dotsContainer.querySelectorAll('.roven-cat-dot');
            if (existingDots.length !== totalPages) {
                dotsContainer.innerHTML = '';
                for (var i = 0; i < totalPages; i++) {
                    (function(pageIdx) {
                        var dot = document.createElement('button');
                        dot.type = 'button';
                        dot.className = 'roven-cat-dot' + (pageIdx === 0 ? ' active' : '');
                        dot.setAttribute('aria-label', 'Go to category slide ' + (pageIdx + 1));
                        dot.addEventListener('click', function() {
                            var targetScroll;
                            if (pageIdx === 0) {
                                targetScroll = 0;
                            } else if (pageIdx === totalPages - 1) {
                                targetScroll = maxScroll;
                            } else {
                                targetScroll = (maxScroll / (totalPages - 1)) * pageIdx;
                            }
                            track.scrollTo({ left: targetScroll, behavior: 'smooth' });
                            setActiveDot(pageIdx);
                        });
                        dotsContainer.appendChild(dot);
                    })(i);
                }
            }

            updateActiveDot();
        }

        function setActiveDot(activeIndex) {
            var dots = dotsContainer.querySelectorAll('.roven-cat-dot');
            dots.forEach(function(dot, idx) {
                if (idx === activeIndex) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        function updateActiveDot() {
            var maxScroll = track.scrollWidth - track.clientWidth;
            if (maxScroll <= 0) return;
            var dots = dotsContainer.querySelectorAll('.roven-cat-dot');
            if (dots.length === 0) return;

            var scrollLeft = Math.max(0, track.scrollLeft);
            var ratio = Math.min(1, Math.max(0, scrollLeft / maxScroll));
            var activeIdx = Math.min(dots.length - 1, Math.round(ratio * (dots.length - 1)));
            setActiveDot(activeIdx);
        }

        track.addEventListener('scroll', updateActiveDot, { passive: true });
        window.addEventListener('resize', updateCategoryPagination, { passive: true });

        // Initial run
        if (document.readyState === 'complete') {
            updateCategoryPagination();
        } else {
            window.addEventListener('load', updateCategoryPagination);
        }
        setTimeout(updateCategoryPagination, 100);
        setTimeout(updateCategoryPagination, 500);
    })();
</script>
}
