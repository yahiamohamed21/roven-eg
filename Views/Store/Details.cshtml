@model Stockify.ViewModels.Store.StoreProductDetailsViewModel
@{
    Layout = "_StoreLayout";
    var p = Model.Product;
    ViewData["Title"] = $"{p.Name} | عطر فاخر من دار روفان ROVEN Haute Parfumerie";
    ViewData["MetaDescription"] = $"تسوق عطر {p.Name} الأصلي من دار روڤين / روفان (ROVEN Haute Parfumerie). عطر فاخر ({p.CategoryName}) بتركيز Extrait de Parfum بنسبة 30% زيوت نقية فرنسية وشرقية بثبات وفوحان يتجاوز 24 ساعة. السعر: {p.Price:N0} ج.م مع التوصيل السريع لجميع محافظات مصر والدفع عند الاستلام مع المعاينة قبل الدفع.";
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = !string.IsNullOrWhiteSpace(p.ImageUrl) ? (p.ImageUrl.StartsWith("http") ? p.ImageUrl : $"https://roven-eg.online{p.ImageUrl}") : "https://roven-eg.online/images/roven-logo.png";
}

<style>
    .product-details-img-box {
        background: radial-gradient(circle, #1a1a1a 0%, #000000 100%);
        min-height: 320px;
        max-height: 440px;
        transition: transform 0.3s ease;
    }
    .product-details-img {
        max-height: 380px;
        width: auto;
        object-fit: contain;
        filter: drop-shadow(0 12px 24px rgba(0,0,0,0.45));
        transition: transform 0.4s ease;
    }
    .product-details-img-box:hover .product-details-img {
        transform: scale(1.04);
    }
    .roven-details-trust-item {
        font-size: 0.76rem;
        color: #6c6358;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #faf8f5;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        border: 1px solid #ede8de;
    }

    @@media (max-width: 767.98px) {
        .roven-breadcrumb-nav {
            overflow-x: auto;
            white-space: nowrap;
            flex-wrap: nowrap !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding-bottom: 2px;
            max-width: 100%;
        }
        .roven-breadcrumb-nav::-webkit-scrollbar {
            display: none;
        }
        .product-details-img-box {
            min-height: 260px !important;
            max-height: 320px !important;
            padding: 1rem !important;
        }
        .product-details-img {
            max-height: 270px !important;
        }
        .star-rating-box {
            font-size: 1.6rem !important;
            gap: 0.35rem !important;
        }
        .roven-details-trust-item {
            font-size: 0.72rem;
            padding: 0.25rem 0.5rem;
        }
    }
</style>

<div class="container py-3 py-md-4 px-2 px-sm-3">
    <!-- Luxury Maison ROVEN Breadcrumb -->
    <nav aria-label="breadcrumb">
        <div class="roven-breadcrumb-nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            <a asp-controller="Store" asp-action="Index">Catalog</a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            <a asp-controller="Store" asp-action="Index" asp-route-categoryId="@p.CategoryId">@p.CategoryName</a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            <span class="breadcrumb-current text-truncate" style="max-width: 200px;">@p.Name</span>
        </div>
    </nav>

    <!-- Product Overview Card -->
    <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5 mb-4 mb-md-5 rounded-4 overflow-hidden" style="background: #ffffff; border: 1px solid #e8e3d5 !important;">
        <div class="row g-4 g-lg-5 align-items-center">
            <!-- Left: Product Image with Luxury Radial Frame -->
            <div class="col-12 col-md-6 text-center">
                <div class="rounded-4 p-3 p-sm-4 d-flex align-items-center justify-content-center shadow-sm position-relative overflow-hidden product-details-img-box">
                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid rounded-3 product-details-img" />
                    }
                    else
                    {
                        <i class="fa-solid fa-spray-can-sparkles display-1" style="color: #EDEBDD;"></i>
                    }

                    @if (p.IsFeatured)
                    {
                        <span class="position-absolute top-0 start-0 m-2.5 m-sm-3 badge px-3 py-1.5 rounded-pill shadow-sm" style="background: linear-gradient(135deg, #810100 0%, #630000 100%); color: #EDEBDD; font-size: 0.74rem; letter-spacing: 0.5px;">
                            <i class="fa-solid fa-gem me-1 text-warning"></i>إصدار حصري
                        </span>
                    }
                </div>
            </div>

            <!-- Right: Details & Purchase Actions -->
            <div class="col-12 col-md-6 d-flex flex-column">
                <!-- Badges & SKU Row -->
                <div class="d-flex align-items-center flex-wrap gap-1.5 gap-sm-2 mb-2">
                    <span class="badge px-3 py-1.5 rounded-pill" style="background-color: #EDEBDD; color: #630000; border: 1px solid rgba(99, 0, 0, 0.2); font-size: 0.78rem; font-weight: 700;">
                        <i class="fa-solid fa-tag me-1"></i>@p.CategoryName
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 font-monospace" style="font-size: 0.75rem;">
                        SKU: @p.Sku
                    </span>
                    @if (p.StockQuantity > 0 && p.StockQuantity <= 5)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-fire me-1"></i>طلب عالي جداً
                        </span>
                    }
                </div>

                <!-- Product Name with Fluid Typography -->
                <h1 class="fw-extrabold mb-2" style="color: #1B1717; font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 4vw, 2.2rem); line-height: 1.25;">
                    @p.Name
                </h1>

                <!-- Rating badge & link to reviews -->
                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                    <div class="text-warning small d-flex align-items-center gap-0.5">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="fa-solid fa-star @(s <= Math.Round(Model.AverageRating) ? "" : "text-muted opacity-25")"></i>
                        }
                    </div>
                    <span class="fw-bold small" style="color: #1B1717;">@Model.AverageRating.ToString("0.0")</span>
                    <span class="text-muted small">(@(Model.ReviewsCount > 0 ? $"{Model.ReviewsCount} تقييمات معتمدة" : "كن أول من يقيّم"))</span>
                    <a href="#reviewsSection" class="small text-decoration-none ms-1 text-nowrap" style="color: #810100; font-weight: 600;">
                        <i class="fa-solid fa-arrow-down small me-1"></i>قراءة التقييمات
                    </a>
                </div>

                <!-- Price and Availability Box (Fluid on Mobile) -->
                <div class="p-3 p-sm-3.5 rounded-3 mb-4 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3" style="background-color: #FAF9F5; border: 1px solid #e8e3d5;">
                    <div>
                        <div class="text-uppercase small fw-bold mb-0.5" style="color: #8c8374; font-size: 0.72rem; letter-spacing: 0.5px;">سعر الزجاجة (Flacon Price)</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fw-extrabold" style="color: #630000; font-size: clamp(1.8rem, 5vw, 2.4rem); font-family: 'Playfair Display', serif; line-height: 1;">
                                @p.Price.ToString("N0")
                            </span>
                            <span class="fw-bold" style="color: #6c6358; font-size: 0.95rem;">جنيه مصري</span>
                        </div>
                    </div>
                    <div class="align-self-stretch align-self-sm-auto text-sm-end">
                        @if (p.IsOutOfStock)
                        {
                            <span class="badge px-3 py-2 w-100 w-sm-auto text-center" style="background-color: #EDEBDD; color: #810100; border: 1px solid #810100; font-size: 0.82rem;">
                                <i class="fa-solid fa-circle-xmark me-1"></i>تم نفاد الكمية (Allocated)
                            </span>
                        }
                        else if (p.IsLowStock)
                        {
                            <span class="badge px-3 py-2 w-100 w-sm-auto text-center" style="background: linear-gradient(135deg, #810100 0%, #630000 100%); color: #EDEBDD; font-size: 0.82rem;">
                                <i class="fa-solid fa-fire me-1 text-warning"></i>متبقي @p.StockQuantity زجاجات فقط!
                            </span>
                        }
                        else
                        {
                            <span class="badge px-3 py-2 w-100 w-sm-auto text-center" style="background-color: #630000; color: #EDEBDD; font-size: 0.82rem;">
                                <i class="fa-solid fa-circle-check me-1 text-success"></i>متوفر جاهز للشحن الفوري
                            </span>
                        }
                    </div>
                </div>

                <!-- Product Description -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-2 d-flex align-items-center gap-2" style="color: #1B1717;">
                        <i class="fa-solid fa-droplet text-danger"></i>
                        <span>الهرم العطري والتفاصيل (Olfactory Profile)</span>
                    </h6>
                    <p class="leading-relaxed mb-0" style="color: #4a4545; line-height: 1.8; font-size: 0.94rem;">
                        @(string.IsNullOrWhiteSpace(p.Description) 
                            ? "تحفة عطرية من دار روڤين بتركيز إكستري دي بارفان 30% من الزيوت النقية المستخلصة في غراس بفرنسا، لثبات يدوم طويلاً وفوحان أخّاذ يأسر الحواس." 
                            : p.Description)
                    </p>
                </div>

                <!-- Purchase Controls -->
                @if (!p.IsOutOfStock)
                {
                    <div class="mt-auto pt-3 border-top" style="border-color: #e8e3d5 !important;">
                        <div class="row g-2 g-sm-3 align-items-center mb-3">
                            <div class="col-4 col-sm-4">
                                <label class="form-label small fw-semibold mb-1 d-block text-muted" style="font-size: 0.75rem;">الكمية</label>
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary px-2 py-2" type="button" onclick="adjustQty(-1)" style="border-color: #d1c9b8;">-</button>
                                    <input type="number" id="purchase-qty" class="form-control text-center fw-bold px-1" value="1" min="1" max="@p.StockQuantity" style="border-color: #d1c9b8;" />
                                    <button class="btn btn-outline-secondary px-2 py-2" type="button" onclick="adjustQty(1)" style="border-color: #d1c9b8;">+</button>
                                </div>
                            </div>
                            <div class="col-8 col-sm-8 d-flex align-items-end">
                                <button type="button" class="btn w-100 py-2.5 py-sm-3 fw-bold rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm text-nowrap" style="background: linear-gradient(135deg, #630000 0%, #810100 100%); color: #EDEBDD; border: 1px solid #810100;" onclick="handleAddToCart()">
                                    <i class="fa-solid fa-bag-shopping fs-5"></i>
                                    <span>إضافة إلى السلة</span>
                                </button>
                            </div>
                        </div>

                        <!-- Direct WhatsApp Concierge Ordering -->
                        @{
                            var waStorePhone = "201008889999";
                            var productUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Store/Details/{p.Id}";
                            var waMessage = Uri.EscapeDataString($"مرحباً دار روڤين، أود طلب عطر {p.Name} بسعر {p.Price:N0} ج.م.\nالرابط: {productUrl}");
                        }
                        <div class="mb-3">
                            <a href="https://wa.me/@waStorePhone?text=@waMessage" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success w-100 py-2 rounded-pill fw-bold d-inline-flex align-items-center justify-content-center gap-2" style="font-size: 0.86rem; border-width: 1.5px;">
                                <i class="fa-brands fa-whatsapp fs-5"></i>
                                <span>طلب فوري مباشر عبر الواتساب</span>
                            </a>
                        </div>

                        <!-- Trust Badges with Wrap -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top" style="border-color: #f0ece3 !important;">
                            <span class="roven-details-trust-item"><i class="fa-solid fa-truck-fast text-danger"></i> شحن سريع لكافة المحافظات</span>
                            <span class="roven-details-trust-item"><i class="fa-solid fa-hand-holding-dollar text-success"></i> معاينة ودفع عند الاستلام</span>
                            <span class="roven-details-trust-item"><i class="fa-solid fa-shield-halved text-primary"></i> زيوت أصلية 100% مضمونة</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-auto pt-3 border-top" style="border-color: #e8e3d5 !important;">
                        <div class="alert alert-secondary mb-0 d-flex align-items-center gap-2 rounded-4" style="background-color: #EDEBDD; color: #630000; border: 1px solid rgba(99, 0, 0, 0.2);">
                            <i class="fa-solid fa-circle-info fs-5 flex-shrink-0"></i>
                            <div class="small">
                                <strong>محجوز بالكامل:</strong> هذا العطر الحصري نفدت كميته مؤقتاً. تابعونا في إطلاق دورة التعتيق القادمة.
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- CLIENT REVIEWS & OLFACTORY IMPRESSIONS SECTION                 -->
    <!-- ============================================================== -->
    <div id="reviewsSection" class="card border-0 shadow-sm p-3 p-sm-4 p-md-5 mb-5 rounded-4 overflow-hidden" style="background: #ffffff; border: 1px solid #e8e3d5 !important;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom" style="border-color: #e8e3d5 !important;">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background-color: #EDEBDD; color: #630000; font-size: 0.78rem; font-weight: 700;">
                    <i class="fa-solid fa-star text-warning"></i>
                    <span>CLIENT EXPERIENCES & REVIEWS</span>
                </div>
                <h3 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', serif; font-size: clamp(1.25rem, 3.5vw, 1.75rem);">آراء وتقييمات العملاء</h3>
                <p class="small text-muted mb-0">تجارب حقيقية لعملاء دار روڤين مع عطر <strong>@p.Name</strong> وثباته وفوحانه.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3 w-100 w-md-auto justify-content-between justify-content-md-end">
                <div class="text-start text-md-end">
                    <div class="d-flex align-items-center gap-1 text-warning fs-5">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fa-solid fa-star @(i <= Math.Round(Model.AverageRating) ? "" : "text-muted opacity-25")"></i>
                        }
                    </div>
                    <div class="small text-muted mt-1" style="font-size: 0.78rem;">
                        متوسط التقييم <strong class="text-dark">@Model.AverageRating.ToString("0.0")</strong> من 5 (@Model.ReviewsCount تقييم معتمد)
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-roven-wine px-3 py-2 rounded-pill fw-bold text-nowrap" onclick="document.getElementById('addReviewCard').scrollIntoView({ behavior: 'smooth' });">
                    <i class="fa-solid fa-pen-nib me-1"></i> أضف تقييمك
                </button>
            </div>
        </div>

        <div class="row g-4">
            <!-- Review Form Column -->
            <div class="col-12 col-lg-5 order-lg-2">
                <div class="card border-0 rounded-4 p-3 p-sm-4 shadow-xs" style="background: #FAF9F5; border: 1.5px solid rgba(99, 0, 0, 0.12) !important;" id="addReviewCard">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa-solid fa-award" style="color: #630000;"></i>
                        <h5 class="fw-bold mb-0" style="color: #1B1717; font-size: 1.05rem;">شاركنا رأيك في العطر</h5>
                    </div>
                    <p class="small text-muted mb-3" style="font-size: 0.8rem;">تقييمك يساعد عملاء دار روڤين في اختيار العطر المناسب لذوقهم.</p>

                    <form id="productReviewForm" asp-controller="Store" asp-action="SubmitReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />
                        
                        <!-- Star Selection -->
                        <div class="mb-3 text-center p-2.5 p-sm-3 bg-white rounded-3 border">
                            <label class="form-label small fw-bold d-block mb-1 text-dark">تقييمك للعطر بالنجوم</label>
                            <div class="star-rating-box d-inline-flex flex-row-reverse gap-2 fs-2" id="starRatingBox">
                                <input type="radio" id="star5" name="rating" value="5" checked class="d-none star-radio" />
                                <label for="star5" class="star-label cursor-pointer text-warning" data-val="5" title="5 نجوم - ممتاز جداً"><i class="fa-solid fa-star"></i></label>
                                <input type="radio" id="star4" name="rating" value="4" class="d-none star-radio" />
                                <label for="star4" class="star-label cursor-pointer text-warning" data-val="4" title="4 نجوم - رائع"><i class="fa-solid fa-star"></i></label>
                                <input type="radio" id="star3" name="rating" value="3" class="d-none star-radio" />
                                <label for="star3" class="star-label cursor-pointer text-warning" data-val="3" title="3 نجوم - جيد"><i class="fa-solid fa-star"></i></label>
                                <input type="radio" id="star2" name="rating" value="2" class="d-none star-radio" />
                                <label for="star2" class="star-label cursor-pointer text-warning" data-val="2" title="نجمتان - متوسط"><i class="fa-solid fa-star"></i></label>
                                <input type="radio" id="star1" name="rating" value="1" class="d-none star-radio" />
                                <label for="star1" class="star-label cursor-pointer text-warning" data-val="1" title="نجمة واحدة - غير راضٍ"><i class="fa-solid fa-star"></i></label>
                            </div>
                            <div id="starRatingLabel" class="small fw-bold text-muted mt-1" style="font-size: 0.78rem;">5 نجوم — ثبات وفوحان استثنائي</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">الاسم الكامل *</label>
                            <input type="text" name="customerName" class="form-control rounded-3" placeholder="مثال: أحمد عبد الله" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">رقم الهاتف (اختياري)</label>
                            <input type="tel" name="customerPhone" class="form-control rounded-3 font-monospace" placeholder="مثال: 01001234567" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">البريد الإلكتروني (اختياري)</label>
                            <input type="email" name="customerEmail" class="form-control rounded-3" placeholder="name@domain.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">رأيك وتجربتك مع العطر *</label>
                            <textarea name="comment" rows="3" class="form-control rounded-3" placeholder="حدثنا عن تجاربك مع فوحان العطر، ثباته، والمناسبات المفضلة لاستخدامه..." required></textarea>
                        </div>

                        <div class="alert alert-light border small text-muted py-2 mb-3" style="font-size: 0.76rem;">
                            <i class="fa-solid fa-shield-halved text-success me-1"></i> يتم فحص واعتماد التقييمات من إدارة المتجر قبل ظهورها علناً حفاظاً على جودة التعليقات.
                        </div>

                        <button type="submit" id="btnSubmitReview" class="btn btn-roven-wine w-100 py-2.5 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>إرسال التقييم للاعتماد</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Approved Reviews List Column -->
            <div class="col-12 col-lg-7 order-lg-1">
                @if (!Model.Reviews.Any())
                {
                    <div class="text-center py-5 p-4 rounded-4 bg-light border border-dashed">
                        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background: #EDEBDD; color: #630000; font-size: 1.4rem;">
                            <i class="fa-regular fa-comment-dots"></i>
                        </div>
                        <h6 class="fw-bold mb-1" style="color: #1B1717;">كن أول من يقيّم هذا العطر!</h6>
                        <p class="small text-muted mb-0">لم يقم أحد بتقييم عطر <strong>@p.Name</strong> حتى الآن. شاركنا تجربتك ورأيك وكن أول المراجعين.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in Model.Reviews)
                        {
                            <div class="p-3 p-sm-3.5 p-md-4 rounded-4 bg-light border shadow-2xs">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 gap-sm-2.5">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-xs flex-shrink-0" style="width: 38px; height: 38px; background: #630000; font-size: 0.95rem;">
                                            @(rev.CustomerName.Length > 0 ? rev.CustomerName.Substring(0, 1).ToUpper() : "R")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">@rev.CustomerName</div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle py-0.5 px-2 rounded-pill" style="font-size: 0.68rem;">
                                                    <i class="fa-solid fa-circle-check me-1"></i> عميل موثّق
                                                </span>
                                                <span class="small text-muted" style="font-size: 0.72rem;">@rev.CreatedAt.ToEgyptTimeString("dd MMM yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-warning text-nowrap" style="font-size: 0.85rem;">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="fa-solid fa-star @(s <= rev.Rating ? "" : "text-muted opacity-25")"></i>
                                        }
                                    </div>
                                </div>
                                <p class="mb-0 text-secondary" style="line-height: 1.6; font-size: 0.88rem;">
                                    "@rev.Comment"
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-3 mb-md-4">
                <div>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background-color: #EDEBDD; color: #630000; font-size: 0.76rem; font-weight: 700;">
                        <i class="fa-solid fa-sparkles text-warning"></i>
                        <span>CURATED PERFUMERY SELECTIONS</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif; font-size: clamp(1.15rem, 3vw, 1.5rem);">
                        عطور أخرى قد تنال إعجابك
                    </h4>
                    <p class="small text-muted mb-0">تشكيلة مختارة بعناية من أرقى إصدارات دار روڤين</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 d-none d-sm-inline-flex align-items-center gap-1.5" style="font-size: 0.78rem;">
                    <span>عرض كافة العطور</span>
                    <i class="fa-solid fa-arrow-left small"></i>
                </a>
            </div>

            <div class="row g-2 g-sm-3 g-md-4 justify-content-center">
                @foreach (var related in Model.RelatedProducts)
                {
                    <div class="@(Model.RelatedProducts.Count == 1 ? "col-12 col-sm-8 col-md-6 col-lg-4" : (Model.RelatedProducts.Count == 2 ? "col-6 col-md-6 col-lg-4" : "col-6 col-lg-3"))">
                        <div class="product-card h-100 d-flex flex-column shadow-xs" data-details-url="@Url.Action("Details", "Store", new { id = related.Id })" style="border-radius: 14px; overflow: hidden; background: #ffffff; border: 1px solid #e8e3d5;">
                            <a asp-action="Details" asp-route-id="@related.Id" class="product-image-container d-block position-relative text-decoration-none" style="background: #000000; height: 180px; overflow: hidden;" title="عرض تفاصيل عطر @related.Name">
                                @if (!string.IsNullOrWhiteSpace(related.ImageUrl))
                                {
                                    <img src="@related.ImageUrl" alt="@related.Name" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.src='/images/products/perfume_default.svg'" style="object-fit: contain; width: 100%; height: 100%; padding: 8px;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                        <i class="fa-solid fa-spray-can-sparkles display-5" style="color: #EDEBDD;"></i>
                                    </div>
                                }

                                @if (related.IsFeatured)
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge px-2 py-1 rounded-pill" style="background: linear-gradient(135deg, #810100 0%, #630000 100%); color: #EDEBDD; font-size: 0.65rem;">
                                        <i class="fa-solid fa-gem me-0.5 text-warning"></i>مميز
                                    </span>
                                }
                            </a>
                            <div class="p-2.5 p-sm-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge px-2 py-0.5 rounded-pill" style="background-color: #EDEBDD; color: #630000; font-size: 0.68rem; font-weight: 600;">
                                        @related.CategoryName
                                    </span>
                                    <div class="text-warning small" style="font-size: 0.7rem;">
                                        <i class="fa-solid fa-star"></i>
                                        <span class="fw-bold text-dark ms-0.5" style="font-size: 0.72rem;">5.0</span>
                                    </div>
                                </div>

                                <h6 class="fw-bold text-dark mb-2" style="font-size: 0.88rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.4em;">
                                    <a asp-action="Details" asp-route-id="@related.Id" class="text-dark text-decoration-none">
                                        @related.Name
                                    </a>
                                </h6>

                                <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between flex-wrap gap-1" style="border-color: #f0ece3 !important;">
                                    <div class="fw-extrabold" style="color: #630000; font-size: 0.92rem; font-family: 'Playfair Display', serif;">
                                        @related.Price.ToString("N0") <span class="fw-normal text-muted" style="font-size: 0.7rem;">ج.م</span>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@related.Id" class="btn btn-sm btn-outline-dark rounded-pill px-2.5 py-1 fw-bold text-nowrap" style="font-size: 0.72rem; border-color: #d1c9b8;">
                                        <span>عرض العطر</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const maxStock = @p.StockQuantity;

    function adjustQty(delta) {
        const input = document.getElementById('purchase-qty');
        let current = parseInt(input.value) || 1;
        current += delta;
        if (current < 1) current = 1;
        if (current > maxStock) current = maxStock;
        input.value = current;
    }

    function handleAddToCart() {
        const input = document.getElementById('purchase-qty');
        const qty = parseInt(input.value) || 1;
        window.addStoreItemToCart(@p.Id, qty);
    }

    // Star Rating interactive selection
    document.addEventListener('DOMContentLoaded', function() {
        const starRadios = document.querySelectorAll('#starRatingBox input[type="radio"]');
        const starLabels = document.querySelectorAll('#starRatingBox .star-label');
        const labelText = document.getElementById('starRatingLabel');

        const ratingDescriptions = {
            1: 'نجمة واحدة — تقييم غير راضٍ',
            2: 'نجمتان — تقييم متوسط',
            3: '3 نجوم — عطر جيد',
            4: '4 نجوم — عطر رائع ومميز',
            5: '5 نجوم — ثبات وفوحان استثنائي'
        };

        function updateStars(val) {
            starLabels.forEach(lbl => {
                const starVal = parseInt(lbl.getAttribute('data-val') || lbl.htmlFor.replace('star', ''));
                const icon = lbl.querySelector('i');
                if (starVal <= val) {
                    lbl.classList.add('text-warning');
                    lbl.classList.remove('text-muted', 'opacity-25');
                    if (icon) icon.className = 'fa-solid fa-star';
                } else {
                    lbl.classList.remove('text-warning');
                    lbl.classList.add('text-muted', 'opacity-25');
                    if (icon) icon.className = 'fa-regular fa-star';
                }
            });
            if (labelText && ratingDescriptions[val]) {
                labelText.textContent = ratingDescriptions[val];
            }
        }

        starRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                updateStars(parseInt(this.value));
            });
        });

        // Hover effect on star labels
        starLabels.forEach(lbl => {
            lbl.addEventListener('mouseenter', function() {
                const val = parseInt(this.getAttribute('data-val') || this.htmlFor.replace('star', ''));
                updateStars(val);
            });
        });

        const starBox = document.getElementById('starRatingBox');
        if (starBox) {
            starBox.addEventListener('mouseleave', function() {
                const checkedRadio = document.querySelector('#starRatingBox input[type="radio"]:checked');
                const val = checkedRadio ? parseInt(checkedRadio.value) : 5;
                updateStars(val);
            });
        }

        // Review form submit via AJAX
        const reviewForm = document.getElementById('productReviewForm');
        if (reviewForm) {
            reviewForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btnSubmitReview');
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري إرسال التقييم...';

                try {
                    const formData = new FormData(this);
                    const res = await fetch(this.action, {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: '<i class="fa-solid fa-circle-check text-success me-2"></i>تم استلام تقييمك بنجاح!',
                                html: `<p class="mb-0 text-muted">${data.message}</p>`,
                                confirmButtonText: 'حسناً، شكراً لكم',
                                customClass: {
                                    confirmButton: 'btn btn-primary px-4 py-2 fw-bold'
                                },
                                buttonsStyling: false
                            });
                        } else {
                            alert(data.message);
                        }
                        reviewForm.reset();
                        updateStars(5);
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'warning',
                                title: 'تنبيه',
                                text: data.message || 'حدث خطأ أثناء إرسال التقييم.',
                                confirmButtonText: 'حسناً',
                                customClass: {
                                    confirmButton: 'btn btn-warning px-4 py-2 fw-bold'
                                },
                                buttonsStyling: false
                            });
                        } else {
                            alert(data.message);
                        }
                    }
                } catch (err) {
                    console.error('Review submit error:', err);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'تعذر الاتصال',
                            text: 'تعذر إرسال التقييم، يرجى التحقق من اتصال الإنترنت.',
                            confirmButtonText: 'إغلاق',
                            customClass: {
                                confirmButton: 'btn btn-secondary px-4 py-2'
                            },
                            buttonsStyling: false
                        });
                    } else {
                        alert('تعذر إرسال التقييم، يرجى المحاولة مرة أخرى.');
                    }
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        }
    });
</script>
}

@section SeoStructuredData {
    <!-- Google Rich Product Snippet JSON-LD Structured Data with Reviews & Brand Knowledge Graph -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "Product",
      "name": "@p.Name",
      "image": [
        "@(!string.IsNullOrWhiteSpace(p.ImageUrl) ? (p.ImageUrl.StartsWith("http") ? p.ImageUrl : $"https://roven-eg.online{p.ImageUrl}") : "https://roven-eg.online/images/roven-logo.png")"
      ],
      "description": "@(string.IsNullOrWhiteSpace(p.Description) ? $"{p.Name} luxury perfume by ROVEN Haute Parfumerie (عطور روفان مصر)" : p.Description.Replace("\"", "\\\"").Replace("\r", "").Replace("\n", " "))",
      "sku": "@p.Sku",
      "mpn": "@p.Sku",
      "brand": {
        "@@type": "Brand",
        "name": "ROVEN",
        "alternateName": ["Maison ROVEN", "ROVEN Haute Parfumerie", "روڤين", "روفان", "روفين", "عطور روڤين", "عطور روفان"]
      },
      "category": "@p.CategoryName",
      @if (Model.ReviewsCount > 0)
      {
        <text>
        "aggregateRating": {
          "@@type": "AggregateRating",
          "ratingValue": "@Model.AverageRating.ToString("0.0")",
          "reviewCount": "@Model.ReviewsCount",
          "bestRating": "5",
          "worstRating": "1"
        },
        </text>
      }
      "offers": {
        "@@type": "Offer",
        "url": "https://roven-eg.online/Store/Details/@p.Id",
        "priceCurrency": "EGP",
        "price": "@p.Price.ToString("F2")",
        "priceValidUntil": "@(DateTime.UtcNow.AddYears(1).ToString("yyyy-MM-dd"))",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "@(p.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")",
        "seller": {
          "@@type": "Organization",
          "name": "ROVEN Haute Parfumerie",
          "url": "https://roven-eg.online/"
        },
        "hasMerchantReturnPolicy": {
          "@@type": "MerchantReturnPolicy",
          "applicableCountry": "EG",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": {
          "@@type": "OfferShippingDetails",
          "shippingRate": {
            "@@type": "MonetaryAmount",
            "value": "0",
            "currency": "EGP"
          },
          "shippingDestination": {
            "@@type": "DefinedRegion",
            "addressCountry": "EG"
          },
          "deliveryTime": {
            "@@type": "ShippingDeliveryTime",
            "handlingTime": { "@@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
            "transitTime": { "@@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" }
          }
        }
      }
    }
    </script>

    <!-- Google BreadcrumbList Structured Data for SERP Hierarchy -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "دار روفان",
          "item": "https://roven-eg.online/"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "متجر العطور",
          "item": "https://roven-eg.online/Store"
        },
        {
          "@@type": "ListItem",
          "position": 3,
          "name": "@p.CategoryName",
          "item": "https://roven-eg.online/Store?categoryId=@p.CategoryId"
        },
        {
          "@@type": "ListItem",
          "position": 4,
          "name": "@p.Name",
          "item": "https://roven-eg.online/Store/Details/@p.Id"
        }
      ]
    }
    </script>
}
