@model Stockify.ViewModels.Store.StoreCatalogViewModel
@{
    var isAjax = (ViewData["IsAjax"] as bool? == true) || (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest");
    Layout = isAjax ? null : "_StoreLayout";
    var catTitle = string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? "كتالوج عطور روفان الفاخرة | All ROVEN Fragrances" : $"عطور {Model.SelectedCategoryName} | دار روفان ROVEN";
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? "كتالوج عطور روفان الرسمية | ROVEN Haute Parfumerie" : $"عطور {Model.SelectedCategoryName} | دار روفان ROVEN";
    ViewData["MetaDescription"] = $"تسوق أرقى تشكيلات عطور روفان (Maison ROVEN) الأصلية في مصر. عطور نيش وExtraits de Parfum بتركيز 30% مع ثبات وفوحان فائق يدوم طويلاً، وشحن وتوصيل فوري مع المعاينة قبل الدفع.";
    var activeFiltersCount = (Model.SelectedCategoryId.HasValue ? 1 : 0) + (Model.InStockOnly ? 1 : 0);
}

<style>
/* ==========================================================================
   MAISON ROVEN — HAUTE PARFUMERIE CATALOG FILTER STYLING
   ========================================================================== */
.roven-catalog-container {
    min-height: 70vh;
    padding-top: 1.5rem !important;
    padding-bottom: 5.5rem !important;
    margin-bottom: 2rem !important;
}

.roven-filter-sidebar-col {
    position: relative;
}

.roven-filter-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(181, 141, 74, 0.22);
    box-shadow: 0 10px 32px rgba(27, 23, 23, 0.04);
    padding: 1.25rem 1.15rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    margin-bottom: 1.5rem;
}

.roven-filter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #810100 0%, #b58d4a 50%, #810100 100%);
}

.roven-filter-card:hover {
    border-color: rgba(181, 141, 74, 0.38);
    box-shadow: 0 14px 40px rgba(27, 23, 23, 0.07);
}

/* Header */
.roven-filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(181, 141, 74, 0.16);
}

.roven-filter-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
}

.roven-filter-icon-badge {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(129, 1, 0, 0.08) 0%, rgba(181, 141, 74, 0.14) 100%);
    border: 1px solid rgba(181, 141, 74, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #810100;
    font-size: 0.95rem;
    box-shadow: 0 2px 8px rgba(181, 141, 74, 0.12);
}

.roven-filter-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.22rem;
    font-weight: 700;
    color: #1B1717;
    margin: 0;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 7px;
}

.roven-filter-active-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #810100;
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 700;
}

.roven-filter-reset-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #8a6519;
    text-decoration: none;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(181, 141, 74, 0.08);
    border: 1px solid rgba(181, 141, 74, 0.2);
    transition: all 0.25s ease;
}

.roven-filter-reset-link:hover {
    color: #810100;
    background: rgba(129, 1, 0, 0.08);
    border-color: rgba(129, 1, 0, 0.25);
    transform: translateY(-1px);
}

/* Category Section */
.roven-filter-section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #8c8278;
    margin-bottom: 0.85rem;
}

.roven-category-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.roven-category-item {
    position: relative;
    cursor: pointer;
    margin: 0;
    display: block;
}

.roven-category-item input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

.roven-category-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: #4A423D;
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.22s ease;
    user-select: none;
}

.roven-category-item:hover .roven-category-label {
    background: #FAF9F5;
    color: #1B1717;
    border-color: rgba(181, 141, 74, 0.2);
    transform: translateX(2px);
}

.roven-cat-left {
    display: flex;
    align-items: center;
    gap: 11px;
}

/* Custom luxury radio indicator */
.roven-custom-radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid rgba(181, 141, 74, 0.45);
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.22s ease;
    flex-shrink: 0;
    font-size: 0.65rem;
    color: #FFFFFF;
}

.roven-cat-name {
    letter-spacing: 0.2px;
    text-transform: capitalize;
}

.roven-cat-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(181, 141, 74, 0.1);
    color: #8a6519;
    letter-spacing: 0.02em;
    transition: all 0.22s ease;
}

/* Checked State */
.roven-category-item input[type="radio"]:checked + .roven-category-label {
    background: linear-gradient(135deg, rgba(223, 177, 91, 0.14) 0%, rgba(129, 1, 0, 0.04) 100%);
    border-color: rgba(181, 141, 74, 0.45);
    color: #1B1717;
    font-weight: 600;
    box-shadow: 0 2px 10px rgba(181, 141, 74, 0.08);
}

.roven-category-item input[type="radio"]:checked + .roven-category-label .roven-custom-radio {
    background: #810100;
    border-color: #810100;
    box-shadow: 0 0 0 3px rgba(181, 141, 74, 0.28);
}

.roven-category-item input[type="radio"]:not(:checked) + .roven-category-label .roven-custom-radio i {
    display: none;
}

.roven-category-item input[type="radio"]:checked + .roven-category-label .roven-cat-count {
    background: linear-gradient(135deg, #b58d4a 0%, #8a6519 100%);
    color: #FFFFFF;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(138, 101, 25, 0.25);
}

/* In-Stock Toggle Luxury Card */
.roven-stock-toggle-box {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(181, 141, 74, 0.16);
}

.roven-stock-toggle-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    border-radius: 14px;
    background: #FAF9F5;
    border: 1px solid rgba(181, 141, 74, 0.2);
    cursor: pointer;
    transition: all 0.25s ease;
    user-select: none;
    margin: 0;
}

.roven-stock-toggle-label:hover {
    border-color: rgba(181, 141, 74, 0.45);
    background: #FFFFFF;
    box-shadow: 0 4px 14px rgba(27, 23, 23, 0.04);
}

.roven-stock-meta {
    display: flex;
    align-items: center;
    gap: 10px;
}

.roven-stock-icon {
    font-size: 1rem;
    color: #810100;
}

.roven-stock-text-main {
    font-size: 0.88rem;
    font-weight: 600;
    color: #1B1717;
    display: block;
    line-height: 1.2;
}

.roven-stock-text-sub {
    font-size: 0.7rem;
    color: #8c8278;
    display: block;
    margin-top: 2px;
}

/* Custom Luxury Toggle Switch */
.roven-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
}

.roven-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.roven-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ded9cd;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 34px;
}

.roven-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 50%;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.roven-switch input:checked + .roven-slider {
    background: linear-gradient(135deg, #810100 0%, #b58d4a 100%);
    box-shadow: 0 0 10px rgba(181, 141, 74, 0.35);
}

.roven-switch input:checked + .roven-slider:before {
    transform: translateX(20px);
}

/* Mobile Filter Trigger Button & Collapsible */
.roven-mobile-filter-bar {
    display: none;
    margin-bottom: 1.25rem;
}

.roven-filter-collapse-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #FFFFFF;
    border: 1px solid rgba(181, 141, 74, 0.28);
    border-radius: 16px;
    font-weight: 600;
    font-size: 0.92rem;
    color: #1B1717;
    box-shadow: 0 4px 16px rgba(27, 23, 23, 0.04);
    transition: all 0.25s ease;
    cursor: pointer;
}

.roven-filter-collapse-btn:hover,
.roven-filter-collapse-btn:focus {
    border-color: var(--rv-gold, #b58d4a);
    color: #810100;
}

.roven-filter-collapse-btn .roven-filter-chevron {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: #8C827A;
}

.roven-filter-collapse-btn:not(.collapsed) .roven-filter-chevron,
.roven-filter-collapse-btn[aria-expanded="true"] .roven-filter-chevron {
    transform: rotate(180deg);
    color: #810100;
}

.roven-filter-collapse-btn:not(.collapsed),
.roven-filter-collapse-btn[aria-expanded="true"] {
    border-color: rgba(181, 141, 74, 0.5);
    background: #FFFCF7;
}

.roven-filter-collapse-wrap.collapsing {
    transition: height 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

@@media (max-width: 991.98px) {
    .roven-mobile-filter-bar {
        display: block;
        margin-bottom: 1rem;
    }
    .roven-filter-sidebar-col {
        margin-bottom: 0.5rem;
    }
    .roven-filter-card {
        padding: 1.25rem 1.1rem;
        margin-bottom: 1rem;
    }
}

@@media (min-width: 992px) {
    .roven-filter-collapse-wrap {
        display: block !important;
        height: auto !important;
        overflow: visible !important;
        visibility: visible !important;
    }
    .roven-filter-sidebar-col {
        position: relative;
    }
    .roven-filter-card {
        position: -webkit-sticky !important;
        position: sticky !important;
        top: 95px !important;
        margin-bottom: 0 !important;
        max-height: calc(100vh - 125px);
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .roven-filter-card::-webkit-scrollbar {
        width: 4px;
    }
    .roven-filter-card::-webkit-scrollbar-thumb {
        background: rgba(181, 141, 74, 0.3);
        border-radius: 4px;
    }
}

/* ==========================================================================
   MAISON ROVEN — HAUTE PARFUMERIE LUXURY PRODUCT CARD
   ========================================================================== */
.roven-store-flacon-card {
    background: #FFFFFF;
    border: 1px solid rgba(181, 141, 74, 0.22);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(27, 23, 23, 0.04);
    position: relative;
}

.roven-store-flacon-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(129, 1, 0, 0.08), 0 4px 16px rgba(181, 141, 74, 0.12);
    border-color: rgba(181, 141, 74, 0.48);
}

.roven-store-flacon-card .product-image-container {
    background: radial-gradient(circle at 50% 40%, #FFFFFF 0%, #FAF8F3 100%);
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid rgba(181, 141, 74, 0.14);
    height: 290px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.roven-store-flacon-card .product-image-container img {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.roven-store-flacon-card:hover .product-image-container img {
    transform: scale(1.05);
}

.roven-product-cat-wrap {
    display: flex;
    align-items: center;
    margin-bottom: 0.55rem;
}

.roven-product-cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: #926d2e;
    background: linear-gradient(135deg, rgba(181, 141, 74, 0.12) 0%, rgba(129, 1, 0, 0.04) 100%);
    border: 1px solid rgba(181, 141, 74, 0.26);
    padding: 3.5px 11px;
    border-radius: 999px;
    transition: all 0.25s ease;
    line-height: 1.2;
}

.roven-cat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: linear-gradient(135deg, #b58d4a, #810100);
    box-shadow: 0 0 5px rgba(181, 141, 74, 0.6);
}

.roven-store-flacon-card:hover .roven-product-cat-badge {
    background: linear-gradient(135deg, rgba(181, 141, 74, 0.22) 0%, rgba(129, 1, 0, 0.08) 100%);
    border-color: rgba(181, 141, 74, 0.5);
    color: #7b591d;
    transform: translateY(-1px);
}

.roven-product-title {
    font-family: 'Playfair Display', Didot, 'Cinzel', Georgia, serif;
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.6px;
    margin: 0 0 0.4rem 0;
    text-transform: capitalize;
}

.roven-product-title a {
    color: #1B1717;
    text-decoration: none;
    transition: color 0.25s ease;
    display: inline-block;
}

.roven-store-flacon-card:hover .roven-product-title a {
    color: #810100;
}

.roven-product-tagline {
    font-size: 0.72rem;
    color: #8c8278;
    letter-spacing: 0.8px;
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    font-weight: 500;
}

.roven-product-tagline::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 1px;
    background: rgba(181, 141, 74, 0.5);
}

.roven-card-footer {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(181, 141, 74, 0.16) !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.roven-price-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #8c8278;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 4px;
}

.roven-price-val {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #810100;
    line-height: 1;
}

.roven-price-curr {
    font-size: 0.74rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #8a6519;
    font-weight: 700;
    margin-inline-start: 2px;
}

.roven-btn-add-bag {
    background: #1B1717;
    color: #FAF9F5;
    border: 1px solid rgba(181, 141, 74, 0.35);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 0.82rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: all 0.25s ease;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(27, 23, 23, 0.12);
}

.roven-btn-add-bag:hover {
    background: #810100;
    color: #FFFFFF;
    border-color: #810100;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(129, 1, 0, 0.28);
}

.roven-badge-featured {
    background: linear-gradient(135deg, #810100 0%, #b58d4a 100%);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 4px 11px;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(129, 1, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: inline-flex;
    align-items: center;
}

.roven-badge-out-of-stock {
    background: rgba(27, 23, 23, 0.88);
    backdrop-filter: blur(6px);
    color: #ded9cd;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid rgba(181, 141, 74, 0.25);
    display: inline-flex;
    align-items: center;
}

/* ==========================================================================
   MAISON ROVEN — LOAD MORE LUXURY PAGINATION & ANIMATIONS
   ========================================================================== */
.roven-load-more-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 3rem;
    margin-bottom: 2rem;
    text-align: center;
}

.roven-load-more-status {
    font-size: 0.84rem;
    letter-spacing: 0.4px;
    color: #7A7269;
}

.roven-load-more-status strong {
    color: #1B1717;
    font-weight: 700;
}

.roven-btn-load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #FFFFFF;
    color: #1B1717;
    border: 1.5px solid rgba(181, 141, 74, 0.45);
    padding: 13px 34px;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(181, 141, 74, 0.12);
    cursor: pointer;
    user-select: none;
    text-decoration: none;
}

.roven-btn-load-more:hover {
    background: #810100;
    color: #FFFFFF;
    border-color: #810100;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(129, 1, 0, 0.22);
}

.roven-btn-load-more:active {
    transform: translateY(0);
}

.roven-btn-load-more .roven-load-more-badge {
    background: rgba(181, 141, 74, 0.18);
    color: #8a6519;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 3px 9px;
    border-radius: 999px;
    transition: all 0.3s ease;
}

.roven-btn-load-more:hover .roven-load-more-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
}

@@keyframes rovenFadeInUp {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ==========================================================================
   MAISON ROVEN — CATALOG VIEW SWITCHER & LUXURY SORT DROPDOWN
   ========================================================================== */
.roven-view-switcher {
    display: inline-flex;
    align-items: center;
    background: #FAF8F5;
    border: 1px solid rgba(181, 141, 74, 0.3);
    border-radius: 12px;
    padding: 3px;
    gap: 3px;
    box-shadow: 0 1px 4px rgba(27, 23, 23, 0.03);
}

.roven-view-btn {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: #8c8278;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
}

.roven-view-btn:hover {
    color: #1B1717;
    background: rgba(181, 141, 74, 0.12);
}

.roven-view-btn.active {
    background: #810100;
    color: #dfb15b;
    box-shadow: 0 2px 8px rgba(129, 1, 0, 0.25);
}

/* Custom Luxury Sort Dropdown */
.roven-luxury-sort-wrapper {
    position: relative;
    display: inline-block;
}

.roven-sort-btn {
    background: #FFFFFF;
    border: 1px solid rgba(181, 141, 74, 0.32);
    border-radius: 12px;
    padding: 7px 14px;
    font-size: 0.85rem;
    color: #1B1717;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(27, 23, 23, 0.03);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    white-space: nowrap;
}

.roven-sort-btn:hover {
    border-color: #b58d4a;
    box-shadow: 0 4px 12px rgba(181, 141, 74, 0.15);
    background: #FAF8F5;
}

.roven-sort-btn.active,
.roven-sort-btn[aria-expanded="true"] {
    border-color: #810100;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(129, 1, 0, 0.1);
}

.roven-sort-label-lead {
    color: #8c8278;
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.roven-sort-current-val {
    color: #810100;
    font-weight: 700;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.roven-sort-chevron {
    color: #b58d4a;
    font-size: 0.72rem;
    transition: transform 0.25s ease, color 0.25s ease;
    margin-inline-start: 4px;
}

.roven-sort-btn[aria-expanded="true"] .roven-sort-chevron {
    transform: rotate(180deg);
    color: #810100;
}

.roven-sort-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 215px;
    background: #FFFFFF;
    border: 1px solid rgba(181, 141, 74, 0.32);
    border-radius: 14px;
    box-shadow: 0 12px 36px rgba(27, 23, 23, 0.14), 0 2px 8px rgba(181, 141, 74, 0.12);
    padding: 6px;
    z-index: 1060;
    display: none;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.roven-sort-menu.show {
    display: block;
    opacity: 1;
    transform: translateY(0);
}

.roven-sort-item {
    width: 100%;
    border: none;
    background: transparent;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #2B2523;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: pointer;
    text-align: left;
    transition: all 0.16s ease;
    white-space: nowrap;
}

.roven-sort-item:hover {
    background: #FAF6ED;
    color: #810100;
}

.roven-sort-item.active {
    background: linear-gradient(135deg, rgba(129, 1, 0, 0.08) 0%, rgba(181, 141, 74, 0.14) 100%);
    color: #810100;
    font-weight: 700;
}

.roven-sort-check {
    font-size: 0.74rem;
    color: #b58d4a;
    display: none;
}

.roven-sort-item.active .roven-sort-check {
    display: inline-block;
}

/* ==========================================================================
   MOBILE RESPONSIVE 1-COL vs 2-COL CATALOG CARD MODES
   ========================================================================== */
@@media (max-width: 767.98px) {
    .roven-view-btn {
        width: 32px;
        height: 32px;
    }
    .roven-sort-btn {
        padding: 6px 10px;
        font-size: 0.78rem;
        gap: 5px;
    }
    .roven-sort-label-lead {
        font-size: 0.66rem;
    }

    /* 2 Columns Mode on Mobile / Small Screens */
    #rovenProductGridRow.roven-mobile-grid-2 {
        --bs-gutter-x: 0.65rem !important;
        --bs-gutter-y: 0.75rem !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-catalog-card-col {
        flex: 0 0 auto !important;
        width: 50% !important;
        max-width: 50% !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-store-flacon-card {
        border-radius: 14px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .product-image-container {
        height: 165px !important;
        border-radius: 14px 14px 0 0 !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-store-flacon-card > div:last-child {
        padding: 0.65rem 0.65rem 0.75rem !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-product-cat-wrap {
        margin-bottom: 0.35rem !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-product-cat-badge {
        font-size: 0.58rem !important;
        padding: 2px 7px !important;
        letter-spacing: 0.4px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-product-title {
        font-size: 0.92rem !important;
        line-height: 1.22 !important;
        margin-bottom: 0.25rem !important;
        min-height: 2.25rem !important;
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        overflow: hidden !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-product-tagline {
        display: none !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-card-footer {
        padding-top: 0.5rem !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 6px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-price-label {
        font-size: 0.55rem !important;
        margin-bottom: 2px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-price-val {
        font-size: 1.05rem !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-price-curr {
        font-size: 0.65rem !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-btn-add-bag {
        width: 100% !important;
        justify-content: center !important;
        padding: 5px 8px !important;
        font-size: 0.74rem !important;
        gap: 5px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-2 .roven-badge-featured,
    #rovenProductGridRow.roven-mobile-grid-2 .roven-badge-out-of-stock {
        font-size: 0.56rem !important;
        padding: 2px 6px !important;
    }

    /* 1 Column Mode on Mobile / Small Screens */
    #rovenProductGridRow.roven-mobile-grid-1 .roven-catalog-card-col {
        flex: 0 0 auto !important;
        width: 100% !important;
        max-width: 100% !important;
    }
    #rovenProductGridRow.roven-mobile-grid-1 .product-image-container {
        height: 260px !important;
    }
    #rovenProductGridRow.roven-mobile-grid-1 .roven-product-title {
        font-size: 1.25rem !important;
    }
}
</style>

<div class="container roven-catalog-container">
    <!-- Luxury Maison ROVEN Breadcrumb -->
    <nav aria-label="breadcrumb">
        <div class="roven-breadcrumb-nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
            @if (string.IsNullOrWhiteSpace(Model.SelectedCategoryName))
            {
                <span class="breadcrumb-current">Catalog</span>
            }
            else
            {
                <a asp-controller="Store" asp-action="Index">Catalog</a>
                <i class="fa-solid fa-chevron-right breadcrumb-sep"></i>
                <span class="breadcrumb-current">@Model.SelectedCategoryName</span>
            }
        </div>
    </nav>

    <!-- Mobile Filter Toggle Bar -->
    <div class="roven-mobile-filter-bar d-lg-none">
        <button class="roven-filter-collapse-btn @(activeFiltersCount > 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#rovenFilterCard" aria-expanded="@(activeFiltersCount > 0 ? "true" : "false")" aria-controls="rovenFilterCard">
            <span class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders" style="color: #810100;"></i>
                <span>Filter</span>
                @if (activeFiltersCount > 0)
                {
                    <span class="roven-filter-active-count">@activeFiltersCount</span>
                }
            </span>
            <i class="fa-solid fa-chevron-down roven-filter-chevron"></i>
        </button>
    </div>

    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-12 col-lg-3 roven-filter-sidebar-col">
            <div class="roven-filter-collapse-wrap collapse d-lg-block @(activeFiltersCount > 0 ? "show" : "")" id="rovenFilterCard">
                <div class="roven-filter-card">
                <div class="roven-filter-header">
                    <div class="roven-filter-title-wrap">
                        <div class="roven-filter-icon-badge" aria-hidden="true">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <h5 class="roven-filter-title">
                            Filters
                            @if (activeFiltersCount > 0)
                            {
                                <span class="roven-filter-active-count" title="@activeFiltersCount فلتر نشط">@activeFiltersCount</span>
                            }
                        </h5>
                    </div>
                    @if (activeFiltersCount > 0 || !string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-action="Index" onclick="applyFilterAjax(this.href); return false;" class="roven-filter-reset-link" title="إلغاء جميع الفلاتر">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>Clear All</span>
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small" style="font-size: 0.76rem; letter-spacing: 0.5px;">All Filters</span>
                    }
                </div>

                <form method="get" asp-action="Index" id="catalog-filter-form" onsubmit="event.preventDefault(); applyFilterAjax();">
                    <!-- Search Field Preservation -->
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <input type="hidden" name="search" value="@Model.SearchTerm" />
                    }

                    <!-- Sort Preservation -->
                    <input type="hidden" name="sort" id="form-sort-input" value="@Model.CurrentSort" />

                    <!-- Categories Section -->
                    <div class="mb-2">
                        <div class="roven-filter-section-label">
                            <span>CATEGORY</span>
                            <span class="text-muted font-monospace" style="font-size: 0.68rem;">@((Model.Categories?.Count ?? 0) + 1) ITEMS</span>
                        </div>
                        <div class="roven-category-list">
                            <!-- All Categories Item -->
                            <label class="roven-category-item" for="cat-all">
                                <input type="radio" name="categoryId" id="cat-all" value="" @(Model.SelectedCategoryId == null ? "checked" : "") onchange="applyFilterAjax()" />
                                <span class="roven-category-label">
                                    <span class="roven-cat-left">
                                        <span class="roven-custom-radio"><i class="fa-solid fa-check"></i></span>
                                        <span class="roven-cat-name">All Categories</span>
                                    </span>
                                    <span class="roven-cat-count">@Model.TotalCount</span>
                                </span>
                            </label>

                            @foreach (var c in Model.Categories ?? Enumerable.Empty<Stockify.ViewModels.Store.StoreCategoryViewModel>())
                            {
                                <label class="roven-category-item" for="cat-@c.Id">
                                    <input type="radio" name="categoryId" id="cat-@c.Id" value="@c.Id" @(Model.SelectedCategoryId == c.Id ? "checked" : "") onchange="applyFilterAjax()" />
                                    <span class="roven-category-label">
                                        <span class="roven-cat-left">
                                            <span class="roven-custom-radio"><i class="fa-solid fa-check"></i></span>
                                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                                            {
                                                <img src="@c.ImageUrl" alt="@c.Name" loading="lazy" decoding="async" class="rounded-circle border" style="width: 20px; height: 20px; object-fit: cover; margin-inline-end: 6px;" onerror="this.remove();" />
                                            }
                                            <span class="roven-cat-name">@c.Name</span>
                                        </span>
                                        <span class="roven-cat-count">@c.ProductsCount</span>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- In-Stock Only Switch Box -->
                    <div class="roven-stock-toggle-box">
                        <label class="roven-stock-toggle-label" for="inStockCheck">
                            <div class="roven-stock-meta">
                                <span class="roven-stock-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                                <div>
                                    <span class="roven-stock-text-main">In-Stock Only</span>
                                    <span class="roven-stock-text-sub">جاهز للتوصيل الفوري</span>
                                </div>
                            </div>
                            <div class="roven-switch">
                                <input type="checkbox" name="inStockOnly" value="true" id="inStockCheck" @(Model.InStockOnly ? "checked" : "") onchange="applyFilterAjax()" />
                                <span class="roven-slider"></span>
                            </div>
                        </label>
                    </div>
                </form>
            </div>
            </div>
        </div>

        <!-- Product Grid Area -->
        <div class="col-12 col-lg-9" id="rovenProductGridCol">
            @{
                var catalogList = (Model.AllProducts != null && Model.AllProducts.Any()) ? Model.AllProducts : Model.Products;
                const int InitialPageSize = 10;
                int initialMatchingCount = 0;
                foreach (var p in catalogList)
                {
                    var match = (!Model.SelectedCategoryId.HasValue || p.CategoryId == Model.SelectedCategoryId.Value || (p.CategoryIds != null && p.CategoryIds.Contains(Model.SelectedCategoryId.Value)))
                             && (!Model.InStockOnly || !p.IsOutOfStock)
                             && (string.IsNullOrWhiteSpace(Model.SearchTerm) || p.Name.Contains(Model.SearchTerm, StringComparison.OrdinalIgnoreCase));
                    if (match) initialMatchingCount++;
                }
                var hasVisibleProducts = initialMatchingCount > 0;
                int renderedCount = 0;
            }

            @if (!string.IsNullOrWhiteSpace(Model.SearchCorrectionNotice))
            {
                <div class="alert border-0 shadow-xs rounded-4 mb-3 d-flex align-items-center gap-3 p-3" style="background: linear-gradient(135deg, rgba(99, 0, 0, 0.08) 0%, rgba(129, 1, 0, 0.04) 100%); border-right: 4px solid #630000 !important;">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 36px; height: 36px; background-color: #630000; color: #EDEBDD;">
                        <i class="fa-solid fa-sparkles"></i>
                    </div>
                    <div>
                        <span class="small d-block text-muted" style="font-size: 0.78rem;">البحث الذكي لدار ROVEN:</span>
                        <strong style="color: #630000; font-size: 0.92rem;">@Model.SearchCorrectionNotice</strong>
                    </div>
                </div>
            }

            <!-- Catalog Header Controls -->
            <div class="card border-0 shadow-sm p-3 mb-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">
                            @(string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? "All Products" : Model.SelectedCategoryName)
                        </h4>
                        <div class="small text-muted" id="rovenCatalogCountText">
                            @if (initialMatchingCount > InitialPageSize)
                            {
                                <span>Showing <strong>@InitialPageSize</strong> of <strong>@initialMatchingCount</strong> products</span>
                            }
                            else
                            {
                                <span>Showing <strong>@initialMatchingCount</strong> product@(initialMatchingCount == 1 ? "" : "s")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <span> matching "<strong>@Model.SearchTerm</strong>"</span>
                            }
                        </div>
                    </div>

                    <!-- Right Controls: View Switcher (1 or 2 cols on mobile) + Luxury Sort Dropdown -->
                    <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 flex-wrap">
                        <!-- Luxury View Mode Switcher (Mobile / Small Screens) -->
                        <div class="roven-view-switcher d-inline-flex d-md-none" role="group" aria-label="Layout view mode">
                            <button type="button" class="roven-view-btn" id="rovenViewBtn1" onclick="setCatalogViewMode('1')" title="عرض منتج واحد في الصف (Single Row)" aria-label="Single column">
                                <svg width="16" height="16" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="2.5" y1="4.5" x2="15.5" y2="4.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                                    <line x1="2.5" y1="9" x2="15.5" y2="9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                                    <line x1="2.5" y1="13.5" x2="15.5" y2="13.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                                </svg>
                            </button>
                            <button type="button" class="roven-view-btn active" id="rovenViewBtn2" onclick="setCatalogViewMode('2')" title="عرض منتجين جنب بعض (Two Columns)" aria-label="Two columns">
                                <svg width="16" height="16" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="2.5" width="4.5" height="13" rx="1.4" stroke="currentColor" stroke-width="1.8"/>
                                    <rect x="10.5" y="2.5" width="4.5" height="13" rx="1.4" stroke="currentColor" stroke-width="1.8"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Luxury Sort Dropdown -->
                        @{
                            var sortDict = new Dictionary<string, string>
                            {
                                { "newest", "Newest First" },
                                { "price_asc", "Price: Low to High" },
                                { "price_desc", "Price: High to Low" },
                                { "name_asc", "Product Name (A-Z)" }
                            };
                            var curSortKey = Model.CurrentSort ?? "newest";
                            var curSortLabel = sortDict.ContainsKey(curSortKey) ? sortDict[curSortKey] : "Newest First";
                        }
                        <div class="roven-luxury-sort-wrapper position-relative">
                            <!-- Hidden native select for fallback & form compatibility -->
                            <select class="d-none" id="rovenNativeSortSelect" onchange="applySorting(this.value)">
                                <option value="newest" selected="@(curSortKey == "newest")">Newest First</option>
                                <option value="price_asc" selected="@(curSortKey == "price_asc")">Price: Low to High</option>
                                <option value="price_desc" selected="@(curSortKey == "price_desc")">Price: High to Low</option>
                                <option value="name_asc" selected="@(curSortKey == "name_asc")">Product Name (A-Z)</option>
                            </select>

                            <!-- Custom Luxury Trigger Button -->
                            <button type="button" class="roven-sort-btn" id="rovenSortDropdownBtn" onclick="toggleRovenSortDropdown(event)" aria-expanded="false" aria-haspopup="true">
                                <span class="roven-sort-label-lead">Sort By:</span>
                                <span class="roven-sort-current-val" id="rovenSortCurrentValLabel">@curSortLabel</span>
                                <i class="fa-solid fa-chevron-down roven-sort-chevron"></i>
                            </button>

                            <!-- Custom Luxury Menu -->
                            <div class="roven-sort-menu" id="rovenSortMenu" role="menu">
                                @foreach (var kvp in sortDict)
                                {
                                    var isActive = kvp.Key == curSortKey;
                                    <button type="button" class="roven-sort-item @(isActive ? "active" : "")" data-sort-val="@kvp.Key" onclick="selectRovenSort('@kvp.Key', '@kvp.Value')" role="menuitem">
                                        <span>@kvp.Value</span>
                                        <i class="fa-solid fa-check roven-sort-check"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Filter Tags -->
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SelectedCategoryId.HasValue || Model.InStockOnly)
                {
                    <div class="d-flex flex-wrap gap-2 pt-3 mt-3 border-top align-items-center">
                        <span class="small text-muted me-1">Active Filters:</span>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                Search: @Model.SearchTerm
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-sort="@Model.CurrentSort" onclick="applyFilterAjax(this.href); return false;" class="text-secondary text-decoration-none"><i class="bi bi-x"></i></a>
                            </span>
                        }
                        @if (Model.SelectedCategoryId.HasValue)
                        {
                            <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                Category: @Model.SelectedCategoryName
                                <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.CurrentSort" onclick="applyFilterAjax(this.href); return false;" class="text-secondary text-decoration-none"><i class="bi bi-x"></i></a>
                            </span>
                        }
                        @if (Model.InStockOnly)
                        {
                            <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                In Stock Only
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.CurrentSort" onclick="applyFilterAjax(this.href); return false;" class="text-secondary text-decoration-none"><i class="bi bi-x"></i></a>
                            </span>
                        }
                    </div>
                }
            </div>

            <!-- Products Grid -->
            <div class="row g-4 roven-mobile-grid-2" id="rovenProductGridRow">
                @foreach (var product in catalogList)
                {
                    var isFilterMatch = (!Model.SelectedCategoryId.HasValue || product.CategoryId == Model.SelectedCategoryId.Value || (product.CategoryIds != null && product.CategoryIds.Contains(Model.SelectedCategoryId.Value)))
                                          && (!Model.InStockOnly || !product.IsOutOfStock)
                                          && (string.IsNullOrWhiteSpace(Model.SearchTerm) || product.Name.Contains(Model.SearchTerm, StringComparison.OrdinalIgnoreCase));
                    var isInitiallyVisible = false;
                    var isPagedHidden = false;

                    if (isFilterMatch)
                    {
                        renderedCount++;
                        if (renderedCount <= InitialPageSize)
                        {
                            isInitiallyVisible = true;
                        }
                        else
                        {
                            isPagedHidden = true;
                        }
                    }

                    <div class="col-12 col-sm-6 col-xl-4 roven-catalog-card-col"
                         data-product-id="@product.Id"
                         data-category-id="@product.CategoryId"
                         data-category-ids="@string.Join(",", (product.CategoryIds != null && product.CategoryIds.Any()) ? product.CategoryIds : new List<int> { product.CategoryId })"
                         data-in-stock="@(!product.IsOutOfStock ? "true" : "false")"
                         data-price="@product.Price"
                         data-name="@product.Name.ToLowerInvariant()"
                         data-paged-hidden="@(isPagedHidden ? "true" : null)"
                         style="@(isInitiallyVisible ? "" : "display: none;")">
                        <div class="product-card roven-store-flacon-card" data-details-url="@Url.Action("Details", "Store", new { id = product.Id })">
                            <a asp-action="Details" asp-route-id="@product.Id" class="product-image-container d-block text-decoration-none position-relative" title="عرض تفاصيل عطر @product.Name">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    if (isInitiallyVisible && renderedCount <= 2)
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" loading="eager" fetchpriority="high" decoding="async" onload="this.classList.add('loaded'); this.closest('.product-image-container')?.classList.add('is-loaded');" onerror="this.onerror=null;this.src='/images/products/perfume_default.svg';" />
                                    }
                                    else
                                    {
                                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" data-src="@product.ImageUrl" alt="@product.Name" class="roven-lazy-img" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/products/perfume_default.svg';" />
                                    }
                                }
                                else
                                {
                                    <i class="fa-solid fa-spray-can-sparkles text-muted display-4"></i>
                                }

                                @if (product.IsFeatured)
                                {
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="roven-badge-featured"><i class="fa-solid fa-gem me-1 text-warning"></i>Featured</span>
                                    </div>
                                }

                                @if (product.IsOutOfStock)
                                {
                                    <div class="position-absolute bottom-0 start-0 m-2">
                                        <span class="roven-badge-out-of-stock"><i class="fa-solid fa-clock-rotate-left me-1"></i>Allocated</span>
                                    </div>
                                }
                            </a>

                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <div class="roven-product-cat-wrap">
                                    <span class="roven-product-cat-badge">
                                        <span class="roven-cat-dot" aria-hidden="true"></span>
                                        <span>@product.CategoryName</span>
                                    </span>
                                </div>

                                <h4 class="roven-product-title">
                                    <a asp-action="Details" asp-route-id="@product.Id" title="عرض تفاصيل عطر @product.Name">
                                        @product.Name
                                    </a>
                                </h4>

                                <div class="roven-product-tagline">
                                    <span>@(string.IsNullOrWhiteSpace(product.FragranceTagline) ? Model.DefaultFragranceTagline : product.FragranceTagline)</span>
                                </div>

                                <partial name="_ProductCardSizes" model="product" />

                                <div class="roven-card-footer">
                                    <div>
                                        <div class="roven-price-label">Price</div>
                                        <div class="roven-price-val">
                                            @product.Price.ToString("N2") <span class="roven-price-curr">EGP</span>
                                        </div>
                                    </div>

                                    @if (product.IsOutOfStock)
                                    {
                                        <button class="btn btn-sm btn-secondary rounded-pill px-3 py-1" disabled style="font-size: 0.78rem;">Unavailable</button>
                                    }
                                    else if (product.IsTester)
                                    {
                                        <a asp-action="Details" asp-route-id="@product.Id" class="roven-btn-add-bag text-decoration-none" title="اختر @product.TesterRequiredCount عطور للتيستر">
                                            <i class="fa-solid fa-vials"></i><span>اختر @product.TesterRequiredCount</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="roven-btn-add-bag" data-size-id="@product.DefaultSizeId" onclick="window.addStoreItemToCart(@product.Id, 1, this)" title="Add to Bag">
                                            <i class="fa-solid fa-bag-shopping"></i><span>Add</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Empty State (Shown when 0 cards match current filters) -->
                <div class="col-12 roven-empty-state" style="@(hasVisibleProducts ? "display: none;" : "")">
                    <div class="card border-0 shadow-sm p-5 text-center">
                        <i class="bi bi-search text-muted display-3 mb-3"></i>
                        <h4 class="fw-bold text-dark">No Products Found</h4>
                        <p class="text-muted mb-4">We couldn't find any products matching your selected filters or search terms.</p>
                        <div>
                            <a asp-action="Index" onclick="resetAllFiltersFast(); return false;" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Filters
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Luxury Load More Button -->
            <div class="roven-load-more-wrap" id="rovenLoadMoreContainer" style="@(initialMatchingCount > InitialPageSize ? "" : "display: none;")">
                <div class="roven-load-more-status" id="rovenLoadMoreStatus">
                    Showing <strong id="rovenCurrentShownCount">@(Math.Min(initialMatchingCount, InitialPageSize))</strong> of <strong id="rovenTotalMatchCount">@initialMatchingCount</strong> products
                </div>
                <button type="button" id="rovenLoadMoreBtn" class="roven-btn-load-more" onclick="loadMoreCatalogProducts()" aria-label="More Products">
                    <i class="fa-solid fa-sparkles text-gold"></i>
                    <span>More Products</span>
                    <span class="badge roven-load-more-badge" id="rovenRemainingCountBadge">
                        +@(Math.Max(0, initialMatchingCount - InitialPageSize))
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ======================================================================
    // 0. CATALOG VIEW MODE SWITCHER (1 COLUMN vs 2 COLUMNS ON MOBILE)
    // ======================================================================
    function setCatalogViewMode(mode) {
        const grid = document.getElementById('rovenProductGridRow');
        const btn1 = document.getElementById('rovenViewBtn1');
        const btn2 = document.getElementById('rovenViewBtn2');

        if (!grid) return;

        if (mode === '1') {
            grid.classList.remove('roven-mobile-grid-2');
            grid.classList.add('roven-mobile-grid-1');
            if (btn1) btn1.classList.add('active');
            if (btn2) btn2.classList.remove('active');
            try { localStorage.setItem('roven_catalog_view_mode', '1'); } catch(e) {}
        } else {
            grid.classList.remove('roven-mobile-grid-1');
            grid.classList.add('roven-mobile-grid-2');
            if (btn1) btn1.classList.remove('active');
            if (btn2) btn2.classList.add('active');
            try { localStorage.setItem('roven_catalog_view_mode', '2'); } catch(e) {}
        }
        if (window.rovenInitLazyImages) window.rovenInitLazyImages();
    }

    // ======================================================================
    // 0.1 LUXURY SORT DROPDOWN TOGGLE & SELECT HANDLERS
    // ======================================================================
    function toggleRovenSortDropdown(event) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        const menu = document.getElementById('rovenSortMenu');
        const btn = document.getElementById('rovenSortDropdownBtn');
        if (!menu || !btn) return;

        const isShown = menu.classList.contains('show');
        if (isShown) {
            menu.classList.remove('show');
            btn.setAttribute('aria-expanded', 'false');
        } else {
            menu.classList.add('show');
            btn.setAttribute('aria-expanded', 'true');
        }
    }

    function selectRovenSort(sortVal, sortLabel) {
        const labelEl = document.getElementById('rovenSortCurrentValLabel');
        if (labelEl) labelEl.textContent = sortLabel;

        const items = document.querySelectorAll('.roven-sort-item');
        items.forEach(it => {
            if (it.dataset.sortVal === sortVal) {
                it.classList.add('active');
            } else {
                it.classList.remove('active');
            }
        });

        const nativeSelect = document.getElementById('rovenNativeSortSelect');
        if (nativeSelect) nativeSelect.value = sortVal;

        const menu = document.getElementById('rovenSortMenu');
        const btn = document.getElementById('rovenSortDropdownBtn');
        if (menu) menu.classList.remove('show');
        if (btn) btn.setAttribute('aria-expanded', 'false');

        applySorting(sortVal);
    }

    // Close sort dropdown when clicking anywhere outside
    document.addEventListener('click', function(e) {
        const wrapper = document.querySelector('.roven-luxury-sort-wrapper');
        const menu = document.getElementById('rovenSortMenu');
        const btn = document.getElementById('rovenSortDropdownBtn');
        if (wrapper && !wrapper.contains(e.target)) {
            if (menu) menu.classList.remove('show');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        }
    });

    // Initialize View Mode on Page Load
    document.addEventListener('DOMContentLoaded', function() {
        let savedMode = '2'; // Default to 2 columns on mobile
        try {
            savedMode = localStorage.getItem('roven_catalog_view_mode') || '2';
        } catch(e) {}
        setCatalogViewMode(savedMode);
    });

    function resetAllFiltersFast() {
        const form = document.getElementById('catalog-filter-form');
        if (form) {
            const allRadio = document.getElementById('cat-all');
            if (allRadio) allRadio.checked = true;
            const inStock = document.getElementById('inStockCheck');
            if (inStock) inStock.checked = false;
            const searchInput = form.querySelector('input[name="search"]');
            if (searchInput) searchInput.value = '';
            applyFilterAjax('/Store');
        }
    }

    function applySorting(sortValue) {
        const sortInput = document.getElementById('form-sort-input');
        if (sortInput) sortInput.value = sortValue;
        applyFilterAjax();
    }

    function applyFilterAjax(customUrl = null) {
        const form = document.getElementById('catalog-filter-form');
        if (!form && !customUrl) return;

        let selectedCatId = '';
        let inStockOnly = false;
        let sortValue = 'newest';
        let searchTerm = '';

        if (customUrl) {
            try {
                const urlObj = new URL(customUrl, window.location.origin);
                selectedCatId = urlObj.searchParams.get('categoryId') || '';
                inStockOnly = urlObj.searchParams.get('inStockOnly') === 'true';
                sortValue = urlObj.searchParams.get('sort') || 'newest';
                searchTerm = urlObj.searchParams.get('search') || '';

                if (form) {
                    const radios = form.querySelectorAll('input[name="categoryId"]');
                    radios.forEach(r => { r.checked = (r.value === selectedCatId); });
                    const stockCb = document.getElementById('inStockCheck');
                    if (stockCb) stockCb.checked = inStockOnly;
                    const sortInput = document.getElementById('form-sort-input');
                    if (sortInput) sortInput.value = sortValue;
                    const sortSelect = document.querySelector('select[onchange*="applySorting"]');
                    if (sortSelect) sortSelect.value = sortValue;
                }
            } catch(e) {}
        } else if (form) {
            const catRadio = form.querySelector('input[name="categoryId"]:checked');
            if (catRadio) selectedCatId = catRadio.value;
            const stockCb = document.getElementById('inStockCheck');
            if (stockCb) stockCb.checked = stockCb.checked;
            const sortInput = document.getElementById('form-sort-input');
            if (sortInput) sortValue = sortInput.value || 'newest';
            const searchInput = form.querySelector('input[name="search"]');
            if (searchInput) searchTerm = searchInput.value || '';
        }

        // Sync Custom Luxury Sort Dropdown UI
        const sortLabelsMap = {
            'newest': 'Newest First',
            'price_asc': 'Price: Low to High',
            'price_desc': 'Price: High to Low',
            'name_asc': 'Product Name (A-Z)'
        };
        const currentSortLabel = sortLabelsMap[sortValue] || 'Newest First';
        const sortValLabelEl = document.getElementById('rovenSortCurrentValLabel');
        if (sortValLabelEl) sortValLabelEl.textContent = currentSortLabel;
        const sortItems = document.querySelectorAll('.roven-sort-item');
        sortItems.forEach(it => {
            if (it.dataset.sortVal === sortValue) it.classList.add('active');
            else it.classList.remove('active');
        });
        const nativeSort = document.getElementById('rovenNativeSortSelect');
        if (nativeSort) nativeSort.value = sortValue;

        // ======================================================================
        // 1. INSTANT CLIENT-SIDE FILTERING & 10-PRODUCT PAGINATION
        // ======================================================================
        const PAGE_SIZE = 10;
        const cards = Array.from(document.querySelectorAll('.roven-catalog-card-col'));

        // Instant sorting in DOM if needed (performed first to preserve sort order)
        const gridRow = document.getElementById('rovenProductGridRow');
        if (gridRow && cards.length > 0) {
            cards.sort((a, b) => {
                const priceA = parseFloat(a.dataset.price) || 0;
                const priceB = parseFloat(b.dataset.price) || 0;
                const nameA = a.dataset.name || '';
                const nameB = b.dataset.name || '';
                const idA = parseInt(a.dataset.productId) || 0;
                const idB = parseInt(b.dataset.productId) || 0;

                if (sortValue === 'price_asc') return priceA - priceB;
                if (sortValue === 'price_desc') return priceB - priceA;
                if (sortValue === 'name_asc') return nameA.localeCompare(nameB);
                if (sortValue === 'name_desc') return nameB.localeCompare(nameA);
                return idB - idA;
            });
            cards.forEach(c => gridRow.appendChild(c));
        }

        let totalMatching = 0;
        let shownCount = 0;

        cards.forEach(card => {
            const cardCat = card.dataset.categoryId;
            const cardCatIds = (card.dataset.categoryIds || cardCat || '').split(',').map(s => s.trim());
            const cardInStock = card.dataset.inStock === 'true';
            const cardName = card.dataset.name || '';

            const catMatch = !selectedCatId || cardCatIds.includes(selectedCatId.toString());
            const stockMatch = !inStockOnly || cardInStock;
            const searchMatch = !searchTerm || cardName.includes(searchTerm.toLowerCase());

            if (catMatch && stockMatch && searchMatch) {
                totalMatching++;
                if (totalMatching <= PAGE_SIZE) {
                    card.style.display = '';
                    card.removeAttribute('data-paged-hidden');
                    shownCount++;
                } else {
                    card.style.display = 'none';
                    card.setAttribute('data-paged-hidden', 'true');
                }
            } else {
                card.style.display = 'none';
                card.removeAttribute('data-paged-hidden');
            }
        });

        // Update counter & title instantly
        const countText = document.querySelector('#rovenProductGridCol .small.text-muted');
        if (countText) {
            if (totalMatching > PAGE_SIZE) {
                countText.innerHTML = `Showing <strong>${shownCount}</strong> of <strong>${totalMatching}</strong> products${searchTerm ? ` matching "<strong>${searchTerm}</strong>"` : ''}`;
            } else {
                countText.innerHTML = `Showing <strong>${totalMatching}</strong> product${totalMatching === 1 ? '' : 's'}${searchTerm ? ` matching "<strong>${searchTerm}</strong>"` : ''}`;
            }
        }

        // Update Load More container
        const loadMoreContainer = document.getElementById('rovenLoadMoreContainer');
        const remainingBadge = document.getElementById('rovenRemainingCountBadge');
        const shownCountEl = document.getElementById('rovenCurrentShownCount');
        const totalCountEl = document.getElementById('rovenTotalMatchCount');
        const remainingCount = totalMatching - shownCount;

        if (totalMatching > PAGE_SIZE) {
            if (loadMoreContainer) loadMoreContainer.style.display = '';
            if (remainingBadge) remainingBadge.textContent = '+' + remainingCount;
            if (shownCountEl) shownCountEl.textContent = shownCount;
            if (totalCountEl) totalCountEl.textContent = totalMatching;
        } else {
            if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        }

        const headerTitle = document.querySelector('#rovenProductGridCol h4');
        if (headerTitle) {
            if (!selectedCatId) {
                headerTitle.textContent = 'All Products';
            } else {
                const checkedRadio = document.querySelector(`input[name="categoryId"][value="${selectedCatId}"]`);
                if (checkedRadio) {
                    const label = checkedRadio.closest('label');
                    const catNameEl = label ? label.querySelector('.roven-cat-name') : null;
                    if (catNameEl) headerTitle.textContent = catNameEl.textContent.trim();
                }
            }
        }

        // Toggle empty state instantly
        const emptyState = document.querySelector('.roven-empty-state');
        if (emptyState) {
            emptyState.style.display = (totalMatching === 0) ? '' : 'none';
        }
        if (window.rovenInitLazyImages) window.rovenInitLazyImages();

        // Update Clear All link in filter header
        const filterHeader = document.querySelector('.roven-filter-head');
        if (filterHeader) {
            const hasActiveFilters = Boolean(selectedCatId || inStockOnly || searchTerm);
            let clearLink = filterHeader.querySelector('.roven-filter-reset-link');
            if (hasActiveFilters && !clearLink) {
                const allFiltersSpan = filterHeader.querySelector('span.text-muted');
                if (allFiltersSpan) allFiltersSpan.remove();
                clearLink = document.createElement('a');
                clearLink.className = 'roven-filter-reset-link';
                clearLink.href = '/Store';
                clearLink.onclick = function() { resetAllFiltersFast(); return false; };
                clearLink.title = 'إلغاء جميع الفلاتر';
                clearLink.innerHTML = '<i class="fa-solid fa-rotate-left"></i><span>Clear All</span>';
                filterHeader.appendChild(clearLink);
            } else if (!hasActiveFilters && clearLink) {
                clearLink.remove();
                const span = document.createElement('span');
                span.className = 'text-muted small';
                span.style.cssText = 'font-size: 0.76rem; letter-spacing: 0.5px;';
                span.textContent = 'All Filters';
                filterHeader.appendChild(span);
            }
        }

        // ======================================================================
        // 2. URL HISTORY UPDATE
        // ======================================================================
        let targetUrl;
        if (customUrl) {
            targetUrl = customUrl;
        } else {
            const params = new URLSearchParams();
            if (selectedCatId) params.append('categoryId', selectedCatId);
            if (inStockOnly) params.append('inStockOnly', 'true');
            if (sortValue && sortValue !== 'newest') params.append('sort', sortValue);
            if (searchTerm) params.append('search', searchTerm);
            const qs = params.toString();
            targetUrl = '/Store' + (qs ? ('?' + qs) : '');
        }

        if (window.history && window.history.replaceState) {
            window.history.replaceState({ url: targetUrl }, '', targetUrl);
        }

        // ======================================================================
        // 3. SILENT BACKGROUND SYNC (Non-blocking, zero dimming, pure speed)
        // ======================================================================
        fetch(targetUrl, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.text();
        })
        .then(html => {
            // Update active filters strip if present
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const currentActiveTags = document.querySelector('#rovenProductGridCol .border-top.d-flex.flex-wrap');
            const newActiveTags = doc.querySelector('#rovenProductGridCol .border-top.d-flex.flex-wrap');
            if (currentActiveTags && newActiveTags) {
                currentActiveTags.innerHTML = newActiveTags.innerHTML;
            } else if (!currentActiveTags && newActiveTags) {
                const headerCard = document.querySelector('#rovenProductGridCol .card');
                if (headerCard) headerCard.appendChild(newActiveTags);
            } else if (currentActiveTags && !newActiveTags) {
                currentActiveTags.remove();
            }
        })
        .catch(err => {
            console.warn('Background filter sync note:', err);
        });
    }

    function loadMoreCatalogProducts() {
        const PAGE_SIZE = 10;
        const hiddenCards = Array.from(document.querySelectorAll('.roven-catalog-card-col')).filter(c => c.getAttribute('data-paged-hidden') === 'true' || c.hasAttribute('data-paged-hidden'));
        if (hiddenCards.length === 0) return;

        const toShow = hiddenCards.slice(0, PAGE_SIZE);
        toShow.forEach((card, idx) => {
            card.removeAttribute('data-paged-hidden');
            card.style.display = '';
            card.style.animation = `rovenFadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards ${idx * 0.04}s`;
        });

        // Recalculate remaining hidden cards
        const remainingHidden = Array.from(document.querySelectorAll('.roven-catalog-card-col')).filter(c => c.getAttribute('data-paged-hidden') === 'true' || c.hasAttribute('data-paged-hidden')).length;
        const allVisibleCards = Array.from(document.querySelectorAll('.roven-catalog-card-col')).filter(c => c.style.display !== 'none');
        const currentlyShown = allVisibleCards.length;
        const totalMatching = currentlyShown + remainingHidden;

        const loadMoreContainer = document.getElementById('rovenLoadMoreContainer');
        const remainingBadge = document.getElementById('rovenRemainingCountBadge');
        const shownCountEl = document.getElementById('rovenCurrentShownCount');
        const totalCountEl = document.getElementById('rovenTotalMatchCount');
        const countText = document.querySelector('#rovenProductGridCol .small.text-muted');

        if (shownCountEl) shownCountEl.textContent = currentlyShown;
        if (totalCountEl) totalCountEl.textContent = totalMatching;
        if (remainingBadge) remainingBadge.textContent = '+' + remainingHidden;

        if (countText) {
            if (remainingHidden > 0) {
                countText.innerHTML = `Showing <strong>${currentlyShown}</strong> of <strong>${totalMatching}</strong> products`;
            } else {
                countText.innerHTML = `Showing <strong>${totalMatching}</strong> product${totalMatching === 1 ? '' : 's'}`;
            }
        }

        if (remainingHidden <= 0) {
            if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        }
        if (window.rovenInitLazyImages) window.rovenInitLazyImages();
    }

    window.addEventListener('popstate', function() {
        applyFilterAjax(window.location.href);
    });
</script>
}

@section SeoStructuredData {
    @{
        var catUrl = Model.SelectedCategoryId.HasValue ? $"https://roven-eg.online/Store?categoryId={Model.SelectedCategoryId.Value}" : "https://roven-eg.online/Store";
        var pageTitle = string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? "كتالوج عطور روفان الرسمية | ROVEN Haute Parfumerie" : $"عطور {Model.SelectedCategoryName} | دار روفان ROVEN";
    }
    <!-- Google BreadcrumbList & CollectionPage Structured Data for Catalog -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "دار روفان",
              "item": "https://roven-eg.online/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "متجر عطور روفان",
              "item": "https://roven-eg.online/Store"
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedCategoryName))
            {
              <text>
              ,{
                "@@type": "ListItem",
                "position": 3,
                "name": "@Model.SelectedCategoryName",
                "item": "@catUrl"
              }
              </text>
            }
          ]
        },
        {
          "@@type": "CollectionPage",
          "name": "@pageTitle",
          "url": "@catUrl",
          "description": "تسوق أرقى عطور النيش والـ Extraits de Parfum من دار روفان ROVEN Haute Parfumerie في مصر.",
          "isPartOf": {
            "@@type": "WebSite",
            "name": "ROVEN Haute Parfumerie",
            "url": "https://roven-eg.online/"
          }
        }
      ]
    }
    </script>
}

