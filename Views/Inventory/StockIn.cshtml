@model Stockify.ViewModels.Inventory.StockInViewModel
@{
    ViewData["Title"] = "Record Inbound Stock (Stock In)";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-in-down text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Record Stock In (Inbound Inventory)</h5>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Inventory
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="StockIn" method="post" id="stockInForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ProductId" class="form-label small fw-semibold text-secondary">
                                Select Product <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ProductId" asp-items="Model.ProductsList" class="form-select" required autofocus>
                                <option value="" disabled selected="@(Model.ProductId == 0 ? "selected" : null)">Choose product to replenish...</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Quantity" class="form-label small fw-semibold text-secondary">
                                Quantity Received <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-plus-lg"></i></span>
                                <input asp-for="Quantity" type="number" class="form-control" placeholder="e.g. 50" min="1" required />
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="SupplierReference" class="form-label small fw-semibold text-secondary">
                                Supplier Name / Purchase Order #
                            </label>
                            <input asp-for="SupplierReference" type="text" class="form-control" placeholder="e.g. Al-Badr Tech PO-1029" />
                            <span asp-validation-for="SupplierReference" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ReceivedDate" class="form-label small fw-semibold text-secondary">
                                Receiving Date
                            </label>
                            <input asp-for="ReceivedDate" type="date" class="form-control" />
                            <span asp-validation-for="ReceivedDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold text-secondary">
                                Batch Notes / Receiving Remarks
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional details, pallet number, warehouse shelf or warranty notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check2-circle me-1"></i>Record Stock In
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
