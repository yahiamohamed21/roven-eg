@using Stockify.Models.Enums
@model Stockify.ViewModels.Store.OrderTrackingViewModel
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Track Your Order";
    ViewData["MetaDescription"] = "Follow your order from the Maison ROVEN atelier to your doorstep with real-time updates, Cash on Delivery, and complete peace of mind across Egypt.";
}

@section Styles {
    <style>
        /* ==========================================================================
           ROVEN Haute Parfumerie - Luxury Order Tracking Page
           Matches bespoke editorial hero + floating ivory card & bronze line icons
           ========================================================================== */

        .roven-track-page {
            background-color: #2B1A12;
            min-height: calc(100vh - 30px);
            display: flex;
            flex-direction: column;
            overflow-x: hidden !important;
            width: 100% !important;
            max-width: 100vw !important;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            padding-bottom: 0;
        }

        .roven-track-scene {
            position: relative;
            flex: 1 0 auto;
            width: 100%;
            background: linear-gradient(180deg, #240305 0%, #3A1614 42%, #573B2B 76%, #3D281D 100%);
            overflow: hidden;
        }

        /* 1. Dark Crimson Satin & ROVEN Flacon Hero Banner */
        .roven-track-hero-banner {
            position: relative;
            width: 100%;
            background: radial-gradient(circle at 20% 45%, #3B0709 0%, #240305 62%, #160203 100%);
            padding: 122px 0 106px;
            min-height: 430px;
            display: flex;
            align-items: center;
            color: #FAF7F2;
            overflow: hidden;
        }

        .roven-track-hero-stage {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 1320px;
            background-image:
                linear-gradient(90deg, #270406 0%, rgba(44, 7, 8, 0.88) 38%, rgba(44, 7, 8, 0.25) 62%, rgba(22, 2, 3, 0.08) 92%, #160203 100%),
                linear-gradient(180deg, rgba(16, 3, 4, 0.55) 0%, rgba(16, 3, 4, 0.05) 38%, rgba(24, 4, 5, 0.50) 100%),
                url('/images/banners/track-order-hero.webp');
            background-size: auto 100%;
            background-position: right center;
            background-repeat: no-repeat;
            pointer-events: none;
            z-index: 1;
        }

        .roven-track-hero-inner {
            width: 100%;
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        .roven-track-hero-copy {
            max-width: 490px;
        }

        .roven-hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
            color: #DFC085;
            font-size: 0.76rem;
            font-weight: 600;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .roven-eyebrow-line {
            display: inline-block;
            width: 34px;
            height: 1px;
            background: linear-gradient(90deg, rgba(223, 192, 133, 0.2), rgba(223, 192, 133, 0.85));
        }

        .roven-eyebrow-line.right {
            background: linear-gradient(90deg, rgba(223, 192, 133, 0.85), rgba(223, 192, 133, 0.2));
        }

        .roven-track-hero-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: clamp(2rem, 5.2vw, 3.2rem);
            font-weight: 700;
            line-height: 1.1;
            color: #FFFDF9;
            margin: 0 0 12px;
            letter-spacing: -0.01em;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
        }

        .roven-track-hero-subtitle {
            font-size: clamp(0.84rem, 2.2vw, 1rem);
            line-height: 1.55;
            color: rgba(248, 241, 232, 0.90);
            margin: 0;
            max-width: 430px;
            font-weight: 400;
        }

        /* Hide Scent Discovery floating CTA on Order Tracking so trust badges remain unobstructed */
        #rovenFindScentFloatingBtn,
        .roven-find-scent-btn {
            display: none !important;
        }

        @@media (max-width: 991.98px) {
            .roven-track-scene {
                padding-bottom: 2.25rem;
            }

            .roven-desktop-scene-bg {
                position: absolute;
                top: 180px;
                left: 0;
                right: 0;
                bottom: -2px;
                width: 100%;
                background-image:
                    linear-gradient(180deg, #240305 0%, rgba(36, 3, 5, 0.55) 18%, rgba(45, 22, 16, 0.08) 48%, rgba(28, 16, 12, 0.25) 100%),
                    url('/images/banners/track-order-hero-desktop.webp');
                background-size: auto 130%;
                background-position: 64% bottom;
                background-repeat: no-repeat;
                pointer-events: none;
                z-index: 1;
            }

            .roven-track-shell {
                position: relative;
                z-index: 2;
            }

            .roven-track-hero-banner {
                background: #240305;
            }

            .roven-track-hero-stage {
                top: 60px;
                background-image:
                    linear-gradient(180deg, #240305 0%, rgba(36, 3, 5, 0) 24%, rgba(36, 3, 5, 0) 76%, rgba(36, 3, 5, 0.90) 100%),
                    linear-gradient(90deg, rgba(36, 4, 5, 0.90) 0%, rgba(52, 7, 9, 0.72) 52%, rgba(24, 4, 5, 0.08) 100%),
                    url('/images/banners/track-order-hero.webp');
                background-size: cover;
                background-position: 86% center;
            }

            .roven-floating-card {
                box-shadow:
                    0 22px 52px rgba(15, 3, 3, 0.42),
                    0 4px 16px rgba(0, 0, 0, 0.14);
            }
        }

        @@media (max-width: 767.98px) {
            .roven-track-hero-banner {
                min-height: 0;
                padding: 86px 0 64px;
                display: block;
            }

            .roven-track-hero-inner {
                padding: 0 18px;
            }

            .roven-track-hero-copy {
                max-width: min(59%, 222px);
            }

            .roven-hero-eyebrow {
                gap: 6px;
                font-size: 0.60rem;
                letter-spacing: 0.2em;
                margin-bottom: 5px;
            }

            .roven-eyebrow-line {
                width: 18px;
            }

            .roven-track-hero-title {
                font-size: clamp(1.52rem, 5.8vw, 1.9rem);
                margin-bottom: 6px;
            }

            .roven-track-hero-subtitle {
                font-size: 0.74rem;
                line-height: 1.44;
            }
        }

        /* 2. Floating Overlapping Ivory Lookup Card */
        .roven-track-card-container {
            max-width: 680px;
            margin: -50px auto 0;
            padding: 0 14px;
            position: relative;
            z-index: 5;
        }

        @@media (max-width: 767.98px) {
            .roven-track-card-container {
                margin-top: -34px;
                padding: 0 12px;
            }
        }

        .roven-floating-card {
            background: linear-gradient(180deg, #FCF8F2 0%, #FBF5ED 100%);
            border: 1px solid rgba(215, 180, 120, 0.34);
            border-radius: 28px;
            box-shadow:
                0 24px 55px rgba(56, 10, 10, 0.14),
                0 4px 16px rgba(27, 23, 23, 0.06);
            padding: 0 38px 34px;
            position: relative;
        }

        @@media (max-width: 575.98px) {
            .roven-floating-card {
                border-radius: 24px;
                padding: 0 18px 20px;
            }
        }

        /* Centered Floating Circular Emblem with Gold Hairlines */
        .roven-card-emblem-header {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 12px;
        }

        .roven-emblem-flank {
            width: 56px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(206, 168, 107, 0.55));
            margin-top: 8px;
        }

        .roven-emblem-flank.right {
            background: linear-gradient(90deg, rgba(206, 168, 107, 0.55), transparent);
        }

        .roven-floating-emblem {
            width: 72px;
            height: 72px;
            margin-top: -36px;
            margin-left: 14px;
            margin-right: 14px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 28%, #830B0B 0%, #580202 68%, #360101 100%);
            border: 2.5px solid #FCF7F0;
            box-shadow:
                0 10px 24px rgba(72, 2, 2, 0.32),
                0 0 0 1px rgba(210, 174, 109, 0.45);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        @@media (max-width: 575.98px) {
            .roven-card-emblem-header {
                margin-bottom: 8px;
            }
            .roven-floating-emblem {
                width: 64px;
                height: 64px;
                margin-top: -32px;
                margin-left: 12px;
                margin-right: 12px;
            }
            .roven-emblem-flank {
                width: 40px;
            }
        }

        .roven-card-heading {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: clamp(1.45rem, 4.6vw, 2.05rem);
            font-weight: 700;
            color: #1A1414;
            text-align: center;
            margin: 0 0 6px;
            letter-spacing: -0.01em;
        }

        .roven-card-subheading {
            font-size: clamp(0.79rem, 2.3vw, 0.94rem);
            color: #5E5248;
            text-align: center;
            max-width: 400px;
            margin: 0 auto 18px;
            line-height: 1.45;
        }

        @@media (max-width: 575.98px) {
            .roven-card-subheading {
                margin-bottom: 15px;
            }
            .roven-field-block {
                margin-bottom: 13px !important;
            }
            .roven-field-label {
                font-size: 0.85rem !important;
                margin-bottom: 6px !important;
            }
            .roven-cream-input-wrap {
                height: 46px !important;
            }
            .btn-roven-track-cta {
                height: 48px !important;
                font-size: 0.98rem !important;
                margin-top: 4px !important;
            }
            .roven-trust-grid {
                gap: 9px !important;
                margin-top: 15px !important;
            }
            .roven-trust-tile {
                padding: 9px 11px !important;
                min-height: 52px !important;
            }
        }

        /* Luxury Warm-Cream Form Inputs */
        .roven-field-block {
            margin-bottom: 18px;
        }

        .roven-field-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            color: #211716;
            margin-bottom: 8px;
        }

        .roven-label-req {
            color: #8E1818;
            font-weight: 700;
            margin-left: 1px;
        }

        .roven-cream-input-wrap {
            display: flex;
            align-items: center;
            background-color: #F4E7DA;
            border: 1px solid #E5D2BE;
            border-radius: 14px;
            height: 50px;
            padding: 0 16px;
            gap: 12px;
            transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        }

        .roven-cream-input-wrap:focus-within {
            background-color: #FFFDF9;
            border-color: #720A0A;
            box-shadow: 0 0 0 3.5px rgba(99, 0, 0, 0.10);
        }

        .roven-cream-input-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #8A6546;
            flex-shrink: 0;
        }

        .roven-cream-input {
            width: 100%;
            border: none;
            background: transparent;
            color: #1F1716;
            font-size: 16px;
            font-weight: 500;
            outline: none !important;
            padding: 0;
            line-height: 1.4;
        }

        .roven-cream-input::placeholder {
            color: #7D7066;
            font-weight: 400;
        }

        .roven-cream-input:-webkit-autofill,
        .roven-cream-input:-webkit-autofill:hover,
        .roven-cream-input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px #F4E7DA inset !important;
            -webkit-text-fill-color: #1F1716 !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Primary Track Order CTA Button */
        .btn-roven-track-cta {
            width: 100%;
            height: 54px;
            border-radius: 9999px;
            border: 1px solid rgba(163, 72, 72, 0.45);
            background: linear-gradient(135deg, #7A0909 0%, #550202 52%, #360202 100%);
            color: #FCF7F0 !important;
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            margin-top: 8px;
            box-shadow:
                0 12px 26px rgba(82, 2, 2, 0.34),
                inset 0 1px 0 rgba(255, 224, 178, 0.18);
            transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
            cursor: pointer;
        }

        .btn-roven-track-cta:hover {
            transform: translateY(-1.5px);
            box-shadow:
                0 15px 30px rgba(82, 2, 2, 0.42),
                inset 0 1px 0 rgba(255, 224, 178, 0.24);
            filter: brightness(1.06);
        }

        .btn-roven-track-cta:active {
            transform: translateY(0);
        }

        .btn-roven-track-cta.is-loading {
            opacity: 0.94;
            cursor: wait;
            pointer-events: none;
            transform: none !important;
        }

        .btn-roven-track-cta .roven-btn-spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(252, 247, 240, 0.35);
            border-top-color: #FCF7F0;
            border-radius: 50%;
            animation: rovenBtnSpin 0.7s linear infinite;
            flex-shrink: 0;
        }

        @@keyframes rovenBtnSpin {
            to { transform: rotate(360deg); }
        }

        /* 2x2 Reassurance Trust Badges Grid */
        .roven-trust-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-top: 24px;
        }

        .roven-trust-tile {
            background-color: #F6ECE0;
            border: 1px solid #EADACB;
            border-radius: 14px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 11px;
            min-height: 62px;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

        .roven-trust-tile:hover {
            background-color: #F3E6D8;
            border-color: #DFC8B0;
        }

        .roven-trust-tile-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #8A6546;
        }

        .roven-trust-tile-text {
            font-size: 0.82rem;
            font-weight: 600;
            line-height: 1.3;
            color: #2D2321;
            min-width: 0;
        }

        .roven-trust-tile-sub {
            display: block;
            font-weight: 400;
            color: #5C4F47;
            font-size: 0.78rem;
            margin-top: 1px;
        }

        @@media (max-width: 420px) {
            .roven-trust-grid {
                gap: 9px;
            }
            .roven-trust-tile {
                padding: 10px 10px;
                gap: 8px;
                min-height: 58px;
            }
            .roven-trust-tile-text {
                font-size: 0.75rem;
            }
            .roven-trust-tile-sub {
                font-size: 0.71rem;
            }
        }

        /* 3. Tracking Results & Status Section (Consistent Luxury Ivory / Burgundy) */
        .roven-result-container {
            position: relative;
            z-index: 2;
            max-width: 900px;
            margin: 28px auto 0;
            padding: 0 14px 1.5rem;
        }

        .roven-heading-line,
        .roven-fields-divider {
            display: none;
        }

        /* Desktop Full-Scene Satin & Marble Backdrop Showcase (>= 992px)
           Preserves exact mobile overlapping layout below 992px */
        @@media (min-width: 992px) {
            .roven-track-page {
                padding-top: 0;
                padding-bottom: 0;
                min-height: calc(100vh - 34px);
                background-color: #2B1A12;
            }

            .roven-track-scene {
                padding-bottom: 64px;
                background-color: #1C0203;
            }

            .roven-desktop-scene-bg {
                position: absolute;
                top: 44px;
                left: 0;
                right: 0;
                bottom: -2px;
                width: 100%;
                background-image:
                    linear-gradient(180deg, #1C0203 0%, rgba(28, 2, 3, 0) 64px),
                    linear-gradient(90deg, rgba(20, 2, 3, 0.52) 0%, rgba(28, 4, 5, 0.16) 40%, rgba(28, 4, 5, 0) 65%),
                    url('/images/banners/track-order-hero-desktop.webp');
                background-size: cover;
                background-position: center top;
                background-repeat: no-repeat;
                pointer-events: none;
                z-index: 1;
            }

            .roven-track-shell {
                position: relative;
                z-index: 2;
                width: 100%;
            }

            .roven-track-hero-banner {
                background: transparent;
                min-height: 0;
                padding: 132px 0 60px;
                display: block;
            }

            .roven-track-hero-stage {
                display: none;
            }

            .roven-track-hero-inner {
                max-width: 960px;
                margin: 0 auto;
                padding: 0 28px;
            }

            .roven-track-hero-copy {
                max-width: 470px;
                text-align: center;
            }

            .roven-hero-eyebrow {
                justify-content: center;
                font-size: 0.78rem;
                letter-spacing: 0.3em;
                margin-bottom: 10px;
            }

            .roven-eyebrow-line {
                width: 38px;
            }

            .roven-track-hero-title {
                font-size: clamp(2.55rem, 3.6vw, 3.2rem);
                margin-bottom: 12px;
            }

            .roven-track-hero-subtitle {
                max-width: 440px;
                margin: 0 auto;
                font-size: 0.96rem;
                line-height: 1.55;
            }

            .roven-track-card-container {
                max-width: 960px;
                margin: 26px auto 0;
                padding: 0 20px;
            }

            .roven-floating-card {
                background: rgba(252, 247, 239, 0.97);
                border: 1px solid rgba(226, 200, 166, 0.65);
                border-radius: 26px;
                padding: 0 46px 32px;
                box-shadow:
                    0 26px 65px rgba(15, 3, 3, 0.45),
                    0 4px 16px rgba(0, 0, 0, 0.16);
            }

            .roven-emblem-flank {
                display: none;
            }

            .roven-card-emblem-header {
                margin-bottom: 8px;
            }

            .roven-floating-emblem {
                width: 70px;
                height: 70px;
                margin-top: -35px;
            }

            .roven-card-heading {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 20px;
                font-size: 2rem;
                margin-bottom: 6px;
            }

            .roven-heading-line {
                display: inline-block;
                width: 88px;
                height: 1px;
                background: linear-gradient(90deg, rgba(196, 154, 96, 0.12), rgba(196, 154, 96, 0.72));
                flex-shrink: 0;
            }

            .roven-heading-line.right {
                background: linear-gradient(90deg, rgba(196, 154, 96, 0.72), rgba(196, 154, 96, 0.12));
            }

            .roven-card-subheading {
                max-width: 560px;
                font-size: 0.94rem;
                margin-bottom: 24px;
            }

            .roven-form-fields-row {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
                gap: 24px;
                align-items: end;
            }

            .roven-field-block {
                margin-bottom: 0;
            }

            .roven-fields-divider {
                display: block;
                width: 1px;
                height: 36px;
                background: rgba(166, 128, 89, 0.34);
                margin-bottom: 7px;
            }

            .roven-cream-input-wrap {
                border-radius: 9999px;
                height: 48px;
                padding: 0 18px;
            }

            .btn-roven-track-cta {
                max-width: 400px;
                height: 52px;
                margin: 22px auto 0;
                display: flex;
            }

            .roven-trust-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 14px;
                margin-top: 26px;
            }

            .roven-trust-tile {
                padding: 12px 14px;
                min-height: 60px;
                background-color: #FAF2E8;
            }

            .roven-result-container {
                max-width: 960px;
                padding: 0 20px 4rem;
                margin-top: 36px;
            }
        }

        @@media (min-width: 1600px) {
            .roven-desktop-scene-bg {
                top: 22px;
            }

            .roven-track-hero-banner {
                padding: 152px 0 74px;
            }
        }

        .roven-order-card {
            background: #FCF8F2;
            border: 1px solid #E5D6C3;
            border-radius: 24px;
            box-shadow: 0 14px 36px rgba(45, 10, 10, 0.08);
            overflow: hidden;
            max-width: 100% !important;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        @@media (max-width: 768px) {
            .roven-order-card {
                padding: 1.25rem 1rem !important;
                border-radius: 20px !important;
            }
        }

        /* Timeline Milestone Stepper - 100% Contained & Zero Mobile Overflow */
        .roven-stepper-track {
            position: relative;
            width: 100%;
            max-width: 100%;
            overflow: hidden;
            padding: 0.5rem 0.25rem 1rem 0.25rem;
        }

        .roven-stepper-progress-bg {
            position: absolute;
            top: 24px;
            left: 12.5%;
            width: 75%;
            height: 4px;
            background-color: #e8dccd;
            z-index: 1;
            overflow: hidden;
            border-radius: 4px;
        }

        .roven-stepper-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #630000, #810100);
            z-index: 2;
            transition: width 0.5s ease;
            border-radius: 4px;
        }

        .roven-step-item {
            position: relative;
            z-index: 3;
            width: 25%;
            max-width: 25%;
            text-align: center;
            padding: 0 2px;
        }

        .roven-step-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            transition: all 0.3s ease;
        }

        .roven-step-circle.active {
            background: linear-gradient(135deg, #630000 0%, #810100 100%);
            color: #EDEBDD;
            box-shadow: 0 4px 15px rgba(99, 0, 0, 0.35);
            border: 2px solid #EDEBDD;
        }

        .roven-step-circle.inactive {
            background: #FAF5ED;
            color: #a39c94;
            border: 2px solid #e8dccd;
        }

        .roven-step-title {
            font-size: 0.85rem;
            font-weight: 700;
            margin-top: 0.5rem;
            word-break: break-word;
            overflow-wrap: break-word;
            line-height: 1.25;
        }

        .roven-step-desc {
            font-size: 0.72rem;
            color: #6c6358;
            margin-top: 2px;
        }

        @@media (max-width: 768px) {
            .roven-stepper-progress-bg {
                top: 18px;
                left: 12.5%;
                width: 75%;
            }
            .roven-step-circle {
                width: 36px;
                height: 36px;
                font-size: 0.85rem;
            }
            .roven-step-title {
                font-size: 0.7rem !important;
                margin-top: 0.35rem !important;
                line-height: 1.2;
                padding: 0 2px;
            }
            .roven-step-desc {
                display: none !important;
            }
        }

        .roven-info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 0.55rem 0;
            border-bottom: 1px dashed rgba(27, 23, 23, 0.08);
            gap: 0.5rem;
            font-size: 0.88rem;
        }

        .roven-info-row:last-child {
            border-bottom: none;
        }

        .roven-info-label {
            color: #6c6358;
            font-weight: 500;
            flex-shrink: 0;
            max-width: 45%;
        }

        .roven-info-value {
            color: #1B1717;
            text-align: end;
            word-break: break-word;
            overflow-wrap: break-word;
            max-width: 55%;
        }

        .roven-info-value .badge {
            display: inline-block;
            max-width: 100%;
            text-align: end;
            white-space: normal !important;
            line-height: 1.3;
        }

        @@media (max-width: 480px) {
            .roven-info-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.2rem;
                padding: 0.45rem 0;
            }
            .roven-info-label {
                max-width: 100%;
                font-size: 0.78rem;
            }
            .roven-info-value {
                max-width: 100%;
                text-align: start;
                width: 100%;
                font-size: 0.85rem;
            }
            .roven-info-value .badge {
                text-align: start;
            }
        }

        .roven-table {
            border: 1px solid #e8dccd;
            border-radius: 16px;
            overflow: hidden;
        }

        .roven-table thead {
            background-color: #F2E6D7;
            color: #630000;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .roven-table th, .roven-table td {
            padding: 0.9rem 1.1rem;
            vertical-align: middle;
            border-color: #efe4d6;
        }

        @@keyframes pulse-roven {
            0% {
                box-shadow: 0 0 0 0 rgba(129, 1, 0, 0.45);
            }
            70% {
                box-shadow: 0 0 0 10px rgba(129, 1, 0, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(129, 1, 0, 0);
            }
        }

        .step-pulse {
            animation: pulse-roven 2s infinite;
        }
    </style>
}

