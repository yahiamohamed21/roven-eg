@section Scripts {
    <script>
        function copyOrderRef(ref) {
            navigator.clipboard.writeText(ref).then(function() {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        iconColor: '#630000',
                        title: 'تم نسخ رقم الطلب بنجاح',
                        text: ref,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true
                    });
                } else {
                    alert('تم نسخ رقم الطلب: ' + ref);
                }
            }).catch(function() {
                alert('كود الطلب: ' + ref);
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const initialResult = document.getElementById('rovenTrackResult');
            if (initialResult) {
                setTimeout(function() {
                    initialResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 120);
            }

            const form = document.getElementById('rovenTrackingForm');
            const btn = document.getElementById('btnTrackOrderSubmit');
            const resultSlot = document.getElementById('rovenTrackResultSlot');

            if (form && btn && resultSlot) {
                const defaultBtnHtml = btn.innerHTML;
                let isSubmitting = false;

                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    if (isSubmitting) return;
                    if (!form.reportValidity()) return;

                    const orderInput = document.getElementById('orderNumberInput');
                    const phoneInput = document.getElementById('phoneInput');
                    const orderNumber = orderInput ? orderInput.value.trim() : '';
                    const phone = phoneInput ? phoneInput.value.trim().replace(/[\s\-]/g, '') : '';

                    if (!orderNumber) return;

                    isSubmitting = true;
                    btn.disabled = true;
                    btn.classList.add('is-loading');
                    btn.innerHTML = '<span class="roven-btn-spinner" aria-hidden="true"></span><span>Checking Order...</span>';

                    const params = new URLSearchParams();
                    params.set('orderNumber', orderNumber);
                    if (phone) params.set('phone', phone);

                    const baseAction = form.getAttribute('action') || '/OrderTracking';
                    const targetUrl = baseAction + '?' + params.toString();

                    try {
                        const response = await fetch(targetUrl, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            throw new Error('Failed to check order status');
                        }

                        const html = await response.text();
                        resultSlot.innerHTML = html;

                        if (window.history && window.history.replaceState) {
                            window.history.replaceState(null, '', targetUrl);
                        }

                        const updatedResult = document.getElementById('rovenTrackResult');
                        if (updatedResult) {
                            setTimeout(function() {
                                updatedResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            }, 80);
                        }
                    } catch (err) {
                        try {
                            sessionStorage.setItem('roven_skip_preloader', 'true');
                        } catch (_) {}
                        window.location.href = targetUrl;
                        return;
                    } finally {
                        isSubmitting = false;
                        btn.disabled = false;
                        btn.classList.remove('is-loading');
                        btn.innerHTML = defaultBtnHtml;
                    }
                });
            }
        });
    </script>
}
