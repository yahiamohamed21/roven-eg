                                <div class="rounded-4 border position-relative overflow-hidden preview-marquee-wrapper" style="background: linear-gradient(90deg, #150f0f 0%, #290808 30%, #3a0606 50%, #290808 70%, #150f0f 100%); color: #EDEBDD; border-color: rgba(223, 177, 91, 0.35) !important;">
                                    <div class="preview-marquee-container" dir="ltr">
                                        <div class="preview-marquee-track">
                                            @for (int k = 0; k < 2; k++)
                                            {
                                                <div class="preview-marquee-group">
                                                    <span class="preview-marquee-badge">@(string.IsNullOrWhiteSpace(Model.MarqueeBadgeText) ? "OFFER 20%" : Model.MarqueeBadgeText)</span>
                                                    <span class="preview-marquee-text">@(string.IsNullOrWhiteSpace(Model.MarqueeText) ? "OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20 • عطور أصلية بتركيز 30% • شحن مجاني ودفع عند الاستلام مع المعاينة في كافة محافظات مصر" : Model.MarqueeText)</span>
                                                    <i class="fa-solid fa-gem text-warning mx-1" style="font-size: 0.68rem; opacity: 0.85;"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="preview-marquee-track" aria-hidden="true">
                                            @for (int k = 0; k < 2; k++)
                                            {
                                                <div class="preview-marquee-group">
                                                    <span class="preview-marquee-badge">@(string.IsNullOrWhiteSpace(Model.MarqueeBadgeText) ? "OFFER 20%" : Model.MarqueeBadgeText)</span>
                                                    <span class="preview-marquee-text">@(string.IsNullOrWhiteSpace(Model.MarqueeText) ? "OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20 • عطور أصلية بتركيز 30% • شحن مجاني ودفع عند الاستلام مع المعاينة في كافة محافظات مصر" : Model.MarqueeText)</span>
                                                    <i class="fa-solid fa-gem text-warning mx-1" style="font-size: 0.68rem; opacity: 0.85;"></i>
                                                </div>
