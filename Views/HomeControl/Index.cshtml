                    <i class="fa-solid fa-eye"></i>
                    <span>معاينة المتجر</span>
                </a>
                <button type="submit" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;">
