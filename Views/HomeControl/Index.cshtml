<!-- Modal: Edit Main Brand Hero (Section #1 - Desktop & Mobile) -->
<div class="modal fade" id="editMainBrandHeroModal" tabindex="-1" aria-labelledby="editMainBrandHeroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom pb-3 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="editMainBrandHeroModalLabel" style="color: #1B1717; font-family: 'Playfair Display', serif;">
                    <i class="fa-solid fa-crown text-warning me-2"></i>تعديل البانر الرئيسي للدار (الهيرو الأساسي — ديسكتوب وموبايل)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="UpdateMainBrandHero" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="d-flex flex-column gap-3">
                        
                        <!-- Desktop Image -->
                        <div class="p-3 rounded-3 bg-light border">
                            <label class="form-label small fw-bold text-dark d-flex align-items-center gap-1.5 mb-1">
                                <i class="fa-solid fa-desktop text-primary"></i>
                                <span>صورة الديسكتوب والشاشات الكبيرة (Desktop Image)</span>
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                المقاس الموصى به: 1920 × 800 بكسل (أو عريض بدقة عالية). يتم تحميلها على الشاشات التي يزيد عرضها عن 768px.
                            </div>
                            <input type="file" name="desktopImage" id="mainHeroDesktopFileInput" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-2">
                                <label class="form-label text-muted small mb-1" style="font-size: 0.75rem;">أو أدخل مسار / رابط الصورة المباشر:</label>
                                <input type="text" name="desktopImageUrl" id="mainHeroDesktopUrlInput" value="@Model.BrandHeroDesktopImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="/images/banners/roven-hero-main.png" />
                            </div>
                        </div>

                        <!-- Mobile Image -->
                        <div class="p-3 rounded-3 bg-light border">
                            <label class="form-label small fw-bold text-dark d-flex align-items-center gap-1.5 mb-1">
                                <i class="fa-solid fa-mobile-screen text-warning"></i>
                                <span>صورة الموبايل والشاشات الصغيرة (Mobile Image)</span>
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                المقاس الموصى به: 750 × 1000 بكسل (تصميم طولي للموبايل). يتم تحميلها على الهواتف والشاشات الصغيرة (<= 768px).
                            </div>
                            <input type="file" name="mobileImage" id="mainHeroMobileFileInput" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-2">
                                <label class="form-label text-muted small mb-1" style="font-size: 0.75rem;">أو أدخل مسار / رابط صورة الموبايل المباشر:</label>
                                <input type="text" name="mobileImageUrl" id="mainHeroMobileUrlInput" value="@Model.BrandHeroMobileImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="/images/banners/roven-hero-main-sm.png" />
                            </div>
                        </div>

                        <!-- Redirect Link -->
                        <div>
                            <label class="form-label small fw-bold text-dark mb-1">
                                <i class="fa-solid fa-link text-primary me-1"></i>رابط التوجيه عند النقر (Redirect Link)
                            </label>
                            <input type="text" name="redirectLink" value="@(string.IsNullOrWhiteSpace(Model.BrandHeroRedirectLink) ? "/Store" : Model.BrandHeroRedirectLink)" class="form-control rounded-3 font-monospace" placeholder="/Store" />
                            <div class="text-muted small mt-1" style="font-size: 0.75rem;">الصفحة التي ينتقل إليها العميل عند النقر على صورة الهيرو (افتراضي: /Store).</div>
                        </div>

                        <!-- Title & Alt Text -->
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    اسم / عنوان البانر (Title)
                                </label>
                                <input type="text" name="title" value="@Model.BrandHeroTitle" class="form-control rounded-3" placeholder="ROVEN FRAGRANCES — Your Safest Choice" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    النص البديل لتحسين محركات البحث (SEO Alt Text)
                                </label>
                                <input type="text" name="altText" value="@Model.BrandHeroAltText" class="form-control rounded-3" placeholder="ROVEN FRAGRANCES — Your Safest Choice • Explore the Collection" />
                            </div>
                        </div>

                        <!-- Active Toggle -->
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" name="isActive" class="form-check-input" value="true" @(Model.ShowBrandHero ? "checked" : "") id="mainHeroActiveCheck" style="cursor: pointer; width: 2.2em; height: 1.2em;" />
                            <label class="form-check-label small fw-bold ms-2 pt-1" for="mainHeroActiveCheck">
                                إظهار وتفعيل سكشن الهيرو الأساسي في المتجر
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2" onclick="setMainHeroDefaults();" title="إرجاع المسارات الافتراضية">
                        <i class="fa-solid fa-arrow-rotate-left me-1"></i>استعادة مسارات الصور الأصلية
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" data-bs-dismiss="modal">
                            إلغاء
                        </button>
                        <button type="submit" class="btn fw-bold px-4 py-2.5 rounded-pill shadow-sm text-white" style="background: #810100; border: none;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> حفظ وتحديث الهيرو
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Hero Banner (Clean Light Theme) -->
<div class="modal fade" id="createHeroBannerModal" tabindex="-1" aria-labelledby="createHeroBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom pb-3 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="createHeroBannerModalLabel" style="color: #1B1717; font-family: 'Playfair Display', serif;">
                    <i class="fa-solid fa-images text-danger me-2"></i>إضافة بانر رئيسي (Create Hero Banner)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="AddHeroBanner" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <!-- Desktop Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                UPLOAD DESKTOP IMAGE <span class="text-danger">*</span>
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                RECOMMENDED: 1920x800 PX (OR 1200x500 PX) | ASPECT RATIO: 12:5
                            </div>
                            <input type="file" name="desktopImage" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-1.5">
                                <input type="text" name="desktopImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="أو مسار الصورة المباشر /images/banners/..." />
                            </div>
                        </div>

                        <!-- Mobile Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                UPLOAD MOBILE IMAGE (OPTIONAL)
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                RECOMMENDED: 750x1000 PX (OR 600x800 PX) | ASPECT RATIO: 3:4
                            </div>
                            <input type="file" name="mobileImage" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-1.5">
                                <input type="text" name="mobileImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="أو مسار صورة الموبايل المباشر..." />
                            </div>
                        </div>

                        <!-- Redirect Link -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                BANNER REDIRECT LINK <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="redirectLink" class="form-control rounded-3 font-monospace" placeholder="/products" value="/Store" required />
                            <div class="text-muted small mt-1" style="font-size: 0.75rem;">الرابط الذي سيتم توجيه العميل إليه عند النقر على البانر (مثال: /Store أو /Store?categoryId=1).</div>
                        </div>

                        <!-- Title & Alt Text -->
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                    BANNER TITLE (NAME)
                                </label>
                                <input type="text" name="title" class="form-control rounded-3" placeholder="Hero Banner Slide #..." />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                    IMAGE ALT TEXT (SEO DESCRIPTION)
                                </label>
                                <input type="text" name="altText" class="form-control rounded-3" placeholder="e.g. Maison ROVEN Luxury Perfumes" />
                            </div>
                        </div>

                        <!-- Active Checkbox -->
                        <div class="form-check mt-2">
                            <input type="checkbox" name="isActive" class="form-check-input" value="true" checked id="createBannerActiveCheck" style="cursor: pointer; width: 1.25rem; height: 1.25rem;" />
                            <label class="form-check-label small fw-bold ms-2 pt-1" for="createBannerActiveCheck" style="color: #1B1717; letter-spacing: 0.5px;">
                                تفعيل البانر مباشرة في المتجر (ENABLE BANNER VISIBILITY)
                            </label>
                        </div>
                    </div>
