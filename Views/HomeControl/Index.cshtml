                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
                    <button type="submit" class="btn fw-bold px-4 py-2.5 rounded-pill shadow-sm text-white" style="background: #810100; border: none; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-save me-1"></i> حفظ التعديلات (SAVE BANNER)
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" data-bs-dismiss="modal">
                        إلغاء (CANCEL)
                    </button>
                </div>
            </form>
        </div>
