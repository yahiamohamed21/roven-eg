                previewImg.src = opt1.getAttribute('data-img');
            } else {
                previewImg.src = '/images/placeholder.svg';
            }
        }

        if (previewSubtitle) {
            previewSubtitle.innerText = badgeInput.value.trim() || (isDuo ? 'DUO BUNDLE • باقة عطرين' : 'HOT DEAL • عرض مميز');
        }

        if (previewTitle) {
