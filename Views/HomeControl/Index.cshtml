                                            </label>
                                            <select name="thirdProductId" id="addOfferProduct3Select" class="form-select roven-studio-input" onchange="onAddOfferFormChange()">
                                                <option value="">-- لا يوجد --</option>
                                                @foreach (var prod in products)
