        }

        if (previewPills) {
            const rawPills = (pillsInput.value || '').split(',').map(s => s.trim()).filter(s => s.length > 0);
            if (rawPills.length > 0) {
                previewPills.innerHTML = rawPills.map(p => `<span class="roven-preview-pill"><i class="fa-solid fa-gem text-gold me-1"></i>${p}</span>`).join(' ');
