                        </div>

                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" name="isActive" class="form-check-input" value="true" checked id="addFaqActiveCheck" style="cursor: pointer; width: 2.2em; height: 1.2em;" />
                            <label class="form-check-label small fw-bold ms-2 pt-1" for="addFaqActiveCheck">
                                تفعيل السؤال مباشرة في المتجر
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-end gap-2">
