@model Stockify.Models.Entities.HomeSetting
@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Control — Maison ROVEN";
    var products = ViewBag.Products as List<Stockify.Models.Entities.Product> ?? new();
    var homeOffers = ViewBag.HomeOffers as List<Stockify.Models.Entities.HomeOffer> ?? new();
    var heroBanners = ViewBag.HeroBanners as List<Stockify.Models.Entities.HeroBanner> ?? new();
}

<style>
    /* Tabs Navigation */
    .roven-tabs {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.5rem;
    }
    .roven-tabs .nav-item {
        flex: 1 1 0;
        min-width: 0;
    }
    .roven-tabs .nav-link {
        width: 100%;
        color: #555;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.75rem 0.5rem;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        background: #fff;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.88rem;
    }
    .roven-tabs .nav-link:hover {
        color: #810100;
        background: #fdfaf6;
        border-color: rgba(129, 1, 0, 0.15);
    }
    .roven-tabs .nav-link.active {
        color: #EDEBDD !important;
        background-color: #810100 !important;
        border-color: #810100 !important;
        box-shadow: 0 4px 12px rgba(129, 1, 0, 0.25);
    }
    .card-setting-header {
        background-color: #ffffff;
        border-bottom: 1px solid #f1ece4;
        padding: 1.15rem 1.25rem;
    }
    .tab-pane-content {
        animation: fadeInTab 0.25s ease-in-out;
    }
    .tab-content,
    .tab-pane,
    .tab-pane-content {
        min-width: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
    }
    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Live Marquee Preview Animation with Strict Containment & Absolute Detached Layout */
    .preview-marquee-wrapper {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        height: 46px !important;
        min-height: 46px !important;
        max-height: 46px !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        display: block !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        contain: strict !important;
        isolation: isolate !important;
        border-radius: 12px !important;
    }
    .preview-marquee-wrapper::before,
    .preview-marquee-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 36px;
        z-index: 4;
        pointer-events: none;
    }
    .preview-marquee-wrapper::before {
        left: 0;
        background: linear-gradient(to right, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-wrapper::after {
        right: 0;
        background: linear-gradient(to left, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        user-select: none;
        contain: strict !important;
        direction: ltr !important;
    }
    .preview-marquee-track {
        display: flex !important;
        align-items: center !important;
        flex-shrink: 0 !important;
        height: 100% !important;
        width: max-content !important;
        animation: previewMarqueeScroll 25s linear infinite;
        will-change: transform;
    }
    .preview-marquee-wrapper:hover .preview-marquee-track {
        animation-play-state: paused;
    }
    .preview-marquee-group {
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.85rem !important;
        padding: 0 1.25rem !important;
        height: 100% !important;
        flex-shrink: 0 !important;
    }
    .preview-marquee-badge {
        height: 24px !important;
        min-height: 24px !important;
        max-height: 24px !important;
        line-height: 24px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 0.75rem !important;
        border-radius: 9999px !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
        max-width: 150px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        background: linear-gradient(135deg, #810100 0%, #630000 100%) !important;
        color: #EDEBDD !important;
        border: 1px solid rgba(223, 177, 91, 0.45) !important;
        box-sizing: border-box !important;
    }
    .preview-marquee-text {
        white-space: nowrap !important;
        font-size: 0.84rem !important;
        font-weight: 600 !important;
        color: #EDEBDD !important;
        letter-spacing: 0.35px !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
    }
    @@keyframes previewMarqueeScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }

    /* Banner Thumbnail & Action styling */
    .banner-thumb-container {
        width: 140px;
        height: 64px;
        background: #fdfaf6;
        border-color: #e8e3d5 !important;
    }

    /* Mobile Offer Card */
    .offer-mobile-card {
        border-radius: 14px;
        border: 1px solid #e8e3d5;
        background: #ffffff;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 767.98px) {
        .roven-tabs {
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
            padding: 0.4rem !important;
            gap: 0.4rem !important;
            scrollbar-width: none;
        }
        .roven-tabs::-webkit-scrollbar {
            display: none;
        }
        .roven-tabs .nav-item {
            flex: 0 0 auto !important;
        }
        .roven-tabs .nav-link {
            font-size: 0.82rem;
            padding: 0.55rem 0.85rem;
        }
        .app-content {
            padding: 0.85rem 0.5rem !important;
        }
        .card-setting-header {
            padding: 0.95rem 0.85rem !important;
        }
        .card-body {
            padding: 0.95rem 0.85rem !important;
        }
        .banner-thumb-container {
            width: 100% !important;
            height: 120px !important;
        }
        .banner-card-mobile {
            padding: 0.85rem !important;
        }
        .sticky-save-bar {
            position: sticky;
            bottom: 0.75rem;
            z-index: 1020;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
        }
    }
</style>

<div class="container-fluid py-3 px-2 px-md-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(99, 0, 0, 0.08); border: 1px solid rgba(99, 0, 0, 0.2); color: #630000; font-size: 0.78rem; font-weight: 700;">
                <i class="fa-solid fa-sliders"></i>
                <span>HOMEPAGE CUSTOMIZATION SUITE</span>
            </div>
            <h2 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', serif;">Home Control Center</h2>
            <p class="text-muted small mb-0">لوحة تحكم كاملة في كافة سكشنات وبانرات ونصوص الصفحة الرئيسية للمتجر بروابط وتعديلات حية تسمع فورياً.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-start justify-content-md-end">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light border text-muted small shadow-xs" title="يتم ضغط وتحويل كافة الصور تلقائياً إلى صيغة WebP السحابية ومزامنتها فور الحفظ وبدء التشغيل">
                <i class="fa-solid fa-cloud-arrow-up text-success"></i>
                <span style="font-size: 0.8rem; font-weight: 600; color: #1B1717;">مزامنة WebP التلقائية نشطة</span>
            </div>
            <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-dark btn-sm px-3 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span>معاينة المتجر</span>
            </a>
            <button type="submit" form="homeControlForm" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2 fw-bold shadow-sm text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>حفظ كافة التغييرات</span>
            </button>
        </div>
    </div>

    <!-- Tabs Navigation Bar (Side-by-Side Clean Tabs) -->
    <ul class="nav nav-pills roven-tabs gap-2 mb-4 p-2 bg-light rounded-4 border d-flex flex-wrap align-items-center" id="homeControlTabs" role="tablist" style="overflow-x: auto;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-banners-btn" data-bs-toggle="pill" data-bs-target="#tab-banners" type="button" role="tab" aria-controls="tab-banners" aria-selected="true">
                <i class="fa-solid fa-images"></i>
                <span>1. Hero Banners</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-spotlight-btn" data-bs-toggle="pill" data-bs-target="#tab-spotlight" type="button" role="tab" aria-controls="tab-spotlight" aria-selected="false">
                <i class="fa-solid fa-bolt text-warning"></i>
                <span>2. Offers & Marquee</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-bestsellers-btn" data-bs-toggle="pill" data-bs-target="#tab-bestsellers" type="button" role="tab" aria-controls="tab-bestsellers" aria-selected="false">
                <i class="fa-solid fa-fire text-danger"></i>
                <span>3. Best Sellers</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-featured-btn" data-bs-toggle="pill" data-bs-target="#tab-featured" type="button" role="tab" aria-controls="tab-featured" aria-selected="false">
                <i class="fa-solid fa-crown" style="color: #630000;"></i>
                <span>4. Featured Parfums</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-sections-btn" data-bs-toggle="pill" data-bs-target="#tab-sections" type="button" role="tab" aria-controls="tab-sections" aria-selected="false">
                <i class="fa-solid fa-arrows-up-down text-primary"></i>
                <span>5. Sections Visibility & Order</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-social-btn" data-bs-toggle="pill" data-bs-target="#tab-social" type="button" role="tab" aria-controls="tab-social" aria-selected="false">
                <i class="fa-solid fa-bullhorn text-danger fs-6"></i>
                <span>6. Top Announcement</span>
            </button>
        </li>
    </ul>

    <!-- Main Form for all tabs -->
    <form id="homeControlForm" asp-controller="HomeControl" asp-action="Update" method="post">
        @Html.AntiForgeryToken()

        <div class="tab-content" id="homeControlTabsContent">

            <!-- ============================================================== -->
            <!-- TAB 1: HOMEPAGE HERO BANNERS (IMAGE-BASED SLIDES)              -->
            <!-- ============================================================== -->
            <div class="tab-pane fade show active tab-pane-content" id="tab-banners" role="tabpanel" aria-labelledby="tab-banners-btn">
                
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <!-- Header Strip in Light Theme matching Maison ROVEN Dashboard -->
                    <div class="card-setting-header p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(129, 1, 0, 0.08); border: 1px solid rgba(129, 1, 0, 0.2); color: #810100; font-size: 0.74rem; font-weight: 700; letter-spacing: 1px;">
                                <i class="fa-solid fa-images"></i>
                                <span>HOMEPAGE HERO BANNERS</span>
                            </div>
                            <h4 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif; color: #1B1717;">بانرات الواجهة الرئيسية (Hero Banner Carousel)</h4>
                            <p class="text-muted small mb-0" style="max-width: 680px;">
                                UPLOAD FULLY STYLED BANNER IMAGES. MULTIPLE ACTIVE BANNERS WILL CYCLE AS A DYNAMIC CAROUSEL.
                                <br />
                                ارفع صور البانرات المصممة بالكامل بمقاس الديسكتوب (1920x800) واختيارياً الموبايل (750x1000). تظهر فوراً في سكشن الهيرو أعلى المتجر.
                            </p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 text-white" style="background: #810100; border-color: #810100; width: auto !important;" data-bs-toggle="modal" data-bs-target="#createHeroBannerModal">
                            <i class="fa-solid fa-plus"></i>
                            <span>ADD NEW BANNER +</span>
                        </button>
                    </div>

                    <!-- Banners List in Light Theme -->
                    <div class="p-2 p-md-4 bg-white">
                        @if (heroBanners.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @for (int i = 0; i < heroBanners.Count; i++)
                                {
                                    var banner = heroBanners[i];
                                    <div class="card border p-3 rounded-4 position-relative bg-white shadow-xs banner-card-mobile" style="border-color: #e8e3d5 !important;">
                                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                                            
                                            <!-- Left: Image Preview & Details -->
                                            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3 w-100 flex-grow-1" style="min-width: 0;">
                                                <div class="position-relative overflow-hidden rounded-3 border flex-shrink-0 banner-thumb-container">
                                                    <img src="@banner.DesktopImageUrl" alt="@banner.Title" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/banners/roven-hero-main.png'" />
                                                    <span class="badge position-absolute bottom-0 start-0 m-1 font-monospace" style="background: rgba(27,23,23,0.85); font-size: 0.65rem; padding: 0.2rem 0.4rem; color: #EDEBDD;">#@banner.DisplayOrder</span>
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0; width: 100%;">
                                                    <div class="fw-bold mb-1 text-truncate" style="font-size: 0.98rem; color: #1B1717;" title="@banner.Title">
                                                        @banner.Title
                                                    </div>
                                                    <div class="d-flex flex-wrap align-items-center gap-2 small">
                                                        <span class="font-monospace text-break" style="color: #810100; font-size: 0.8rem; word-break: break-all;">
                                                            <i class="fa-solid fa-link me-1"></i>Redirect Link: <strong class="text-decoration-underline">@banner.RedirectLink</strong>
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(banner.MobileImageUrl))
                                                        {
                                                            <span class="badge rounded-pill" style="background: rgba(223, 177, 91, 0.15); color: #8a6a1b; border: 1px solid rgba(223, 177, 91, 0.4); font-size: 0.68rem;">
                                                                <i class="fa-solid fa-mobile-screen me-1"></i>Mobile Ready
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill bg-light text-muted border font-monospace" style="font-size: 0.68rem;">
                                                                Desktop Only
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Right: Controls matching user's image (Active Pill, Up, Down, Edit, Delete) -->
                                            <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 w-100 w-md-auto pt-2 pt-md-0 border-top border-md-top-0" style="border-color: #f1ece4 !important;">
                                                <!-- Active Badge / Toggle Button -->
                                                <button type="submit" form="toggleBannerForm_@banner.Id" class="badge rounded-pill px-3 py-2 fw-bold text-decoration-none border-0 shadow-xs" style="background-color: @(banner.IsActive ? "#198754" : "#6c757d"); color: #ffffff; cursor: pointer; font-size: 0.74rem; letter-spacing: 0.5px;" title="انقر لتغيير الحالة">
                                                    @(banner.IsActive ? "ACTIVE" : "INACTIVE")
                                                </button>

                                                <div class="d-flex align-items-center gap-1.5">
                                                    <!-- Move Up -->
                                                    <button type="submit" form="moveBannerUpForm_@banner.Id" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center @(i == 0 ? "disabled" : "")" style="width: 34px; height: 34px;" title="تحريك لأعلى">
                                                        <i class="fa-solid fa-arrow-up" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Move Down -->
                                                    <button type="submit" form="moveBannerDownForm_@banner.Id" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center @(i == heroBanners.Count - 1 ? "disabled" : "")" style="width: 34px; height: 34px;" title="تحريك لأسفل">
                                                        <i class="fa-solid fa-arrow-down" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(13, 110, 253, 0.1); color: #0d6efd; border: 1px solid rgba(13, 110, 253, 0.25);" title="تعديل البانر" onclick="openEditBannerModal(@banner.Id, '@(banner.Title.Replace("'", "\\'"))', '@(banner.DesktopImageUrl.Replace("'", "\\'"))', '@(banner.MobileImageUrl?.Replace("'", "\\'") ?? "")', '@(banner.RedirectLink?.Replace("'", "\\'") ?? "")', '@(banner.AltText?.Replace("'", "\\'") ?? "")', @(banner.IsActive ? "true" : "false"), @banner.DisplayOrder)">
                                                        <i class="fa-solid fa-pen" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Delete Button -->
                                                    <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.25);" title="حذف البانر" onclick="confirmDeleteBanner(@banner.Id, '@(banner.Title.Replace("'", "\\'"))')">
                                                        <i class="fa-solid fa-xmark" style="font-size: 0.95rem;"></i>
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 rounded-4 bg-light border" style="border-style: dashed !important; border-color: #d1c7bd !important;">
                                <i class="fa-solid fa-images display-4 mb-3" style="color: #810100;"></i>
                                <h5 class="fw-bold mb-2" style="color: #1B1717;">لا توجد بانرات مضافة حالياً</h5>
                                <p class="text-muted small mb-3">
                                    اضغط على زر "ADD NEW BANNER +" لرفع أول بانر مصمم بالكامل للواجهة الرئيسية للمتجر.
                                </p>
                                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold text-white" style="background: #810100; border-color: #810100;" data-bs-toggle="modal" data-bs-target="#createHeroBannerModal">
                                    <i class="fa-solid fa-plus me-1"></i> ADD NEW BANNER +
                                </button>
                            </div>
                        }
                    </div>
                </div>

            </div>

                        <!-- TAB 2: SPECIAL OFFERS & DEALS (MULTI-PRODUCT)                  -->
            <!-- ============================================================== -->
            <!-- TAB 2: SPECIAL OFFERS & DEALS MANAGEMENT                      -->
            <!-- ============================================================== -->
            <div class="tab-pane fade tab-pane-content" id="tab-spotlight" role="tabpanel" aria-labelledby="tab-spotlight-btn">
                
                <!-- Section Header Copywriting Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <div class="card-setting-header p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <span class="fw-bold fs-5 d-inline-flex align-items-center gap-2" style="color: #1B1717;">
                                <i class="fa-solid fa-pen-nib text-warning"></i>
                                <span>نصوص وعناوين سكشن العروض (Offers Section Copywriting)</span>
                            </span>
                            <div class="text-muted small mt-1">
                                تحكم كامل في الشارة الذهبية، العنوان الرئيسي، والوصف التوضيحي الظاهر في واجهة متجر دار روفان.
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <!-- Inputs Column -->
                            <div class="col-12 col-lg-7">
                                <div class="mb-3">
                                    <label asp-for="SpotlightBadgeText" class="form-label small fw-bold text-secondary">
                                        نص الشارة الذهبية العلوية (Badge Text)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-warning"><i class="fa-solid fa-bolt"></i></span>
                                        <input asp-for="SpotlightBadgeText" id="inputSpotlightBadge" class="form-control" placeholder="EXCLUSIVE ATELIER OFFERS & DEALS" />
                                    </div>
                                    <small class="text-muted d-block mt-1">النص داخل الشارة البيضاوية الذهبية أعلى السكشن (افتراضي: EXCLUSIVE ATELIER OFFERS & DEALS)</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="SpotlightTitle" class="form-label small fw-bold text-secondary">
                                        العنوان الرئيسي للسكشن (Section Title)
                                    </label>
                                    <input asp-for="SpotlightTitle" id="inputSpotlightTitle" class="form-control fw-bold" placeholder="عروض وتخفيضات دار روفين الحصرية" />
                                    <small class="text-muted d-block mt-1">العنوان الرئيسي العريض للسكشن (افتراضي: عروض وتخفيضات دار روفين الحصرية)</small>
                                </div>

                                <div class="mb-0">
                                    <label asp-for="SpotlightSubtitle" class="form-label small fw-bold text-secondary">
                                        الوصف والسطر التوضيحي (Section Subtitle)
                                    </label>
                                    <textarea asp-for="SpotlightSubtitle" id="inputSpotlightSubtitle" class="form-control" rows="2" placeholder="إصدارات عطرية مختارة بتخفيضات استثنائية لفترة محدودة، مع شحن لكافة المحافظات وإمكانية معاينة الطرد قبل الدفع عند الاستلام."></textarea>
                                    <small class="text-muted d-block mt-1">الجملة التي تشرح مميزات العروض والتوصيل والمعاينة أسفل العنوان</small>
                                </div>
                            </div>

                            <!-- Live Header Preview -->
                            <div class="col-12 col-lg-5">
                                <div class="p-3.5 p-md-4 rounded-4 border text-center shadow-xs position-relative overflow-hidden" style="background: #FAF9F5; border: 1px solid rgba(181, 141, 74, 0.25) !important;">
                                    <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: linear-gradient(90deg, #810100 0%, #b58d4a 50%, #810100 100%);"></div>
                                    <div class="small text-muted fw-bold text-uppercase mb-3" style="font-size: 0.72rem; letter-spacing: 1px; color: #8a6519 !important;">
                                        <i class="fa-solid fa-eye me-1"></i>معاينة حية كما تظهر لعملاء المتجر
                                    </div>

                                    <div class="my-2">
                                        <span class="badge px-3 py-1.5 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2 shadow-xs" id="previewSpotlightBadge" style="background: rgba(181, 141, 74, 0.12); color: #8a6519; border: 1px solid rgba(181, 141, 74, 0.35); font-size: 0.75rem;">
                                            <i class="fa-solid fa-bolt text-warning"></i>
                                            <span>@(string.IsNullOrWhiteSpace(Model.SpotlightBadgeText) ? "EXCLUSIVE ATELIER OFFERS & DEALS" : Model.SpotlightBadgeText)</span>
                                        </span>
                                        <h3 class="fw-extrabold mb-2" id="previewSpotlightTitle" style="font-family: 'Playfair Display', serif; color: #1B1717; font-size: 1.35rem;">
                                            @(string.IsNullOrWhiteSpace(Model.SpotlightTitle) ? "عروض وتخفيضات دار روفين الحصرية" : Model.SpotlightTitle)
                                        </h3>
                                        <p class="text-muted small mx-auto mb-0" id="previewSpotlightSubtitle" style="max-width: 420px; font-size: 0.82rem; line-height: 1.5;">
                                            @(string.IsNullOrWhiteSpace(Model.SpotlightSubtitle) ? "إصدارات عطرية مختارة بتخفيضات استثنائية لفترة محدودة، مع شحن لكافة المحافظات وإمكانية معاينة الطرد قبل الدفع عند الاستلام." : Model.SpotlightSubtitle)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Offers Management Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-setting-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-bolt text-warning me-2"></i>عروض وتخفيضات الصفحة الرئيسية (Special Offers & Deals)
                            </span>
                            <div class="text-muted small mt-1">
                                أضف أكثر من منتج إلى قسم العروض. إذا وجد منتجين أو أكثر سيتم عرضها كشبكة كروت عروض فاخرة في الهوم.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 gap-md-3 flex-wrap justify-content-between justify-content-md-end">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="SpotlightActive" id="spotlightSwitch" style="cursor: pointer;">
                                <label class="form-check-label small fw-semibold" for="spotlightSwitch">تفعيل قسم العروض</label>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5 text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;" data-bs-toggle="modal" data-bs-target="#addOfferModal">
                                <i class="fa-solid fa-plus"></i>
                                <span>إضافة عطر جديد للعروض</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-2 p-md-4">
                        @if (homeOffers.Any())
                        {
                            <!-- Desktop View: Comprehensive 10-Column Table -->
                            <div class="table-responsive d-none d-lg-block">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th style="width: 50px;">#</th>
                                            <th>محتوى العرض</th>
                                            <th>النوع</th>
                                            <th>السعر الأصلي</th>
                                            <th>سعر العرض</th>
                                            <th>الشارة والنسبة</th>
                                            <th>المتبقي</th>
                                            <th>تاريخ الانتهاء</th>
                                            <th>الحالة</th>
                                            <th class="text-center" style="width: 140px;">الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var offer in homeOffers)
                                        {
                                            var prod = offer.Product;
                                            var prod2 = offer.SecondProduct;
                                            var isDuo = prod2 != null;
                                            var origPrice = (prod?.Price ?? 0m) + (prod2?.Price ?? 0m);
                                            var discount = origPrice > offer.OfferPrice && origPrice > 0 
                                                ? (int)Math.Round((origPrice - offer.OfferPrice) / origPrice * 100) 
                                                : 0;

                                            <tr>
                                                <td class="font-monospace text-muted small">@offer.DisplayOrder</td>
                                                <td>
                                                    @if (isDuo)
                                                    {
                                                        <div class="d-flex flex-column gap-1">
                                                            @if (!string.IsNullOrWhiteSpace(offer.Title))
                                                            {
                                                                <div class="fw-bold text-dark" style="font-size: 0.94rem;">@offer.Title</div>
                                                            }
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" title="@prod?.Name">
                                                                    @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                                    {
                                                                        <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa-solid fa-spray-can-sparkles text-muted small"></i>
                                                                    }
                                                                </div>
                                                                <span class="small fw-semibold text-dark">1. @(prod?.Name ?? "العطر الأول")</span>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" title="@prod2?.Name">
                                                                    @if (!string.IsNullOrWhiteSpace(prod2?.ImageUrl))
                                                                    {
                                                                        <img src="@prod2.ImageUrl" alt="@prod2.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa-solid fa-spray-can-sparkles text-muted small"></i>
                                                                    }
                                                                </div>
                                                                <span class="small fw-semibold text-dark">2. @(prod2?.Name ?? "العطر الثاني")</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                                                @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                                {
                                                                    <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa-solid fa-spray-can-sparkles text-muted"></i>
                                                                }
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold text-dark" style="font-size: 0.92rem;">@(prod?.Name ?? "عطر غير معروف")</div>
                                                                <div class="text-muted small font-monospace" style="font-size: 0.75rem;">SKU: @(prod?.Sku ?? "N/A")</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (isDuo)
                                                    {
                                                        <span class="badge rounded-pill" style="background-color: #630000; color: #fdf4dc;">
                                                            <i class="fa-solid fa-layer-group me-1"></i>باقة عطرين
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-secondary border rounded-pill">عطر فردي</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="text-muted text-decoration-line-through font-monospace">@origPrice.ToString("N0") ج.م</span>
                                                </td>
                                                <td>
                                                    <span class="fw-bold font-monospace text-danger fs-6">@offer.OfferPrice.ToString("N0") ج.م</span>
                                                    @if (discount > 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 small ms-1">
                                                            -@discount%
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge badge-roven-crimson px-2.5 py-1 rounded-pill small">@offer.BadgeText</span>
                                                    <div class="text-muted small mt-1 font-monospace" style="font-size: 0.75rem;">محجوز: @offer.AllocatedPercent%</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill font-monospace">
                                                        @offer.RemainingCount باقة
                                                    </span>
                                                </td>
                                                <td class="small text-muted font-monospace">
                                                    @(offer.EndTime?.ToString("yyyy-MM-dd HH:mm") ?? "مستمر")
                                                </td>
                                                <td>
                                                    @if (offer.IsActive)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">نشط</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">معطل</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="submit" form="toggleOfferForm_@offer.Id" class="btn btn-outline-secondary" title="@(offer.IsActive ? "إيقاف العرض" : "تفعيل العرض")">
                                                            <i class="fa-solid @(offer.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-primary" title="تعديل العرض" onclick="openEditOfferModal(@offer.Id, @offer.ProductId, @(offer.SecondProductId?.ToString() ?? "null"), '@(offer.Title?.Replace("'", "\\'") ?? "")', @offer.OfferPrice, '@(offer.BadgeText?.Replace("'", "\\'") ?? "")', @offer.AllocatedPercent, @offer.RemainingCount, '@(offer.EndTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @offer.DisplayOrder)">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" title="حذف العرض" onclick="confirmDeleteOffer(@offer.Id, '@(prod?.Name?.Replace("'", "\\'") ?? "العرض")@(isDuo ? " + " + prod2?.Name?.Replace("'", "\\'") : "")')">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Mobile View: Clean Touch-Friendly Luxury Cards (d-lg-none) -->
                            <div class="d-lg-none d-flex flex-column gap-3">
                                @foreach (var offer in homeOffers)
                                {
                                    var prod = offer.Product;
                                    var prod2 = offer.SecondProduct;
                                    var isDuo = prod2 != null;
                                    var origPrice = (prod?.Price ?? 0m) + (prod2?.Price ?? 0m);
                                    var discount = origPrice > offer.OfferPrice && origPrice > 0 
                                        ? (int)Math.Round((origPrice - offer.OfferPrice) / origPrice * 100) 
                                        : 0;

                                    <div class="offer-mobile-card">
                                        <!-- Top Bar: Order & Badges -->
                                        <div class="d-flex justify-content-between align-items-center mb-2.5 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge rounded-pill bg-dark font-monospace px-2 py-1" style="font-size: 0.72rem;">#@offer.DisplayOrder</span>
                                                @if (isDuo)
                                                {
                                                    <span class="badge rounded-pill" style="background-color: #630000; color: #fdf4dc; font-size: 0.7rem;">
                                                        <i class="fa-solid fa-layer-group me-1"></i>باقة عطرين
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border rounded-pill" style="font-size: 0.7rem;">عطر فردي</span>
                                                }
                                            </div>
                                            <div>
                                                @if (offer.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-circle-check me-1"></i>نشط
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-circle-pause me-1"></i>معطل
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Product details -->
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            @if (isDuo)
                                            {
                                                <div class="position-relative" style="width: 58px; height: 58px; flex-shrink: 0;">
                                                    <img src="@prod?.ImageUrl" alt="@prod?.Name" class="rounded-3 border position-absolute top-0 start-0" style="width: 38px; height: 38px; object-fit: cover; z-index: 2;" onerror="this.src='/images/placeholder.svg'" />
                                                    <img src="@prod2?.ImageUrl" alt="@prod2?.Name" class="rounded-3 border position-absolute bottom-0 end-0" style="width: 38px; height: 38px; object-fit: cover; z-index: 1;" onerror="this.src='/images/placeholder.svg'" />
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    @if (!string.IsNullOrWhiteSpace(offer.Title))
                                                    {
                                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@offer.Title</div>
                                                    }
                                                    <div class="small text-muted text-truncate">1. @(prod?.Name ?? "العطر الأول")</div>
                                                    <div class="small text-muted text-truncate">2. @(prod2?.Name ?? "العطر الثاني")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width: 54px; height: 54px;">
                                                    @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/placeholder.svg'" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-spray-can-sparkles text-muted fs-4"></i>
                                                    }
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@(prod?.Name ?? "عطر غير معروف")</div>
                                                    <div class="text-muted small font-monospace" style="font-size: 0.75rem;">SKU: @(prod?.Sku ?? "N/A")</div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Pricing & Badge row -->
                                        <div class="p-2.5 rounded-3 mb-3" style="background: #FAF9F5; border: 1px solid #f0ebe1;">
                                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                                <div>
                                                    <span class="text-muted text-decoration-line-through small font-monospace me-2">@origPrice.ToString("N0") ج.م</span>
                                                    <span class="fw-bold font-monospace text-danger fs-6">@offer.OfferPrice.ToString("N0") ج.م</span>
                                                </div>
                                                @if (discount > 0)
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill px-2 py-0.5 small fw-bold">
                                                        خصم @discount%
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted pt-1 border-top" style="border-color: #e8e3d5 !important; font-size: 0.76rem;">
                                                <span><i class="fa-solid fa-tag text-warning me-1"></i>@offer.BadgeText</span>
                                                <span class="font-monospace"><i class="fa-solid fa-box text-secondary me-1"></i>متبقي: <strong>@offer.RemainingCount</strong></span>
                                                <span><i class="fa-solid fa-clock text-info me-1"></i>@(offer.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "مستمر")</span>
                                            </div>
                                        </div>

                                        <!-- Mobile Action Buttons -->
                                        <div class="d-flex gap-2">
                                            <button type="submit" form="toggleOfferForm_@offer.Id" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;">
                                                <i class="fa-solid @(offer.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                                <span>@(offer.IsActive ? "إيقاف" : "تفعيل")</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;" onclick="openEditOfferModal(@offer.Id, @offer.ProductId, @(offer.SecondProductId?.ToString() ?? "null"), '@(offer.Title?.Replace("'", "\\'") ?? "")', @offer.OfferPrice, '@(offer.BadgeText?.Replace("'", "\\'") ?? "")', @offer.AllocatedPercent, @offer.RemainingCount, '@(offer.EndTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @offer.DisplayOrder)">
                                                <i class="fa-solid fa-pen"></i>
                                                <span>تعديل</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;" onclick="confirmDeleteOffer(@offer.Id, '@(prod?.Name?.Replace("'", "\\'") ?? "العرض")@(isDuo ? " + " + prod2?.Name?.Replace("'", "\\'") : "")')">
                                                <i class="fa-solid fa-trash"></i>
                                                <span>حذف</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 bg-light rounded-4 border">
                                <i class="fa-solid fa-bolt text-warning display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">لا توجد عطور مضافة في قسم العروض حالياً</h5>
                                <p class="text-muted small mb-3">يمكنك إضافة عطور متعددة وتقديم خصومات حصرية للمتجر مع شريط العد التنازلي.</p>
                                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold text-white" style="background: #810100; border-color: #810100;" data-bs-toggle="modal" data-bs-target="#addOfferModal">
                                    <i class="fa-solid fa-plus me-1"></i> إضافة أول عطر للعروض الآن
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Fallback / Single Product Spotlight Settings (Collapsible) -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-setting-header bg-white" data-bs-toggle="collapse" data-bs-target="#fallbackSpotlightSettings" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" style="color: #1B1717;">
                                    <i class="fa-solid fa-sliders text-secondary me-2"></i>الإعدادات الافتراضية للعرض الفردي (Fallback Single Spotlight)
                                </span>
                                <div class="text-muted small mt-0.5">تُستخدم هذه الإعدادات كاحتياطي في حالة عدم تفعيل قائمة العروض المتعددة أعلاه.</div>
                            </div>
                            <i class="fa-solid fa-chevron-down text-muted"></i>
                        </div>
                    </div>
                    <div class="collapse" id="fallbackSpotlightSettings">
                        <div class="card-body p-4 border-top">
                            <div class="row g-4">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-dark">العطر المعروض الافتراضي</label>
                                    <select asp-for="SpotlightProductId" class="form-select rounded-3">
                                        <option value="">-- التحديد التلقائي لأول عطر مميز في الكتالوج --</option>
                                        @foreach (var prod in products)
                                        {
                                            <option value="@prod.Id">@prod.Name (@prod.Price.ToString("N0") EGP)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-dark">سعر العرض الخاص (Spotlight Price EGP)</label>
                                    <div class="input-group">
                                        <input type="number" step="0.01" asp-for="SpotlightPrice" class="form-control rounded-start-3 font-monospace fw-bold" />
                                        <span class="input-group-text bg-light">EGP</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold text-dark">موعد انتهاء العرض (Timer End Date/Time)</label>
                                    <input type="datetime-local" asp-for="SpotlightEndTime" class="form-control rounded-3" />
                                </div>
                                <div class="col-12 col-md-4">
