@model Stockify.Models.Entities.HomeSetting
@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Control — Maison ROVEN";
    var products = ViewBag.Products as List<Stockify.Models.Entities.Product> ?? new();
    var homeOffers = ViewBag.HomeOffers as List<Stockify.Models.Entities.HomeOffer> ?? new();
    var heroBanners = ViewBag.HeroBanners as List<Stockify.Models.Entities.HeroBanner> ?? new();
}

<style>
    /* Tabs Navigation */
    .roven-tabs {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.5rem;
    }
    .roven-tabs .nav-item {
        flex: 1 1 0;
        min-width: 0;
    }
    .roven-tabs .nav-link {
        width: 100%;
        color: #555;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.75rem 0.5rem;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        background: #fff;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.88rem;
    }
    .roven-tabs .nav-link:hover {
        color: #810100;
        background: #fdfaf6;
        border-color: rgba(129, 1, 0, 0.15);
    }
    .roven-tabs .nav-link.active {
        color: #EDEBDD !important;
        background-color: #810100 !important;
        border-color: #810100 !important;
        box-shadow: 0 4px 12px rgba(129, 1, 0, 0.25);
    }
    .card-setting-header {
        background-color: #ffffff;
        border-bottom: 1px solid #f1ece4;
        padding: 1.15rem 1.25rem;
    }
    .tab-pane-content {
        animation: fadeInTab 0.25s ease-in-out;
    }
    .tab-content,
    .tab-pane,
    .tab-pane-content {
        min-width: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
    }
    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Live Marquee Preview Animation with Strict Containment & Absolute Detached Layout */
    .preview-marquee-wrapper {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        height: 46px !important;
        min-height: 46px !important;
        max-height: 46px !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        display: block !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        contain: strict !important;
        isolation: isolate !important;
        border-radius: 12px !important;
    }
    .preview-marquee-wrapper::before,
    .preview-marquee-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 36px;
        z-index: 4;
        pointer-events: none;
    }
    .preview-marquee-wrapper::before {
        left: 0;
        background: linear-gradient(to right, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-wrapper::after {
        right: 0;
        background: linear-gradient(to left, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        user-select: none;
        contain: strict !important;
        direction: ltr !important;
    }
    .preview-marquee-track {
        display: flex !important;
        align-items: center !important;
        flex-shrink: 0 !important;
        height: 100% !important;
        width: max-content !important;
        animation: previewMarqueeScroll 25s linear infinite;
        will-change: transform;
    }
    .preview-marquee-wrapper:hover .preview-marquee-track {
        animation-play-state: paused;
    }
    .preview-marquee-group {
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.85rem !important;
        padding: 0 1.25rem !important;
        height: 100% !important;
        flex-shrink: 0 !important;
    }
    .preview-marquee-badge {
        height: 24px !important;
        min-height: 24px !important;
        max-height: 24px !important;
        line-height: 24px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 0.75rem !important;
        border-radius: 9999px !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
        max-width: 150px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        background: linear-gradient(135deg, #810100 0%, #630000 100%) !important;
        color: #EDEBDD !important;
        border: 1px solid rgba(223, 177, 91, 0.45) !important;
        box-sizing: border-box !important;
    }
    .preview-marquee-text {
        white-space: nowrap !important;
        font-size: 0.84rem !important;
        font-weight: 600 !important;
        color: #EDEBDD !important;
        letter-spacing: 0.35px !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
    }
    @@keyframes previewMarqueeScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }

    /* Banner Thumbnail & Action styling */
    .banner-thumb-container {
        width: 140px;
        height: 64px;
        background: #fdfaf6;
        border-color: #e8e3d5 !important;
    }

    /* Mobile Offer Card */
    .offer-mobile-card {
        border-radius: 14px;
        border: 1px solid #e8e3d5;
        background: #ffffff;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 767.98px) {
        .roven-tabs {
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
            padding: 0.4rem !important;
            gap: 0.4rem !important;
            scrollbar-width: none;
        }
        .roven-tabs::-webkit-scrollbar {
            display: none;
        }
        .roven-tabs .nav-item {
            flex: 0 0 auto !important;
        }
        .roven-tabs .nav-link {
            font-size: 0.82rem;
            padding: 0.55rem 0.85rem;
        }
        .app-content {
            padding: 0.85rem 0.5rem !important;
        }
        .card-setting-header {
            padding: 0.95rem 0.85rem !important;
        }
        .card-body {
            padding: 0.95rem 0.85rem !important;
        }
        .banner-thumb-container {
            width: 100% !important;
            height: 120px !important;
        }
        .banner-card-mobile {
            padding: 0.85rem !important;
        }
        .sticky-save-bar {
            position: sticky;
            bottom: 0.75rem;
            z-index: 1020;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
        }
    }
</style>

<div class="container-fluid py-3 px-2 px-md-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(99, 0, 0, 0.08); border: 1px solid rgba(99, 0, 0, 0.2); color: #630000; font-size: 0.78rem; font-weight: 700;">
                <i class="fa-solid fa-sliders"></i>
                <span>HOMEPAGE CUSTOMIZATION SUITE</span>
            </div>
            <h2 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', serif;">Home Control Center</h2>
            <p class="text-muted small mb-0">لوحة تحكم كاملة في كافة سكشنات وبانرات ونصوص الصفحة الرئيسية للمتجر بروابط وتعديلات حية تسمع فورياً.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-start justify-content-md-end">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2 shadow-xs" onclick="syncImagesToCloudinary(this)" title="ضغط وتحويل كل صور المتجر إلى WebP ورفعها لـ Cloudinary">
                <i class="fa-solid fa-cloud-arrow-up text-primary"></i>
                <span>مزامنة الصور (WebP)</span>
            </button>
            <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-dark btn-sm px-3 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span>معاينة المتجر</span>
            </a>
            <button type="submit" form="homeControlForm" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2 fw-bold shadow-sm text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>حفظ كافة التغييرات</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert" style="background-color: #f0fdf4; border-left: 5px solid #16a34a !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <span class="fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert" style="background-color: #fef2f2; border-left: 5px solid #dc2626 !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation text-danger fs-5"></i>
                <span class="fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs Navigation Bar (4 Side-by-Side English Tabs) -->
    <ul class="nav nav-pills roven-tabs gap-2 mb-4 p-2 bg-light rounded-4 border" id="homeControlTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-banners-btn" data-bs-toggle="pill" data-bs-target="#tab-banners" type="button" role="tab" aria-controls="tab-banners" aria-selected="true">
                <i class="fa-solid fa-images"></i>
                <span>1. Hero Banners</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-spotlight-btn" data-bs-toggle="pill" data-bs-target="#tab-spotlight" type="button" role="tab" aria-controls="tab-spotlight" aria-selected="false">
                <i class="fa-solid fa-bolt text-warning"></i>
                <span>2. Offers & Marquee</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-sections-btn" data-bs-toggle="pill" data-bs-target="#tab-sections" type="button" role="tab" aria-controls="tab-sections" aria-selected="false">
                <i class="fa-solid fa-eye"></i>
                <span>3. Sections Visibility</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-social-btn" data-bs-toggle="pill" data-bs-target="#tab-social" type="button" role="tab" aria-controls="tab-social" aria-selected="false">
                <i class="fa-solid fa-bullhorn"></i>
                <span>4. Announcement & Social</span>
            </button>
        </li>
    </ul>

    <!-- Main Form for all tabs -->
    <form id="homeControlForm" asp-controller="HomeControl" asp-action="Update" method="post">
        @Html.AntiForgeryToken()

        <div class="tab-content" id="homeControlTabsContent">

            <!-- ============================================================== -->
            <!-- TAB 1: HOMEPAGE HERO BANNERS (IMAGE-BASED SLIDES)              -->
            <!-- ============================================================== -->
            <div class="tab-pane fade show active tab-pane-content" id="tab-banners" role="tabpanel" aria-labelledby="tab-banners-btn">
                
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <!-- Header Strip in Light Theme matching Maison ROVEN Dashboard -->
                    <div class="card-setting-header p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(129, 1, 0, 0.08); border: 1px solid rgba(129, 1, 0, 0.2); color: #810100; font-size: 0.74rem; font-weight: 700; letter-spacing: 1px;">
                                <i class="fa-solid fa-images"></i>
                                <span>HOMEPAGE HERO BANNERS</span>
                            </div>
                            <h4 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif; color: #1B1717;">بانرات الواجهة الرئيسية (Hero Banner Carousel)</h4>
                            <p class="text-muted small mb-0" style="max-width: 680px;">
                                UPLOAD FULLY STYLED BANNER IMAGES. MULTIPLE ACTIVE BANNERS WILL CYCLE AS A DYNAMIC CAROUSEL.
                                <br />
                                ارفع صور البانرات المصممة بالكامل بمقاس الديسكتوب (1920x800) واختيارياً الموبايل (750x1000). تظهر فوراً في سكشن الهيرو أعلى المتجر.
                            </p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 text-white" style="background: #810100; border-color: #810100; width: auto !important;" data-bs-toggle="modal" data-bs-target="#createHeroBannerModal">
                            <i class="fa-solid fa-plus"></i>
                            <span>ADD NEW BANNER +</span>
                        </button>
                    </div>

                    <!-- Banners List in Light Theme -->
                    <div class="p-2 p-md-4 bg-white">
                        @if (heroBanners.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @for (int i = 0; i < heroBanners.Count; i++)
                                {
                                    var banner = heroBanners[i];
                                    <div class="card border p-3 rounded-4 position-relative bg-white shadow-xs banner-card-mobile" style="border-color: #e8e3d5 !important;">
                                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                                            
                                            <!-- Left: Image Preview & Details -->
                                            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3 w-100 flex-grow-1" style="min-width: 0;">
                                                <div class="position-relative overflow-hidden rounded-3 border flex-shrink-0 banner-thumb-container">
                                                    <img src="@banner.DesktopImageUrl" alt="@banner.Title" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/banners/hero_slide_1.svg'" />
                                                    <span class="badge position-absolute bottom-0 start-0 m-1 font-monospace" style="background: rgba(27,23,23,0.85); font-size: 0.65rem; padding: 0.2rem 0.4rem; color: #EDEBDD;">#@banner.DisplayOrder</span>
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0; width: 100%;">
                                                    <div class="fw-bold mb-1 text-truncate" style="font-size: 0.98rem; color: #1B1717;" title="@banner.Title">
                                                        @banner.Title
                                                    </div>
                                                    <div class="d-flex flex-wrap align-items-center gap-2 small">
                                                        <span class="font-monospace text-break" style="color: #810100; font-size: 0.8rem; word-break: break-all;">
                                                            <i class="fa-solid fa-link me-1"></i>Redirect Link: <strong class="text-decoration-underline">@banner.RedirectLink</strong>
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(banner.MobileImageUrl))
                                                        {
                                                            <span class="badge rounded-pill" style="background: rgba(223, 177, 91, 0.15); color: #8a6a1b; border: 1px solid rgba(223, 177, 91, 0.4); font-size: 0.68rem;">
                                                                <i class="fa-solid fa-mobile-screen me-1"></i>Mobile Ready
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill bg-light text-muted border font-monospace" style="font-size: 0.68rem;">
                                                                Desktop Only
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Right: Controls matching user's image (Active Pill, Up, Down, Edit, Delete) -->
                                            <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 w-100 w-md-auto pt-2 pt-md-0 border-top border-md-top-0" style="border-color: #f1ece4 !important;">
                                                <!-- Active Badge / Toggle Button -->
                                                <button type="submit" form="toggleBannerForm_@banner.Id" class="badge rounded-pill px-3 py-2 fw-bold text-decoration-none border-0 shadow-xs" style="background-color: @(banner.IsActive ? "#198754" : "#6c757d"); color: #ffffff; cursor: pointer; font-size: 0.74rem; letter-spacing: 0.5px;" title="انقر لتغيير الحالة">
                                                    @(banner.IsActive ? "ACTIVE" : "INACTIVE")
                                                </button>

                                                <div class="d-flex align-items-center gap-1.5">
                                                    <!-- Move Up -->
                                                    <button type="submit" form="moveBannerUpForm_@banner.Id" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center @(i == 0 ? "disabled" : "")" style="width: 34px; height: 34px;" title="تحريك لأعلى">
                                                        <i class="fa-solid fa-arrow-up" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Move Down -->
                                                    <button type="submit" form="moveBannerDownForm_@banner.Id" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center @(i == heroBanners.Count - 1 ? "disabled" : "")" style="width: 34px; height: 34px;" title="تحريك لأسفل">
                                                        <i class="fa-solid fa-arrow-down" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(13, 110, 253, 0.1); color: #0d6efd; border: 1px solid rgba(13, 110, 253, 0.25);" title="تعديل البانر" onclick="openEditBannerModal(@banner.Id, '@(banner.Title.Replace("'", "\\'"))', '@(banner.DesktopImageUrl.Replace("'", "\\'"))', '@(banner.MobileImageUrl?.Replace("'", "\\'") ?? "")', '@(banner.RedirectLink?.Replace("'", "\\'") ?? "")', '@(banner.AltText?.Replace("'", "\\'") ?? "")', @(banner.IsActive ? "true" : "false"), @banner.DisplayOrder)">
                                                        <i class="fa-solid fa-pen" style="font-size: 0.8rem;"></i>
                                                    </button>

                                                    <!-- Delete Button -->
                                                    <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.25);" title="حذف البانر" onclick="confirmDeleteBanner(@banner.Id, '@(banner.Title.Replace("'", "\\'"))')">
                                                        <i class="fa-solid fa-xmark" style="font-size: 0.95rem;"></i>
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 rounded-4 bg-light border" style="border-style: dashed !important; border-color: #d1c7bd !important;">
                                <i class="fa-solid fa-images display-4 mb-3" style="color: #810100;"></i>
                                <h5 class="fw-bold mb-2" style="color: #1B1717;">لا توجد بانرات مضافة حالياً</h5>
                                <p class="text-muted small mb-3">
                                    اضغط على زر "ADD NEW BANNER +" لرفع أول بانر مصمم بالكامل للواجهة الرئيسية للمتجر.
                                </p>
                                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold text-white" style="background: #810100; border-color: #810100;" data-bs-toggle="modal" data-bs-target="#createHeroBannerModal">
                                    <i class="fa-solid fa-plus me-1"></i> ADD NEW BANNER +
                                </button>
                            </div>
                        }
                    </div>
                </div>

            </div>

                        <!-- TAB 2: SPECIAL OFFERS & DEALS (MULTI-PRODUCT)                  -->
            <!-- ============================================================== -->
            <div class="tab-pane fade tab-pane-content" id="tab-spotlight" role="tabpanel" aria-labelledby="tab-spotlight-btn">
                
                <!-- Main Offers Management Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-setting-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-bolt text-warning me-2"></i>عروض وتخفيضات الصفحة الرئيسية (Special Offers & Deals)
                            </span>
                            <div class="text-muted small mt-1">
                                أضف أكثر من منتج إلى قسم العروض. إذا وجد منتجين أو أكثر سيتم عرضها كشبكة كروت عروض فاخرة في الهوم.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 gap-md-3 flex-wrap justify-content-between justify-content-md-end">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="SpotlightActive" id="spotlightSwitch" style="cursor: pointer;">
                                <label class="form-check-label small fw-semibold" for="spotlightSwitch">تفعيل قسم العروض</label>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5 text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;" data-bs-toggle="modal" data-bs-target="#addOfferModal">
                                <i class="fa-solid fa-plus"></i>
                                <span>إضافة عطر جديد للعروض</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-2 p-md-4">
                        @if (homeOffers.Any())
                        {
                            <!-- Desktop View: Comprehensive 10-Column Table -->
                            <div class="table-responsive d-none d-lg-block">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th style="width: 50px;">#</th>
                                            <th>محتوى العرض</th>
                                            <th>النوع</th>
