@model Stockify.Models.Entities.HomeSetting
@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Control — Maison ROVEN";
    var products = ViewBag.Products as List<Stockify.Models.Entities.Product> ?? new();
    var homeOffers = ViewBag.HomeOffers as List<Stockify.Models.Entities.HomeOffer> ?? new();
    var heroBanners = ViewBag.HeroBanners as List<Stockify.Models.Entities.HeroBanner> ?? new();
    var faqItems = ViewBag.FaqItems as List<Stockify.Models.Entities.HomeFaqItem> ?? new();
}

<style>
    /* Drag & Drop Reordering Styles */
    .sortable-section-card {
        user-select: none;
        -webkit-user-select: none;
    }
    .sortable-section-card:hover {
        border-color: rgba(181, 141, 74, 0.6) !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06) !important;
    }
    .sortable-ghost {
        opacity: 0.35 !important;
        background: #fff8eb !important;
        border: 2px dashed #dfb15b !important;
        box-shadow: none !important;
    }
    .sortable-chosen {
        background-color: #fdfaf3 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12) !important;
    }
    .sortable-drag {
        opacity: 0.95 !important;
        transform: scale(1.015);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18) !important;
    }
    .cursor-grab {
        cursor: grab !important;
    }
    .cursor-grab:active {
        cursor: grabbing !important;
    }

    /* Live Sequence Stepper / Pipeline Track */
    .section-sequence-track {
        display: flex !important;
        align-items: center !important;
        gap: 0.55rem !important;
        overflow-x: auto !important;
        white-space: nowrap !important;
        -webkit-overflow-scrolling: touch !important;
        padding: 0.65rem 0.5rem 0.85rem !important;
        scrollbar-width: thin;
        scrollbar-color: rgba(181, 141, 74, 0.45) transparent;
        direction: rtl !important;
    }
    .section-sequence-track::-webkit-scrollbar {
        height: 6px;
    }
    .section-sequence-track::-webkit-scrollbar-track {
        background: rgba(27, 23, 23, 0.04);
        border-radius: 10px;
    }
    .section-sequence-track::-webkit-scrollbar-thumb {
        background: rgba(181, 141, 74, 0.45);
        border-radius: 10px;
    }
    .section-sequence-track::-webkit-scrollbar-thumb:hover {
        background: #810100;
    }

    .section-seq-chip {
        flex-shrink: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.55rem !important;
        height: 42px !important;
        padding: 0 16px 0 12px !important;
        border-radius: 9999px !important;
        background: #ffffff !important;
        border: 1.5px solid rgba(181, 141, 74, 0.35) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
        user-select: none;
        cursor: default;
    }
    .section-seq-chip:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(129, 1, 0, 0.14) !important;
        border-color: #810100 !important;
    }
    .section-seq-chip.is-active {
        background: #ffffff !important;
        border-color: rgba(181, 141, 74, 0.45) !important;
    }
    .section-seq-chip.is-disabled {
        background: #f7f5ef !important;
        border: 1.5px dashed #cfc8ba !important;
        opacity: 0.72;
    }
    .seq-num-circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 800;
        font-family: monospace;
        flex-shrink: 0;
        color: #EDEBDD;
        background: linear-gradient(135deg, #810100 0%, #630000 100%);
        box-shadow: 0 2px 5px rgba(99, 0, 0, 0.3);
    }
    .section-seq-chip.is-disabled .seq-num-circle {
        background: #8c857b !important;
        box-shadow: none;
    }
    .seq-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    .seq-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: #1B1717;
        white-space: nowrap;
        letter-spacing: 0.2px;
    }
    .section-seq-chip.is-disabled .seq-title {
        color: #7a7369;
    }
    .seq-hidden-tag {
        font-size: 0.65rem;
        font-weight: 700;
        background: rgba(129, 1, 0, 0.08);
        color: #810100;
        padding: 2px 8px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        border: 1px solid rgba(129, 1, 0, 0.18);
        margin-right: 2px;
    }
    .seq-connector {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #b58d4a;
        opacity: 0.65;
        font-size: 0.78rem;
        padding: 0 3px;
        user-select: none;
    }

    /* Tabs Navigation */
    .roven-tabs {
        display: flex;
        gap: 0.5rem;
    }
    @@media (min-width: 1200px) {
        .roven-tabs {
            flex-wrap: nowrap;
        }
        .roven-tabs .nav-item {
            flex: 1 1 0;
            min-width: 0;
        }
    }
    @@media (max-width: 1199.98px) {
        .roven-tabs {
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
            padding: 0.45rem !important;
        }
        .roven-tabs::-webkit-scrollbar {
            display: none !important;
        }
        .roven-tabs .nav-item {
            flex: 0 0 auto !important;
            min-width: max-content !important;
        }
        .roven-tabs .nav-link {
            font-size: 0.84rem !important;
            padding: 0.6rem 1rem !important;
            border-radius: 9999px !important;
            white-space: nowrap !important;
        }
    }
    .roven-tabs .nav-link {
        width: 100%;
        color: #555;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.75rem 0.5rem;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        background: #fff;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.88rem;
    }
    .roven-tabs .nav-link:hover {
        color: #810100;
        background: #fdfaf6;
        border-color: rgba(129, 1, 0, 0.15);
    }
    .roven-tabs .nav-link.active {
        color: #EDEBDD !important;
        background-color: #810100 !important;
        border-color: #810100 !important;
        box-shadow: 0 4px 12px rgba(129, 1, 0, 0.25);
    }
    .card-setting-header {
        background-color: #ffffff;
        border-bottom: 1px solid #f1ece4;
        padding: 1.15rem 1.25rem;
    }
    .tab-pane-content {
        animation: fadeInTab 0.25s ease-in-out;
    }
    .tab-content,
    .tab-pane,
    .tab-pane-content {
        min-width: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
    }
    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Live Marquee Preview Animation with Strict Containment & Absolute Detached Layout */
    .preview-marquee-wrapper {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        height: 46px !important;
        min-height: 46px !important;
        max-height: 46px !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        display: block !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        contain: strict !important;
        isolation: isolate !important;
        border-radius: 12px !important;
    }
    .preview-marquee-wrapper::before,
    .preview-marquee-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 36px;
        z-index: 4;
        pointer-events: none;
    }
    .preview-marquee-wrapper::before {
        left: 0;
        background: linear-gradient(to right, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-wrapper::after {
        right: 0;
        background: linear-gradient(to left, #150f0f 0%, transparent 100%);
    }
    .preview-marquee-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        overflow: hidden !important;
        white-space: nowrap !important;
        user-select: none;
        contain: strict !important;
        direction: ltr !important;
    }
    .preview-marquee-track {
        display: flex !important;
        align-items: center !important;
        flex-shrink: 0 !important;
        height: 100% !important;
        width: max-content !important;
        animation: previewMarqueeScroll 25s linear infinite;
        will-change: transform;
    }
    .preview-marquee-wrapper:hover .preview-marquee-track {
        animation-play-state: paused;
    }
    .preview-marquee-group {
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.85rem !important;
        padding: 0 1.25rem !important;
        height: 100% !important;
        flex-shrink: 0 !important;
    }
    .preview-marquee-badge {
        height: 24px !important;
        min-height: 24px !important;
        max-height: 24px !important;
        line-height: 24px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 0.75rem !important;
        border-radius: 9999px !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
        max-width: 150px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        background: linear-gradient(135deg, #810100 0%, #630000 100%) !important;
        color: #EDEBDD !important;
        border: 1px solid rgba(223, 177, 91, 0.45) !important;
        box-sizing: border-box !important;
    }
    .preview-marquee-text {
        white-space: nowrap !important;
        font-size: 0.84rem !important;
        font-weight: 600 !important;
        color: #EDEBDD !important;
        letter-spacing: 0.35px !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
    }
    @@keyframes previewMarqueeScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }

    /* Banner Thumbnail & Action styling */
    .banner-thumb-container {
        width: 140px;
        height: 64px;
        background: #fdfaf6;
        border-color: #e8e3d5 !important;
    }

    /* Mobile Offer Card */
    .offer-mobile-card {
        border-radius: 14px;
        border: 1px solid #e8e3d5;
        background: #ffffff;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 767.98px) {
        .roven-tabs {
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
            padding: 0.4rem !important;
            gap: 0.4rem !important;
            scrollbar-width: none;
        }
        .roven-tabs::-webkit-scrollbar {
            display: none;
        }
        .roven-tabs .nav-item {
            flex: 0 0 auto !important;
        }
        .roven-tabs .nav-link {
            font-size: 0.82rem;
            padding: 0.55rem 0.85rem;
        }
        .app-content {
            padding: 0.85rem 0.5rem !important;
        }
        .card-setting-header {
            padding: 0.95rem 0.85rem !important;
        }
        .card-body {
            padding: 0.95rem 0.85rem !important;
        }
        .banner-thumb-container {
            width: 100% !important;
            height: 120px !important;
        }
        .banner-card-mobile {
            padding: 0.85rem !important;
        }
        .sticky-save-bar {
            position: sticky;
            bottom: 0.75rem;
            z-index: 1020;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
            padding: 0.85rem !important;
        }
    }

    @@media (max-width: 575.98px) {
        .sortable-section-card {
            padding: 0.75rem !important;
        }
        .sortable-section-card .drag-handle {
            padding: 0 4px !important;
        }
        .sortable-section-card .section-rank-badge {
            font-size: 0.7rem !important;
            padding: 0.25rem 0.55rem !important;
            min-width: 44px !important;
        }
        .sortable-section-card .rounded-circle {
            width: 34px !important;
            height: 34px !important;
        }
        .sortable-section-card .rounded-circle i {
            font-size: 0.95rem !important;
        }
        .sortable-section-card .fw-bold span {
            font-size: 0.88rem !important;
        }
        .sticky-save-bar .btn {
            font-size: 0.8rem !important;
            padding: 0.45rem 0.75rem !important;
        }
    }
</style>

<div class="container-fluid py-3 px-2 px-md-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(99, 0, 0, 0.08); border: 1px solid rgba(99, 0, 0, 0.2); color: #630000; font-size: 0.78rem; font-weight: 700;">
                <i class="fa-solid fa-sliders"></i>
                <span>HOMEPAGE CUSTOMIZATION SUITE</span>
            </div>
            <h2 class="fw-extrabold mb-1" style="color: #1B1717; font-family: 'Playfair Display', serif;">Home Control Center</h2>
            <p class="text-muted small mb-0">لوحة تحكم كاملة في كافة سكشنات وبانرات ونصوص الصفحة الرئيسية للمتجر بروابط وتعديلات حية تسمع فورياً.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-start justify-content-md-end">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light border text-muted small shadow-xs" title="يتم ضغط وتحويل كافة الصور تلقائياً إلى صيغة WebP السحابية ومزامنتها فور الحفظ وبدء التشغيل">
                <i class="fa-solid fa-cloud-arrow-up text-success"></i>
                <span style="font-size: 0.8rem; font-weight: 600; color: #1B1717;">مزامنة WebP التلقائية نشطة</span>
            </div>
            <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-dark btn-sm px-3 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span>معاينة المتجر</span>
            </a>
            <button type="submit" form="homeControlForm" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2 fw-bold shadow-sm text-white" style="background: #810100; border-color: #810100; width: auto !important; max-width: fit-content;">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>حفظ كافة التغييرات</span>
            </button>
        </div>
    </div>

    <!-- Tabs Navigation Bar (Side-by-Side Clean Tabs) -->
    <ul class="nav nav-pills roven-tabs gap-2 mb-4 p-2 bg-light rounded-4 border d-flex flex-wrap align-items-center" id="homeControlTabs" role="tablist" style="overflow-x: auto;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-banners-btn" data-bs-toggle="pill" data-bs-target="#tab-banners" type="button" role="tab" aria-controls="tab-banners" aria-selected="true">
                <i class="fa-solid fa-images"></i>
                <span>1. Hero Banners</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-spotlight-btn" data-bs-toggle="pill" data-bs-target="#tab-spotlight" type="button" role="tab" aria-controls="tab-spotlight" aria-selected="false">
                <i class="fa-solid fa-bolt text-warning"></i>
                <span>2. Offers & Marquee</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-bestsellers-btn" data-bs-toggle="pill" data-bs-target="#tab-bestsellers" type="button" role="tab" aria-controls="tab-bestsellers" aria-selected="false">
                <i class="fa-solid fa-fire text-danger"></i>
                <span>3. Best Sellers</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-featured-btn" data-bs-toggle="pill" data-bs-target="#tab-featured" type="button" role="tab" aria-controls="tab-featured" aria-selected="false">
                <i class="fa-solid fa-crown" style="color: #630000;"></i>
                <span>4. Featured Parfums</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-sections-btn" data-bs-toggle="pill" data-bs-target="#tab-sections" type="button" role="tab" aria-controls="tab-sections" aria-selected="false">
                <i class="fa-solid fa-arrows-up-down text-primary"></i>
                <span>5. Sections Visibility & Order</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-faq-btn" data-bs-toggle="pill" data-bs-target="#tab-faq" type="button" role="tab" aria-controls="tab-faq" aria-selected="false">
                <i class="fa-solid fa-circle-question text-info fs-6"></i>
                <span>6. FAQ Clarifications</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-comparison-btn" data-bs-toggle="pill" data-bs-target="#tab-comparison" type="button" role="tab" aria-controls="tab-comparison" aria-selected="false">
                <i class="fa-solid fa-code-compare text-success"></i>
                <span>7. Before & After (Us vs Them)</span>
            </button>
        </li>
    </ul>

    <!-- Main Form for all tabs -->
    <form id="homeControlForm" asp-controller="HomeControl" asp-action="Update" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="activeTab" id="mainFormActiveTab" value="@(ViewBag.ActiveTab ?? "tab-banners")" />

        <div class="tab-content" id="homeControlTabsContent">

            <!-- ============================================================== -->
            <!-- TAB 1: HOMEPAGE HERO BANNERS (IMAGE-BASED SLIDES)              -->
            <!-- ============================================================== -->
            <div class="tab-pane fade show active tab-pane-content" id="tab-banners" role="tabpanel" aria-labelledby="tab-banners-btn">
                
                <!-- ============================================================== -->
                <!-- TOP DEDICATED CARD: MAIN BRAND HERO (FIRST HOMEPAGE SECTION)   -->
                <!-- ============================================================== -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden" style="border: 1.5px solid rgba(181, 141, 74, 0.4) !important;">
                    <div class="card-setting-header p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(181, 141, 74, 0.12); border: 1px solid rgba(181, 141, 74, 0.35); color: #8a6519; font-size: 0.74rem; font-weight: 700; letter-spacing: 1px;">
                                <i class="fa-solid fa-crown text-warning"></i>
                                <span>HOMEPAGE SECTION #1 — MAIN BRAND HERO</span>
                            </div>
                            <h4 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif; color: #1B1717;">
                                البانر الرئيسي للدار (الهيرو الأساسي — ديسكتوب وموبايل)
                            </h4>
                            <p class="text-muted small mb-0" style="max-width: 720px;">
                                هذا هو أول وأكبر سكشن يظهر لزوار المتجر بأعلى الصفحة الرئيسية. يمكنك هنا تعديل صورة الديسكتوب وصورة الموبايل المنفصلة ورابط التوجيه والنص البديل بكل سهولة.
                            </p>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-primary btn-sm px-4 py-2.5 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 text-white" style="background: #810100; border-color: #810100; width: auto !important;" data-bs-toggle="modal" data-bs-target="#editMainBrandHeroModal">
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>تعديل صور وبيانات الهيرو</span>
                            </button>
                            <button type="submit" form="resetMainBrandHeroForm" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill fw-semibold shadow-xs" title="استعادة الصور الافتراضية الأصلية">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                <span class="d-none d-sm-inline ms-1">استعادة الأصلية</span>
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-3 p-md-4">
                        <div class="row g-4">
                            <!-- Desktop Hero Preview -->
                            <div class="col-12 col-lg-7">
                                <div class="p-3 rounded-4 border bg-light h-100 position-relative">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-desktop text-primary"></i>
                                            <span class="fw-bold text-dark small">صورة الديسكتوب والشاشات الكبيرة (Desktop Hero)</span>
                                        </div>
                                        <span class="badge bg-white text-muted border font-monospace" style="font-size: 0.72rem;">1920 × 800 px</span>
                                    </div>
                                    <div class="position-relative overflow-hidden rounded-3 border bg-dark" style="aspect-ratio: 1920/800; max-height: 230px;">
                                        <img src="@(string.IsNullOrWhiteSpace(Model.BrandHeroDesktopImageUrl) ? "/images/banners/roven-hero-main.png" : Model.BrandHeroDesktopImageUrl)" 
                                             alt="Desktop Hero Preview" 
                                             id="displayMainHeroDesktopPreview"
                                             style="width: 100%; height: 100%; object-fit: cover;" 
                                             onerror="this.src='/images/banners/roven-hero-main.png'" />
                                    </div>
                                    <div class="mt-2 text-truncate small text-muted font-monospace" style="font-size: 0.75rem;" title="@Model.BrandHeroDesktopImageUrl">
