@section Scripts {
<script>
    function openEditBannerModal(id, title, desktopUrl, mobileUrl, redirectLink, altText, isActive, order) {
        document.getElementById('editBannerId').value = id;
        document.getElementById('editBannerTitleInput').value = title;
        document.getElementById('editBannerDesktopUrlInput').value = desktopUrl;
        document.getElementById('editBannerDesktopPreview').src = desktopUrl;
        
        const mobilePreviewWrap = document.getElementById('editBannerMobilePreviewWrap');
        const mobilePreview = document.getElementById('editBannerMobilePreview');
        if (mobileUrl && mobileUrl.trim() !== '') {
            document.getElementById('editBannerMobileUrlInput').value = mobileUrl;
            mobilePreview.src = mobileUrl;
            mobilePreviewWrap.style.display = 'block';
        } else {
            document.getElementById('editBannerMobileUrlInput').value = '';
            mobilePreviewWrap.style.display = 'none';
        }

        document.getElementById('editBannerRedirectLinkInput').value = redirectLink || '/Store';
        document.getElementById('editBannerAltTextInput').value = altText || '';
        document.getElementById('editBannerActiveCheck').checked = (isActive === true || isActive === 'true');
        document.getElementById('editBannerDisplayOrder').value = order;

        const modal = new bootstrap.Modal(document.getElementById('editHeroBannerModal'));
        modal.show();
    }

    function confirmDeleteBanner(id, title) {
        document.getElementById('deleteBannerIdInput').value = id;
        document.getElementById('deleteBannerTitleDisplay').innerText = title;
        const modal = new bootstrap.Modal(document.getElementById('deleteHeroBannerModal'));
        modal.show();
    }

    function executeDeleteBanner() {
        document.getElementById('deleteBannerFormGlobal').submit();
    }

    function calculateAddOfferPricing() {
        const s1 = document.getElementById('addOfferProduct1Select');
        const s2 = document.getElementById('addOfferProduct2Select');
        const priceInput = document.getElementById('addOfferPriceInput');
        const summary = document.getElementById('addOfferPricingSummary');
        const badgeInput = document.getElementById('addOfferBadgeInput');

        const opt1 = s1.options[s1.selectedIndex];
        const opt2 = s2.options[s2.selectedIndex];

        const p1 = (opt1 && opt1.value) ? parseFloat(opt1.getAttribute('data-price') || '0') : 0;
        const p2 = (opt2 && opt2.value) ? parseFloat(opt2.getAttribute('data-price') || '0') : 0;
        const totalOrig = p1 + p2;

        if (p2 > 0) {
            if (badgeInput.value === 'EXCLUSIVE • عرض خاص' || !badgeInput.value) {
                badgeInput.value = 'DUO BUNDLE • عرض عطرين';
            }
        }

        if (totalOrig > 0 && (!priceInput.value || parseFloat(priceInput.value) <= 0 || priceInput.dataset.autoFilled === 'true')) {
            const suggested = Math.round(totalOrig * 0.82); // 18% discount
            priceInput.value = suggested;
            priceInput.dataset.autoFilled = 'true';
        }

        const currentOfferPrice = parseFloat(priceInput.value || '0');
        if (totalOrig > 0 && currentOfferPrice > 0) {
            const saving = Math.max(0, totalOrig - currentOfferPrice);
            const discPercent = Math.round((saving / totalOrig) * 100);
            summary.innerHTML = `السعر الأصلي الإجمالي: <strong>${totalOrig.toLocaleString()} ج.م</strong> &bull; قيمة التوفير: <strong>${saving.toLocaleString()} ج.م (${discPercent}%)</strong>`;
        }
    }

    function calculateEditOfferPricing() {
        const s1 = document.getElementById('editOfferProduct1Select');
        const s2 = document.getElementById('editOfferProduct2Select');
        const priceInput = document.getElementById('editOfferPriceInput');
        const summary = document.getElementById('editOfferPricingSummary');

        const opt1 = s1.options[s1.selectedIndex];
        const opt2 = s2.options[s2.selectedIndex];

        const p1 = (opt1 && opt1.value) ? parseFloat(opt1.getAttribute('data-price') || '0') : 0;
        const p2 = (opt2 && opt2.value) ? parseFloat(opt2.getAttribute('data-price') || '0') : 0;
        const totalOrig = p1 + p2;

        const currentOfferPrice = parseFloat(priceInput.value || '0');
        if (totalOrig > 0 && currentOfferPrice > 0) {
            const saving = Math.max(0, totalOrig - currentOfferPrice);
            const discPercent = Math.round((saving / totalOrig) * 100);
            summary.innerHTML = `السعر الأصلي: <strong>${totalOrig.toLocaleString()} ج.م</strong> &bull; التوفير: <strong>${saving.toLocaleString()} ج.م (${discPercent}%)</strong>`;
        }
    }

    function openEditOfferModal(id, prodId, secondProdId, title, offerPrice, badgeText, allocated, remaining, endTime, order) {
        document.getElementById('editOfferId').value = id;
        
        const s1 = document.getElementById('editOfferProduct1Select');
        if (s1) s1.value = prodId;

        const s2 = document.getElementById('editOfferProduct2Select');
        if (s2) s2.value = secondProdId || '';

        document.getElementById('editOfferTitleInput').value = title || '';
        document.getElementById('editOfferPriceInput').value = offerPrice;
        document.getElementById('editOfferBadgeInput').value = badgeText || '';
        document.getElementById('editOfferAllocatedInput').value = allocated;
        document.getElementById('editOfferRemainingInput').value = remaining;
        document.getElementById('editOfferEndTimeInput').value = endTime || '';
        document.getElementById('editOfferOrderInput').value = order;

        calculateEditOfferPricing();

        const modal = new bootstrap.Modal(document.getElementById('editOfferModal'));
        modal.show();
    }

    function confirmDeleteOffer(id, name) {
        document.getElementById('deleteOfferIdInput').value = id;
        document.getElementById('deleteOfferNameDisplay').innerText = name;
        const modal = new bootstrap.Modal(document.getElementById('deleteOfferModal'));
        modal.show();
    }

    function executeDeleteOffer() {
        document.getElementById('deleteOfferFormGlobal').submit();
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Save current tab in localStorage so refresh preserves active tab
        const tabLinks = document.querySelectorAll('#homeControlTabs button[data-bs-toggle="pill"]');
        const activeTabKey = 'roven_home_control_active_tab';

        const savedTab = localStorage.getItem(activeTabKey);
        if (savedTab) {
            const triggerEl = document.querySelector(`#homeControlTabs button[data-bs-target="${savedTab}"]`);
            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
            }
        }

        tabLinks.forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const target = e.target.getAttribute('data-bs-target');
                if (target) {
                    localStorage.setItem(activeTabKey, target);
                }
            });
        });

        // Live Marquee Preview Listeners
        const marqueeTextInput = document.getElementById('marqueeTextInput');
        const marqueeBadgeInput = document.getElementById('marqueeBadgeInput');

        if (marqueeTextInput) {
            marqueeTextInput.addEventListener('input', function () {
                const val = this.value.trim() || 'OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20';
                document.querySelectorAll('.preview-marquee-text').forEach(function (el) {
                    el.textContent = val;
                });
            });
        }
        if (marqueeBadgeInput) {
            marqueeBadgeInput.addEventListener('input', function () {
                const val = this.value.trim() || 'OFFER 20%';
                document.querySelectorAll('.preview-marquee-badge').forEach(function (el) {
                    el.textContent = val;
                });
            });
        }
    });

    async function syncImagesToCloudinary(btn) {
        const confirmResult = await Swal.fire({
            title: 'مزامنة الصور مع Cloudinary',
            text: 'سيتم تحويل وضغط كافة صور المنتجات والبانرات الحالية إلى صيغة WebP ورفعها إلى Cloudinary CDN وتحديث قاعدة البيانات بالروابط السحابية مباشرة.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'بدء المزامنة الآن',
            cancelButtonText: 'إلغاء',
            confirmButtonColor: '#630000',
            cancelButtonColor: '#6c757d'
        });

        if (!confirmResult.isConfirmed) return;

        const originalBtnHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> جاري المزامنة...';

        Swal.fire({
            title: 'جاري ضغط ورفع الصور...',
            text: 'يتم الآن تحويل الصور إلى WebP وضغطها ورفعها لـ Cloudinary. يرجى الانتظار قليلاً.',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : '';

            const response = await fetch('/HomeControl/SyncImagesToCloudinary', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            });

            const data = await response.json();

            if (data.success) {
                await Swal.fire({
                    icon: 'success',
                    title: 'اكتملت المزامنة بنجاح!',
                    html: `
                        <div class="text-start p-2">
                            <p class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> ${data.message}</p>
                            <p class="mb-1 text-muted small"><i class="fa-solid fa-images me-2"></i> عدد الصور التي تم تحويلها: <strong>${data.syncedCount}</strong></p>
                            <p class="mb-0 text-muted small"><i class="fa-solid fa-hard-drive me-2"></i> المساحة المخففة على السيرفر: <strong>${data.mbSaved} MB</strong></p>
                        </div>
                    `,
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#630000'
                });
                window.location.reload();
            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'تنبيه',
                    text: data.message || 'تعذرت المزامنة، يرجى مراجعة إعدادات Cloudinary.',
                    confirmButtonColor: '#630000'
                });
            }
        } catch (err) {
            console.error('Cloudinary sync error:', err);
            await Swal.fire({
                icon: 'error',
                title: 'خطأ في الاتصال',
                text: 'حدث خطأ أثناء الاتصال بالسيرفر. يرجى التأكد من تشغيل السيرفر والمحاولة مرة أخرى.',
                confirmButtonColor: '#630000'
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalBtnHtml;
        }
    }
</script>
}
