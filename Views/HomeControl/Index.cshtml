    function onAddOfferFormChange() {
        const s1 = document.getElementById('addOfferProduct1Select');
        const s2 = document.getElementById('addOfferProduct2Select');
        const s3 = document.getElementById('addOfferProduct3Select');
        const priceInput = document.getElementById('addOfferPriceInput');
        const origPriceInput = document.getElementById('addOfferOrigPriceInput');
        const badgeInput = document.getElementById('addOfferBadgeInput');
        const titleInput = document.getElementById('addOfferTitleInput');
        const descInput = document.getElementById('addOfferCustomDescInput');
        const pillsInput = document.getElementById('addOfferPillsInput');
        const btnTextInput = document.getElementById('addOfferBtnTextInput');
        const customUrlInput = document.getElementById('addOfferCustomImageUrlInput');
        const summary = document.getElementById('addOfferPricingSummary');

        const opt1 = s1 ? s1.options[s1.selectedIndex] : null;
        const opt2 = s2 ? s2.options[s2.selectedIndex] : null;
        const opt3 = s3 ? s3.options[s3.selectedIndex] : null;

        const p1 = (opt1 && opt1.value) ? parseFloat(opt1.getAttribute('data-price') || '0') : 0;
        const p2 = (opt2 && opt2.value) ? parseFloat(opt2.getAttribute('data-price') || '0') : 0;
        const p3 = (opt3 && opt3.value) ? parseFloat(opt3.getAttribute('data-price') || '0') : 0;
        const isTrio = (opt2 && opt2.value && opt3 && opt3.value);
        const isDuo = (opt2 && opt2.value && (!opt3 || !opt3.value));
        const isMulti = isDuo || isTrio;
        const catalogTotal = p1 + p2 + p3;

        let effectiveOrig = catalogTotal;
        const origOverride = parseFloat(origPriceInput?.value || '0');
        if (origOverride > 0) {
            effectiveOrig = origOverride;
        }

        if (isTrio && (!badgeInput.value || badgeInput.value === 'HOT DEAL • عرض مميز' || badgeInput.value === 'DUO BUNDLE • باقة عطرين')) {
            badgeInput.value = 'TRIO BUNDLE • باقة 3 عطور';
        } else if (isDuo && (!badgeInput.value || badgeInput.value === 'HOT DEAL • عرض مميز' || badgeInput.value === 'TRIO BUNDLE • باقة 3 عطور')) {
            badgeInput.value = 'DUO BUNDLE • باقة عطرين';
        }

        if (effectiveOrig > 0 && (!priceInput.value || parseFloat(priceInput.value) <= 0 || priceInput.dataset.autoFilled === 'true')) {
            const suggested = Math.round(effectiveOrig * 0.82);
            priceInput.value = suggested;
            priceInput.dataset.autoFilled = 'true';
        }

        const currentOfferPrice = parseFloat(priceInput.value || '0');
        const saving = Math.max(0, effectiveOrig - currentOfferPrice);
        const discPercent = effectiveOrig > 0 ? Math.round((saving / effectiveOrig) * 100) : 0;

        if (summary) {
            if (effectiveOrig > 0 && currentOfferPrice > 0) {
                summary.innerHTML = `
                    <div class="d-flex align-items-center justify-content-between w-100 flex-wrap gap-2 py-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-muted border px-2.5 py-1.5 font-monospace" style="font-size: 0.78rem;">
