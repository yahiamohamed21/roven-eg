                                                                <div class="fw-bold text-dark" style="font-size: 0.94rem;">@offer.Title</div>
                                                            }
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" title="@prod?.Name">
                                                                    @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                                    {
                                                                        <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa-solid fa-spray-can-sparkles text-muted small"></i>
                                                                    }
                                                                </div>
                                                                <span class="small fw-semibold text-dark">1. @(prod?.Name ?? "العطر الأول")</span>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" title="@prod2?.Name">
                                                                    @if (!string.IsNullOrWhiteSpace(prod2?.ImageUrl))
                                                                    {
                                                                        <img src="@prod2.ImageUrl" alt="@prod2.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa-solid fa-spray-can-sparkles text-muted small"></i>
                                                                    }
                                                                </div>
                                                                <span class="small fw-semibold text-dark">2. @(prod2?.Name ?? "العطر الثاني")</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                                                @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                                {
                                                                    <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa-solid fa-spray-can-sparkles text-muted"></i>
                                                                }
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold text-dark" style="font-size: 0.92rem;">@(prod?.Name ?? "عطر غير معروف")</div>
                                                                <div class="text-muted small font-monospace" style="font-size: 0.75rem;">SKU: @(prod?.Sku ?? "N/A")</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (isDuo)
                                                    {
                                                        <span class="badge rounded-pill" style="background-color: #630000; color: #fdf4dc;">
                                                            <i class="fa-solid fa-layer-group me-1"></i>باقة عطرين
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-secondary border rounded-pill">عطر فردي</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="text-muted text-decoration-line-through font-monospace">@origPrice.ToString("N0") ج.م</span>
                                                </td>
                                                <td>
                                                    <span class="fw-bold font-monospace text-danger fs-6">@offer.OfferPrice.ToString("N0") ج.م</span>
                                                    @if (discount > 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 small ms-1">
                                                            -@discount%
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge badge-roven-crimson px-2.5 py-1 rounded-pill small">@offer.BadgeText</span>
                                                    <div class="text-muted small mt-1 font-monospace" style="font-size: 0.75rem;">محجوز: @offer.AllocatedPercent%</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill font-monospace">
                                                        @offer.RemainingCount باقة
                                                    </span>
                                                </td>
                                                <td class="small text-muted font-monospace">
                                                    @(offer.EndTime?.ToString("yyyy-MM-dd HH:mm") ?? "مستمر")
                                                </td>
                                                <td>
                                                    @if (offer.IsActive)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">نشط</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">معطل</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="submit" form="toggleOfferForm_@offer.Id" class="btn btn-outline-secondary" title="@(offer.IsActive ? "إيقاف العرض" : "تفعيل العرض")">
                                                            <i class="fa-solid @(offer.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-primary" title="تعديل العرض" onclick="openEditOfferModal(@offer.Id, @offer.ProductId, @(offer.SecondProductId?.ToString() ?? "null"), '@(offer.Title?.Replace("'", "\\'") ?? "")', @offer.OfferPrice, '@(offer.BadgeText?.Replace("'", "\\'") ?? "")', @offer.AllocatedPercent, @offer.RemainingCount, '@(offer.EndTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @offer.DisplayOrder)">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" title="حذف العرض" onclick="confirmDeleteOffer(@offer.Id, '@(prod?.Name?.Replace("'", "\\'") ?? "العرض")@(isDuo ? " + " + prod2?.Name?.Replace("'", "\\'") : "")')">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Mobile View: Clean Touch-Friendly Luxury Cards (d-lg-none) -->
                            <div class="d-lg-none d-flex flex-column gap-3">
                                @foreach (var offer in homeOffers)
                                {
                                    var prod = offer.Product;
                                    var prod2 = offer.SecondProduct;
                                    var isDuo = prod2 != null;
                                    var origPrice = (prod?.Price ?? 0m) + (prod2?.Price ?? 0m);
                                    var discount = origPrice > offer.OfferPrice && origPrice > 0 
                                        ? (int)Math.Round((origPrice - offer.OfferPrice) / origPrice * 100) 
                                        : 0;

                                    <div class="offer-mobile-card">
                                        <!-- Top Bar: Order & Badges -->
                                        <div class="d-flex justify-content-between align-items-center mb-2.5 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge rounded-pill bg-dark font-monospace px-2 py-1" style="font-size: 0.72rem;">#@offer.DisplayOrder</span>
                                                @if (isDuo)
                                                {
                                                    <span class="badge rounded-pill" style="background-color: #630000; color: #fdf4dc; font-size: 0.7rem;">
                                                        <i class="fa-solid fa-layer-group me-1"></i>باقة عطرين
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border rounded-pill" style="font-size: 0.7rem;">عطر فردي</span>
                                                }
                                            </div>
                                            <div>
                                                @if (offer.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-circle-check me-1"></i>نشط
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-circle-pause me-1"></i>معطل
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Product details -->
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            @if (isDuo)
                                            {
                                                <div class="position-relative" style="width: 58px; height: 58px; flex-shrink: 0;">
                                                    <img src="@prod?.ImageUrl" alt="@prod?.Name" class="rounded-3 border position-absolute top-0 start-0" style="width: 38px; height: 38px; object-fit: cover; z-index: 2;" onerror="this.src='/images/placeholder.svg'" />
                                                    <img src="@prod2?.ImageUrl" alt="@prod2?.Name" class="rounded-3 border position-absolute bottom-0 end-0" style="width: 38px; height: 38px; object-fit: cover; z-index: 1;" onerror="this.src='/images/placeholder.svg'" />
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    @if (!string.IsNullOrWhiteSpace(offer.Title))
                                                    {
                                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@offer.Title</div>
                                                    }
                                                    <div class="small text-muted text-truncate">1. @(prod?.Name ?? "العطر الأول")</div>
                                                    <div class="small text-muted text-truncate">2. @(prod2?.Name ?? "العطر الثاني")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rounded-3 overflow-hidden border bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width: 54px; height: 54px;">
                                                    @if (!string.IsNullOrWhiteSpace(prod?.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/placeholder.svg'" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-spray-can-sparkles text-muted fs-4"></i>
                                                    }
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">@(prod?.Name ?? "عطر غير معروف")</div>
                                                    <div class="text-muted small font-monospace" style="font-size: 0.75rem;">SKU: @(prod?.Sku ?? "N/A")</div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Pricing & Badge row -->
                                        <div class="p-2.5 rounded-3 mb-3" style="background: #FAF9F5; border: 1px solid #f0ebe1;">
                                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                                <div>
                                                    <span class="text-muted text-decoration-line-through small font-monospace me-2">@origPrice.ToString("N0") ج.م</span>
                                                    <span class="fw-bold font-monospace text-danger fs-6">@offer.OfferPrice.ToString("N0") ج.م</span>
                                                </div>
                                                @if (discount > 0)
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill px-2 py-0.5 small fw-bold">
                                                        خصم @discount%
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted pt-1 border-top" style="border-color: #e8e3d5 !important; font-size: 0.76rem;">
                                                <span><i class="fa-solid fa-tag text-warning me-1"></i>@offer.BadgeText</span>
                                                <span class="font-monospace"><i class="fa-solid fa-box text-secondary me-1"></i>متبقي: <strong>@offer.RemainingCount</strong></span>
                                                <span><i class="fa-solid fa-clock text-info me-1"></i>@(offer.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "مستمر")</span>
                                            </div>
                                        </div>

                                        <!-- Mobile Action Buttons -->
                                        <div class="d-flex gap-2">
                                            <button type="submit" form="toggleOfferForm_@offer.Id" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;">
                                                <i class="fa-solid @(offer.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                                <span>@(offer.IsActive ? "إيقاف" : "تفعيل")</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;" onclick="openEditOfferModal(@offer.Id, @offer.ProductId, @(offer.SecondProductId?.ToString() ?? "null"), '@(offer.Title?.Replace("'", "\\'") ?? "")', @offer.OfferPrice, '@(offer.BadgeText?.Replace("'", "\\'") ?? "")', @offer.AllocatedPercent, @offer.RemainingCount, '@(offer.EndTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @offer.DisplayOrder)">
                                                <i class="fa-solid fa-pen"></i>
                                                <span>تعديل</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1.5 py-2" style="font-size: 0.82rem;" onclick="confirmDeleteOffer(@offer.Id, '@(prod?.Name?.Replace("'", "\\'") ?? "العرض")@(isDuo ? " + " + prod2?.Name?.Replace("'", "\\'") : "")')">
                                                <i class="fa-solid fa-trash"></i>
                                                <span>حذف</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 bg-light rounded-4 border">
                                <i class="fa-solid fa-bolt text-warning display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">لا توجد عطور مضافة في قسم العروض حالياً</h5>
                                <p class="text-muted small mb-3">يمكنك إضافة عطور متعددة وتقديم خصومات حصرية للمتجر مع شريط العد التنازلي.</p>
                                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold text-white" style="background: #810100; border-color: #810100;" data-bs-toggle="modal" data-bs-target="#addOfferModal">
                                    <i class="fa-solid fa-plus me-1"></i> إضافة أول عطر للعروض الآن
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Fallback / Single Product Spotlight Settings (Collapsible) -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-setting-header bg-white" data-bs-toggle="collapse" data-bs-target="#fallbackSpotlightSettings" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" style="color: #1B1717;">
                                    <i class="fa-solid fa-sliders text-secondary me-2"></i>الإعدادات الافتراضية للعرض الفردي (Fallback Single Spotlight)
                                </span>
                                <div class="text-muted small mt-0.5">تُستخدم هذه الإعدادات كاحتياطي في حالة عدم تفعيل قائمة العروض المتعددة أعلاه.</div>
                            </div>
                            <i class="fa-solid fa-chevron-down text-muted"></i>
                        </div>
                    </div>
                    <div class="collapse" id="fallbackSpotlightSettings">
                        <div class="card-body p-4 border-top">
                            <div class="row g-4">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-dark">العطر المعروض الافتراضي</label>
                                    <select asp-for="SpotlightProductId" class="form-select rounded-3">
                                        <option value="">-- التحديد التلقائي لأول عطر مميز في الكتالوج --</option>
                                        @foreach (var prod in products)
                                        {
                                            <option value="@prod.Id">@prod.Name (@prod.Price.ToString("N0") EGP)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-dark">سعر العرض الخاص (Spotlight Price EGP)</label>
                                    <div class="input-group">
                                        <input type="number" step="0.01" asp-for="SpotlightPrice" class="form-control rounded-start-3 font-monospace fw-bold" />
                                        <span class="input-group-text bg-light">EGP</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold text-dark">موعد انتهاء العرض (Timer End Date/Time)</label>
                                    <input type="datetime-local" asp-for="SpotlightEndTime" class="form-control rounded-3" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold text-dark">نسبة الحجز المحجوزة ظاهرياً (%)</label>
                                    <div class="input-group">
                                        <input type="number" min="0" max="100" asp-for="SpotlightAllocatedPercent" class="form-control rounded-start-3 font-monospace" />
                                        <span class="input-group-text bg-light">%</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small fw-bold text-dark">العدد المتبقي المحجوز</label>
                                    <div class="input-group">
                                        <input type="number" min="0" asp-for="SpotlightRemainingCount" class="form-control rounded-start-3 font-monospace" />
                                        <span class="input-group-text bg-light">زجاجة</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Infinite Moving Marquee Announcement Tape (الشريط الإعلاني المتحرك تحت البانرات) -->
                <div class="card border-0 shadow-sm rounded-4 mt-4" style="max-width: 100%; overflow: hidden; min-width: 0;">
                    <div class="card-setting-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-bullhorn text-danger me-2"></i>شريط العروض والخصومات المتحرك (Infinite Marquee Tape)
                            </span>
                            <div class="text-muted small mt-1">
                                شريط متحرك بلا نهاية أسفل البانرات الرئيسية لعرض نسب الخصم (مثل Offer 20%)، أكواد التخفيض، والمميزات الترويجية.
                            </div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="MarqueeActive" id="marqueeSwitch" style="cursor: pointer;">
                            <label class="form-check-label small fw-semibold" for="marqueeSwitch">تفعيل ظهور الشريط المتحرك في الهوم</label>
                        </div>
                    </div>
                    <div class="card-body p-4 border-top" style="max-width: 100%; overflow: hidden; min-width: 0;">
                        <div class="row g-3 g-md-4" style="min-width: 0; max-width: 100%;">
                            <div class="col-12 col-lg-8" style="min-width: 0; max-width: 100%;">
                                <label class="form-label small fw-bold text-dark">نص العرض والإعلانات (Marquee Text)</label>
                                <div class="input-group" style="min-width: 0; max-width: 100%;">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-scroll text-muted"></i></span>
                                    <input type="text" asp-for="MarqueeText" id="marqueeTextInput" class="form-control rounded-end-3" style="min-width: 0;" placeholder="مثال: OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20 • عطور أصلية بتركيز 30% • شحن مجاني ودفع عند الاستلام" />
                                </div>
                                <div class="form-text small text-muted">
                                    يمكنك كتابة نص العرض واستخدام النقطة الفاصلة (•) بين العبارات للتنقل السلس.
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-4" style="min-width: 0; max-width: 100%;">
                                <label class="form-label small fw-bold text-dark">نص البادج البارز (Badge Text)</label>
                                <div class="input-group" style="min-width: 0; max-width: 100%;">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-tag text-warning"></i></span>
                                    <input type="text" asp-for="MarqueeBadgeText" id="marqueeBadgeInput" class="form-control rounded-end-3 font-monospace fw-bold" style="min-width: 0;" placeholder="مثال: OFFER 20%" />
                                </div>
                                <div class="form-text small text-muted">
                                    شارة مضيئة تظهر بجوار النص لجذب انتباه العميل مباشرة (مثل: OFFER 20% أو عرض محدود).
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-4" style="min-width: 0; max-width: 100%;">
                                <label class="form-label small fw-bold text-dark">سرعة حركة الشريط (بالثواني للدورة الكاملة)</label>
                                <div class="input-group" style="min-width: 0; max-width: 100%;">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-gauge-high text-muted"></i></span>
                                    <input type="number" min="5" max="120" asp-for="MarqueeSpeedSeconds" id="marqueeSpeedInput" class="form-control font-monospace" style="min-width: 0;" />
                                    <span class="input-group-text bg-light">ثانية</span>
                                </div>
                                <div class="form-text small text-muted">
                                    الافتراضي 25 ثانية (كلما كان الرقم أصغر كانت الحركة أسرع).
                                </div>
                            </div>
                            <!-- Live Interactive Preview with Guaranteed Containment -->
                            <div class="col-12" style="min-width: 0; max-width: 100%; overflow: hidden;">
                                <label class="form-label small fw-bold text-dark mb-2">معاينة حية لشكل الشريط في الصفحة الرئيسية:</label>
                                <div class="rounded-4 border position-relative overflow-hidden preview-marquee-wrapper" style="background: linear-gradient(90deg, #150f0f 0%, #290808 30%, #3a0606 50%, #290808 70%, #150f0f 100%); color: #EDEBDD; border-color: rgba(223, 177, 91, 0.35) !important;">
                                    <div class="preview-marquee-container" dir="ltr">
                                        <div class="preview-marquee-track">
                                            @for (int k = 0; k < 2; k++)
                                            {
                                                <div class="preview-marquee-group">
                                                    <span class="preview-marquee-badge">@(string.IsNullOrWhiteSpace(Model.MarqueeBadgeText) ? "OFFER 20%" : Model.MarqueeBadgeText)</span>
                                                    <span class="preview-marquee-text">@(string.IsNullOrWhiteSpace(Model.MarqueeText) ? "OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20 • عطور أصلية بتركيز 30% • شحن مجاني ودفع عند الاستلام مع المعاينة في كافة محافظات مصر" : Model.MarqueeText)</span>
                                                    <i class="fa-solid fa-gem text-warning mx-1" style="font-size: 0.68rem; opacity: 0.85;"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="preview-marquee-track" aria-hidden="true">
                                            @for (int k = 0; k < 2; k++)
                                            {
                                                <div class="preview-marquee-group">
                                                    <span class="preview-marquee-badge">@(string.IsNullOrWhiteSpace(Model.MarqueeBadgeText) ? "OFFER 20%" : Model.MarqueeBadgeText)</span>
                                                    <span class="preview-marquee-text">@(string.IsNullOrWhiteSpace(Model.MarqueeText) ? "OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20 • عطور أصلية بتركيز 30% • شحن مجاني ودفع عند الاستلام مع المعاينة في كافة محافظات مصر" : Model.MarqueeText)</span>
                                                    <i class="fa-solid fa-gem text-warning mx-1" style="font-size: 0.68rem; opacity: 0.85;"></i>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ============================================================== -->
            <!-- TAB 3: BEST SELLERS SECTION CUSTOMIZATION                      -->
            <!-- ============================================================== -->
            <div class="tab-pane fade tab-pane-content" id="tab-bestsellers" role="tabpanel" aria-labelledby="tab-bestsellers-btn">
                
                <!-- 1. Header Card with Toggle -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <div class="card-setting-header p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <span class="fw-bold fs-5 d-inline-flex align-items-center gap-2" style="color: #1B1717;">
                                <i class="fa-solid fa-fire text-danger"></i>
                                <span>تخصيص سكشن الأكثر طلباً (Best Sellers Section)</span>
                            </span>
                            <div class="text-muted small mt-1">
                                تحكم كامل في النصوص والبادج والعطور المعروضة في سكشن الأكثر مبيعاً بالصفحة الرئيسية للمتجر.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="ShowBestSellersSection" id="bsSectionToggle" style="cursor: pointer; width: 2.5em; height: 1.3em;">
                                <label class="form-check-label fw-bold small" for="bsSectionToggle">إظهار السكشن في المتجر</label>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">
                            <!-- Text Copywriting Fields -->
                            <div class="col-12 col-lg-7">
