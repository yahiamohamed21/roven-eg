<!-- Modal: Add New Home Offer -->
<div class="modal fade" id="addOfferModal" tabindex="-1" aria-labelledby="addOfferModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="addOfferModalLabel" style="color: #1B1717;">
                    <i class="fa-solid fa-bolt text-warning me-2"></i>إضافة عرض جديد (عطر فردي أو باقة عطرين معاً)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="AddHomeOffer" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Product 1 -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">العطر الأول (الأساسي) <span class="text-danger">*</span></label>
                            <select name="productId" id="addOfferProduct1Select" class="form-select rounded-3" required onchange="calculateAddOfferPricing()">
                                <option value="" selected disabled>-- اختر العطر الأول من الكتالوج --</option>
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م - مخزون: @prod.StockQuantity)</option>
                                }
                            </select>
                        </div>

                        <!-- Product 2 (Optional) -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">
                                العطر الثاني <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1 font-monospace">اختياري لباقة عطرين</span>
                            </label>
                            <select name="secondProductId" id="addOfferProduct2Select" class="form-select rounded-3" onchange="calculateAddOfferPricing()">
                                <option value="">-- لا يوجد (عرض عطر واحد فقط) --</option>
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م - مخزون: @prod.StockQuantity)</option>
                                }
                            </select>
                        </div>

                        <!-- Custom Title -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">عنوان مخصص للعرض (اختياري)</label>
                            <input type="text" name="title" id="addOfferTitleInput" class="form-control rounded-3" placeholder="مثال: باقة الروائح الملكية (روج فيلور + نوار إنتنس)" />
                            <div class="form-text small">اتركه فارغاً للتسمية التلقائية بأسماء العطور.</div>
                        </div>

                        <!-- Offer Price -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">سعر العرض الترويجي الإجمالي (ج.م) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.01" min="1" name="offerPrice" id="addOfferPriceInput" class="form-control rounded-start-3 font-monospace fw-bold" placeholder="مثال: 3850" required oninput="calculateAddOfferPricing()" />
                                <span class="input-group-text bg-light">EGP</span>
                            </div>
                            <div class="form-text small" id="addOfferPricingSummary" style="color: #630000; font-weight: 600;">
                                حدد العطور لحساب السعر الإجمالي الأصلي ونسبة الخصم المقترحة.
                            </div>
                        </div>

                        <!-- Badge Label -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">شارة العرض (Badge Label)</label>
                            <input type="text" name="badgeText" id="addOfferBadgeInput" class="form-control rounded-3" placeholder="مثال: DUO BUNDLE • عرض عطرين" value="EXCLUSIVE • عرض خاص" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">نسبة الحجز المحجوزة ظاهرياً (%)</label>
                            <div class="input-group">
                                <input type="number" min="1" max="100" name="allocatedPercent" class="form-control rounded-start-3 font-monospace" value="82" />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">الكمية المتبقية المحجوزة</label>
                            <div class="input-group">
                                <input type="number" min="1" name="remainingCount" id="addOfferRemainingInput" class="form-control rounded-start-3 font-monospace" value="15" />
                                <span class="input-group-text bg-light">باقة / حجز</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">موعد انتهاء العرض (Timer)</label>
                            <input type="datetime-local" name="endTime" class="form-control rounded-3" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #810100; border-color: #810100;">
                        <i class="fa-solid fa-plus me-1"></i> حفظ وإضافة العرض
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

