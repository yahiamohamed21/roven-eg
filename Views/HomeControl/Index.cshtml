<!-- Modal: Add New Home Offer -->
<div class="modal fade" id="addOfferModal" tabindex="-1" aria-labelledby="addOfferModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="addOfferModalLabel" style="color: #1B1717;">
                    <i class="fa-solid fa-bolt text-warning me-2"></i>إضافة عرض جديد (عطر فردي أو باقة عطرين معاً)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="AddHomeOffer" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Product 1 -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">العطر الأول (الأساسي) <span class="text-danger">*</span></label>
                            <select name="productId" id="addOfferProduct1Select" class="form-select rounded-3" required onchange="calculateAddOfferPricing()">
                                <option value="" selected disabled>-- اختر العطر الأول من الكتالوج --</option>
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م - مخزون: @prod.StockQuantity)</option>
                                }
                            </select>
                        </div>

                        <!-- Product 2 (Optional) -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">
                                العطر الثاني <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1 font-monospace">اختياري لباقة عطرين</span>
                            </label>
                            <select name="secondProductId" id="addOfferProduct2Select" class="form-select rounded-3" onchange="calculateAddOfferPricing()">
                                <option value="">-- لا يوجد (عرض عطر واحد فقط) --</option>
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م - مخزون: @prod.StockQuantity)</option>
                                }
                            </select>
                        </div>

                        <!-- Custom Title -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">عنوان مخصص للعرض (اختياري)</label>
                            <input type="text" name="title" id="addOfferTitleInput" class="form-control rounded-3" placeholder="مثال: باقة الروائح الملكية (روج فيلور + نوار إنتنس)" />
                            <div class="form-text small">اتركه فارغاً للتسمية التلقائية بأسماء العطور.</div>
                        </div>

                        <!-- Offer Price -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">سعر العرض الترويجي الإجمالي (ج.م) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.01" min="1" name="offerPrice" id="addOfferPriceInput" class="form-control rounded-start-3 font-monospace fw-bold" placeholder="مثال: 3850" required oninput="calculateAddOfferPricing()" />
                                <span class="input-group-text bg-light">EGP</span>
                            </div>
                            <div class="form-text small" id="addOfferPricingSummary" style="color: #630000; font-weight: 600;">
                                حدد العطور لحساب السعر الإجمالي الأصلي ونسبة الخصم المقترحة.
                            </div>
                        </div>

                        <!-- Badge Label -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">شارة العرض (Badge Label)</label>
                            <input type="text" name="badgeText" id="addOfferBadgeInput" class="form-control rounded-3" placeholder="مثال: DUO BUNDLE • عرض عطرين" value="EXCLUSIVE • عرض خاص" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">نسبة الحجز المحجوزة ظاهرياً (%)</label>
                            <div class="input-group">
                                <input type="number" min="1" max="100" name="allocatedPercent" class="form-control rounded-start-3 font-monospace" value="82" />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">الكمية المتبقية المحجوزة</label>
                            <div class="input-group">
                                <input type="number" min="1" name="remainingCount" id="addOfferRemainingInput" class="form-control rounded-start-3 font-monospace" value="15" />
                                <span class="input-group-text bg-light">باقة / حجز</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold text-dark">موعد انتهاء العرض (Timer)</label>
                            <input type="datetime-local" name="endTime" class="form-control rounded-3" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #810100; border-color: #810100;">
                        <i class="fa-solid fa-plus me-1"></i> حفظ وإضافة العرض
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Home Offer -->
<div class="modal fade" id="editOfferModal" tabindex="-1" aria-labelledby="editOfferModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="editOfferModalLabel" style="color: #1B1717;">
                    <i class="fa-solid fa-pen-to-square text-primary me-2"></i>تعديل بيانات العرض (عطر فردي أو باقة عطرين)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="UpdateHomeOffer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editOfferId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Product 1 -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">العطر الأول (الأساسي) <span class="text-danger">*</span></label>
                            <select name="productId" id="editOfferProduct1Select" class="form-select rounded-3" required onchange="calculateEditOfferPricing()">
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م)</option>
                                }
                            </select>
                        </div>

                        <!-- Product 2 (Optional) -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">
                                العطر الثاني <span class="badge bg-warning-subtle text-dark border border-warning-subtle ms-1 font-monospace">اختياري لباقة عطرين</span>
                            </label>
                            <select name="secondProductId" id="editOfferProduct2Select" class="form-select rounded-3" onchange="calculateEditOfferPricing()">
                                <option value="">-- لا يوجد (عرض عطر واحد فقط) --</option>
                                @foreach (var prod in products)
                                {
                                    <option value="@prod.Id" data-price="@prod.Price">@prod.Name (@prod.Price.ToString("N0") ج.م)</option>
                                }
                            </select>
                        </div>

                        <!-- Title -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">عنوان مخصص للعرض (اختياري)</label>
                            <input type="text" name="title" id="editOfferTitleInput" class="form-control rounded-3" placeholder="عنوان العرض..." />
                        </div>

                        <!-- Offer Price -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">سعر العرض الإجمالي (ج.م) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.01" min="1" name="offerPrice" id="editOfferPriceInput" class="form-control rounded-start-3 font-monospace fw-bold" required oninput="calculateEditOfferPricing()" />
                                <span class="input-group-text bg-light">EGP</span>
                            </div>
                            <div class="form-text small" id="editOfferPricingSummary" style="color: #630000; font-weight: 600;"></div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold text-dark">شارة العرض (Badge Label)</label>
                            <input type="text" name="badgeText" id="editOfferBadgeInput" class="form-control rounded-3" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold text-dark">نسبة الحجز (%)</label>
                            <div class="input-group">
                                <input type="number" min="0" max="100" name="allocatedPercent" id="editOfferAllocatedInput" class="form-control rounded-start-3 font-monospace" />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold text-dark">الكمية المتبقية</label>
                            <div class="input-group">
                                <input type="number" min="0" name="remainingCount" id="editOfferRemainingInput" class="form-control rounded-start-3 font-monospace" />
                                <span class="input-group-text bg-light">باقة</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold text-dark">الترتيب</label>
                            <input type="number" name="displayOrder" id="editOfferOrderInput" class="form-control rounded-3 font-monospace" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold text-dark">موعد الانتهاء</label>
                            <input type="datetime-local" name="endTime" id="editOfferEndTimeInput" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #810100; border-color: #810100;">
                        <i class="fa-solid fa-check me-1"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Confirm Delete Offer -->
<div class="modal fade" id="deleteOfferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow-lg text-center p-3">
            <div class="modal-body">
                <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex mb-3">
                    <i class="fa-solid fa-trash-can fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">حذف العطر من العروض؟</h6>
                <p class="text-muted small mb-3">هل أنت متأكد من حذف <strong id="deleteOfferNameDisplay" class="text-dark"></strong> من قسم العروض؟</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" onclick="executeDeleteOffer()">تأكيد الحذف</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
    function openEditBannerModal(id, title, desktopUrl, mobileUrl, redirectLink, altText, isActive, order) {
        document.getElementById('editBannerId').value = id;
        document.getElementById('editBannerTitleInput').value = title;
        document.getElementById('editBannerDesktopUrlInput').value = desktopUrl;
        document.getElementById('editBannerDesktopPreview').src = desktopUrl;
        
        const mobilePreviewWrap = document.getElementById('editBannerMobilePreviewWrap');
        const mobilePreview = document.getElementById('editBannerMobilePreview');
        if (mobileUrl && mobileUrl.trim() !== '') {
            document.getElementById('editBannerMobileUrlInput').value = mobileUrl;
            mobilePreview.src = mobileUrl;
            mobilePreviewWrap.style.display = 'block';
        } else {
            document.getElementById('editBannerMobileUrlInput').value = '';
            mobilePreviewWrap.style.display = 'none';
        }

        document.getElementById('editBannerRedirectLinkInput').value = redirectLink || '/Store';
        document.getElementById('editBannerAltTextInput').value = altText || '';
        document.getElementById('editBannerActiveCheck').checked = (isActive === true || isActive === 'true');
        document.getElementById('editBannerDisplayOrder').value = order;

        const modal = new bootstrap.Modal(document.getElementById('editHeroBannerModal'));
        modal.show();
    }

    function confirmDeleteBanner(id, title) {
        document.getElementById('deleteBannerIdInput').value = id;
        document.getElementById('deleteBannerTitleDisplay').innerText = title;
        const modal = new bootstrap.Modal(document.getElementById('deleteHeroBannerModal'));
        modal.show();
    }

    function executeDeleteBanner() {
        document.getElementById('deleteBannerFormGlobal').submit();
    }

    function calculateAddOfferPricing() {
        const s1 = document.getElementById('addOfferProduct1Select');
        const s2 = document.getElementById('addOfferProduct2Select');
        const priceInput = document.getElementById('addOfferPriceInput');
        const summary = document.getElementById('addOfferPricingSummary');
        const badgeInput = document.getElementById('addOfferBadgeInput');

        const opt1 = s1.options[s1.selectedIndex];
        const opt2 = s2.options[s2.selectedIndex];

        const p1 = (opt1 && opt1.value) ? parseFloat(opt1.getAttribute('data-price') || '0') : 0;
        const p2 = (opt2 && opt2.value) ? parseFloat(opt2.getAttribute('data-price') || '0') : 0;
        const totalOrig = p1 + p2;

        if (p2 > 0) {
            if (badgeInput.value === 'EXCLUSIVE • عرض خاص' || !badgeInput.value) {
                badgeInput.value = 'DUO BUNDLE • عرض عطرين';
            }
        }

        if (totalOrig > 0 && (!priceInput.value || parseFloat(priceInput.value) <= 0 || priceInput.dataset.autoFilled === 'true')) {
            const suggested = Math.round(totalOrig * 0.82); // 18% discount
            priceInput.value = suggested;
            priceInput.dataset.autoFilled = 'true';
        }

        const currentOfferPrice = parseFloat(priceInput.value || '0');
        if (totalOrig > 0 && currentOfferPrice > 0) {
            const saving = Math.max(0, totalOrig - currentOfferPrice);
            const discPercent = Math.round((saving / totalOrig) * 100);
            summary.innerHTML = `السعر الأصلي الإجمالي: <strong>${totalOrig.toLocaleString()} ج.م</strong> &bull; قيمة التوفير: <strong>${saving.toLocaleString()} ج.م (${discPercent}%)</strong>`;
        }
    }

    function calculateEditOfferPricing() {
        const s1 = document.getElementById('editOfferProduct1Select');
        const s2 = document.getElementById('editOfferProduct2Select');
        const priceInput = document.getElementById('editOfferPriceInput');
        const summary = document.getElementById('editOfferPricingSummary');

        const opt1 = s1.options[s1.selectedIndex];
        const opt2 = s2.options[s2.selectedIndex];

        const p1 = (opt1 && opt1.value) ? parseFloat(opt1.getAttribute('data-price') || '0') : 0;
        const p2 = (opt2 && opt2.value) ? parseFloat(opt2.getAttribute('data-price') || '0') : 0;
        const totalOrig = p1 + p2;

        const currentOfferPrice = parseFloat(priceInput.value || '0');
        if (totalOrig > 0 && currentOfferPrice > 0) {
            const saving = Math.max(0, totalOrig - currentOfferPrice);
            const discPercent = Math.round((saving / totalOrig) * 100);
            summary.innerHTML = `السعر الأصلي: <strong>${totalOrig.toLocaleString()} ج.م</strong> &bull; التوفير: <strong>${saving.toLocaleString()} ج.م (${discPercent}%)</strong>`;
        }
    }

    function openEditOfferModal(id, prodId, secondProdId, title, offerPrice, badgeText, allocated, remaining, endTime, order) {
        document.getElementById('editOfferId').value = id;
        
        const s1 = document.getElementById('editOfferProduct1Select');
        if (s1) s1.value = prodId;

        const s2 = document.getElementById('editOfferProduct2Select');
        if (s2) s2.value = secondProdId || '';

        document.getElementById('editOfferTitleInput').value = title || '';
        document.getElementById('editOfferPriceInput').value = offerPrice;
        document.getElementById('editOfferBadgeInput').value = badgeText || '';
        document.getElementById('editOfferAllocatedInput').value = allocated;
        document.getElementById('editOfferRemainingInput').value = remaining;
        document.getElementById('editOfferEndTimeInput').value = endTime || '';
        document.getElementById('editOfferOrderInput').value = order;

        calculateEditOfferPricing();

        const modal = new bootstrap.Modal(document.getElementById('editOfferModal'));
        modal.show();
    }

    function confirmDeleteOffer(id, name) {
        document.getElementById('deleteOfferIdInput').value = id;
        document.getElementById('deleteOfferNameDisplay').innerText = name;
        const modal = new bootstrap.Modal(document.getElementById('deleteOfferModal'));
        modal.show();
    }

    function executeDeleteOffer() {
        document.getElementById('deleteOfferFormGlobal').submit();
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Save current tab in localStorage so refresh preserves active tab
        const tabLinks = document.querySelectorAll('#homeControlTabs button[data-bs-toggle="pill"]');
        const activeTabKey = 'roven_home_control_active_tab';

        // Check URL parameter first, then ViewBag, then localStorage
        const activeTabFromViewBag = '@(ViewBag.ActiveTab ?? "")';
        const urlParamTab = new URLSearchParams(window.location.search).get('tab') || activeTabFromViewBag;
        let tabToActivate = null;
        if (urlParamTab) {
            tabToActivate = urlParamTab.startsWith('#') ? urlParamTab : '#' + urlParamTab;
        } else {
            tabToActivate = localStorage.getItem(activeTabKey);
        }

        if (tabToActivate) {
            const triggerEl = document.querySelector(`#homeControlTabs button[data-bs-target="${tabToActivate}"]`);
            if (triggerEl) {
                new bootstrap.Tab(triggerEl).show();
                const mainFormTabInput = document.getElementById('mainFormActiveTab');
                if (mainFormTabInput) mainFormTabInput.value = tabToActivate.replace('#', '');
            }
        }

        tabLinks.forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const target = e.target.getAttribute('data-bs-target');
                if (target) {
                    localStorage.setItem(activeTabKey, target);
                    const mainFormTabInput = document.getElementById('mainFormActiveTab');
                    if (mainFormTabInput) mainFormTabInput.value = target.replace('#', '');
                }
            });
        });

        // Live Marquee Preview Listeners
        const marqueeTextInput = document.getElementById('marqueeTextInput');
        const marqueeBadgeInput = document.getElementById('marqueeBadgeInput');

        if (marqueeTextInput) {
            marqueeTextInput.addEventListener('input', function () {
                const val = this.value.trim() || 'OFFER 20% OFF ON ALL LUXURY EXTRAITS • كود الخصم: ROVEN20';
                document.querySelectorAll('.preview-marquee-text').forEach(function (el) {
                    el.textContent = val;
                });
            });
        }
        if (marqueeBadgeInput) {
            marqueeBadgeInput.addEventListener('input', function () {
                const val = this.value.trim() || 'OFFER 20%';
                document.querySelectorAll('.preview-marquee-badge').forEach(function (el) {
                    el.textContent = val;
                });
            });
        }

        // Spotlight Offers Live Preview Handlers
        const inputSpotlightBadge = document.getElementById('inputSpotlightBadge');
        const inputSpotlightTitle = document.getElementById('inputSpotlightTitle');
        const inputSpotlightSubtitle = document.getElementById('inputSpotlightSubtitle');

        const previewSpotlightBadge = document.querySelector('#previewSpotlightBadge span');
        const previewSpotlightTitle = document.getElementById('previewSpotlightTitle');
        const previewSpotlightSubtitle = document.getElementById('previewSpotlightSubtitle');

        if (inputSpotlightBadge && previewSpotlightBadge) {
            inputSpotlightBadge.addEventListener('input', function() {
                previewSpotlightBadge.textContent = this.value.trim() || 'EXCLUSIVE ATELIER OFFERS & DEALS';
            });
        }
        if (inputSpotlightTitle && previewSpotlightTitle) {
            inputSpotlightTitle.addEventListener('input', function() {
                previewSpotlightTitle.textContent = this.value.trim() || 'عروض وتخفيضات دار Roven الحصرية';
            });
        }
        if (inputSpotlightSubtitle && previewSpotlightSubtitle) {
            inputSpotlightSubtitle.addEventListener('input', function() {
                previewSpotlightSubtitle.textContent = this.value.trim() || 'إصدارات عطرية مختارة بتخفيضات استثنائية لفترة محدودة، مع شحن لكافة المحافظات وإمكانية معاينة الطرد قبل الدفع عند الاستلام.';
            });
        }

        // Best Sellers Live Preview & Product Selection Handlers
        const inputBsBadge = document.getElementById('inputBsBadge');
        const inputBsTitle = document.getElementById('inputBsTitle');
        const inputBsSubtitle = document.getElementById('inputBsSubtitle');

        const previewBsBadge = document.querySelector('#previewBsBadge span');
        const previewBsTitle = document.getElementById('previewBsTitle');
        const previewBsSubtitle = document.getElementById('previewBsSubtitle');

        if (inputBsBadge && previewBsBadge) {
            inputBsBadge.addEventListener('input', function() {
                previewBsBadge.textContent = this.value.trim() || 'Most Requested';
            });
        }
        if (inputBsTitle && previewBsTitle) {
            inputBsTitle.addEventListener('input', function() {
                previewBsTitle.textContent = this.value.trim() || 'Top Acclaimed ROVEN Parfums';
            });
        }
        if (inputBsSubtitle && previewBsSubtitle) {
            inputBsSubtitle.addEventListener('input', function() {
                previewBsSubtitle.textContent = this.value.trim() || 'The fragrances most cherished by our clientele across Egypt this month';
            });
        }

        // Product Selection & Counter Logic
        function updateBsCounter() {
            const checkedBoxes = document.querySelectorAll('.bs-checkbox:checked');
            const counter = document.getElementById('bsSelectionCounter');
            if (counter) {
                counter.textContent = `${checkedBoxes.length} عطور مختارة`;
            }
        }

        document.querySelectorAll('.bs-product-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.classList.contains('bs-checkbox')) {
                    const cb = e.target;
                    card.classList.toggle('border-danger', cb.checked);
                    card.classList.toggle('bg-danger-subtle', cb.checked);
                    card.classList.toggle('shadow-xs', cb.checked);
                    card.classList.toggle('bg-white', !cb.checked);
                    updateBsCounter();
                    return;
                }
                const cb = card.querySelector('.bs-checkbox');
                if (cb) {
                    cb.checked = !cb.checked;
                    card.classList.toggle('border-danger', cb.checked);
                    card.classList.toggle('bg-danger-subtle', cb.checked);
                    card.classList.toggle('shadow-xs', cb.checked);
                    card.classList.toggle('bg-white', !cb.checked);
                    updateBsCounter();
                }
            });
        });

        const btnSelectAll = document.getElementById('btnSelectAllBs');
        if (btnSelectAll) {
            btnSelectAll.addEventListener('click', function() {
                document.querySelectorAll('.bs-product-card').forEach(card => {
                    const cb = card.querySelector('.bs-checkbox');
                    if (cb) cb.checked = true;
                    card.classList.add('border-danger', 'bg-danger-subtle', 'shadow-xs');
                    card.classList.remove('bg-white');
                });
                updateBsCounter();
            });
        }

        const btnClearAll = document.getElementById('btnClearAllBs');
        if (btnClearAll) {
            btnClearAll.addEventListener('click', function() {
                document.querySelectorAll('.bs-product-card').forEach(card => {
                    const cb = card.querySelector('.bs-checkbox');
                    if (cb) cb.checked = false;
                    card.classList.remove('border-danger', 'bg-danger-subtle', 'shadow-xs');
                    card.classList.add('bg-white');
                });
                updateBsCounter();
            });
        }

        // Live Search Filter
        const bsSearchInput = document.getElementById('bsSearchInput');
        if (bsSearchInput) {
            bsSearchInput.addEventListener('input', function() {
                const term = this.value.trim().toLowerCase();
                document.querySelectorAll('.bs-product-col').forEach(col => {
                    const name = col.getAttribute('data-name') || '';
                    const sku = col.getAttribute('data-sku') || '';
                    if (!term || name.includes(term) || sku.includes(term)) {
                        col.style.display = '';
                    } else {
                        col.style.display = 'none';
                    }
                });
            });
        }

        // Initial counter call
        updateBsCounter();

        // ==============================================================
        // FEATURED PRODUCTS SECTION LIVE PREVIEW & SELECTION LOGIC
        // ==============================================================
        const inputFeatBadge = document.getElementById('inputFeatBadge');
        const inputFeatTitle = document.getElementById('inputFeatTitle');
        const inputFeatSubtitle = document.getElementById('inputFeatSubtitle');
        const inputFeatExplore = document.getElementById('inputFeatExplore');

        const previewFeatBadge = document.querySelector('#previewFeatBadge span');
        const previewFeatTitle = document.getElementById('previewFeatTitle');
        const previewFeatSubtitle = document.getElementById('previewFeatSubtitle');
        const previewFeatExplore = document.getElementById('previewFeatExplore');

        if (inputFeatBadge && previewFeatBadge) {
            inputFeatBadge.addEventListener('input', function() {
                previewFeatBadge.textContent = this.value.trim() || 'Master Distillations';
            });
        }
        if (inputFeatTitle && previewFeatTitle) {
            inputFeatTitle.addEventListener('input', function() {
                previewFeatTitle.textContent = this.value.trim() || 'Featured ROVEN Parfums';
            });
        }
        if (inputFeatSubtitle && previewFeatSubtitle) {
            inputFeatSubtitle.addEventListener('input', function() {
                previewFeatSubtitle.textContent = this.value.trim() || 'Our most acclaimed fragrant creations formulated with precious Grasse and oriental oils';
            });
        }
        if (inputFeatExplore && previewFeatExplore) {
            inputFeatExplore.addEventListener('input', function() {
                previewFeatExplore.textContent = this.value.trim() || 'Explore Full Collection';
            });
        }

        // Featured Product Selection & Counter Logic
        function updateFeatCounter() {
            const checkedBoxes = document.querySelectorAll('.feat-checkbox:checked');
            const counter = document.getElementById('featSelectionCounter');
            if (counter) {
                counter.textContent = `${checkedBoxes.length} عطور مختارة`;
            }
        }

        document.querySelectorAll('.feat-product-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.classList.contains('feat-checkbox')) {
                    const cb = e.target;
                    card.classList.toggle('border-danger', cb.checked);
                    card.classList.toggle('bg-danger-subtle', cb.checked);
                    card.classList.toggle('shadow-xs', cb.checked);
                    card.classList.toggle('bg-white', !cb.checked);
                    updateFeatCounter();
                    return;
                }
                const cb = card.querySelector('.feat-checkbox');
                if (cb) {
                    cb.checked = !cb.checked;
                    card.classList.toggle('border-danger', cb.checked);
                    card.classList.toggle('bg-danger-subtle', cb.checked);
                    card.classList.toggle('shadow-xs', cb.checked);
                    card.classList.toggle('bg-white', !cb.checked);
                    updateFeatCounter();
                }
            });
        });

        const btnSelectAllFeat = document.getElementById('btnSelectAllFeat');
        if (btnSelectAllFeat) {
            btnSelectAllFeat.addEventListener('click', function() {
                document.querySelectorAll('.feat-product-card').forEach(card => {
                    const cb = card.querySelector('.feat-checkbox');
                    if (cb) cb.checked = true;
                    card.classList.add('border-danger', 'bg-danger-subtle', 'shadow-xs');
                    card.classList.remove('bg-white');
                });
                updateFeatCounter();
            });
        }

        const btnClearAllFeat = document.getElementById('btnClearAllFeat');
        if (btnClearAllFeat) {
            btnClearAllFeat.addEventListener('click', function() {
                document.querySelectorAll('.feat-product-card').forEach(card => {
                    const cb = card.querySelector('.feat-checkbox');
                    if (cb) cb.checked = false;
                    card.classList.remove('border-danger', 'bg-danger-subtle', 'shadow-xs');
                    card.classList.add('bg-white');
                });
                updateFeatCounter();
            });
        }

        // Live Search Filter for Featured
        const featSearchInput = document.getElementById('featSearchInput');
        if (featSearchInput) {
            featSearchInput.addEventListener('input', function() {
                const term = this.value.trim().toLowerCase();
                document.querySelectorAll('.feat-product-col').forEach(col => {
                    const name = col.getAttribute('data-name') || '';
                    const sku = col.getAttribute('data-sku') || '';
                    if (!term || name.includes(term) || sku.includes(term)) {
                        col.style.display = '';
                    } else {
                        col.style.display = 'none';
                    }
                });
            });
        }

        // Initial counter call for Featured
        updateFeatCounter();

        // Handle URL Hash navigation to specific tab (e.g. #tab-social)
        if (window.location.hash) {
            const targetTabBtn = document.querySelector(`button[data-bs-target="${window.location.hash}"]`);
            if (targetTabBtn) {
                const tabTrigger = new bootstrap.Tab(targetTabBtn);
                tabTrigger.show();
                setTimeout(() => {
                    const el = document.querySelector(window.location.hash);
                    if (el) el.scrollIntoView({ behavior: 'smooth' });
                }, 150);
            }
        }

        // ==============================================================
        // TAB 5: SECTIONS DRAG & DROP REORDERING LOGIC
        // ==============================================================
        const visualBar = document.getElementById('sectionOrderVisualBar');
        const sortableSectionsList = document.getElementById('sortableSectionsList');

        function updateSectionVisualBar() {
            if (!visualBar || !sortableSectionsList) return;
            const cards = sortableSectionsList.querySelectorAll('.sortable-section-card');
            const items = [];
            cards.forEach((card, idx) => {
                const input = card.querySelector('.section-order-val');
                const shortName = (input ? input.getAttribute('data-section-shortname') : null) || card.getAttribute('data-section-shortname') || (input ? input.getAttribute('data-section-name') : 'سكشن');
                const fullName = (input ? input.getAttribute('data-section-name') : null) || shortName;
                const icon = (input ? input.getAttribute('data-section-icon') : null) || card.getAttribute('data-section-icon') || 'fa-solid fa-layer-group';
                const color = (input ? input.getAttribute('data-section-color') : null) || card.getAttribute('data-section-color') || '#810100';
                const cb = card.querySelector('.section-visibility-cb');
                const isChecked = cb ? cb.checked : true;
                items.push({ 
                    order: idx + 1, 
                    name: shortName, 
                    fullName: fullName, 
                    icon: icon, 
                    color: color, 
                    isChecked: isChecked 
                });
            });

            visualBar.innerHTML = items.map((item, idx) => `
                <div class="section-seq-chip ${item.isChecked ? 'is-active' : 'is-disabled'}" title="${item.fullName} (${item.isChecked ? 'مفعل وظاهر بالصفحة' : 'معطل ومخفي'})">
                    <span class="seq-num-circle">${item.order}</span>
                    <span class="seq-icon-wrap" style="color: ${item.isChecked ? item.color : '#8c857b'};">
                        <i class="${item.icon}"></i>
                    </span>
                    <span class="seq-title">${item.name}</span>
                    ${!item.isChecked ? '<span class="seq-hidden-tag"><i class="fa-solid fa-eye-slash"></i> مخفي</span>' : ''}
                </div>
                ${idx < items.length - 1 ? '<span class="seq-connector"><i class="fa-solid fa-arrow-left"></i></span>' : ''}
            `).join('');
        }

        function recalculateSectionOrders() {
            if (!sortableSectionsList) return;
            const cards = sortableSectionsList.querySelectorAll('.sortable-section-card');
            cards.forEach((card, idx) => {
                const orderNum = idx + 1;
                const input = card.querySelector('.section-order-val');
                if (input) input.value = orderNum;

                const badge = card.querySelector('.section-rank-badge');
                if (badge) {
                    if (orderNum === 1) {
                        badge.innerHTML = `<i class="fa-solid fa-arrow-up-long me-1"></i> #1 (الأول — أعلى الصفحة)`;
                        badge.style.background = '#198754';
                    } else if (orderNum === cards.length) {
                        badge.innerHTML = `#${orderNum} (الأخير — أسفل الصفحة) <i class="fa-solid fa-arrow-down-long ms-1"></i>`;
                        badge.style.background = '#6c757d';
                    } else {
                        badge.innerHTML = `#${orderNum}`;
                        badge.style.background = '#810100';
                    }
                }

                const upBtn = card.querySelector('.btn-move-section-up');
                if (upBtn) {
                    if (orderNum === 1) upBtn.classList.add('disabled');
                    else upBtn.classList.remove('disabled');
                }

                const downBtn = card.querySelector('.btn-move-section-down');
                if (downBtn) {
                    if (orderNum === cards.length) downBtn.classList.add('disabled');
                    else downBtn.classList.remove('disabled');
                }
            });

            updateSectionVisualBar();
        }

        // Initialize SortableJS
        if (sortableSectionsList && typeof Sortable !== 'undefined') {
            new Sortable(sortableSectionsList, {
                animation: 200,
                handle: '.drag-handle, .sortable-section-card',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
                onEnd: function() {
                    recalculateSectionOrders();
                }
            });
        }

        // Native HTML5 Drag and Drop fallback
        if (sortableSectionsList) {
            let draggedSection = null;
            sortableSectionsList.querySelectorAll('.sortable-section-card').forEach(card => {
                card.addEventListener('dragstart', function(e) {
                    draggedSection = this;
                    e.dataTransfer.effectAllowed = 'move';
                    this.classList.add('sortable-chosen');
                });
                card.addEventListener('dragend', function() {
                    draggedSection = null;
                    this.classList.remove('sortable-chosen');
                    recalculateSectionOrders();
                });
                card.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    if (!draggedSection || draggedSection === this) return;
                    const rect = this.getBoundingClientRect();
                    const mid = rect.top + rect.height / 2;
                    if (e.clientY < mid) {
                        sortableSectionsList.insertBefore(draggedSection, this);
                    } else {
                        sortableSectionsList.insertBefore(draggedSection, this.nextSibling);
                    }
                });
            });
        }

        // Up / Down Button Handlers
        document.addEventListener('click', function(e) {
            const upBtn = e.target.closest('.btn-move-section-up');
            if (upBtn && !upBtn.classList.contains('disabled')) {
                const card = upBtn.closest('.sortable-section-card');
                const prev = card.previousElementSibling;
                if (prev && prev.classList.contains('sortable-section-card')) {
                    card.parentNode.insertBefore(card, prev);
                    recalculateSectionOrders();
                }
                return;
            }
            const downBtn = e.target.closest('.btn-move-section-down');
            if (downBtn && !downBtn.classList.contains('disabled')) {
                const card = downBtn.closest('.sortable-section-card');
                const next = card.nextElementSibling;
                if (next && next.classList.contains('sortable-section-card')) {
                    card.parentNode.insertBefore(next, card);
                    recalculateSectionOrders();
                }
                return;
            }
        });

        // Top Save Order Button Handler
        const btnSaveTop = document.getElementById('btnSaveSectionOrderTop');
        if (btnSaveTop) {
            btnSaveTop.addEventListener('click', function() {
                const activeTabInput = document.getElementById('mainFormActiveTab');
                if (activeTabInput) activeTabInput.value = 'tab-sections';
                const mainForm = document.getElementById('homeControlForm');
                if (mainForm) mainForm.submit();
            });
        }

        // Section Checkboxes Listeners
        document.querySelectorAll('#sortableSectionsList .section-visibility-cb').forEach(cb => {
            cb.addEventListener('change', updateSectionVisualBar);
        });

        // Sync Tab 5 Spotlight and Marquee switches with their primary switches in Tab 2
        const mainSpotlightSwitch = document.getElementById('spotlightSwitch');
        const tab5SpotlightSwitch = document.getElementById('tab5SpotlightSwitch');
        if (mainSpotlightSwitch && tab5SpotlightSwitch) {
            tab5SpotlightSwitch.checked = mainSpotlightSwitch.checked;
            tab5SpotlightSwitch.addEventListener('change', function() {
                mainSpotlightSwitch.checked = this.checked;
                updateSectionVisualBar();
            });
            mainSpotlightSwitch.addEventListener('change', function() {
                tab5SpotlightSwitch.checked = this.checked;
                updateSectionVisualBar();
            });
        }

        const mainMarqueeSwitch = document.getElementById('marqueeSwitch');
        const tab5MarqueeSwitch = document.getElementById('tab5MarqueeSwitch');
        if (mainMarqueeSwitch && tab5MarqueeSwitch) {
            tab5MarqueeSwitch.checked = mainMarqueeSwitch.checked;
            tab5MarqueeSwitch.addEventListener('change', function() {
                mainMarqueeSwitch.checked = this.checked;
                updateSectionVisualBar();
            });
            mainMarqueeSwitch.addEventListener('change', function() {
                tab5MarqueeSwitch.checked = this.checked;
                updateSectionVisualBar();
            });
        }

        // Reset default order button
        const btnResetDefaultOrder = document.getElementById('btnResetDefaultOrder');
        if (btnResetDefaultOrder) {
            btnResetDefaultOrder.addEventListener('click', function() {
                const defaultOrderKeys = [
                    'BrandHero',
                    'Marquee',
                    'TrustBadges',
                    'HeroBanners',
                    'Categories',
                    'Offers',
                    'Featured',
                    'BestSellers',
                    'Testimonials',
                    'Faq',
                    'Newsletter'
                ];

                if (!sortableSectionsList) return;
                defaultOrderKeys.forEach(key => {
                    const card = sortableSectionsList.querySelector(`.sortable-section-card[data-section-key="${key}"]`);
                    if (card) sortableSectionsList.appendChild(card);
                });

                recalculateSectionOrders();

                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show mt-2';
                alertDiv.innerHTML = '<i class="fa-solid fa-check me-2"></i>تمت استعادة الترتيب الافتراضي (1 إلى 11). اضغط "حفظ الترتيب وتطبيقه فوراً" لتثبيته في المتجر.';
                const header = document.querySelector('#tab-sections .card-setting-header');
                if (header) header.parentNode.insertBefore(alertDiv, header.nextSibling);
                setTimeout(() => alertDiv.remove(), 4000);
            });
        }

        // Initial visual bar and orders calculation
        recalculateSectionOrders();
    });

    function setMainHeroDefaults() {
        const desktopInput = document.getElementById('mainHeroDesktopUrlInput');
        const mobileInput = document.getElementById('mainHeroMobileUrlInput');
        if (desktopInput) desktopInput.value = '/images/banners/roven-hero-main.png';
        if (mobileInput) mobileInput.value = '/images/banners/roven-hero-main-sm.png';
    }

    // ==============================================================
    // FAQ ACTIONS MANAGEMENT (AJAX + MODALS + INSTANT VISUAL SYNC)
    // ==============================================================
    function openAddFaqModal() {
        const modalEl = document.getElementById('addFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function openEditFaqModal(id) {
        const qInput = document.getElementById('faq-raw-question-' + id);
        const aInput = document.getElementById('faq-raw-answer-' + id);
        const store = document.getElementById('faqDataStore_' + id);

        const question = qInput ? qInput.value : '';
        const answer = aInput ? aInput.value : '';
        const icon = store ? (store.getAttribute('data-icon') || 'fa-solid fa-circle-question') : 'fa-solid fa-circle-question';
        const order = store ? (store.getAttribute('data-order') || '1') : '1';
        const isActive = store ? (store.getAttribute('data-active') === 'true') : true;

        document.getElementById('editFaqId').value = id;
        document.getElementById('editFaqQuestion').value = question;
        document.getElementById('editFaqAnswer').value = answer;
        const iconSelect = document.getElementById('editFaqIconClass');
        if (iconSelect) iconSelect.value = icon;
        document.getElementById('editFaqDisplayOrder').value = order;
        document.getElementById('editFaqIsActive').checked = isActive;

        const modalEl = document.getElementById('editFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    let pendingDeleteFaqId = 0;
    function confirmDeleteFaqModal(id) {
        pendingDeleteFaqId = id;
        const qInput = document.getElementById('faq-raw-question-' + id);
        const qText = qInput ? qInput.value : 'هذا السؤال';
        const titleEl = document.getElementById('deleteFaqTitleDisplay');
        if (titleEl) titleEl.textContent = `"${qText}"`;

        const modalEl = document.getElementById('deleteFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function executeDeleteFaq() {
        if (!pendingDeleteFaqId) return;
        const id = pendingDeleteFaqId;
        const modalEl = document.getElementById('deleteFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        const card = document.getElementById('faqCard_' + id);
        if (card) {
            card.style.transition = 'all 0.25s ease';
            card.style.opacity = '0';
            card.style.transform = 'scale(0.96)';
            setTimeout(() => {
                card.remove();
                recalculateFaqOrdersInDom();
            }, 260);
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        fetch('/HomeControl/DeleteFaqItem', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            showFaqToast(data.message || 'تم حذف السؤال بنجاح!', 'success');
        })
        .catch(err => {
            console.error('Delete FAQ error:', err);
            const fallbackForm = document.getElementById('deleteFaqForm_' + id);
            if (fallbackForm) fallbackForm.submit();
        });
    }

    function confirmResetDefaultFaqModal() {
        const modalEl = document.getElementById('resetDefaultFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function executeResetDefaultFaq() {
        const modalEl = document.getElementById('resetDefaultFaqModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }
        const form = document.getElementById('resetDefaultFaqForm');
        if (form) form.submit();
    }

    function toggleFaqStatus(id) {
        const btn = document.getElementById('faqToggleBtn_' + id);
        const store = document.getElementById('faqDataStore_' + id);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        if (btn) btn.style.opacity = '0.6';

        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        fetch('/HomeControl/ToggleFaqItem', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => {
            if (!res.ok) throw new Error('Toggle error');
            return res.json();
        })
        .then(data => {
            if (btn) {
                btn.style.opacity = '1';
                if (data.isActive) {
                    btn.textContent = 'ACTIVE';
                    btn.style.backgroundColor = '#198754';
                } else {
                    btn.textContent = 'INACTIVE';
                    btn.style.backgroundColor = '#6c757d';
                }
            }
            if (store) store.setAttribute('data-active', data.isActive ? 'true' : 'false');
            showFaqToast(data.message || 'تم تغيير حالة السؤال بنجاح', 'success');
        })
        .catch(err => {
            console.error('Toggle FAQ error:', err);
            if (btn) btn.style.opacity = '1';
            const fallbackForm = document.getElementById('toggleFaqForm_' + id);
            if (fallbackForm) fallbackForm.submit();
        });
    }

    function moveFaqItemOrder(id, direction) {
        const card = document.getElementById('faqCard_' + id);
        const container = document.getElementById('faqItemsContainer');
        if (!card || !container) return;

        if (direction === 'up') {
            const prev = card.previousElementSibling;
            if (prev && prev.classList.contains('faq-item-row')) {
                container.insertBefore(card, prev);
            }
        } else if (direction === 'down') {
            const next = card.nextElementSibling;
            if (next && next.classList.contains('faq-item-row')) {
                container.insertBefore(next, card);
            }
        }

        recalculateFaqOrdersInDom();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('direction', direction);
        formData.append('__RequestVerificationToken', token);

        fetch('/HomeControl/MoveFaqItem', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .catch(err => {
            console.error('Move FAQ error:', err);
            const fallbackForm = document.getElementById(direction === 'up' ? ('moveFaqUpForm_' + id) : ('moveFaqDownForm_' + id));
            if (fallbackForm) fallbackForm.submit();
        });
    }

    function recalculateFaqOrdersInDom() {
        const container = document.getElementById('faqItemsContainer');
        if (!container) return;
        const cards = container.querySelectorAll('.faq-item-row');
        cards.forEach((card, idx) => {
            const badge = card.querySelector('.faq-order-badge');
            if (badge) badge.textContent = '#' + (idx + 1);

            const upBtn = card.querySelector('.faq-move-up-btn');
            if (upBtn) {
                if (idx === 0) upBtn.classList.add('disabled');
                else upBtn.classList.remove('disabled');
            }

            const downBtn = card.querySelector('.faq-move-down-btn');
            if (downBtn) {
                if (idx === cards.length - 1) downBtn.classList.add('disabled');
                else downBtn.classList.remove('disabled');
            }
        });
    }

    function showFaqToast(message, type = 'success') {
        let toastContainer = document.getElementById('faqToastContainer');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'faqToastContainer';
            toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            toastContainer.style.zIndex = '9999';
            document.body.appendChild(toastContainer);
        }

        const toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-white border-0 shadow-lg rounded-3';
        toastEl.style.backgroundColor = type === 'success' ? '#198754' : '#dc3545';
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.setAttribute('aria-atomic', 'true');
        toastEl.innerHTML = `
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation'}"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;
        toastContainer.appendChild(toastEl);
        const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3000 });
        bsToast.show();
        toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
    }

    // Live Header Preview for FAQ
    const inputFaqBadge = document.getElementById('inputFaqBadge');
    const previewFaqBadge = document.getElementById('previewFaqBadge');
    if (inputFaqBadge && previewFaqBadge) {
        inputFaqBadge.addEventListener('input', function() {
            const span = previewFaqBadge.querySelector('span');
            if (span) span.textContent = this.value.trim() || 'Maison ROVEN Clarifications';
        });
    }

    const inputFaqTitle = document.getElementById('inputFaqTitle');
    const previewFaqTitle = document.getElementById('previewFaqTitle');
    if (inputFaqTitle && previewFaqTitle) {
        inputFaqTitle.addEventListener('input', function() {
            previewFaqTitle.textContent = this.value.trim() || 'Frequently Asked Questions';
        });
    }

    const inputFaqSubtitle = document.getElementById('inputFaqSubtitle');
    const previewFaqSubtitle = document.getElementById('previewFaqSubtitle');
    if (inputFaqSubtitle && previewFaqSubtitle) {
        inputFaqSubtitle.addEventListener('input', function() {
            previewFaqSubtitle.textContent = this.value.trim() || 'Everything you need to know about concentrations, parcel inspection, and authenticity';
        });
    }
</script>
}
