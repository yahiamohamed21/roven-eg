                        ("Offers", "OrderOffers", Model.OrderOffers > 0 ? Model.OrderOffers : 6, Model.SpotlightActive, "عروض وتخفيضات دار Roven الحصرية", "عروض Roven", "Special Offers", "fa-solid fa-bolt", "#f39c12", "كروت عروض العطور الفاخرة، عداد الوقت، نسبة الحجز، وأسعار التخفيض الاستثنائية.", "tab5SpotlightSwitch"),
                        ("Featured", "OrderFeatured", Model.OrderFeatured > 0 ? Model.OrderFeatured : 7, Model.ShowFeaturedSection, "سكشن العطور المميزة (Featured)", "العطور المميزة", "Featured", "fa-solid fa-crown", "#d35400", "شبكة العطور المميزة (Master Distillations) التي تختارها الدار لعملائها.", "ShowFeaturedSection"),
                        ("BestSellers", "OrderBestSellers", Model.OrderBestSellers > 0 ? Model.OrderBestSellers : 8, Model.ShowBestSellersSection, "سكشن الأكثر مبيعاً (Best Sellers)", "الأكثر مبيعاً", "Best Sellers", "fa-solid fa-fire", "#e74c3c", "العطور الأكثر طلباً ومبيعاً ومعدلات الشراء المرتفعة عبر المتجر.", "ShowBestSellersSection"),
                        ("Testimonials", "OrderTestimonials", Model.OrderTestimonials > 0 ? Model.OrderTestimonials : 9, Model.ShowTestimonialsSection, "آراء وانطباعات رواد الدار (Testimonials)", "آراء العملاء", "Testimonials", "fa-solid fa-comment-dots", "#7f8c8d", "تقييمات وآراء العملاء وتجاربهم العطرية الفاخرة وتقييمات الـ 5 نجوم.", "ShowTestimonialsSection"),
                        ("Faq", "OrderFaq", Model.OrderFaq > 0 ? Model.OrderFaq : 10, Model.ShowFaqSection, "سكشن الأسئلة الشائعة وتوضيحات الدار", "الأسئلة الشائعة", "FAQ", "fa-solid fa-circle-question", "#16a085", "قائمة الأسئلة الشائعة والأكورديون عن التراكيز ومعاينة الشحنات والتوصيل.", "ShowFaqSection"),
                        ("Newsletter", "OrderNewsletter", Model.OrderNewsletter > 0 ? Model.OrderNewsletter : 11, Model.ShowNewsletterSection, "شريط الاشتراك في النشرة VIP", "النشرة البريدية", "Newsletter", "fa-solid fa-envelope-open-text", "#27ae60", "بانر خصم 10% والاشتراك في النشرة البريدية الحصرية لرواد الدار.", "ShowNewsletterSection")
                    }
                    .OrderBy(s => s.Order)
                    .ToList();
                }

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-setting-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 border-bottom pb-3">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-up-down-left-right text-primary me-2"></i>ترتيب سكاشن المتجر بالسحب والإفلات (Drag & Drop Reordering)
                            </span>
                            <div class="text-muted small mt-1">
                                اسحب أي سكشن من المقبض <strong>(⋮⋮)</strong> وضعه في المكان المطلوب، أو استخدم أزرار الأسهم <strong>(↑ ↓)</strong>، ثم اضغط حفظ لتطبيق الترتيب فوراً على واجهة المتجر.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill fw-semibold shadow-xs" id="btnResetDefaultOrder" title="استعادة الترتيب الافتراضي">
                                <i class="fa-solid fa-arrow-rotate-left me-1"></i>
                                <span>استعادة الافتراضي</span>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-1.5 text-white" id="btnSaveSectionOrderTop" style="background: #810100; border-color: #810100;">
                                <i class="fa-solid fa-floppy-disk"></i>
                                <span>حفظ الترتيب وتطبيقه فوراً</span>
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-3 p-md-4">
                        <!-- Live Visual Sequence Bar -->
                        <div class="p-3 rounded-4 mb-4" style="background: #FAF9F5; border: 1px solid rgba(181, 141, 74, 0.25);">
                            <div class="d-flex align-items-center justify-content-between mb-2.5 flex-wrap gap-2">
                                <span class="small fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.84rem;">
                                    <i class="fa-solid fa-layer-group" style="color: #b58d4a;"></i>
                                    <span>تسلسل السكشنات المباشر في واجهة المتجر (Live Sequence):</span>
                                </span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small d-none d-md-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-arrows-left-right text-secondary opacity-75"></i>
                                        اسحب أفقياً للمعاينة
                                    </span>
                                    <span class="badge text-muted bg-white border px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                        ترتيب تصاعدي من 1 إلى 11
                                    </span>
                                </div>
                            </div>
                            <div id="sectionOrderVisualBar" class="section-sequence-track">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>

                        <!-- Drag and Drop Sections List -->
                        <div id="sortableSectionsList" class="d-flex flex-column gap-2.5">
                            @for (int idx = 0; idx < sectionItems.Count; idx++)
                            {
                                var item = sectionItems[idx];
                                var isFirst = idx == 0;
                                var isLast = idx == sectionItems.Count - 1;
                                var rankText = isFirst ? "#1 (الأول — أعلى الصفحة)" : (isLast ? $"#{idx + 1} (الأخير — أسفل الصفحة)" : $"#{idx + 1}");
                                var rankBg = isFirst ? "#198754" : (isLast ? "#6c757d" : "#810100");

                                <div class="sortable-section-card card border p-3 rounded-4 bg-white shadow-xs position-relative"
                                     data-section-key="@item.Key"
                                     data-section-name="@item.Title"
                                     data-section-shortname="@item.ShortTitle"
                                     data-section-icon="@item.Icon"
                                     data-section-color="@item.IconColor"
                                     draggable="true"
                                     style="border: 1px solid rgba(181, 141, 74, 0.28) !important; cursor: grab; transition: all 0.2s ease;">
                                    
                                    <input type="hidden" name="@item.OrderProp" id="orderInput_@item.Key" value="@item.Order" class="section-order-val" 
                                           data-section-name="@item.Title"
                                           data-section-shortname="@item.ShortTitle"
                                           data-section-icon="@item.Icon"
                                           data-section-color="@item.IconColor" />

                                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                                        <!-- Right Side: Handle + Rank Badge + Icon + Title + Description -->
                                        <div class="d-flex align-items-start align-items-md-center gap-2.5 flex-grow-1" style="min-width: 0;">
                                            <!-- Drag Handle -->
                                            <div class="drag-handle px-1 py-2 text-muted d-flex align-items-center justify-content-center cursor-grab" title="اسحب وأفلت لإعادة الترتيب (Drag & Drop)" style="cursor: grab;">
                                                <i class="fa-solid fa-grip-vertical fs-5 text-secondary opacity-75"></i>
                                            </div>

                                            <!-- Sequence Rank Badge -->
                                            <span class="badge section-rank-badge font-monospace text-white px-3 py-2 rounded-pill shadow-xs flex-shrink-0" style="background: @rankBg; font-size: 0.78rem; min-width: 55px; text-align: center;">
                                                @rankText
                                            </span>

                                            <!-- Section Icon -->
                                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border flex-shrink-0" style="width: 40px; height: 40px;">
                                                <i class="@item.Icon fs-5" style="color: @item.IconColor;"></i>
                                            </div>

                                            <!-- Title & Details -->
                                            <div class="min-w-0 flex-grow-1">
                                                <div class="fw-bold text-dark mb-0.5 d-flex align-items-center gap-2 flex-wrap">
                                                    <span style="font-size: 0.95rem;">@item.Title</span>
                                                    <span class="badge text-muted bg-light border fw-normal" style="font-size: 0.65rem;">@item.Badge</span>
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.78rem; line-height: 1.4;">
                                                    @item.Desc
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Left Side: Quick Up/Down buttons + Visibility Toggle Switch -->
                                        <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 w-100 w-md-auto pt-2 pt-md-0 border-top border-md-top-0" style="border-color: #f1ece4 !important;">
                                            <div class="d-flex align-items-center gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center btn-move-section-up @(isFirst ? "disabled" : "")" style="width: 32px; height: 32px;" title="تحريك لأعلى">
                                                    <i class="fa-solid fa-arrow-up" style="font-size: 0.72rem;"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center btn-move-section-down @(isLast ? "disabled" : "")" style="width: 32px; height: 32px;" title="تحريك لأسفل">
                                                    <i class="fa-solid fa-arrow-down" style="font-size: 0.72rem;"></i>
                                                </button>
                                            </div>

                                            <div class="form-check form-switch mb-0 ms-2">
                                                @if (item.SwitchProp == "tab5MarqueeSwitch")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" id="tab5MarqueeSwitch" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل شريط الماركي">
                                                }
                                                else if (item.SwitchProp == "tab5SpotlightSwitch")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" id="tab5SpotlightSwitch" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل قسم العروض">
                                                }
                                                else if (item.SwitchProp == "ShowBrandHero")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowBrandHero" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل سكشن الهيرو">
                                                }
                                                else if (item.SwitchProp == "ShowHeroBanners")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowHeroBanners" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل سلايدر البانرات">
                                                }
                                                else if (item.SwitchProp == "ShowTrustBadges")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowTrustBadges" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل مميزات الثقة">
                                                }
                                                else if (item.SwitchProp == "ShowCategoriesShowcase")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowCategoriesShowcase" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل استعراض الأقسام">
                                                }
                                                else if (item.SwitchProp == "ShowFeaturedSection")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowFeaturedSection" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل العطور المميزة">
                                                }
                                                else if (item.SwitchProp == "ShowBestSellersSection")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowBestSellersSection" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل الأكثر مبيعاً">
                                                }
                                                else if (item.SwitchProp == "ShowTestimonialsSection")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowTestimonialsSection" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل آراء العملاء">
                                                }
                                                else if (item.SwitchProp == "ShowFaqSection")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowFaqSection" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل الأسئلة الشائعة">
                                                }
                                                else if (item.SwitchProp == "ShowNewsletterSection")
                                                {
                                                    <input class="form-check-input section-visibility-cb" type="checkbox" role="switch" asp-for="ShowNewsletterSection" style="cursor: pointer; width: 2.2em; height: 1.2em;" title="تفعيل النشرة البريدية">
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- TAB 6: TOP ANNOUNCEMENT BAR                                    -->
            <!-- ============================================================== -->
            <div class="tab-pane fade tab-pane-content" id="tab-social" role="tabpanel" aria-labelledby="tab-social-btn">
                <div class="row g-4">
                    <!-- Top Announcement Bar -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-setting-header d-flex justify-content-between align-items-center bg-white p-3 p-md-4 border-bottom">
                                <span class="fw-bold fs-5" style="color: #1B1717;">
                                    <i class="fa-solid fa-bullhorn text-danger me-2"></i>الشريط الإعلاني العلوي (Top Announcement Bar)
                                </span>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="AnnouncementActive" id="announcementSwitch" style="cursor: pointer; width: 2.5em; height: 1.3em;">
                                    <label class="form-check-label small fw-semibold ms-2" for="announcementSwitch">تفعيل الشريط العلوي في المتجر</label>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <label class="form-label small fw-bold text-dark mb-1">نص الإعلان الترويجي</label>
                                <input type="text" asp-for="AnnouncementText" class="form-control rounded-3 py-2" placeholder="Maison ROVEN • Complimentary Nationwide Delivery Across Egypt" />
                                <div class="form-text small mt-2 text-muted">
                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    يظهر هذا النص في الشريط العلوي المتحرك أعلى كافة صفحات المتجر الإلكتروني.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notice Card directing to Store Messages & Inquiries -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: linear-gradient(135deg, #FAF8F5 0%, #FFFFFF 100%); border: 1.5px dashed rgba(99, 0, 0, 0.2) !important;">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 44px; height: 44px; background: rgba(99, 0, 0, 0.08); color: #630000; font-size: 1.25rem;">
                                        <i class="fa-brands fa-whatsapp"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark mb-0.5">إدارة أرقام الواتساب ولينكات السوشيال ميديا وبيانات الكونسيرج</div>
                                        <div class="text-muted small">تم نقل وتوحيد إدارة رقم الواتساب الرسمي ولينكات Facebook & Instagram وبيانات التواصل إلى صفحة <strong>رسائل واستفسارات المتجر</strong>.</div>
                                    </div>
                                </div>
                                <a asp-controller="Messages" asp-action="Index" asp-route-tab="contact_settings" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-2 fw-bold text-nowrap d-inline-flex align-items-center gap-2">
                                    <span>الانتقال لصفحة رسائل واستفسارات المتجر</span>
                                    <i class="fa-solid fa-arrow-left"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- TAB 7: FAQ CLARIFICATIONS & ACCORDION MANAGEMENT               -->
            <!-- ============================================================== -->
            <div class="tab-pane fade tab-pane-content" id="tab-faq" role="tabpanel" aria-labelledby="tab-faq-btn">
                
                <!-- Section Header Settings Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-setting-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 border-bottom">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-circle-question text-info me-2"></i>إعدادات عنوان ونصوص سكشن الأسئلة الشائعة (FAQ Header)
                            </span>
                            <div class="text-muted small mt-1">
                                تحكم في الشارة العلوية، العنوان الرئيسي، والنص التوضيحي الظاهر أعلى سكشن الأسئلة الشائعة في متجر دار Roven.
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <div class="col-12 col-lg-7">
                                <div class="mb-3">
                                    <label asp-for="FaqBadgeText" class="form-label small fw-bold text-secondary">
                                        نص الشارة العلوية (Badge Text)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-danger"><i class="fa-solid fa-gem"></i></span>
                                        <input asp-for="FaqBadgeText" id="inputFaqBadge" class="form-control" placeholder="Maison ROVEN Clarifications" />
                                    </div>
                                    <small class="text-muted d-block mt-1">النص داخل الشارة البيضاوية أعلى السكشن (افتراضي: Maison ROVEN Clarifications)</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="FaqTitle" class="form-label small fw-bold text-secondary">
                                        العنوان الرئيسي للسكشن (Section Title)
                                    </label>
                                    <input asp-for="FaqTitle" id="inputFaqTitle" class="form-control fw-bold" placeholder="Frequently Asked Questions" />
                                    <small class="text-muted d-block mt-1">العنوان الرئيسي العريض (افتراضي: Frequently Asked Questions)</small>
                                </div>

                                <div class="mb-0">
                                    <label asp-for="FaqSubtitle" class="form-label small fw-bold text-secondary">
                                        الوصف التوضيحي للسكشن (Section Subtitle)
                                    </label>
                                    <textarea asp-for="FaqSubtitle" id="inputFaqSubtitle" class="form-control" rows="2" placeholder="Everything you need to know about concentrations, parcel inspection, and authenticity"></textarea>
                                    <small class="text-muted d-block mt-1">الجملة التوضيحية أسفل العنوان عن التراكيز ومعاينة الطرد</small>
                                </div>
                            </div>

                            <!-- Live Header Preview -->
                            <div class="col-12 col-lg-5">
                                <div class="p-3.5 p-md-4 rounded-4 border text-center shadow-xs position-relative overflow-hidden" style="background: #FAF9F5; border: 1px solid rgba(181, 141, 74, 0.25) !important;">
                                    <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: linear-gradient(90deg, #810100 0%, #b58d4a 50%, #810100 100%);"></div>
                                    <div class="small text-muted fw-bold text-uppercase mb-3" style="font-size: 0.72rem; letter-spacing: 1px; color: #8a6519 !important;">
                                        <i class="fa-solid fa-eye me-1"></i>معاينة مباشرة في المتجر
                                    </div>

                                    <div class="my-2">
                                        <span class="badge px-3 py-1.5 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2 shadow-xs" id="previewFaqBadge" style="background: rgba(181, 141, 74, 0.12); color: #8a6519; border: 1px solid rgba(181, 141, 74, 0.35); font-size: 0.75rem;">
                                            <i class="fa-solid fa-gem text-danger"></i>
                                            <span>@(string.IsNullOrWhiteSpace(Model.FaqBadgeText) ? "Maison ROVEN Clarifications" : Model.FaqBadgeText)</span>
                                        </span>
                                        <h4 class="fw-extrabold mb-2" id="previewFaqTitle" style="font-family: 'Playfair Display', serif; color: #1B1717; font-size: 1.25rem;">
                                            @(string.IsNullOrWhiteSpace(Model.FaqTitle) ? "Frequently Asked Questions" : Model.FaqTitle)
                                        </h4>
                                        <p class="text-muted small mx-auto mb-0" id="previewFaqSubtitle" style="max-width: 420px; font-size: 0.82rem; line-height: 1.5;">
                                            @(string.IsNullOrWhiteSpace(Model.FaqSubtitle) ? "Everything you need to know about concentrations, parcel inspection, and authenticity" : Model.FaqSubtitle)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main FAQ Items Management Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-setting-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 bg-white border-bottom">
                        <div>
                            <span class="fw-bold fs-6" style="color: #1B1717;">
                                <i class="fa-solid fa-list-check text-success me-2"></i>قائمة الأسئلة والأجوبة (FAQ Questions & Answers)
                            </span>
                            <div class="text-muted small mt-1">
                                يمكنك إضافة أسئلة جديدة، تعديل نص أي سؤال أو إجابته، إعادة ترتيبها تصاعدياً، أو تفعيلها وإلغاء تفعيلها فوراً.
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5 text-white" style="background: #810100; border-color: #810100; width: auto !important;" onclick="openAddFaqModal()">
                                <i class="fa-solid fa-plus"></i>
                                <span>إضافة سؤال جديد +</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill fw-semibold shadow-xs" title="استعادة الأسئلة الافتراضية" onclick="confirmResetDefaultFaqModal()">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                <span class="d-none d-sm-inline ms-1">استعادة الافتراضية</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="card-body p-3 p-md-4">
                        @if (faqItems.Any())
                        {
                            <div class="d-flex flex-column gap-3" id="faqItemsContainer">
                                @for (int i = 0; i < faqItems.Count; i++)
                                {
                                    var item = faqItems[i];
                                    var itemIcon = !string.IsNullOrWhiteSpace(item.IconClass) ? item.IconClass : "fa-solid fa-circle-question";

                                    <div class="card border p-3 rounded-4 bg-white shadow-xs position-relative faq-item-row" id="faqCard_@item.Id" data-id="@item.Id" style="border-color: #e8e3d5 !important;">
                                        <!-- Hidden Raw Data Store for 100% Reliable Escaping & Modal Sync -->
                                        <input type="hidden" id="faq-raw-question-@item.Id" value="@item.Question" />
                                        <textarea id="faq-raw-answer-@item.Id" class="d-none">@item.Answer</textarea>
                                        <div class="d-none" id="faqDataStore_@item.Id"
                                             data-id="@item.Id"
                                             data-icon="@itemIcon"
                                             data-order="@item.DisplayOrder"
                                             data-active="@(item.IsActive ? "true" : "false")">
                                        </div>

                                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                                            
                                            <!-- Question & Answer Preview -->
                                            <div class="d-flex align-items-start gap-3 flex-grow-1" style="min-width: 0;">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border flex-shrink-0" style="width: 40px; height: 40px;">
                                                    <i class="@itemIcon faq-icon-preview" style="color: #810100; font-size: 1rem;"></i>
                                                </div>
                                                <div class="flex-grow-1" style="min-width: 0;">
                                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                        <span class="badge font-monospace text-white px-2 py-0.5 rounded-pill faq-order-badge" style="background: #810100; font-size: 0.7rem;">#@item.DisplayOrder</span>
                                                        <h6 class="fw-bold mb-0 text-dark faq-question-preview" style="font-size: 0.95rem;">@item.Question</h6>
                                                    </div>
                                                    <div class="text-muted small faq-answer-preview" style="font-size: 0.8rem; line-height: 1.5; max-height: 2.8em; overflow: hidden;">
                                                        @Html.Raw(item.Answer)
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Controls (Actions) -->
                                            <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 w-100 w-md-auto pt-2 pt-md-0 border-top border-md-top-0" style="border-color: #f1ece4 !important;">
                                                <!-- Status Toggle -->
                                                <button type="button" 
                                                        id="faqToggleBtn_@item.Id"
                                                        onclick="toggleFaqStatus(@item.Id)" 
                                                        class="badge rounded-pill px-3 py-2 fw-bold text-decoration-none border-0 shadow-xs btn-faq-toggle" 
                                                        style="background-color: @(item.IsActive ? "#198754" : "#6c757d"); color: #ffffff; cursor: pointer; font-size: 0.74rem;" 
                                                        title="انقر لتغيير حالة التفعيل">
                                                    @(item.IsActive ? "ACTIVE" : "INACTIVE")
                                                </button>

                                                <div class="d-flex align-items-center gap-1.5">
                                                    <!-- Move Up -->
                                                    <button type="button" 
                                                            id="faqMoveUpBtn_@item.Id"
                                                            onclick="moveFaqItemOrder(@item.Id, 'up')" 
                                                            class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center faq-move-up-btn @(i == 0 ? "disabled" : "")" 
                                                            style="width: 32px; height: 32px;" 
                                                            title="تحريك لأعلى">
                                                        <i class="fa-solid fa-arrow-up" style="font-size: 0.75rem;"></i>
                                                    </button>

                                                    <!-- Move Down -->
                                                    <button type="button" 
                                                            id="faqMoveDownBtn_@item.Id"
                                                            onclick="moveFaqItemOrder(@item.Id, 'down')" 
                                                            class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center faq-move-down-btn @(i == faqItems.Count - 1 ? "disabled" : "")" 
                                                            style="width: 32px; height: 32px;" 
                                                            title="تحريك لأسفل">
                                                        <i class="fa-solid fa-arrow-down" style="font-size: 0.75rem;"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button type="button" 
                                                            id="faqEditBtn_@item.Id"
                                                            onclick="openEditFaqModal(@item.Id)" 
                                                            class="btn btn-sm btn-light border rounded-circle d-flex align-items-center justify-content-center text-primary" 
                                                            style="width: 32px; height: 32px;" 
                                                            title="تعديل السؤال">
                                                        <i class="fa-solid fa-pen-to-square" style="font-size: 0.78rem;"></i>
                                                    </button>

                                                    <!-- Delete Button -->
                                                    <button type="button" 
                                                            id="faqDeleteBtn_@item.Id"
                                                            onclick="confirmDeleteFaqModal(@item.Id)" 
                                                            class="btn btn-sm btn-light border rounded-circle d-flex align-items-center justify-content-center text-danger" 
                                                            style="width: 32px; height: 32px;" 
                                                            title="حذف السؤال">
                                                        <i class="fa-solid fa-trash-can" style="font-size: 0.78rem;"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5" id="faqEmptyState">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 bg-light" style="width: 60px; height: 60px;">
                                    <i class="fa-solid fa-circle-question text-muted fs-3"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">لا توجد أسئلة مضافة حالياً</h6>
                                <p class="text-muted small mb-3">يمكنك إضافة سؤال جديد أو استعادة الأسئلة الافتراضية للدار بنقرة واحدة.</p>
                                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold text-white" style="background: #810100; border-color: #810100;" onclick="openAddFaqModal()">
                                    <i class="fa-solid fa-plus me-1"></i> إضافة سؤال جديد
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Sticky Bottom Save Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mt-4 bg-white border sticky-save-bar d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2.5">
                <i class="fa-solid fa-cloud-arrow-up text-danger fs-4 flex-shrink-0"></i>
                <div>
                    <div class="fw-bold text-dark small">حفظ فوري ومباشر لكافة الإعدادات</div>
                    <div class="text-muted" style="font-size: 0.75rem;">يتم تطبيق التعديلات في الصفحة الرئيسية للمتجر فور الضغط على زر الحفظ.</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-nowrap flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-1.5 text-nowrap" style="white-space: nowrap !important; width: auto !important;">
                    <i class="fa-solid fa-eye"></i>
                    <span>معاينة المتجر</span>
                </a>
                <button type="submit" class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 text-white text-nowrap" style="background: #810100; border-color: #810100; white-space: nowrap !important; width: auto !important;">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>حفظ وتطبيق</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Hidden Actions Forms for Offers (Outside main form to prevent nested form submissions) -->
