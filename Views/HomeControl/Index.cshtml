        function updateSectionVisualBar() {
            if (!visualBar) return;
            const items = [];
            orderSelects.forEach(select => {
                const orderVal = parseInt(select.value, 10) || 99;
                const name = select.getAttribute('data-section-name') || 'سكشن';
                const card = select.closest('.section-card-item');
                const isChecked = card ? (card.querySelector('input[type="checkbox"]')?.checked ?? true) : true;
                items.push({ order: orderVal, name: name, isChecked: isChecked });
            });

            // Sort ascending by order value
            items.sort((a, b) => a.order - b.order);

            visualBar.innerHTML = items.map((item, idx) => `
                <div class="d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill border ${item.isChecked ? 'bg-white shadow-xs' : 'bg-light text-muted opacity-60'}" style="font-size: 0.76rem; border-color: rgba(181, 141, 74, 0.3) !important;">
