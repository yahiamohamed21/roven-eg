        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        fetch('/HomeControl/ToggleFaqItem', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => {
            if (!res.ok) throw new Error('Toggle error');
            return res.json();
        })
        .then(data => {
            if (btn) {
                btn.style.opacity = '1';
                if (data.isActive) {
                    btn.textContent = 'ACTIVE';
                    btn.style.backgroundColor = '#198754';
                } else {
                    btn.textContent = 'INACTIVE';
                    btn.style.backgroundColor = '#6c757d';
                }
            }
            if (store) store.setAttribute('data-active', data.isActive ? 'true' : 'false');
            showFaqToast(data.message || 'تم تغيير حالة السؤال بنجاح', 'success');
        })
        .catch(err => {
            console.error('Toggle FAQ error:', err);
            if (btn) btn.style.opacity = '1';
            const fallbackForm = document.getElementById('toggleFaqForm_' + id);
            if (fallbackForm) fallbackForm.submit();
        });
    }

    function moveFaqItemOrder(id, direction) {
        const card = document.getElementById('faqCard_' + id);
        const container = document.getElementById('faqItemsContainer');
        if (!card || !container) return;

        if (direction === 'up') {
            const prev = card.previousElementSibling;
            if (prev && prev.classList.contains('faq-item-row')) {
                container.insertBefore(card, prev);
            }
        } else if (direction === 'down') {
            const next = card.nextElementSibling;
            if (next && next.classList.contains('faq-item-row')) {
                container.insertBefore(next, card);
            }
        }

        recalculateFaqOrdersInDom();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('direction', direction);
        formData.append('__RequestVerificationToken', token);

        fetch('/HomeControl/MoveFaqItem', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .catch(err => {
            console.error('Move FAQ error:', err);
            const fallbackForm = document.getElementById(direction === 'up' ? ('moveFaqUpForm_' + id) : ('moveFaqDownForm_' + id));
            if (fallbackForm) fallbackForm.submit();
        });
    }

    function recalculateFaqOrdersInDom() {
        const container = document.getElementById('faqItemsContainer');
        if (!container) return;
        const cards = container.querySelectorAll('.faq-item-row');
        cards.forEach((card, idx) => {
            const badge = card.querySelector('.faq-order-badge');
            if (badge) badge.textContent = '#' + (idx + 1);

            const upBtn = card.querySelector('.faq-move-up-btn');
            if (upBtn) {
                if (idx === 0) upBtn.classList.add('disabled');
                else upBtn.classList.remove('disabled');
            }

            const downBtn = card.querySelector('.faq-move-down-btn');
            if (downBtn) {
                if (idx === cards.length - 1) downBtn.classList.add('disabled');
                else downBtn.classList.remove('disabled');
            }
        });
    }

    function showFaqToast(message, type = 'success') {
        let toastContainer = document.getElementById('faqToastContainer');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'faqToastContainer';
            toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            toastContainer.style.zIndex = '9999';
            document.body.appendChild(toastContainer);
        }

        const toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-white border-0 shadow-lg rounded-3';
        toastEl.style.backgroundColor = type === 'success' ? '#198754' : '#dc3545';
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.setAttribute('aria-atomic', 'true');
        toastEl.innerHTML = `
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fw-semibold">
                    <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation'}"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;
        toastContainer.appendChild(toastEl);
        const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3000 });
        bsToast.show();
        toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
    }

    // Live Header Preview for FAQ
    const inputFaqBadge = document.getElementById('inputFaqBadge');
    const previewFaqBadge = document.getElementById('previewFaqBadge');
    if (inputFaqBadge && previewFaqBadge) {
        inputFaqBadge.addEventListener('input', function() {
            const span = previewFaqBadge.querySelector('span');
            if (span) span.textContent = this.value.trim() || 'Maison ROVEN Clarifications';
        });
    }

    const inputFaqTitle = document.getElementById('inputFaqTitle');
    const previewFaqTitle = document.getElementById('previewFaqTitle');
    if (inputFaqTitle && previewFaqTitle) {
        inputFaqTitle.addEventListener('input', function() {
            previewFaqTitle.textContent = this.value.trim() || 'Frequently Asked Questions';
        });
    }

    const inputFaqSubtitle = document.getElementById('inputFaqSubtitle');
    const previewFaqSubtitle = document.getElementById('previewFaqSubtitle');
    if (inputFaqSubtitle && previewFaqSubtitle) {
        inputFaqSubtitle.addEventListener('input', function() {
            previewFaqSubtitle.textContent = this.value.trim() || 'Everything you need to know about concentrations, parcel inspection, and authenticity';
        });
    }
</script>
}
