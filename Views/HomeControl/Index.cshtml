<!-- Hidden Actions Forms for Offers (Outside main form to prevent nested form submissions) -->
@foreach (var offer in homeOffers)
{
    <form id="toggleOfferForm_@offer.Id" asp-controller="HomeControl" asp-action="ToggleHomeOffer" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@offer.Id" />
    </form>
}

<form id="deleteOfferFormGlobal" asp-controller="HomeControl" asp-action="DeleteHomeOffer" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteOfferIdInput" value="0" />
</form>

<!-- Hidden Actions Forms for Hero Banners -->
@foreach (var b in heroBanners)
{
    <form id="toggleBannerForm_@b.Id" asp-controller="HomeControl" asp-action="ToggleHeroBanner" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@b.Id" />
    </form>
    <form id="moveBannerUpForm_@b.Id" asp-controller="HomeControl" asp-action="MoveHeroBanner" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@b.Id" />
        <input type="hidden" name="direction" value="up" />
    </form>
    <form id="moveBannerDownForm_@b.Id" asp-controller="HomeControl" asp-action="MoveHeroBanner" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@b.Id" />
        <input type="hidden" name="direction" value="down" />
    </form>
}

<form id="deleteBannerFormGlobal" asp-controller="HomeControl" asp-action="DeleteHeroBanner" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteBannerIdInput" value="0" />
</form>

<!-- Modal: Create Hero Banner (Clean Light Theme) -->
<div class="modal fade" id="createHeroBannerModal" tabindex="-1" aria-labelledby="createHeroBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom pb-3 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="createHeroBannerModalLabel" style="color: #1B1717; font-family: 'Playfair Display', serif;">
                    <i class="fa-solid fa-images text-danger me-2"></i>إضافة بانر رئيسي (Create Hero Banner)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="AddHeroBanner" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <!-- Desktop Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                UPLOAD DESKTOP IMAGE <span class="text-danger">*</span>
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                RECOMMENDED: 1920x800 PX (OR 1200x500 PX) | ASPECT RATIO: 12:5
                            </div>
                            <input type="file" name="desktopImage" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-1.5">
                                <input type="text" name="desktopImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="أو مسار الصورة المباشر /images/banners/..." />
                            </div>
                        </div>

                        <!-- Mobile Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                UPLOAD MOBILE IMAGE (OPTIONAL)
                            </label>
                            <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                RECOMMENDED: 750x1000 PX (OR 600x800 PX) | ASPECT RATIO: 3:4
                            </div>
                            <input type="file" name="mobileImage" accept="image/*" class="form-control rounded-3" />
                            <div class="mt-1.5">
                                <input type="text" name="mobileImageUrl" class="form-control form-control-sm rounded-3 font-monospace" placeholder="أو مسار صورة الموبايل المباشر..." />
                            </div>
                        </div>

                        <!-- Redirect Link -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                BANNER REDIRECT LINK <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="redirectLink" class="form-control rounded-3 font-monospace" placeholder="/products" value="/Store" required />
                            <div class="text-muted small mt-1" style="font-size: 0.75rem;">الرابط الذي سيتم توجيه العميل إليه عند النقر على البانر (مثال: /Store أو /Store?categoryId=1).</div>
                        </div>

                        <!-- Title & Alt Text -->
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                    BANNER TITLE (NAME)
                                </label>
                                <input type="text" name="title" class="form-control rounded-3" placeholder="Hero Banner Slide #..." />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717; letter-spacing: 0.5px;">
                                    IMAGE ALT TEXT (SEO DESCRIPTION)
                                </label>
                                <input type="text" name="altText" class="form-control rounded-3" placeholder="e.g. Maison ROVEN Luxury Perfumes" />
                            </div>
                        </div>

                        <!-- Active Checkbox -->
                        <div class="form-check mt-2">
                            <input type="checkbox" name="isActive" class="form-check-input" value="true" checked id="createBannerActiveCheck" style="cursor: pointer; width: 1.25rem; height: 1.25rem;" />
                            <label class="form-check-label small fw-bold ms-2 pt-1" for="createBannerActiveCheck" style="color: #1B1717; letter-spacing: 0.5px;">
                                تفعيل البانر مباشرة في المتجر (ENABLE BANNER VISIBILITY)
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
                    <button type="submit" class="btn fw-bold px-4 py-2.5 rounded-pill shadow-sm text-white" style="background: #810100; border: none; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-save me-1"></i> حفظ البانر (SAVE BANNER)
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill" data-bs-dismiss="modal">
                        إلغاء (CANCEL)
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Hero Banner (Clean Light Theme) -->
<div class="modal fade" id="editHeroBannerModal" tabindex="-1" aria-labelledby="editHeroBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-white">
            <div class="modal-header border-bottom pb-3 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="editHeroBannerModalLabel" style="color: #1B1717; font-family: 'Playfair Display', serif;">
                    <i class="fa-solid fa-pen-to-square text-primary me-2"></i>تعديل البانر الرئيسي (Edit Hero Banner)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="HomeControl" asp-action="UpdateHeroBanner" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editBannerId" />
                <input type="hidden" name="displayOrder" id="editBannerDisplayOrder" />
                <div class="modal-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <!-- Current Previews -->
                        <div class="p-3 rounded-3 bg-light border" style="border-color: #e8e3d5 !important;">
                            <div class="small fw-bold text-uppercase mb-2" style="color: #810100;">
                                <i class="fa-solid fa-eye me-1"></i> CURRENT BANNER PREVIEW:
                            </div>
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div>
                                    <div class="small text-muted mb-1 font-monospace">Desktop (1920x800):</div>
                                    <img id="editBannerDesktopPreview" src="" alt="Desktop Preview" class="rounded border shadow-xs" style="width: 180px; height: 75px; object-fit: cover; border-color: #ddd !important;" />
                                </div>
                                <div id="editBannerMobilePreviewWrap">
                                    <div class="small text-muted mb-1 font-monospace">Mobile (750x1000):</div>
                                    <img id="editBannerMobilePreview" src="" alt="Mobile Preview" class="rounded border shadow-xs" style="width: 60px; height: 75px; object-fit: cover; border-color: #ddd !important;" />
                                </div>
                            </div>
                        </div>

                        <!-- Replace Desktop Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717;">
                                CHANGE DESKTOP IMAGE (OPTIONAL)
                            </label>
                            <input type="file" name="desktopImage" accept="image/*" class="form-control rounded-3" />
                            <input type="text" name="desktopImageUrl" id="editBannerDesktopUrlInput" class="form-control form-control-sm rounded-3 font-monospace mt-1" placeholder="أو مسار الصورة المباشر..." />
                        </div>

                        <!-- Replace Mobile Image -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717;">
                                CHANGE MOBILE IMAGE (OPTIONAL)
                            </label>
                            <input type="file" name="mobileImage" accept="image/*" class="form-control rounded-3" />
                            <input type="text" name="mobileImageUrl" id="editBannerMobileUrlInput" class="form-control form-control-sm rounded-3 font-monospace mt-1" placeholder="أو مسار صورة الموبايل المباشر..." />
                        </div>

                        <!-- Redirect Link -->
                        <div>
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717;">
                                BANNER REDIRECT LINK <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="redirectLink" id="editBannerRedirectLinkInput" class="form-control rounded-3 font-monospace" required />
                        </div>

                        <!-- Title & Alt Text -->
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717;">
                                    BANNER TITLE (NAME)
                                </label>
                                <input type="text" name="title" id="editBannerTitleInput" class="form-control rounded-3" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-uppercase mb-1" style="color: #1B1717;">
                                    IMAGE ALT TEXT (SEO)
                                </label>
                                <input type="text" name="altText" id="editBannerAltTextInput" class="form-control rounded-3" />
                            </div>
                        </div>

                        <!-- Active Checkbox -->
                        <div class="form-check mt-2">
                            <input type="checkbox" name="isActive" class="form-check-input" value="true" id="editBannerActiveCheck" style="cursor: pointer; width: 1.25rem; height: 1.25rem;" />
