                                    <option value="fa-solid fa-shield-halved">fa-shield-halved (ضمان / معاينة COD)</option>
                                    <option value="fa-solid fa-truck-fast">fa-truck-fast (شحن وتوصيل)</option>
                                    <option value="fa-solid fa-box-open">fa-box-open (تتبع شحنة / طرد)</option>
                                    <option value="fa-solid fa-gem">fa-gem (جودة وفخامة)</option>
                                    <option value="fa-solid fa-spray-can-sparkles">fa-spray-can-sparkles (عطور وفوحان)</option>
                                    <option value="fa-solid fa-clock">fa-clock (مواعيد وساعات)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
