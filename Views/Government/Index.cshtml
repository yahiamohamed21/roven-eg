@model IEnumerable<Stockify.Models.Entities.Governorate>
@{
    ViewData["Title"] = "إدارة المحافظات وأسعار الشحن (Governorates & Shipping Rates)";
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count();
    var activeCount = ViewBag.ActiveCount as int? ?? Model.Count(g => g.IsActive);
    var avgFee = ViewBag.AvgFee as decimal? ?? 0m;
    var minFee = ViewBag.MinFee as decimal? ?? 0m;
    var maxFee = ViewBag.MaxFee as decimal? ?? 0m;
    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #1B1717;">
            <i class="fa-solid fa-truck-fast text-roven me-2" style="color: #630000;"></i>
            إدارة المحافظات وتكلفة الشحن
        </h3>
        <p class="text-muted small mb-0">
            تحديد وتعديل أسعار الشحن لكافة محافظات الجمهورية — تظهر وتُحسب مباشرة للعميل عند اختيار المحافظة في شاشة الدفع (Checkout).
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="button" class="btn btn-roven-wine px-3 py-2 fw-bold rounded-pill shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addGovModal">
            <i class="fa-solid fa-plus"></i>
            <span>إضافة محافظة جديدة</span>
        </button>
    </div>
</div>

<!-- KPI Summary Strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 fs-4 d-flex align-items-center justify-content-center" style="background-color: #EDEBDD; color: #630000;">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium">إجمالي المحافظات</span>
                    <h5 class="fw-bold text-dark mb-0 font-monospace">@totalCount</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 fs-4 d-flex align-items-center justify-content-center" style="background-color: rgba(25, 135, 84, 0.12); color: #198754;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium">محافظات شحن نشطة</span>
                    <h5 class="fw-bold text-success mb-0 font-monospace">@activeCount</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 fs-4 d-flex align-items-center justify-content-center" style="background-color: rgba(13, 110, 253, 0.12); color: #0d6efd;">
                    <i class="fa-solid fa-coins"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium">متوسط سعر الشحن</span>
                    <h5 class="fw-bold text-dark mb-0 font-monospace">@avgFee.ToString("N1") ج.م</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 fs-4 d-flex align-items-center justify-content-center" style="background-color: rgba(255, 193, 7, 0.15); color: #856404;">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium">النطاق السعري</span>
                    <h5 class="fw-bold text-dark mb-0 font-monospace" style="font-size: 0.95rem;">@minFee.ToString("N0") - @maxFee.ToString("N0") ج.م</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white p-3">
    <form method="get" action="/goverment" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="search" value="@search" class="form-control border-start-0 bg-light" placeholder="بحث باسم المحافظة (عربي أو إنجليزي)..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select bg-light">
                <option value="">جميع الحالات (الكل)</option>
                <option value="active" selected="@(status == "active" ? "selected" : null)">النشطة فقط</option>
                <option value="inactive" selected="@(status == "inactive" ? "selected" : null)">المعطلة فقط</option>
            </select>
        </div>
        <div class="col-6 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark rounded-pill px-3 py-1.5 flex-grow-1 fw-semibold">
                <i class="fa-solid fa-filter me-1"></i> تصفية
            </button>
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status))
            {
                <a href="/goverment" class="btn btn-outline-secondary rounded-pill px-3 py-1.5">
                    إلغاء الفلتر
                </a>
            }
        </div>
    </form>
</div>

<!-- Governorates Data Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: #EDEBDD !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-list-check text-muted"></i>
            <h6 class="fw-bold mb-0 text-dark">جدول المحافظات وتكلفة الشحن للعملاء (@Model.Count() محافظة)</h6>
        </div>
        <span class="badge bg-light text-muted border small">
            تحديث فوري للسعر على المتجر
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background-color: #EDEBDD; color: #630000;">
                <i class="fa-solid fa-map-location-dot fs-3"></i>
            </div>
            <h5 class="fw-bold text-dark">لا توجد محافظات مطابقة</h5>
            <p class="text-muted small">يمكنك إضافة محافظة جديدة أو إعادة ضبط شروط البحث.</p>
            <button type="button" class="btn btn-roven-wine rounded-pill px-4 py-2 mt-2" data-bs-toggle="modal" data-bs-target="#addGovModal">
                <i class="fa-solid fa-plus me-1"></i> إضافة أول محافظة
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>اسم المحافظة (عربي / English)</th>
                        <th style="min-width: 180px;">سعر الشحن (ج.م)</th>
                        <th>مدة التوصيل التقديرية</th>
                        <th class="text-center">الحالة</th>
                        <th class="text-end pe-3">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gov in Model)
                    {
                        <tr id="gov-row-@gov.Id" class="@(!gov.IsActive ? "table-light opacity-75" : "")">
                            <td class="text-center text-muted small font-monospace">@gov.DisplayOrder</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background-color: #EDEBDD; color: #630000; font-size: 0.8rem;">
                                        <i class="fa-solid fa-location-dot"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-7">@gov.NameAr</div>
                                        <div class="small text-muted font-monospace" style="font-size: 0.76rem;">@gov.NameEn</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <!-- Quick Inline Price Update Form -->
                                <div class="input-group input-group-sm" style="max-width: 180px;">
                                    <input type="number" step="1" min="0" id="price-input-@gov.Id" class="form-control font-monospace fw-bold text-dark" value="@gov.ShippingFee.ToString("0.##")" />
                                    <span class="input-group-text bg-light text-muted small">ج.م</span>
                                    <button type="button" class="btn btn-outline-success" onclick="quickSaveGovPrice(@gov.Id)" title="حفظ السعر فوراً">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1 small">
                                    <i class="fa-regular fa-clock me-1 text-muted"></i>@(gov.DeliveryTime ?? "1-3 أيام عمل")
                                </span>
                            </td>
                            <td class="text-center">
                                <form method="post" action="/goverment/ToggleStatus" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@gov.Id" />
                                    <button type="submit" class="badge rounded-pill border-0 px-3 py-1.5 fw-semibold cursor-pointer @(gov.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")" style="cursor: pointer;" title="انقر لتغيير الحالة">
                                        <i class="fa-solid @(gov.IsActive ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                                        @(gov.IsActive ? "مفعلة بالمتجر" : "معطلة")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1.5">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" onclick="openEditGovModal(@gov.Id, '@gov.NameAr', '@gov.NameEn', @gov.ShippingFee, '@gov.DeliveryTime', @gov.DisplayOrder, @(gov.IsActive ? "true" : "false"))" title="تعديل">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <form method="post" action="/goverment/Delete" class="d-inline form-delete-gov">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@gov.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 btn-delete-gov" data-name="@gov.NameAr" title="حذف">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ============================================================== -->
<!-- MODAL: ADD GOVERNORATE                                         -->
<!-- ============================================================== -->
<div class="modal fade" id="addGovModal" tabindex="-1" aria-labelledby="addGovModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header py-3" style="background-color: #EDEBDD; border-bottom: 1px solid rgba(99, 0, 0, 0.15);">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-map-pin" style="color: #630000;"></i>
                    <h5 class="modal-title fw-bold" id="addGovModalLabel" style="color: #630000; font-size: 1.05rem;">إضافة محافظة جديدة وسعر الشحن</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/goverment/Create">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">اسم المحافظة بالعربية <span class="text-danger">*</span></label>
                        <input type="text" name="NameAr" class="form-control rounded-3" placeholder="مثال: القاهرة" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">اسم المحافظة بالإنجليزية (English Name) <span class="text-danger">*</span></label>
                        <input type="text" name="NameEn" class="form-control rounded-3" placeholder="e.g. Cairo" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label small fw-bold text-dark">سعر الشحن للعميل <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.5" min="0" name="ShippingFee" class="form-control font-monospace fw-bold" value="50" required />
                                <span class="input-group-text bg-light">ج.م</span>
                            </div>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold text-dark">ترتيب الظهور</label>
                            <input type="number" name="DisplayOrder" class="form-control font-monospace" value="@(totalCount + 1)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">مدة التوصيل التقديرية (اختياري)</label>
                        <input type="text" name="DeliveryTime" class="form-control rounded-3" value="1-3 أيام عمل" placeholder="مثال: 1-2 أيام عمل" />
                    </div>

                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="addGovIsActive" checked style="cursor: pointer;" />
                        <label class="form-check-label small fw-semibold" for="addGovIsActive">تفعيل المحافظة فوراً لتظهر للعميل في المتجر</label>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2.5 border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-roven-wine rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ وإضافة المحافظة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: EDIT GOVERNORATE                                        -->
<!-- ============================================================== -->
<div class="modal fade" id="editGovModal" tabindex="-1" aria-labelledby="editGovModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header py-3" style="background-color: #EDEBDD; border-bottom: 1px solid rgba(99, 0, 0, 0.15);">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-pen-to-square" style="color: #630000;"></i>
                    <h5 class="modal-title fw-bold" id="editGovModalLabel" style="color: #630000; font-size: 1.05rem;">تعديل بيانات المحافظة وسعر الشحن</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/goverment/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editGovId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">اسم المحافظة بالعربية <span class="text-danger">*</span></label>
                        <input type="text" name="NameAr" id="editGovNameAr" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">اسم المحافظة بالإنجليزية (English Name) <span class="text-danger">*</span></label>
                        <input type="text" name="NameEn" id="editGovNameEn" class="form-control rounded-3" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label small fw-bold text-dark">سعر الشحن للعميل (ج.م) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.5" min="0" name="ShippingFee" id="editGovShippingFee" class="form-control font-monospace fw-bold" required />
                                <span class="input-group-text bg-light">ج.م</span>
                            </div>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold text-dark">ترتيب الظهور</label>
                            <input type="number" name="DisplayOrder" id="editGovDisplayOrder" class="form-control font-monospace" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">مدة التوصيل التقديرية</label>
                        <input type="text" name="DeliveryTime" id="editGovDeliveryTime" class="form-control rounded-3" />
                    </div>

                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editGovIsActive" style="cursor: pointer;" />
                        <label class="form-check-label small fw-semibold" for="editGovIsActive">تفعيل المحافظة في المتجر</label>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2.5 border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-roven-wine rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditGovModal(id, nameAr, nameEn, fee, delivery, order, isActive) {
        document.getElementById('editGovId').value = id;
        document.getElementById('editGovNameAr').value = nameAr;
        document.getElementById('editGovNameEn').value = nameEn;
        document.getElementById('editGovShippingFee').value = fee;
        document.getElementById('editGovDeliveryTime').value = delivery || '1-3 أيام عمل';
        document.getElementById('editGovDisplayOrder').value = order;
        document.getElementById('editGovIsActive').checked = isActive;

        var modal = new bootstrap.Modal(document.getElementById('editGovModal'));
        modal.show();
    }

    async function quickSaveGovPrice(govId) {
        var input = document.getElementById('price-input-' + govId);
        if (!input) return;

        var newPrice = parseFloat(input.value);
        if (isNaN(newPrice) || newPrice < 0) {
            alert('يرجى إدخال سعر صحيح أكبر من أو يساوي الصفر.');
            return;
        }

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        var formData = new FormData();
        formData.append('id', govId);
        formData.append('shippingFee', newPrice);
        formData.append('__RequestVerificationToken', token);

        try {
            var res = await fetch('/goverment/QuickUpdatePrice', {
                method: 'POST',
                body: formData
            });
            var data = await res.json();
            if (data.success) {
                // Visual feedback
                input.classList.add('is-valid');
                setTimeout(() => input.classList.remove('is-valid'), 1800);
            } else {
                alert(data.message || 'حدث خطأ أثناء حفظ السعر.');
            }
        } catch (err) {
            console.error('Error updating price:', err);
            alert('تعذر الاتصال بالسيرفر.');
        }
    }

    // Delete Governorate confirmation
    document.addEventListener('click', function (e) {
        const deleteGovBtn = e.target.closest('.btn-delete-gov');
        if (deleteGovBtn) {
            e.preventDefault();
            const form = deleteGovBtn.closest('form');
            const govName = deleteGovBtn.getAttribute('data-name') || 'هذه المحافظة';
            const swalApi = window.Swal || window.Sweetalert2;

            if (swalApi) {
                swalApi.fire({
                    title: '<span style="font-family: \'Playfair Display\', serif; color: #630000;">حذف المحافظة من الشحن؟</span>',
                    html: `
                        <div class="text-center my-2">
                            <p class="mb-3 text-secondary fs-6">هل أنت متأكد من حذف محافظة <strong>${govName}</strong> من قائمة الشحن والتوصيل؟</p>
                            <div class="alert alert-danger text-start small mb-0 py-2 border-0 bg-danger-subtle text-danger-emphasis rounded-3">
                                <i class="fa-solid fa-triangle-exclamation me-1 text-danger"></i> تنبيه: لن تظهر هذه المحافظة للعملاء في خيارات الشحن بصفحة إتمام الطلب بعد الحذف.
                            </div>
                        </div>
                    `,
                    icon: 'warning',
                    iconColor: '#630000',
                    showCancelButton: true,
                    confirmButtonText: '<i class="fa-solid fa-trash-can me-1"></i> نعم، حذف المحافظة',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#630000',
                    cancelButtonColor: '#6c757d',
                    customClass: {
                        confirmButton: 'btn btn-danger px-4 py-2 fw-bold me-2 rounded-pill shadow-sm',
                        cancelButton: 'btn btn-outline-secondary px-4 py-2 rounded-pill'
                    },
                    buttonsStyling: false,
                    reverseButtons: false
                }).then(function (result) {
                    if (result.isConfirmed && form) {
                        form.submit();
                    }
                });
            } else if (form) {
                form.submit();
            }
        }
    });
</script>
}

