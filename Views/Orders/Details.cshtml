@model Stockify.Models.Entities.Order
@using Stockify.Models.Enums
@{
    ViewData["Title"] = $"Order Details: {Model.OrderNumber}";
    var subtotal = Model.OrderItems.Sum(i => i.UnitPrice * i.Quantity);

    var recipientName = !string.IsNullOrWhiteSpace(Model.CustomerName) 
        ? Model.CustomerName 
        : (Model.Customer?.FullName ?? "Guest Customer");

    var recipientPhone = !string.IsNullOrWhiteSpace(Model.CustomerPhone)
        ? Model.CustomerPhone
        : (Model.Customer?.PhoneNumber ?? "N/A");

    var recipientEmail = !string.IsNullOrWhiteSpace(Model.CustomerEmail)
        ? Model.CustomerEmail
        : (Model.Customer?.Email ?? "N/A");

    var deliveryAddress = !string.IsNullOrWhiteSpace(Model.ShippingAddress)
        ? $"{Model.ShippingAddress}, {Model.City}"
        : (Model.Customer?.Address ?? "Store Counter Pickup");
}

<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h3 class="fw-bold text-dark mb-0 font-monospace">@Model.OrderNumber</h3>
            @if (Model.OrderSource == OrderSource.Website)
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                    <i class="bi bi-globe me-1"></i>Website Order
                </span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                    <i class="bi bi-shop me-1"></i>POS / Counter Order
                </span>
            }

            @switch (Model.Status)
            {
                case OrderStatus.Completed:
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6">
                        <i class="bi bi-check2-all me-1"></i>Delivered / Completed
                    </span>
                    break;
                case OrderStatus.Shipped:
                    <span class="badge bg-info-subtle text-info border border-info-subtle fs-6">
                        <i class="bi bi-truck me-1"></i>Shipped / Out for Delivery
                    </span>
                    break;
                case OrderStatus.Processing:
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">
                        <i class="bi bi-arrow-repeat me-1"></i>Processing / Packing
                    </span>
                    break;
                case OrderStatus.Cancelled:
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6">
                        <i class="bi bi-x-circle me-1"></i>Cancelled
                    </span>
                    break;
                default:
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6">
                        <i class="bi bi-clock-history me-1"></i>Pending Review
                    </span>
                    break;
            }
        </div>
        <p class="text-muted mb-0 small mt-1"><i class="bi bi-clock me-1"></i>Placed on @Model.OrderDate.ToEgyptTimeString("dd MMMM yyyy, hh:mm tt")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Orders
        </a>

    </div>
</div>

<!-- Status Management Bar (Order Status Lifecycle) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 bg-light rounded d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-arrow-repeat text-primary fs-5"></i>
            <div>
                <span class="fw-bold text-dark small d-block">Manage Order Lifecycle Status</span>
                <span class="text-muted small">Update fulfillment status or cancel order (cancelling automatically restores reserved inventory).</span>
            </div>
        </div>
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" id="updateStatusForm" class="d-flex align-items-center gap-2">
            @Html.AntiForgeryToken()
            <select name="newStatus" id="orderStatusSelect" class="form-select form-select-sm w-auto">
                <option value="@OrderStatus.Pending" selected="@(Model.Status == OrderStatus.Pending ? "selected" : null)">Pending Review</option>
                <option value="@OrderStatus.Processing" selected="@(Model.Status == OrderStatus.Processing ? "selected" : null)">Processing (Packing)</option>
                <option value="@OrderStatus.Shipped" selected="@(Model.Status == OrderStatus.Shipped ? "selected" : null)">Shipped (Out for Delivery)</option>
                <option value="@OrderStatus.Completed" selected="@(Model.Status == OrderStatus.Completed ? "selected" : null)">Delivered / Completed</option>
                <option value="@OrderStatus.Cancelled" selected="@(Model.Status == OrderStatus.Cancelled ? "selected" : null)">Cancelled (Restock Items)</option>
            </select>
            <button type="button" id="btnUpdateStatus" class="btn btn-sm btn-primary px-3 text-nowrap">
                Update Status
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Order Items Breakdown -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-box-seam text-primary me-2"></i>Ordered Line Items</span>
                <span class="badge bg-light text-dark border">@Model.OrderItems.Count Items</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item & Description</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th class="text-end pe-3">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            var lineTotal = item.UnitPrice * item.Quantity;
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @(item.Product != null ? item.Product.Name : "Product")
                                    </div>
                                    <span class="font-monospace small text-muted">
                                        SKU: @(item.Product != null ? item.Product.Sku : "—")
                                    </span>
                                </td>
                                <td>@item.UnitPrice.ToString("N2") EGP</td>
                                <td><span class="badge bg-light text-dark border fs-6">@item.Quantity</span></td>
                                <td class="text-end pe-3 fw-bold text-dark">@lineTotal.ToString("N2") EGP</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
        {
            <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-chat-left-text me-2 text-primary"></i>Customer Order Notes</h6>
                <p class="mb-0 small text-secondary">@Model.OrderNotes</p>
            </div>
        }
    </div>

    <!-- Right Column: Customer & Financial Summary -->
    <div class="col-12 col-lg-4">
        <!-- Customer & Shipping Details Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <span class="fw-bold"><i class="bi bi-truck text-primary me-2"></i>Customer & Shipping Details</span>
            </div>
            <div class="card-body p-4 small">
                <div class="fw-bold text-dark fs-6 mb-1">
                    @if (Model.CustomerId > 0)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-decoration-none text-dark">
                            @recipientName
                        </a>
                    }
                    else
                    {
                        <span>@recipientName</span>
                    }
                </div>
                <div class="text-muted mb-2"><i class="bi bi-envelope me-1"></i>@recipientEmail</div>
                <div class="text-muted mb-3"><i class="bi bi-telephone me-1"></i>@recipientPhone</div>

                <div class="fw-semibold text-secondary mb-1">Delivery Destination:</div>
                <div class="text-dark bg-light p-2 rounded mb-3 border">
                    <i class="bi bi-geo-alt text-danger me-1"></i>@deliveryAddress
                </div>

                <div class="fw-semibold text-secondary mb-1">Payment Method:</div>
                <div class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-cash-stack me-1"></i>@Model.PaymentMethod
                </div>
            </div>
        </div>

        <!-- Payment & Financial Summary Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <span class="fw-bold"><i class="bi bi-receipt text-success me-2"></i>Financial Summary</span>
            </div>
            <div class="card-body p-4 small">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-bold text-dark">@subtotal.ToString("N2") EGP</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span><i class="fa-solid fa-ticket me-1"></i>Coupon Discount (@(Model.CouponCode ?? "PROMO")):</span>
                        <span class="fw-bold">- @Model.DiscountAmount.ToString("N2") EGP</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Shipping / Delivery (@(string.IsNullOrEmpty(Model.City) ? "Nationwide" : Model.City)):</span>
                    <span class="@(Model.ShippingFee > 0 ? "fw-bold text-dark font-monospace" : "text-success fw-bold")">
                        @(Model.ShippingFee > 0 ? Model.ShippingFee.ToString("N2") + " EGP" : "FREE")
                    </span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 mb-3">
                    <span class="fw-bold text-dark">Grand Total:</span>
                    <span class="fw-bold text-primary">@Model.TotalAmount.ToString("N2") EGP</span>
                </div>
                <div class="bg-light p-2 rounded text-muted text-center small">
                    <i class="bi bi-shield-check me-1 text-success"></i>Confirmed against SQL Server Catalog
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnUpdateStatus').addEventListener('click', function () {
            const form = document.getElementById('updateStatusForm');
            const select = document.getElementById('orderStatusSelect');
            const isCancel = select.value === '@((int)OrderStatus.Cancelled)';

            if (isCancel) {
                StockifyAlert.confirmDelete(
                    'Cancel Order & Restore Inventory?',
                    'Are you sure you want to cancel this order? All product quantities in this order will be automatically returned back to warehouse inventory.',
                    function () {
                        form.submit();
                    }
                );
            } else {
                form.submit();
            }
        });
    </script>
}
