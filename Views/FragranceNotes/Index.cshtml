@model Stockify.ViewModels.FragranceNotes.FragranceNoteIndexViewModel
@using Stockify.Models.Enums
@{
    ViewData["Title"] = "Fragrance Notes Catalog";
}

<div class="container-fluid px-0">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                    <i class="fa-solid fa-wand-magic-sparkles fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Fragrance Notes Catalog</h4>
                    <span class="text-muted small">إدارة كتالوج النوتات العطرية وخيارات الترشيح السريع لميزة Find Your Scent ✨</span>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="QuickPicks" asp-route-context="@((int)QuickPickContext.Love)" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-xs">
                <i class="fa-solid fa-heart text-danger"></i>
                <span>Loved Quick Picks</span>
                <span class="badge bg-primary text-white rounded-pill ms-1">@Model.LoveQuickPicksCount</span>
            </a>
            <a asp-action="QuickPicks" asp-route-context="@((int)QuickPickContext.Avoid)" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-xs">
                <i class="fa-solid fa-ban text-danger"></i>
                <span>Avoided Quick Picks</span>
                <span class="badge bg-secondary text-white rounded-pill ms-1">@Model.AvoidQuickPicksCount</span>
            </a>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-xs">
                <i class="fa-solid fa-plus"></i>
                <span>Add Fragrance Note</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-xs mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-xs mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-xs rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Total Notes</span>
                    <i class="fa-solid fa-list-check text-primary opacity-50"></i>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalNotesCount</h3>
                <small class="text-muted">إجمالي النوتات المسجلة</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-xs rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Active Notes</span>
                    <i class="fa-solid fa-circle-check text-success opacity-50"></i>
                </div>
                <h3 class="fw-bold mb-0 text-success">@Model.ActiveNotesCount</h3>
                <small class="text-muted">نوتة نشطة قابلة للاختيار</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-xs rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Loved Quick Picks</span>
                    <i class="fa-solid fa-heart text-danger opacity-50"></i>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.LoveQuickPicksCount</h3>
                <small class="text-muted">نوتات تظهر كأزرار سريعة (سؤال 2)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-xs rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Avoided Quick Picks</span>
                    <i class="fa-solid fa-ban text-secondary opacity-50"></i>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.AvoidQuickPicksCount</h3>
                <small class="text-muted">نوتات غير مرغوبة سريعة (سؤال 3)</small>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-xs rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by English or Arabic name..." />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="category" class="form-select">
                        <option value="">All Olfactive Categories (جميع العائلات)</option>
                        <option value="1" selected="@(Model.SelectedCategory == 1)">Citrus (حمضيات)</option>
                        <option value="2" selected="@(Model.SelectedCategory == 2)">Floral (زهور)</option>
                        <option value="3" selected="@(Model.SelectedCategory == 3)">Woody (أخشاب)</option>
                        <option value="4" selected="@(Model.SelectedCategory == 4)">Oriental / Amber (شرقي وعنبر)</option>
                        <option value="5" selected="@(Model.SelectedCategory == 5)">Fresh / Aromatic (منعش وأروماتيك)</option>
                        <option value="6" selected="@(Model.SelectedCategory == 6)">Gourmand / Sweet (غورماند وحلويات)</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnlyCheck" checked="@(Model.ActiveOnly == true)">
                        <label class="form-check-label small text-secondary" for="activeOnlyCheck">Active notes only</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 text-md-end">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notes Table Card -->
    <div class="card border-0 shadow-xs rounded-3 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">#</th>
                        <th>Note Name (English / Arabic)</th>
                        <th>Olfactive Category</th>
                        <th>Quick Picks</th>
                        <th class="text-center">Assigned In</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Order</th>
                        <th class="text-end pe-3" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Notes.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-wand-magic-sparkles fs-2 mb-2 d-block opacity-25"></i>
                                <span>No fragrance notes found matching your criteria.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var note in Model.Notes)
                        {
                            <tr>
                                <td class="ps-3 text-muted small">@note.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@note.Name</div>
                                    <div class="text-secondary small">@note.ArabicName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill">
                                        @note.CategoryNameEn <span class="text-muted">(@note.CategoryNameAr)</span>
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (note.IsLoveQuickPick)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 py-1" title="Quiz Step 2 Quick Pick">
                                                <i class="fa-solid fa-heart me-1"></i>Loved
                                            </span>
                                        }
                                        @if (note.IsAvoidQuickPick)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-1" title="Quiz Step 3 Quick Pick">
                                                <i class="fa-solid fa-ban me-1"></i>Avoided
                                            </span>
                                        }
                                        @if (!note.IsLoveQuickPick && !note.IsAvoidQuickPick)
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (note.ProductsCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1">
                                            @note.ProductsCount perfume(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1">
                                            0 perfumes
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (note.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-center text-muted small">
                                    @note.DisplayOrder
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-light border px-2 py-1" title="Edit Note">
                                            <i class="fa-solid fa-pen-to-square text-secondary"></i>
                                        </a>

                                        <form asp-action="ToggleActive" asp-route-id="@note.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border px-2 py-1" title="@(note.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fa-solid @(note.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                            </button>
                                        </form>

                                        @if (note.ProductsCount > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border px-2 py-1 text-muted opacity-50" title="Cannot delete: assigned to @note.ProductsCount product(s)" disabled>
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="Delete" asp-route-id="@note.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this note?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-light border px-2 py-1 text-danger" title="Delete Note">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
