@model Stockify.ViewModels.FragranceNotes.QuickPicksManagementViewModel
@using Stockify.Models.Enums
@{
    ViewData["Title"] = $"Quick Picks: {Model.ContextTitle}";
    bool isLove = Model.Context == QuickPickContext.Love;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 @(isLove ? "bg-danger" : "bg-secondary") bg-opacity-10 @(isLove ? "text-danger" : "text-secondary") p-2">
                    <i class="fa-solid @(isLove ? "fa-heart" : "fa-ban") fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Quick Picks Configuration</h4>
                    <span class="text-muted small">@Model.ContextDescription</span>
                </div>
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back to Catalog</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-xs mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-xs mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs Navigation -->
    <div class="card border-0 shadow-xs rounded-3 mb-4 bg-white">
        <div class="card-body p-2">
            <ul class="nav nav-pills nav-fill">
                <li class="nav-item">
                    <a class="nav-link py-2.5 @(isLove ? "active bg-danger" : "text-secondary")" 
                       asp-action="QuickPicks" asp-route-context="@((int)QuickPickContext.Love)">
                        <i class="fa-solid fa-heart me-1.5"></i>
                        <span>Question 2: Loved Notes (النوتات المحبوبة)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-2.5 @(!isLove ? "active bg-secondary" : "text-secondary")" 
                       asp-action="QuickPicks" asp-route-context="@((int)QuickPickContext.Avoid)">
                        <i class="fa-solid fa-ban me-1.5"></i>
                        <span>Question 3: Avoided Notes (النوتات غير المرغوبة)</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Quick Add Card -->
    <div class="card border-0 shadow-xs rounded-3 mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-plus-circle me-1.5 text-primary"></i>
                Add Note to Quick Picks (@(isLove ? "Loved" : "Avoided"))
            </h6>
        </div>
        <div class="card-body p-3">
            <form asp-action="AddQuickPick" method="post" class="row g-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="context" value="@((int)Model.Context)" />
                <div class="col-12 col-md-9">
                    <select name="noteId" asp-items="Model.AvailableNotesSelectList" class="form-select" required>
                        <option value="" disabled selected>Select an active note to add to this quick pick bar...</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn @(isLove ? "btn-danger" : "btn-secondary") w-100 shadow-xs">
                        <i class="fa-solid fa-plus me-1"></i>Add Quick Pick
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Current Quick Picks Table -->
    <div class="card border-0 shadow-xs rounded-3 bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <div>
                <h6 class="fw-bold mb-0 text-dark">
                    Current Quick Picks (@Model.QuickPicks.Count notes configured)
                </h6>
                <small class="text-muted">هذه النوتات ستظهر كأزرار بارزة مباشرة في واجهة اكتشاف العطر</small>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 80px;">Order</th>
                        <th>Note Name (English)</th>
                        <th>Arabic Name</th>
                        <th>Category</th>
                        <th class="text-end pe-3" style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.QuickPicks.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid @(isLove ? "fa-heart-crack" : "fa-ban") fs-2 mb-2 d-block opacity-25"></i>
                                <span>No quick picks currently configured for this question. Add one above!</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var qp in Model.QuickPicks)
                        {
                            <tr>
                                <td class="ps-3">
                                    <form asp-action="UpdateQuickPickOrder" method="post" class="d-inline-flex align-items-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="context" value="@((int)Model.Context)" />
                                        <input type="hidden" name="noteId" value="@qp.FragranceNoteId" />
                                        <input type="number" name="displayOrder" value="@qp.DisplayOrder" class="form-control form-control-sm text-center" style="width: 60px;" min="0" onchange="this.form.submit()" title="Change order and press enter" />
                                    </form>
                                </td>
                                <td class="fw-bold text-dark">
                                    @qp.Name
                                </td>
                                <td class="text-secondary">
                                    @qp.ArabicName
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill">
                                        @qp.Category
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <form asp-action="RemoveQuickPick" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="context" value="@((int)Model.Context)" />
                                        <input type="hidden" name="noteId" value="@qp.FragranceNoteId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill" title="Remove from Quick Picks">
                                            <i class="fa-solid fa-xmark me-1"></i>Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
