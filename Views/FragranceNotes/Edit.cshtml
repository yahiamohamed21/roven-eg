@model Stockify.ViewModels.FragranceNotes.FragranceNoteFormViewModel
@using Stockify.Models.Enums
@{
    ViewData["Title"] = $"Edit Note: {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">Edit Fragrance Note: @Model.Name</h5>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Catalog
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.AssignedProductsCount > 0)
                {
                    <div class="alert alert-info border-0 shadow-xs rounded-3 p-3 mb-4">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fa-solid fa-circle-info fs-5 mt-0.5 text-primary"></i>
                            <div>
                                <div class="fw-bold">Note Assigned to @Model.AssignedProductsCount Active Product(s)</div>
                                <div class="small text-secondary mb-1">هذه النوتة مرتبطة حالياً بالعطور التالية في الكتالوج:</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var prodName in Model.AssignedProductNames)
                                    {
                                        <span class="badge bg-white text-dark border px-2 py-1 rounded-pill">@prodName</span>
                                    }
                                </div>
                                <div class="small text-muted mt-2">
                                    <i class="fa-solid fa-shield-halved me-1"></i>
                                    لا يمكن حذف هذه النوتة طالما أنها مستخدمة في أي عطر، ولكن يمكنك إلغاء تفعيلها لإخفائها من الاختيارات الجديدة.
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-xs mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ArabicName" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="ArabicName" class="form-control" dir="rtl" />
                            <span asp-validation-for="ArabicName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="Category" class="form-select">
                                <option value="1">Citrus (حمضيات)</option>
                                <option value="2">Floral (زهور)</option>
                                <option value="3">Woody (أخشاب)</option>
                                <option value="4">Oriental / Amber (شرقي وعنبر)</option>
                                <option value="5">Fresh / Aromatic (منعش وأروماتيك)</option>
                                <option value="6">Gourmand / Sweet (غورماند وحلويات)</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" min="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="card border rounded-3 p-3 bg-light bg-opacity-50">
                                <h6 class="fw-bold text-dark mb-2">Quiz Discovery Prompts (خيارات الظهور السريع في الاختبار)</h6>
                                <p class="text-muted small mb-3">حدد ما إذا كانت هذه النوتة ستظهر كزر اختيار سريع بأعلى خطوات اختبار Find Your Scent.</p>

                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <div class="form-check form-switch p-2 bg-white rounded-3 border">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsLoveQuickPick" id="loveCheck">
                                            <label class="form-check-label fw-semibold text-dark" for="loveCheck">
                                                <i class="fa-solid fa-heart text-danger me-1"></i>
                                                Loved Notes Quick Pick (سؤال 2)
                                            </label>
                                            <div class="text-muted small ms-4">تظهر كزر بارز في خطوة النوتات المفضلة</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="form-check form-switch p-2 bg-white rounded-3 border">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsAvoidQuickPick" id="avoidCheck">
                                            <label class="form-check-label fw-semibold text-dark" for="avoidCheck">
                                                <i class="fa-solid fa-ban text-secondary me-1"></i>
                                                Avoided Notes Quick Pick (سؤال 3)
                                            </label>
                                            <div class="text-muted small ms-4">تظهر كزر بارز في خطوة النوتات غير المرغوبة</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeCheck">
                                <label class="form-check-label fw-semibold text-dark" for="activeCheck">
                                    Active in Catalog (نوتة نشطة قابلة للتخصيص والربط بالمنتجات)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="fa-solid fa-check me-1"></i>Update Note
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
